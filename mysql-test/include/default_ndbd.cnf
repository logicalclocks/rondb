[cluster_config]
#UseShm= 1
MaxNoOfSavedMessages=          1000
MaxNoOfConcurrentTransactions= 2048
MaxNoOfConcurrentOperations=   10000
MaxNoOfConcurrentScans=        64
BatchSizePerLocalScan=         64
DataMemory=                    30M
Diskless=                      0
TimeBetweenWatchDogCheck=      30000
MaxNoOfOrderedIndexes=         128
MaxNoOfAttributes=             2048
TimeBetweenGlobalCheckpoints=  3000
TimeBetweenEpochs=             100
NoOfFragmentLogFiles=          4
FragmentLogFileSize=           64M
DiskPageBufferMemory=          4M
SharedGlobalMemory=            20M
LongMessageBuffer=             32M
RedoBuffer=                    4M
BackupDataBufferSize=          2M
BackupLogBufferSize=           2M
TwoPassInitialNodeRestartCopy=1
TransactionDeadlockDetectionTimeout=3000
# RONDB-1062: proactive deadlock discovery defaults to OFF in production, but
# MTR runs with it ON so the deadlock test suite exercises it.  Tests that must
# hold a deadlock open (e.g. ndbinfo_cluster_locks) override this back to 0 in
# their own .cnf.
# Temporarily disabled Deadlock Discovery in MTR
EnableProactiveDeadlockDetection=0
Checksum=1
SpinMethod=CostBasedSpinning
AutomaticThreadConfig=0
AutomaticMemoryConfig=0
PartitionsPerNode=4
UseOnlyIPv4=1

ODirect= 1
CompressedLCP= 1
CompressedBackup= 1
# the following parameters just function as a small regression
# test that the parameter exists
InitialNoOfOpenFiles= 27

# Increase timeouts for slow test-machines
HeartbeatIntervalDbDb=         30000
HeartbeatIntervalDbApi=        30000

#TransactionDeadlockDetectionTimeout= 7500
DiskIOThreadPool=1

#######
# Configure a typical MT configuration in order to test
# several instances of the MT'ed components.
#
# (Option is ignored for non-MT'ed NDB)
#
ThreadConfig=main={count=1},tc={count=3},ldm={count=4},io={count=1},rep={count=1},recv={count=2},send={count=2}

[api]
UseOnlyIPv4=1

[ndb_mgm]
verbose=0

[ENV]
# Use the multithreaded scheduler whenever available
MTR_NDBMTD= 1
