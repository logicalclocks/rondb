{
  "PIDFile": "@pid-file",
  "REST": {
    "ServerIP": "@bind-address",
    "ServerPort": @port,
    "ProbePort": @probeport,
    "UploadPath": "@uploadpath"
  },
  "RonDB": {
      "Mgmds": [ { "IP": "@cluster_config.ndb_mgmd.1.1.HostName",
                   "Port": @cluster_config.ndb_mgmd.1.1.PortNumber } ]
  },
  "Security": {
    "InsecureAllowAll": @InsecureAllowAll,
    "TLS": {
      "EnableTLS": true,
      "RequireAndVerifyClientCert": true,
      "CertificateFile": "@std-data/hopsworks_fake_certificates/hw_service_and_intermediate.pem",
      "PrivateKeyFile": "@std-data/hopsworks_fake_certificates/hw_service.key",
      "RootCACertFile": "@std-data/hopsworks_fake_certificates/hw_root.pem",
      "TestParameters": {
        "ClientCertFile": "@std-data/hopsworks_fake_certificates/hw_project_and_intermediate.pem",
        "ClientKeyFile": "@std-data/hopsworks_fake_certificates/hw_project.key"
      }
    },
    "APIKey": {
      "UseHopsworksAPIKeys": @UseHopsworksAPIKeys,
      "CacheRefreshIntervalMS": 5000
    }
  },
  "Log": {
    "Level": "INFO"
  },
  "Testing": {
    "MySQL": {
        "Servers": [ { "IP": "@mysqld.1.1.#host",
                       "Port": @mysqld.1.1.port } ],
      "User": "root",
      "Password": ""
    }
  }
}
