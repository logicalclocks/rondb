# RONDB-1104: end-to-end data-node outage test for the REST server.
#
# The REST servers (rdrs.1.1 / rdrs.2.1) keep running while ALL data nodes
# are stopped and later restarted. Verifies over HTTP that rdrs2:
#   1. reports healthy before the outage,
#   2. flips /health to 503 while no data node is available (even though
#      its cluster connection object still exists),
#   3. recovers to /health 200 after the data nodes restart WITHOUT an
#      rdrs2 process restart - which is only possible if the RONDB-1104
#      reconnection cycle (trigger -> teardown -> new cluster connection)
#      actually ran.
#
# During the outage and recovery the test pokes a pk-read endpoint with a
# dummy API key: the key lookup reads RonDB through the metadata
# connection, fails with a cluster-unavailability error and thereby
# exercises the production reconnection trigger path.
#
# Runs after rdrs2-golang_gotest (alphabetical order); it does not depend
# on the seeded test databases and leaves no databases behind.

--source include/have_ndb.inc
--source include/not_windows.inc

# Ignore the warnings generated by ndbcluster's binlog thread when the
# whole cluster is restarted - on both mysqlds.
--disable_query_log
call mtr.add_suppression("cluster disconnect An incident event has been written");
call mtr.add_suppression("The util tables has been lost");
--enable_query_log

connect(mysqld2,127.0.0.1,root,,test,$MASTER_MYPORT1);
connection mysqld2;
--disable_query_log
call mtr.add_suppression("cluster disconnect An incident event has been written");
call mtr.add_suppression("The util tables has been lost");
--enable_query_log
connection default;

--echo # Wait for REST server to report healthy
perl END_OF_PERL;
use strict;
use warnings;
require "$ENV{MYSQL_TEST_DIR}/suite/rdrs2-golang/include/outage_http.pl";
poll_health(200, 60, 'initial health');
print "health: up\n";
END_OF_PERL

--echo # Stop all data nodes
--exec $NDB_MGM -e "all restart -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --not-started --timeout=120 >> $NDB_TOOLS_OUTPUT

--echo # /health must report unavailable during the outage
perl END_OF_PERL;
use strict;
use warnings;
require "$ENV{MYSQL_TEST_DIR}/suite/rdrs2-golang/include/outage_http.pl";
# Poke pk-read so a request-path failure triggers the reconnection.
poll_health_with_poke(503, 120, 'health during outage');
print "health: down during outage\n";
END_OF_PERL

--echo # Restart all data nodes
--exec $NDB_MGM -e "all start" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --timeout=600 >> $NDB_TOOLS_OUTPUT

--echo # REST server must recover without a process restart
perl END_OF_PERL;
use strict;
use warnings;
require "$ENV{MYSQL_TEST_DIR}/suite/rdrs2-golang/include/outage_http.pl";
poll_health_with_poke(200, 180, 'health after recovery');
print "health: recovered without restart\n";
END_OF_PERL

# Wait until mysqld's ndbcluster engine has reconnected too, so the
# post-test checks can run their queries.
--source include/ndb_wait_connected.inc
connection mysqld2;
--source include/ndb_wait_connected.inc
--disconnect mysqld2
connection default;

# The ndb tool output log is created by the --exec redirects above;
# remove it so check-testcase does not see a new file (same convention as
# the ndb suite's restart tests).
--remove_file $NDB_TOOLS_OUTPUT
