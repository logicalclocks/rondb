--source include/have_ndb.inc

# Load TPC-H data (prerequisite for all benchmarks below)
--echo Loading TPC-H data
--exec $NDB_PUSH_AGG_DIR/load_tpch -c "$NDB_CONNECTSTRING" -m $MASTER_MYPORT > $MYSQLTEST_VARDIR/log/load_tpch.log 2>&1
--echo PASSED

