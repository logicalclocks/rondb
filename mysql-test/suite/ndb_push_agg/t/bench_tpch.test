--source include/have_ndb.inc

# Load TPC-H data (prerequisite for all benchmarks below)
--echo Loading TPC-H data
--exec $NDB_PUSH_AGG_DIR/load_tpch -c "$NDB_CONNECTSTRING" -m $MASTER_MYPORT --sf 0.01 > /dev/null 2>&1
--echo PASSED

--echo Running bench_q2_ndbapi
--exec $NDB_PUSH_AGG_DIR/bench_q2_ndbapi -c "$NDB_CONNECTSTRING" -m $MASTER_MYPORT --iterations 1 > /dev/null 2>&1
--echo PASSED

