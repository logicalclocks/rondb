--source include/have_ndb.inc

# Test 6: CHAR GROUP BY with ordered index scan
# Separated due to intermittent schema version issues in DBSPJ.
# The C++ test has a retry loop for error 1227 (Invalid schema version).
--echo Running testJoinAggNdbApi --only 6
--replace_regex /Connect string: .*/Connect string: #/ /MySQL port: .*/MySQL port: #/
--exec $NDB_PUSH_AGG_DIR/testJoinAggNdbApi -c "$NDB_CONNECTSTRING" -m $MASTER_MYPORT --only 6 2>&1
--echo PASSED

# Clean up database created by test program
DROP DATABASE IF EXISTS test_db;
