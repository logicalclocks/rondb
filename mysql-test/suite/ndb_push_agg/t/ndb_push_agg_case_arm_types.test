--source include/have_ndb.inc

# Pushed aggregates over a CASE with a DOUBLE THEN arm and integer
# ELSE arms (dblqh_ronsql_analysis.md section 1, item 1).
#
# The CASE updates one aggregate slot from each arm, and one arm runs
# per row.  The data node's OptimizeProgramBuffer typed each update from
# its own register: SumDouble / MinDouble / MaxDouble in the THEN arm,
# SumBigint / MinBigint / MaxBigint in the ELSE arm, on the same slot.
# The typed kernels never convert the slot, so a group whose rows took
# both arms got DOUBLE bits in a BIGINT slot, or integers added to the
# bits of a DOUBLE.
#
# ct is partitioned on g, so all rows of a group are aggregated in one
# fragment.  Groups 1 and 2 take both arms (group 2 with negative THEN
# values, inserted THEN arm first), group 3 only the THEN arm and group 4
# only the ELSE arm.  The ELSE of MAX is 0 - 100: a negative literal is
# Item_func_neg, which the handler does not push.
#
# Every query runs with pushdown OFF (baseline) then ON: the outputs
# must be identical.

CREATE TABLE ct (
  g  INT NOT NULL,
  id INT NOT NULL,
  k  INT NOT NULL,
  d  DOUBLE NOT NULL,
  PRIMARY KEY (g, id)
) ENGINE=NDB PARTITION BY KEY (g);

# THEN arm: k > 5.
INSERT INTO ct VALUES
  (1, 1,  1,  0.5),  (1, 2,  8,  2.5),  (1, 3,  2,  0.5),  (1, 4,  9,  9.25),
  (1, 5,  3,  0.5),  (1, 6, 10,  4.75), (1, 7,  4,  0.5),  (1, 8, 11, 12.5);
INSERT INTO ct VALUES
  (2, 1,  7, -1.5),  (2, 2,  0,  0.5),  (2, 3,  8, -8.25), (2, 4,  1,  0.5),
  (2, 5,  9, -3.75), (2, 6,  2,  0.5);
INSERT INTO ct VALUES
  (3, 1,  6,  1.25), (3, 2,  7,  2.5),  (3, 3,  8,  3.75), (3, 4,  9,  5);
INSERT INTO ct VALUES
  (4, 1,  0,  0.5),  (4, 2,  1,  0.5),  (4, 3,  2,  0.5);

# Parent of the join: one row per ct row.
CREATE TABLE ctd (
  pk INT PRIMARY KEY,
  g  INT NOT NULL,
  id INT NOT NULL
) ENGINE=NDB;
INSERT INTO ctd SELECT g * 100 + id, g, id FROM ct;

--echo ############################################################
--echo # Test 1: SUM / MIN / MAX over a DOUBLE THEN arm, per group
--echo ############################################################
SET ndb_pushdown_aggregate=OFF;
--sorted_result
SELECT g,
       SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE 0 - 100 END) AS maxm
FROM ct GROUP BY g;

SET ndb_pushdown_aggregate=ON;
--sorted_result
SELECT g,
       SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE 0 - 100 END) AS maxm
FROM ct GROUP BY g;

--replace_column 4 # 7 # 8 # 9 # 10 # 11 #
EXPLAIN SELECT g,
       SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE 0 - 100 END) AS maxm
FROM ct GROUP BY g;

--echo ############################################################
--echo # Test 2: three arms, DOUBLE then integers
--echo ############################################################
SET ndb_pushdown_aggregate=OFF;
--sorted_result
SELECT g, SUM(CASE WHEN k > 9 THEN d WHEN k > 5 THEN 2 ELSE 0 END) AS s
FROM ct GROUP BY g;

SET ndb_pushdown_aggregate=ON;
--sorted_result
SELECT g, SUM(CASE WHEN k > 9 THEN d WHEN k > 5 THEN 2 ELSE 0 END) AS s
FROM ct GROUP BY g;

--echo ############################################################
--echo # Test 3: Test 1 without GROUP BY
--echo ############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE 0 - 100 END) AS maxm
FROM ct;

SET ndb_pushdown_aggregate=ON;
SELECT SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE 0 - 100 END) AS maxm
FROM ct;

--echo ############################################################
--echo # Test 4: Test 1 over a pushed join
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT ctd.g,
       SUM(CASE WHEN ct.k > 5 THEN ct.d ELSE 0 END) AS sum0,
       SUM(CASE WHEN ct.k > 5 THEN ct.d ELSE 1 END) AS sum1,
       MIN(CASE WHEN ct.k > 5 THEN ct.d ELSE 7 END) AS min7,
       MAX(CASE WHEN ct.k > 5 THEN ct.d ELSE 0 - 100 END) AS maxm
FROM ctd JOIN ct ON ct.g = ctd.g AND ct.id = ctd.id
GROUP BY ctd.g;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT ctd.g,
       SUM(CASE WHEN ct.k > 5 THEN ct.d ELSE 0 END) AS sum0,
       SUM(CASE WHEN ct.k > 5 THEN ct.d ELSE 1 END) AS sum1,
       MIN(CASE WHEN ct.k > 5 THEN ct.d ELSE 7 END) AS min7,
       MAX(CASE WHEN ct.k > 5 THEN ct.d ELSE 0 - 100 END) AS maxm
FROM ctd JOIN ct ON ct.g = ctd.g AND ct.id = ctd.id
GROUP BY ctd.g;

--replace_column 4 # 7 # 8 # 9 # 10 # 11 #
EXPLAIN SELECT ctd.g,
       SUM(CASE WHEN ct.k > 5 THEN ct.d ELSE 0 END) AS sum0,
       SUM(CASE WHEN ct.k > 5 THEN ct.d ELSE 1 END) AS sum1,
       MIN(CASE WHEN ct.k > 5 THEN ct.d ELSE 7 END) AS min7,
       MAX(CASE WHEN ct.k > 5 THEN ct.d ELSE 0 - 100 END) AS maxm
FROM ctd JOIN ct ON ct.g = ctd.g AND ct.id = ctd.id
GROUP BY ctd.g;

SET ndb_pushdown_aggregate=DEFAULT;
SET ndb_join_pushdown_aggregate=DEFAULT;
DROP TABLE ctd, ct;
