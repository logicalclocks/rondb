--source include/have_ndb.inc
# Requires DUMP LqhSkipTcNodeCheck (2359) so an API-node signal sender can
# drive LQHKEYREQ directly. That DUMP is only effective in debug builds
# (VM_TRACE / ERROR_INSERT); in production the check fires and LQHKEYREF
# errorCode=1223 (ZNODE_SHUTDOWN_IN_PROGRESS) aborts the benchmark.
--source include/have_ndb_debug.inc

--echo Running bench_q12_tpch
--exec $NDB_PUSH_AGG_DIR/bench_q12_tpch -c "$NDB_CONNECTSTRING" -m $MASTER_MYPORT --orders 4000 --iterations 1
