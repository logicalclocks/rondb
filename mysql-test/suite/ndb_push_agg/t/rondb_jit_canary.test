--source include/have_ndb.inc

# RONDB-1056 Phase 4 — JIT canary.
#
# Drives a join-aggregation query through JOIN_AGG_SETUP_REQ with
# bytecode that the Phase 4 admission walk should accept:
#
#   - BIGINT NOT NULL columns only (admission rejects nullable / non-int64)
#   - No WHERE clause (any filter triggers kOpEmbeddedInterp -> reject)
#   - No CASE / control flow (also kOpEmbeddedInterp)
#   - No GROUP BY (m_n_gb_cols == 0 is the dispatch gate)
#   - Single leaf (m_num_leaves == 1; multi-leaf admits but bridge skips)
#
# The supported program shape: load each input column, do bigint
# arithmetic, sum into the accumulator, exit.
#
# Validation strategy (Phase 4): assert correctness — JIT'd result
# must match the interpreted result. We don't have a session
# variable to flip JIT off (Phase 4 doesn't include one), but the
# WHERE-bearing fallback query exercises the interpreter on the
# same rows and the totals must agree under simple arithmetic.

--echo ############################################################
--echo # RONDB-1056 Phase 4 JIT canary
--echo ############################################################

# Verify the join-pushdown engine is enabled (a hard requirement for
# JOIN_AGG_SETUP_REQ to fire). Older builds may have it off by
# default.
--let $join_pushdown = `SELECT @@ndb_join_pushdown`
if (!$join_pushdown)
{
  --skip ndb_join_pushdown must be enabled
}

--echo # Tables: BIGINT NOT NULL columns only.
CREATE TABLE t1 (
  pk    BIGINT NOT NULL,
  c1    BIGINT NOT NULL,
  PRIMARY KEY (pk)
) ENGINE=NDB;

CREATE TABLE t2 (
  pk    BIGINT NOT NULL,
  c2    BIGINT NOT NULL,
  PRIMARY KEY (pk)
) ENGINE=NDB;

--echo # Load test data — small, deterministic.
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 50);
INSERT INTO t2 VALUES (1, 100), (2, 200), (3, 300), (4, 400), (5, 500);

--echo ############################################################
--echo # Q1: SUM over a 2-table PK join, no GROUP BY, no WHERE.
--echo #     Expected: SUM(t2.c2) for matched pks = 100+200+300+400+500 = 1500
--echo ############################################################
SET ndb_join_pushdown_aggregate=ON;
SELECT SUM(t2.c2)
  FROM t1 JOIN t2 ON t2.pk = t1.pk;

--echo ############################################################
--echo # Q2: SUM of bigint arithmetic over the same join.
--echo #     Expected: SUM(t1.c1 + t2.c2) = (10+100)+(20+200)+(30+300)+(40+400)+(50+500) = 1650
--echo ############################################################
SELECT SUM(t1.c1 + t2.c2)
  FROM t1 JOIN t2 ON t2.pk = t1.pk;

--echo ############################################################
--echo # Q3: SUM of mixed arithmetic (Plus + Minus + Mul).
--echo #     Expected: SUM(t2.c2 - t1.c1 + t1.c1 * 0)
--echo #             = (100-10)+(200-20)+(300-30)+(400-40)+(500-50)
--echo #             = 90+180+270+360+450 = 1350
--echo ############################################################
SELECT SUM(t2.c2 - t1.c1 + t1.c1 * 0)
  FROM t1 JOIN t2 ON t2.pk = t1.pk;

--echo ############################################################
--echo # Q4 (fallback): query with WHERE clause — admission MUST reject
--echo #                (kOpEmbeddedInterp for the filter), interpreter
--echo #                takes over. Same expected result as Q1 minus
--echo #                rows where t1.c1 < 25 (i.e., pk in {1,2}):
--echo #                SUM(t2.c2) for pk in {3,4,5} = 300+400+500 = 1200
--echo ############################################################
SELECT SUM(t2.c2)
  FROM t1 JOIN t2 ON t2.pk = t1.pk
 WHERE t1.c1 >= 25;

--echo ############################################################
--echo # Cleanup
--echo ############################################################
DROP TABLE t2;
DROP TABLE t1;
