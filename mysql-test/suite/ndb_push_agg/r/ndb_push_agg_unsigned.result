############################################################
# Pushed aggregation over BIGINT UNSIGNED past 2^63
############################################################
CREATE TABLE t1 (
pk  BIGINT NOT NULL,
grp BIGINT NOT NULL,
u   BIGINT UNSIGNED NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t1 VALUES
(1, 1, 9223372036854775808),
(2, 1, 4611686018427387904),
(3, 2, 100),
(4, 2, 5);
CREATE TABLE t2 (
pk BIGINT NOT NULL,
u  BIGINT UNSIGNED NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t2 VALUES
(1, 3),
(2, 9223372036854775813),
(3, 18446744073709551615);
# Baseline: pushdown OFF (server-side aggregation).
SET ndb_pushdown_aggregate=OFF;
SELECT SUM(u) FROM t1;
SUM(u)
13835058055282163817
SELECT grp, SUM(u) FROM t1 GROUP BY grp;
grp	SUM(u)
1	13835058055282163712
2	105
SELECT grp, AVG(u) FROM t1 GROUP BY grp;
grp	AVG(u)
1	6917529027641081856.0000
2	52.5000
SELECT MIN(u), MAX(u) FROM t2;
MIN(u)	MAX(u)
3	18446744073709551615
# Pushdown ON — every result must match the baseline above.
SET ndb_pushdown_aggregate=ON;
SELECT SUM(u) FROM t1;
SUM(u)
13835058055282163817
SELECT grp, SUM(u) FROM t1 GROUP BY grp;
grp	SUM(u)
1	13835058055282163712
2	105
SELECT grp, AVG(u) FROM t1 GROUP BY grp;
grp	AVG(u)
1	6917529027641081856.0000
2	52.5000
SELECT MIN(u), MAX(u) FROM t2;
MIN(u)	MAX(u)
3	18446744073709551615
DROP TABLE t1;
DROP TABLE t2;
