############################################################
# RONDB-733: Single-Table Aggregation Pushdown
############################################################
############################################################
# Section A: Create main test table and load data
############################################################
CREATE TABLE t1 (
pk INT PRIMARY KEY,
grp INT,
val INT,
val_null INT
) ENGINE=NDB;
INSERT INTO t1 VALUES
(1,  1, 10,  100),
(2,  1, 20,  NULL),
(3,  1, 30,  300),
(4,  1, 40,  NULL),
(5,  2, 50,  500),
(6,  2, 60,  600),
(7,  2, 70,  NULL),
(8,  3, 80,  800),
(9,  3, 90,  900),
(10, 3, 100, 1000),
(11, 3, 110, NULL),
(12, 3, 120, 1200);
############################################################
# Test 1: GROUP BY single column, COUNT(*)
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, COUNT(*) FROM t1 GROUP BY grp;
grp	COUNT(*)
1	4
2	3
3	5
SET ndb_pushdown_aggregate=ON;
SELECT grp, COUNT(*) FROM t1 GROUP BY grp;
grp	COUNT(*)
1	4
2	3
3	5
############################################################
# Test 2: GROUP BY single column, SUM
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val) FROM t1 GROUP BY grp;
grp	SUM(val)
1	100
2	180
3	500
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val) FROM t1 GROUP BY grp;
grp	SUM(val)
1	100
2	180
3	500
############################################################
# Test 3: GROUP BY single column, MIN + MAX
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, MIN(val), MAX(val) FROM t1 GROUP BY grp;
grp	MIN(val)	MAX(val)
1	10	40
2	50	70
3	80	120
SET ndb_pushdown_aggregate=ON;
SELECT grp, MIN(val), MAX(val) FROM t1 GROUP BY grp;
grp	MIN(val)	MAX(val)
1	10	40
2	50	70
3	80	120
############################################################
# Test 4: All 4 aggregate functions
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, COUNT(*), SUM(val), MIN(val), MAX(val) FROM t1 GROUP BY grp;
grp	COUNT(*)	SUM(val)	MIN(val)	MAX(val)
1	4	100	10	40
2	3	180	50	70
3	5	500	80	120
SET ndb_pushdown_aggregate=ON;
SELECT grp, COUNT(*), SUM(val), MIN(val), MAX(val) FROM t1 GROUP BY grp;
grp	COUNT(*)	SUM(val)	MIN(val)	MAX(val)
1	4	100	10	40
2	3	180	50	70
3	5	500	80	120
############################################################
# Test 5: Multi-column GROUP BY
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, val, COUNT(*) FROM t1 GROUP BY grp, val;
grp	val	COUNT(*)
1	10	1
1	20	1
1	30	1
1	40	1
2	50	1
2	60	1
2	70	1
3	100	1
3	110	1
3	120	1
3	80	1
3	90	1
SET ndb_pushdown_aggregate=ON;
SELECT grp, val, COUNT(*) FROM t1 GROUP BY grp, val;
grp	val	COUNT(*)
1	10	1
1	20	1
1	30	1
1	40	1
2	50	1
2	60	1
2	70	1
3	100	1
3	110	1
3	120	1
3	80	1
3	90	1
############################################################
# Test 6: COUNT(nullable_col) vs COUNT(*)
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, COUNT(val_null), COUNT(*) FROM t1 GROUP BY grp;
grp	COUNT(val_null)	COUNT(*)
1	2	4
2	2	3
3	4	5
SET ndb_pushdown_aggregate=ON;
SELECT grp, COUNT(val_null), COUNT(*) FROM t1 GROUP BY grp;
grp	COUNT(val_null)	COUNT(*)
1	2	4
2	2	3
3	4	5
############################################################
# Test 7: HAVING
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val) AS total FROM t1 GROUP BY grp HAVING total > 200;
grp	total
3	500
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val) AS total FROM t1 GROUP BY grp HAVING total > 200;
grp	total
3	500
############################################################
# Test 8: ORDER BY aggregate
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val) AS total FROM t1 GROUP BY grp ORDER BY total DESC;
grp	total
3	500
2	180
1	100
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val) AS total FROM t1 GROUP BY grp ORDER BY total DESC;
grp	total
3	500
2	180
1	100
############################################################
# Test 9: LIMIT
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val) AS total FROM t1 GROUP BY grp ORDER BY grp LIMIT 2;
grp	total
1	100
2	180
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val) AS total FROM t1 GROUP BY grp ORDER BY grp LIMIT 2;
grp	total
1	100
2	180
############################################################
# Test 10: HAVING + ORDER BY + LIMIT
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val) AS total FROM t1
GROUP BY grp HAVING total > 100 ORDER BY total DESC LIMIT 2;
grp	total
3	500
2	180
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val) AS total FROM t1
GROUP BY grp HAVING total > 100 ORDER BY total DESC LIMIT 2;
grp	total
3	500
2	180
############################################################
# Test 11: Implicit aggregation — COUNT(*) only
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT COUNT(*) FROM t1;
COUNT(*)
12
SET ndb_pushdown_aggregate=ON;
SELECT COUNT(*) FROM t1;
COUNT(*)
12
############################################################
# Test 12: Implicit aggregation — multiple aggregates
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT COUNT(*), SUM(val), MIN(val), MAX(val) FROM t1;
COUNT(*)	SUM(val)	MIN(val)	MAX(val)
12	780	10	120
SET ndb_pushdown_aggregate=ON;
SELECT COUNT(*), SUM(val), MIN(val), MAX(val) FROM t1;
COUNT(*)	SUM(val)	MIN(val)	MAX(val)
12	780	10	120
############################################################
# Test 13: Implicit aggregation with WHERE
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT COUNT(*), SUM(val) FROM t1 WHERE grp = 1;
COUNT(*)	SUM(val)
4	100
SET ndb_pushdown_aggregate=ON;
SELECT COUNT(*), SUM(val) FROM t1 WHERE grp = 1;
COUNT(*)	SUM(val)
4	100
############################################################
# Test 14: WHERE with GROUP BY
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val) FROM t1 WHERE val > 50 GROUP BY grp;
grp	SUM(val)
2	130
3	500
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val) FROM t1 WHERE val > 50 GROUP BY grp;
grp	SUM(val)
2	130
3	500
############################################################
# Test 15: WHERE single row
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val) FROM t1 WHERE pk = 1 GROUP BY grp;
grp	SUM(val)
1	10
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val) FROM t1 WHERE pk = 1 GROUP BY grp;
grp	SUM(val)
1	10
############################################################
# Test 16: Empty table
############################################################
CREATE TABLE t_empty (
pk INT PRIMARY KEY,
grp INT,
val INT
) ENGINE=NDB;
SET ndb_pushdown_aggregate=OFF;
SELECT COUNT(*) FROM t_empty;
COUNT(*)
0
SELECT COUNT(*), SUM(val), MIN(val), MAX(val) FROM t_empty;
COUNT(*)	SUM(val)	MIN(val)	MAX(val)
0	NULL	NULL	NULL
SELECT grp, COUNT(*) FROM t_empty GROUP BY grp;
grp	COUNT(*)
SET ndb_pushdown_aggregate=ON;
SELECT COUNT(*) FROM t_empty;
COUNT(*)
0
SELECT COUNT(*), SUM(val), MIN(val), MAX(val) FROM t_empty;
COUNT(*)	SUM(val)	MIN(val)	MAX(val)
0	NULL	NULL	NULL
SELECT grp, COUNT(*) FROM t_empty GROUP BY grp;
grp	COUNT(*)
DROP TABLE t_empty;
############################################################
# Test 17: Single row table
############################################################
CREATE TABLE t_one (
pk INT PRIMARY KEY,
grp INT,
val INT
) ENGINE=NDB;
INSERT INTO t_one VALUES (1, 1, 42);
SET ndb_pushdown_aggregate=OFF;
SELECT COUNT(*), SUM(val), MIN(val), MAX(val) FROM t_one;
COUNT(*)	SUM(val)	MIN(val)	MAX(val)
1	42	42	42
SELECT grp, SUM(val) FROM t_one GROUP BY grp;
grp	SUM(val)
1	42
SET ndb_pushdown_aggregate=ON;
SELECT COUNT(*), SUM(val), MIN(val), MAX(val) FROM t_one;
COUNT(*)	SUM(val)	MIN(val)	MAX(val)
1	42	42	42
SELECT grp, SUM(val) FROM t_one GROUP BY grp;
grp	SUM(val)
1	42
DROP TABLE t_one;
############################################################
# Test 18: All-NULL aggregate column
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val_null), MIN(val_null), MAX(val_null)
FROM t1 WHERE val_null IS NULL GROUP BY grp;
grp	SUM(val_null)	MIN(val_null)	MAX(val_null)
1	NULL	NULL	NULL
2	NULL	NULL	NULL
3	NULL	NULL	NULL
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val_null), MIN(val_null), MAX(val_null)
FROM t1 WHERE val_null IS NULL GROUP BY grp;
grp	SUM(val_null)	MIN(val_null)	MAX(val_null)
1	NULL	NULL	NULL
2	NULL	NULL	NULL
3	NULL	NULL	NULL
############################################################
# Section G: Index scan tests
############################################################
CREATE TABLE t_idx (
pk INT PRIMARY KEY,
idx_col INT,
val INT,
INDEX ix1 (idx_col)
) ENGINE=NDB;
INSERT INTO t_idx VALUES
(1,  10, 100),
(2,  10, 200),
(3,  20, 300),
(4,  20, 400),
(5,  30, 500),
(6,  30, 600),
(7,  40, 700),
(8,  40, 800);
############################################################
# Test 19: Index range scan with aggregation
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT idx_col, SUM(val) FROM t_idx
WHERE idx_col BETWEEN 10 AND 30 GROUP BY idx_col;
idx_col	SUM(val)
10	300
20	700
30	1100
SET ndb_pushdown_aggregate=ON;
SELECT idx_col, SUM(val) FROM t_idx
WHERE idx_col BETWEEN 10 AND 30 GROUP BY idx_col;
idx_col	SUM(val)
10	300
20	700
30	1100
############################################################
# Test 20: Index range scan with implicit aggregation
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT COUNT(*), SUM(val) FROM t_idx WHERE idx_col > 20;
COUNT(*)	SUM(val)
4	2600
SET ndb_pushdown_aggregate=ON;
SELECT COUNT(*), SUM(val) FROM t_idx WHERE idx_col > 20;
COUNT(*)	SUM(val)
4	2600
DROP TABLE t_idx;
############################################################
# Section H: Type coverage
############################################################
CREATE TABLE t_types (
pk INT PRIMARY KEY,
grp_int INT,
val_bigint BIGINT,
val_float FLOAT,
val_double DOUBLE,
val_date DATE,
val_char CHAR(10),
val_varchar VARCHAR(20)
) ENGINE=NDB;
INSERT INTO t_types VALUES
(1, 1, 1000000000, 1.5,  1.25,  '2025-01-01', 'alpha', 'foo'),
(2, 1, 2000000000, 2.5,  2.75,  '2025-01-01', 'alpha', 'foo'),
(3, 1, 3000000000, 3.5,  3.25,  '2025-01-15', 'beta',  'bar'),
(4, 2, 4000000000, 4.5,  4.75,  '2025-01-15', 'beta',  'bar'),
(5, 2, 5000000000, 5.5,  5.25,  '2025-02-01', 'gamma', 'baz'),
(6, 2, 6000000000, 6.5,  6.75,  '2025-02-01', 'gamma', 'baz');
############################################################
# Test 21: SUM/MIN/MAX on BIGINT
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp_int, SUM(val_bigint), MIN(val_bigint), MAX(val_bigint)
FROM t_types GROUP BY grp_int;
grp_int	SUM(val_bigint)	MIN(val_bigint)	MAX(val_bigint)
1	6000000000	1000000000	3000000000
2	15000000000	4000000000	6000000000
SET ndb_pushdown_aggregate=ON;
SELECT grp_int, SUM(val_bigint), MIN(val_bigint), MAX(val_bigint)
FROM t_types GROUP BY grp_int;
grp_int	SUM(val_bigint)	MIN(val_bigint)	MAX(val_bigint)
1	6000000000	1000000000	3000000000
2	15000000000	4000000000	6000000000
############################################################
# Test 22: SUM/MIN/MAX on FLOAT
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp_int, SUM(val_float), MIN(val_float), MAX(val_float)
FROM t_types GROUP BY grp_int;
grp_int	SUM(val_float)	MIN(val_float)	MAX(val_float)
1	7.5	1.5	3.5
2	16.5	4.5	6.5
SET ndb_pushdown_aggregate=ON;
SELECT grp_int, SUM(val_float), MIN(val_float), MAX(val_float)
FROM t_types GROUP BY grp_int;
grp_int	SUM(val_float)	MIN(val_float)	MAX(val_float)
1	7.5	1.5	3.5
2	16.5	4.5	6.5
############################################################
# Test 23: SUM/MIN/MAX on DOUBLE
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp_int, SUM(val_double), MIN(val_double), MAX(val_double)
FROM t_types GROUP BY grp_int;
grp_int	SUM(val_double)	MIN(val_double)	MAX(val_double)
1	7.25	1.25	3.25
2	16.75	4.75	6.75
SET ndb_pushdown_aggregate=ON;
SELECT grp_int, SUM(val_double), MIN(val_double), MAX(val_double)
FROM t_types GROUP BY grp_int;
grp_int	SUM(val_double)	MIN(val_double)	MAX(val_double)
1	7.25	1.25	3.25
2	16.75	4.75	6.75
############################################################
# Test 24: GROUP BY DATE
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT val_date, COUNT(*), SUM(val_bigint)
FROM t_types GROUP BY val_date;
val_date	COUNT(*)	SUM(val_bigint)
2025-01-01	2	3000000000
2025-01-15	2	7000000000
2025-02-01	2	11000000000
SET ndb_pushdown_aggregate=ON;
SELECT val_date, COUNT(*), SUM(val_bigint)
FROM t_types GROUP BY val_date;
val_date	COUNT(*)	SUM(val_bigint)
2025-01-01	2	3000000000
2025-01-15	2	7000000000
2025-02-01	2	11000000000
