DROP TABLE t_types;
############################################################
# Section I: Fallback — unsupported queries
############################################################
############################################################
# Test 27: COUNT(DISTINCT) — not pushable, MySQL fallback
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, COUNT(DISTINCT val) FROM t1 GROUP BY grp;
grp	COUNT(DISTINCT val)
1	4
2	3
3	5
SET ndb_pushdown_aggregate=ON;
SELECT grp, COUNT(DISTINCT val) FROM t1 GROUP BY grp;
grp	COUNT(DISTINCT val)
1	4
2	3
3	5
############################################################
# Test 28: AVG — not pushable, MySQL fallback
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, AVG(val) FROM t1 GROUP BY grp;
grp	AVG(val)
1	25.0000
2	60.0000
3	100.0000
SET ndb_pushdown_aggregate=ON;
SELECT grp, AVG(val) FROM t1 GROUP BY grp;
grp	AVG(val)
1	25.0000
2	60.0000
3	100.0000
############################################################
# Test 29: ROLLUP — not pushable, MySQL fallback
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(val) FROM t1 GROUP BY grp WITH ROLLUP;
grp	SUM(val)
1	100
2	180
3	500
NULL	780
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val) FROM t1 GROUP BY grp WITH ROLLUP;
grp	SUM(val)
1	100
2	180
3	500
NULL	780
############################################################
# Section J: EXPLAIN
############################################################
############################################################
# Test 30: EXPLAIN with pushdown ON
############################################################
SET ndb_pushdown_aggregate=ON;
EXPLAIN SELECT grp, SUM(val), COUNT(*) FROM t1 GROUP BY grp;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	#	ALL	NULL	#	#	#	#	#	Using pushed aggregation; Using temporary
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`grp` AS `grp`,sum(`test`.`t1`.`val`) AS `SUM(val)`,count(0) AS `COUNT(*)` from `test`.`t1` group by `test`.`t1`.`grp`
############################################################
# Test 31: EXPLAIN with pushdown OFF
############################################################
SET ndb_pushdown_aggregate=OFF;
EXPLAIN SELECT grp, SUM(val), COUNT(*) FROM t1 GROUP BY grp;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	#	ALL	NULL	#	#	#	#	#	Using temporary
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`grp` AS `grp`,sum(`test`.`t1`.`val`) AS `SUM(val)`,count(0) AS `COUNT(*)` from `test`.`t1` group by `test`.`t1`.`grp`
############################################################
# Cleanup
############################################################
DROP TABLE t1;
############################################################
# Phase 19: CASE in Single-Table Aggregates
############################################################
CREATE TABLE tc (
pk INT PRIMARY KEY,
grp INT,
val INT,
flag INT
) ENGINE=NDB;
INSERT INTO tc VALUES
(1, 1, 10, 1), (2, 1, 20, 0), (3, 1, 30, 1),
(4, 2, 40, 0), (5, 2, 50, 1), (6, 2, 60, 0),
(7, 3, 70, 1), (8, 3, 80, 0);
############################################################
# Test 32: SUM(CASE WHEN val <= 30 THEN 1 ELSE 0 END)
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp,
SUM(CASE WHEN val <= 30 THEN 1 ELSE 0 END) AS cnt_low
FROM tc GROUP BY grp;
grp	cnt_low
1	3
2	0
3	0
SET ndb_pushdown_aggregate=ON;
SELECT grp,
SUM(CASE WHEN val <= 30 THEN 1 ELSE 0 END) AS cnt_low
FROM tc GROUP BY grp;
grp	cnt_low
1	3
2	0
3	0
############################################################
# Test 33: All 6 comparison operators
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT
SUM(CASE WHEN val =  30 THEN 1 ELSE 0 END) AS eq_30,
SUM(CASE WHEN val != 30 THEN 1 ELSE 0 END) AS ne_30,
SUM(CASE WHEN val <  30 THEN 1 ELSE 0 END) AS lt_30,
SUM(CASE WHEN val <= 30 THEN 1 ELSE 0 END) AS le_30,
SUM(CASE WHEN val >  30 THEN 1 ELSE 0 END) AS gt_30,
SUM(CASE WHEN val >= 30 THEN 1 ELSE 0 END) AS ge_30
FROM tc;
eq_30	ne_30	lt_30	le_30	gt_30	ge_30
1	7	2	3	5	6
SET ndb_pushdown_aggregate=ON;
SELECT
SUM(CASE WHEN val =  30 THEN 1 ELSE 0 END) AS eq_30,
SUM(CASE WHEN val != 30 THEN 1 ELSE 0 END) AS ne_30,
SUM(CASE WHEN val <  30 THEN 1 ELSE 0 END) AS lt_30,
SUM(CASE WHEN val <= 30 THEN 1 ELSE 0 END) AS le_30,
SUM(CASE WHEN val >  30 THEN 1 ELSE 0 END) AS gt_30,
SUM(CASE WHEN val >= 30 THEN 1 ELSE 0 END) AS ge_30
FROM tc;
eq_30	ne_30	lt_30	le_30	gt_30	ge_30
1	7	2	3	5	6
############################################################
# Test 34: CASE with field ref in THEN arm
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp,
SUM(CASE WHEN flag = 1 THEN val ELSE 0 END) AS flagged_sum
FROM tc GROUP BY grp;
grp	flagged_sum
1	40
2	50
3	70
SET ndb_pushdown_aggregate=ON;
SELECT grp,
SUM(CASE WHEN flag = 1 THEN val ELSE 0 END) AS flagged_sum
FROM tc GROUP BY grp;
grp	flagged_sum
1	40
2	50
3	70
############################################################
# Test 35: COUNT, MIN, MAX with CASE
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp,
COUNT(CASE WHEN val > 20 THEN 1 ELSE 0 END) AS cnt,
MIN(CASE WHEN flag = 1 THEN val ELSE 999 END) AS min_flagged,
MAX(CASE WHEN flag = 1 THEN val ELSE 0 END) AS max_flagged
FROM tc GROUP BY grp;
grp	cnt	min_flagged	max_flagged
1	3	10	30
2	3	50	50
3	2	70	70
SET ndb_pushdown_aggregate=ON;
SELECT grp,
COUNT(CASE WHEN val > 20 THEN 1 ELSE 0 END) AS cnt,
MIN(CASE WHEN flag = 1 THEN val ELSE 999 END) AS min_flagged,
MAX(CASE WHEN flag = 1 THEN val ELSE 0 END) AS max_flagged
FROM tc GROUP BY grp;
grp	cnt	min_flagged	max_flagged
1	3	10	30
2	3	50	50
3	2	70	70
############################################################
# Test 36: Multiple CASE aggregates in one query
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp,
SUM(CASE WHEN val <= 30 THEN 1 ELSE 0 END) AS low,
SUM(CASE WHEN val > 30  THEN 1 ELSE 0 END) AS high,
SUM(CASE WHEN flag = 1  THEN val ELSE 0 END) AS fsum
FROM tc GROUP BY grp;
grp	low	high	fsum
1	3	0	40
2	0	3	50
3	0	2	70
SET ndb_pushdown_aggregate=ON;
SELECT grp,
SUM(CASE WHEN val <= 30 THEN 1 ELSE 0 END) AS low,
SUM(CASE WHEN val > 30  THEN 1 ELSE 0 END) AS high,
SUM(CASE WHEN flag = 1  THEN val ELSE 0 END) AS fsum
FROM tc GROUP BY grp;
grp	low	high	fsum
1	3	0	40
2	0	3	50
3	0	2	70
############################################################
# Test 37: Multi-WHEN CASE (now pushed)
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp,
SUM(CASE WHEN val <= 20 THEN 1
WHEN val <= 50 THEN 2
ELSE 3 END) AS bucketed
FROM tc GROUP BY grp;
grp	bucketed
1	4
2	7
3	6
SET ndb_pushdown_aggregate=ON;
SELECT grp,
SUM(CASE WHEN val <= 20 THEN 1
WHEN val <= 50 THEN 2
ELSE 3 END) AS bucketed
FROM tc GROUP BY grp;
grp	bucketed
1	4
2	7
3	6
############################################################
# Test 38: Implicit aggregation (no GROUP BY) with CASE
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT SUM(CASE WHEN val <= 40 THEN 1 ELSE 0 END) AS low,
SUM(CASE WHEN flag = 1 THEN val ELSE 0 END) AS fsum
FROM tc;
low	fsum
4	160
SET ndb_pushdown_aggregate=ON;
SELECT SUM(CASE WHEN val <= 40 THEN 1 ELSE 0 END) AS low,
SUM(CASE WHEN flag = 1 THEN val ELSE 0 END) AS fsum
FROM tc;
low	fsum
4	160
############################################################
# Test 39: Simple CASE (CASE col WHEN val THEN ...)
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp,
SUM(CASE flag WHEN 1 THEN val WHEN 0 THEN 0 ELSE -1 END) AS sval
FROM tc GROUP BY grp;
grp	sval
1	40
2	50
3	70
SET ndb_pushdown_aggregate=ON;
SELECT grp,
SUM(CASE flag WHEN 1 THEN val WHEN 0 THEN 0 ELSE -1 END) AS sval
FROM tc GROUP BY grp;
grp	sval
1	40
2	50
3	70
