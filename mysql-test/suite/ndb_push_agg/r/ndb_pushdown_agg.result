SELECT grp,
SUM(CASE WHEN status = 'ACTIVE' THEN 1
WHEN status = 'PENDING' THEN 1
ELSE 0 END) AS non_inactive
FROM ts GROUP BY grp;
grp	non_inactive
1	2
2	2
SET ndb_pushdown_aggregate=ON;
SELECT grp,
SUM(CASE WHEN status = 'ACTIVE' THEN 1
WHEN status = 'PENDING' THEN 1
ELSE 0 END) AS non_inactive
FROM ts GROUP BY grp;
grp	non_inactive
1	2
2	2
