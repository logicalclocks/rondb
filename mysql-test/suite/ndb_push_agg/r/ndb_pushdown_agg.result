############################################################
# Test 46: DECIMAL arithmetic (TPC-H Q9 pattern)
############################################################
CREATE TABLE td (
pk INT PRIMARY KEY,
grp INT,
price DECIMAL(10,2),
discount DECIMAL(5,2),
qty INT
) ENGINE=NDB;
INSERT INTO td VALUES (1, 1, 100.00, 0.10, 5);
INSERT INTO td VALUES (2, 1, 200.00, 0.20, 3);
INSERT INTO td VALUES (3, 2, 150.00, 0.05, 10);
INSERT INTO td VALUES (4, 2, 50.00,  0.15, 8);
SET ndb_pushdown_aggregate=OFF;
SELECT grp, SUM(price * (1 - discount)) AS revenue
FROM td GROUP BY grp;
grp	revenue
1	250.0000
2	185.0000
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(price * (1 - discount)) AS revenue
FROM td GROUP BY grp;
grp	revenue
1	250.0000
2	185.0000
############################################################
# Test 47: Fallback - unsupported patterns
############################################################
# DIV in arithmetic falls back
SET ndb_pushdown_aggregate=ON;
SELECT grp, SUM(val / 2) AS half FROM ts GROUP BY grp;
grp	half
1	175.0000
2	125.0000
############################################################
# Section G: AVG aggregate pushdown
############################################################
CREATE TABLE ta (
pk INT PRIMARY KEY,
grp INT,
val INT,
val_null INT,
val_float FLOAT,
val_double DOUBLE
) ENGINE=NDB;
INSERT INTO ta VALUES
(1,  1, 10,  100,  1.5,  1.25),
(2,  1, 20,  NULL, 2.5,  2.75),
(3,  1, 30,  300,  3.5,  3.25),
(4,  1, 40,  NULL, 4.5,  4.75),
(5,  2, 50,  500,  5.5,  5.25),
(6,  2, 60,  600,  6.5,  6.75),
(7,  2, 70,  NULL, 7.5,  7.25),
(8,  3, 80,  800,  8.5,  8.25),
(9,  3, 90,  900,  9.5,  9.25),
(10, 3, 100, 1000, 10.5, 10.25),
(11, 3, 110, NULL, 11.5, 11.25),
(12, 3, 120, 1200, 12.5, 12.25);
############################################################
# Test 48: AVG with GROUP BY
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, AVG(val) FROM ta GROUP BY grp;
grp	AVG(val)
1	25.0000
2	60.0000
3	100.0000
SET ndb_pushdown_aggregate=ON;
SELECT grp, AVG(val) FROM ta GROUP BY grp;
grp	AVG(val)
1	25.0000
2	60.0000
3	100.0000
############################################################
# Test 49: AVG with NULL values
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT grp, AVG(val_null) FROM ta GROUP BY grp;
grp	AVG(val_null)
1	200.0000
2	550.0000
3	975.0000
SET ndb_pushdown_aggregate=ON;
SELECT grp, AVG(val_null) FROM ta GROUP BY grp;
grp	AVG(val_null)
1	200.0000
2	550.0000
3	975.0000
############################################################
