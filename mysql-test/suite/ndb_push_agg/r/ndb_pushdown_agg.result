# Test 25: GROUP BY CHAR
############################################################
SET ndb_pushdown_aggregate=OFF;
SELECT val_char, SUM(val_bigint) FROM t_types GROUP BY val_char;
val_char	SUM(val_bigint)
alpha	3000000000
beta	7000000000
gamma	11000000000
SET ndb_pushdown_aggregate=ON;
SELECT val_char, SUM(val_bigint) FROM t_types GROUP BY val_char;
val_char	SUM(val_bigint)
