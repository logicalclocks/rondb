SELECT t3.qty, SUM(t1.region), MIN(t1.region), MAX(t1.region), COUNT(t1.region)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t3.qty;
