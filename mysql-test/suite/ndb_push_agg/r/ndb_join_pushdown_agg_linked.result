############################################################
# Test F3: COUNT(*) and SUM with linked GROUP BY
# GROUP BY on root column, COUNT and SUM on leaf
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT t1.grp, COUNT(*), SUM(t3.amount)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp;
grp	COUNT(*)	SUM(t3.amount)
A	3	1000
B	3	1500
C	2	1100
SET ndb_join_pushdown_aggregate=ON;
SELECT t1.grp, COUNT(*), SUM(t3.amount)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp;
grp	COUNT(*)	SUM(t3.amount)
A	3	1000
B	3	1500
C	2	1100
############################################################
# Test F4: Multiple linked GROUP BY columns
# GROUP BY on root + intermediate columns
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT t1.grp, t2.cat, SUM(t3.amount)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp, t2.cat;
grp	cat	SUM(t3.amount)
A	X	300
A	Z	700
B	X	800
B	Y	700
C	X	500
C	Z	600
SET ndb_join_pushdown_aggregate=ON;
SELECT t1.grp, t2.cat, SUM(t3.amount)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp, t2.cat;
grp	cat	SUM(t3.amount)
A	X	300
A	Z	700
B	X	800
B	Y	700
C	X	500
C	Z	600
# Cleanup
DROP TABLE t3, t2, t1;
