############################################################
# Test E5: Manual AVG decomposition (SUM/COUNT) on linked col
# Diagnostic: If SUM and COUNT individually are correct,
# this should give the correct AVG even if AVG() is buggy.
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT t2.cat, SUM(t1.region), COUNT(t1.region),
SUM(t1.region)/COUNT(t1.region) AS manual_avg
FROM t1 JOIN t2 ON t2.pk = t1.pk
GROUP BY t2.cat;
cat	SUM(t1.region)	COUNT(t1.region)	manual_avg
X	70	4	17.5000
Y	40	2	20.0000
Z	40	2	20.0000
SET ndb_join_pushdown_aggregate=ON;
SELECT t2.cat, SUM(t1.region), COUNT(t1.region),
SUM(t1.region)/COUNT(t1.region) AS manual_avg
FROM t1 JOIN t2 ON t2.pk = t1.pk
GROUP BY t2.cat;
cat	SUM(t1.region)	COUNT(t1.region)	manual_avg
X	70	4	17.5000
Y	40	2	20.0000
Z	40	2	20.0000
