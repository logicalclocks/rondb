############################################################
# Test 10: COUNT(*) vs COUNT(nullable) per type family
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT td.grp, COUNT(*), COUNT(tf.ti), COUNT(tf.f), COUNT(tf.dec2),
COUNT(tf.vc), COUNT(tf.dt)
FROM td JOIN tf ON tf.pk = td.pk
GROUP BY td.grp;
grp	COUNT(*)	COUNT(tf.ti)	COUNT(tf.f)	COUNT(tf.dec2)	COUNT(tf.vc)	COUNT(tf.dt)
A	3	2	2	2	2	2
B	3	2	2	2	2	2
C	2	2	2	2	2	2
SET ndb_join_pushdown_aggregate=ON;
SELECT td.grp, COUNT(*), COUNT(tf.ti), COUNT(tf.f), COUNT(tf.dec2),
COUNT(tf.vc), COUNT(tf.dt)
FROM td JOIN tf ON tf.pk = td.pk
GROUP BY td.grp;
grp	COUNT(*)	COUNT(tf.ti)	COUNT(tf.f)	COUNT(tf.dec2)	COUNT(tf.vc)	COUNT(tf.dt)
A	3	2	2	2	2	2
B	3	2	2	2	2	2
C	2	2	2	2	2	2
