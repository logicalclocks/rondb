############################################################
# Test 1: SUM + COUNT over signed int widths, GROUP BY dim
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT td.grp, SUM(tf.ti), SUM(tf.si), SUM(tf.mi), SUM(tf.i), SUM(tf.bi), COUNT(*)
FROM td JOIN tf ON tf.pk = td.pk
GROUP BY td.grp;
grp	SUM(tf.ti)	SUM(tf.si)	SUM(tf.mi)	SUM(tf.i)	SUM(tf.bi)	COUNT(*)
A	1	10	100	1000	10000	3
B	1	10	100	1000	10000	3
C	1	10	100	1000	10000	2
SET ndb_join_pushdown_aggregate=ON;
SELECT td.grp, SUM(tf.ti), SUM(tf.si), SUM(tf.mi), SUM(tf.i), SUM(tf.bi), COUNT(*)
FROM td JOIN tf ON tf.pk = td.pk
GROUP BY td.grp;
grp	SUM(tf.ti)	SUM(tf.si)	SUM(tf.mi)	SUM(tf.i)	SUM(tf.bi)	COUNT(*)
A	1	10	100	1000	10000	3
B	1	10	100	1000	10000	3
C	1	10	100	1000	10000	2
############################################################
# Test 2: SUM over unsigned int widths, GROUP BY dim
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT td.grp, SUM(tf.tiu), SUM(tf.siu), SUM(tf.miu), SUM(tf.iu), SUM(tf.biu)
FROM td JOIN tf ON tf.pk = td.pk
GROUP BY td.grp;
grp	SUM(tf.tiu)	SUM(tf.siu)	SUM(tf.miu)	SUM(tf.iu)	SUM(tf.biu)
A	3	30	300	3000	30000
B	7	70	700	7000	70000
C	11	110	1100	11000	110000
SET ndb_join_pushdown_aggregate=ON;
SELECT td.grp, SUM(tf.tiu), SUM(tf.siu), SUM(tf.miu), SUM(tf.iu), SUM(tf.biu)
FROM td JOIN tf ON tf.pk = td.pk
GROUP BY td.grp;
grp	SUM(tf.tiu)	SUM(tf.siu)	SUM(tf.miu)	SUM(tf.iu)	SUM(tf.biu)
A	3	30	300	3000	30000
B	7	70	700	7000	70000
C	11	110	1100	11000	110000
############################################################
# Test 3: MIN/MAX over signed int widths at their boundaries
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT MIN(tb.ti), MAX(tb.ti), MIN(tb.si), MAX(tb.si), MIN(tb.mi), MAX(tb.mi),
MIN(tb.i), MAX(tb.i), MIN(tb.bi), MAX(tb.bi)
FROM td JOIN tb ON tb.pk = td.pk;
MIN(tb.ti)	MAX(tb.ti)	MIN(tb.si)	MAX(tb.si)	MIN(tb.mi)	MAX(tb.mi)	MIN(tb.i)	MAX(tb.i)	MIN(tb.bi)	MAX(tb.bi)
-128	127	-32768	32767	-8388608	8388607	-2147483648	2147483647	-9223372036854775808	9223372036854775807
SET ndb_join_pushdown_aggregate=ON;
SELECT MIN(tb.ti), MAX(tb.ti), MIN(tb.si), MAX(tb.si), MIN(tb.mi), MAX(tb.mi),
MIN(tb.i), MAX(tb.i), MIN(tb.bi), MAX(tb.bi)
FROM td JOIN tb ON tb.pk = td.pk;
MIN(tb.ti)	MAX(tb.ti)	MIN(tb.si)	MAX(tb.si)	MIN(tb.mi)	MAX(tb.mi)	MIN(tb.i)	MAX(tb.i)	MIN(tb.bi)	MAX(tb.bi)
-128	127	-32768	32767	-8388608	8388607	-2147483648	2147483647	-9223372036854775808	9223372036854775807
