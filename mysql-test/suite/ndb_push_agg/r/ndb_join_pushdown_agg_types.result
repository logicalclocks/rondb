############################################################
# Test 13: All-NULL rows only (aggregates return NULL)
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT COUNT(*), COUNT(tf.i), SUM(tf.i), MIN(tf.vc), MAX(tf.dt)
FROM td JOIN tf ON tf.pk = td.pk
WHERE td.pk > 6;
COUNT(*)	COUNT(tf.i)	SUM(tf.i)	MIN(tf.vc)	MAX(tf.dt)
2	0	NULL	NULL	NULL
SET ndb_join_pushdown_aggregate=ON;
SELECT COUNT(*), COUNT(tf.i), SUM(tf.i), MIN(tf.vc), MAX(tf.dt)
FROM td JOIN tf ON tf.pk = td.pk
WHERE td.pk > 6;
COUNT(*)	COUNT(tf.i)	SUM(tf.i)	MIN(tf.vc)	MAX(tf.dt)
2	0	NULL	NULL	NULL
SET ndb_join_pushdown_aggregate=DEFAULT;
# Cleanup
DROP TABLE tf;
DROP TABLE tb;
DROP TABLE td;
