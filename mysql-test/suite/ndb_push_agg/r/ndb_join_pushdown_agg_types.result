MIN(tf.dec0), MAX(tf.dec0), MIN(tf.dec2), MAX(tf.dec2)
FROM td JOIN tf ON tf.pk = td.pk;
MIN(tf.f)	MAX(tf.f)	MIN(tf.d)	MAX(tf.d)	MIN(tf.dec0)	MAX(tf.dec0)	MIN(tf.dec2)	MAX(tf.dec2)
-6.5	5.5	-13.5	11.25	-666	555	-66.66	55.55
