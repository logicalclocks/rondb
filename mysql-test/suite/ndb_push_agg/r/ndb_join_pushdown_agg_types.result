############################################################
# Pushed join aggregation: data-type sweep
#
# Every query runs twice: ndb_join_pushdown_aggregate=OFF
# (MySQL-evaluated baseline) and =ON (pushed when supported).
# A type the pushdown path cannot handle falls back to the
# non-pushed plan, so OFF/ON result equality must always hold;
# a divergence is a pushed-aggregation correctness bug.
#
# tf carries moderate values (SUM/COUNT/GROUP BY safe), tb
# carries per-width boundary values (MIN/MAX only, so no SUM
# accumulator can overflow).  TIMESTAMP is deliberately left
# out (time-zone display; covered elsewhere).
# See test_benchmark_extension_plan.md (Phase T5).
############################################################
# Create dimension + fact tables
CREATE TABLE td (
pk INT PRIMARY KEY,
grp VARCHAR(10)
) ENGINE=NDB;
CREATE TABLE tf (
pk INT PRIMARY KEY,
ti TINYINT, tiu TINYINT UNSIGNED,
si SMALLINT, siu SMALLINT UNSIGNED,
mi MEDIUMINT, miu MEDIUMINT UNSIGNED,
i INT, iu INT UNSIGNED,
bi BIGINT, biu BIGINT UNSIGNED,
f FLOAT, d DOUBLE,
dec0 DECIMAL(12,0), dec2 DECIMAL(12,2),
ch CHAR(10), vc VARCHAR(24),
dt DATE, dtt DATETIME
) ENGINE=NDB;
CREATE TABLE tb (
pk INT PRIMARY KEY,
ti TINYINT, tiu TINYINT UNSIGNED,
si SMALLINT, siu SMALLINT UNSIGNED,
mi MEDIUMINT, miu MEDIUMINT UNSIGNED,
i INT, iu INT UNSIGNED,
bi BIGINT, biu BIGINT UNSIGNED,
dec0 DECIMAL(12,0), dec2 DECIMAL(12,2),
ch CHAR(10), vc VARCHAR(24),
dt DATE, dtt DATETIME
) ENGINE=NDB;
