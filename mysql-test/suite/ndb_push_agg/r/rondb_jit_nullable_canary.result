############################################################
# RONDB-1056 nullable-column JIT canary (per-row fallback)
############################################################
CREATE TABLE tn (
pk  BIGINT NOT NULL,
grp BIGINT NOT NULL,
v   BIGINT,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO tn VALUES
(1, 1, 10), (2, 1, NULL), (3, 1, 30),
(4, 2, NULL), (5, 2, NULL), (6, 2, 60),
(7, 3, NULL);
SET ndb_pushdown_aggregate=ON;
# Q1: scalar SUM/COUNT over a nullable column — NULL rows fall back
#     per row, non-NULL rows run the JIT; the program compiles.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT SUM(v), COUNT(v) FROM tn;
SUM(v)	COUNT(v)
100	3
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q1_jit_compiled;
q1_jit_compiled
1
# Q2: grouped — including a group whose rows are ALL NULL (grp 3):
#     SUM stays SQL NULL and COUNT is 0 for that group, the
#     per-group NULL semantics that pushed SQL could not otherwise
#     express.
SELECT grp, SUM(v), COUNT(v) FROM tn GROUP BY grp;
grp	SUM(v)	COUNT(v)
1	40	2
2	60	1
3	NULL	0
DROP TABLE tn;
