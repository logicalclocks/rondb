############################################################
# RONDB-1056 JIT fallback census
############################################################
CREATE TABLE t1 (
pk   BIGINT NOT NULL,
a    BIGINT NOT NULL,
b    BIGINT NOT NULL,
u    BIGINT UNSIGNED NOT NULL,
d    DOUBLE NOT NULL,
f    FLOAT NOT NULL,
dec9 DECIMAL(9,2) NOT NULL,
s    VARCHAR(16) NOT NULL,
dt   DATE NOT NULL,
n    BIGINT,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t1 VALUES
(1, 10, 3, 100, 2.5, 0.5, 1.10, 'beta',  '2026-01-15', NULL),
(2, 20, 4, 200, 3.5, 0.5, 2.20, 'alpha', '2026-02-15', 5),
(3, 30, 5, 300, 4.0, 2.0, 3.30, 'gamma', '2026-03-15', 7),
(4, 40, 6, 400, 6.0, 4.0, 4.40, 'delta', '2026-04-15', NULL);
SET ndb_pushdown_aggregate=ON;
#
# ---- Shapes expected to COMPILE (controls) ----
#
# sum_bigint: plain SUM (Phase 4).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a) FROM t1;
SUM(a)
100
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS sum_bigint_fell_back;
sum_bigint_fell_back
0
# case_int: integer CASE aggregation (Phase 5A).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(CASE WHEN a > 25 THEN a ELSE 0 END) FROM t1;
SUM(CASE WHEN a > 25 THEN a ELSE 0 END)
70
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS case_int_fell_back;
case_int_fell_back
0
# sum_double + double division (Phase 5C-2).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(d), SUM(d / f) FROM t1;
SUM(d)	SUM(d / f)
16	15.5
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS double_div_fell_back;
double_div_fell_back
0
# min_max_u64: unsigned MIN/MAX (Phase 5C-3).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT MIN(u), MAX(u) FROM t1;
MIN(u)	MAX(u)
100	400
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS min_max_u64_fell_back;
min_max_u64_fell_back
0
# nullable_sum: NULL rows on the JIT (Phase 5D).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(n), COUNT(n) FROM t1;
SUM(n)	COUNT(n)
12	2
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS nullable_sum_fell_back;
nullable_sum_fell_back
0
#
# ---- Shapes expected to FALL BACK (the census proper) ----
#
# int_div: integer division (5E — kOpDivIntBigint).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a DIV b) FROM t1;
SUM(a DIV b)
20
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS int_div_fell_back;
int_div_fell_back
0
# int_mod: modulo (5E — kOpMod; the Test 27 canary's opcode).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a % b) FROM t1;
SUM(a % b)
5
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS int_mod_fell_back;
int_mod_fell_back
0
# generic_div_int: '/' over INTEGER operands (5E-adjacent — the
# kernel converts i64 to double at runtime; no JIT conversion ops).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a / b) FROM t1;
SUM(a / b)
21.0000
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS generic_div_int_fell_back;
generic_div_int_fell_back
0
# string_min: MIN over VARCHAR (5F — generic kOpMin, string track).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT MIN(s), MAX(s) FROM t1;
MIN(s)	MAX(s)
alpha	gamma
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS string_min_fell_back;
string_min_fell_back
1
# decimal_sum: SUM over DECIMAL (no DECIMAL track).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(dec9) FROM t1;
SUM(dec9)
11.00
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS decimal_sum_fell_back;
decimal_sum_fell_back
1
# date_min: MIN/MAX over DATE (temporal follow-up on the u64
# stencils — see phase_5c_plan.md).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT MIN(dt), MAX(dt) FROM t1;
MIN(dt)	MAX(dt)
2026-01-15	2026-04-15
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS date_min_fell_back;
date_min_fell_back
0
# unsigned_arith: arithmetic over BIGINT UNSIGNED (5C-3 deferral).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(u + 1) FROM t1;
SUM(u + 1)
1004
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS unsigned_arith_fell_back;
unsigned_arith_fell_back
1
DROP TABLE t1;
