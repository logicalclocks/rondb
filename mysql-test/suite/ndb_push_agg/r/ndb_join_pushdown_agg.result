############################################################
# Test 33: EXPLAIN on 2-way join with aggregation
############################################################
SET ndb_join_pushdown_aggregate=ON;
EXPLAIN SELECT tp1.grp, SUM(tp2.val_int)
FROM tp1 JOIN tp2 ON tp2.pk = tp1.pk
GROUP BY tp1.grp;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	tp1	#	ALL	PRIMARY	#	#	#	#	#	Parent of 2 pushed join@1; Using pushed join aggregation; Using temporary
1	SIMPLE	tp2	#	eq_ref	PRIMARY	#	#	#	#	#	Child of 'tp1' in pushed join@1
Warnings:
Note	1003	/* select#1 */ select `test`.`tp1`.`grp` AS `grp`,sum(`test`.`tp2`.`val_int`) AS `SUM(tp2.val_int)` from `test`.`tp1` join `test`.`tp2` where (`test`.`tp2`.`pk` = `test`.`tp1`.`pk`) group by `test`.`tp1`.`grp`
# Cleanup type tables
DROP TABLE tp2, tp1;
