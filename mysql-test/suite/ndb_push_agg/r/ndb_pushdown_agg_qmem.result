############################################################
# RONDB-1124: pushed GROUP BY under real QueryMemory pressure
############################################################
#
# Fragments keep their groups resident until QueryMemory runs short
# (ndb_pushdown_agg_qmem.cnf keeps it small). These scans need several
# times what QueryMemory can hold, so they only complete if every
# fragment detects the pressure, drains its groups and resumes, and
# the API merges the groups sent more than once. push_agg_compare.inc
# runs every query with pushdown OFF and ON and fails unless both
# return the same rows.
#
############################################################
# A: one scan at a time
############################################################
# A1 50000 groups with a 900-byte key: pushed=1 rows=50000
# A2 20000 groups with a 900-byte MAX payload: pushed=1 rows=20000
############################################################
# B: four concurrent scans share QueryMemory
############################################################
# B1: 4 concurrent pushed scans match the non-pushed result
SET ndb_pushdown_aggregate = DEFAULT;
DROP TABLE t_qm;
DROP TABLE seq_n;
