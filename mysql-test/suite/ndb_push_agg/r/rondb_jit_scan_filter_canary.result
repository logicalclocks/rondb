############################################################
# RONDB-1056 scan-filter JIT canary
############################################################
CREATE TABLE t1 (
pk BIGINT NOT NULL,
v  BIGINT,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t1 VALUES
(1, 10), (2, NULL), (3, 30), (4, NULL), (5, 50);
# Q1: WHERE v IS NOT NULL must JIT (filter rejects the NULL rows).
SELECT pk, v FROM t1 WHERE v IS NOT NULL;
pk	v
1	10
3	30
5	50
# Q2: WHERE v IS NULL must JIT (filter keeps the NULL rows).
SELECT pk FROM t1 WHERE v IS NULL;
pk
2
4
# Q3: differential — same filter without the error insert matches Q1.
SELECT pk, v FROM t1 WHERE v IS NOT NULL;
pk	v
1	10
3	30
5	50
# Q4: WHERE v > 25 must JIT (BRANCH_ATTR_OP_ARG, integer GT literal).
SELECT pk, v FROM t1 WHERE v > 25;
pk	v
3	30
5	50
# Q5: WHERE v = 30 must JIT (BRANCH_ATTR_OP_ARG, integer EQ literal).
SELECT pk, v FROM t1 WHERE v = 30;
pk	v
3	30
# Q6: differential — same comparison without the error insert matches Q4.
SELECT pk, v FROM t1 WHERE v > 25;
pk	v
3	30
5	50
# Q7: WHERE v > ? (bound parameter) must JIT (BRANCH_ATTR_OP_PARAM —
#     the ndbcluster handler pushes a non-const param via cmp_param).
PREPARE pstmt FROM 'SELECT pk, v FROM t1 WHERE v > ?';
SET @lim = 25;
EXECUTE pstmt USING @lim;
pk	v
3	30
5	50
DEALLOCATE PREPARE pstmt;
# Q8: WHERE pk < v (column vs column) must JIT (BRANCH_ATTR_OP_ATTR).
SELECT pk, v FROM t1 WHERE pk < v;
pk	v
1	10
3	30
5	50
# Q9: differential — same col-vs-col comparison without the error insert.
SELECT pk, v FROM t1 WHERE pk < v;
pk	v
1	10
3	30
5	50
DROP TABLE t1;
