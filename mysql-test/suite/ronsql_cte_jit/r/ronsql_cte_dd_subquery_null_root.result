=== sn-2: grouped CTE root, the key is the other side of an OR ===
== Query ==
WITH s AS (SELECT c AS k, SUM(v) AS m FROM sn_o GROUP BY c)
SELECT k, m FROM s
WHERE m > (SELECT MAX(e_x) FROM sn_e GROUP BY e_id) OR k = 2;

