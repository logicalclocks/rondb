=== ol-8: lookupCte root joined to a table on its primary key ===
== Query ==
WITH c AS (SELECT g1, g2, COUNT(*) AS n FROM ol GROUP BY g1, g2)
SELECT c.g1, c.g2, c.n, p.pname
FROM c JOIN olp AS p ON p.pid = c.g2
WHERE c.g1 = 2 AND c.g2 = 1;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH c AS (SELECT g1, g2, COUNT(*) AS n FROM ol GROUP BY g1, g2)
SELECT c.g1, c.g2, c.n, p.pname
FROM c JOIN olp AS p ON p.pid = c.g2
WHERE c.g1 = 2 AND c.g2 = 1|
g1	g2	n	pname
2	1	2	one

