# RONDB-1056 — the JIT arm of the RonSQL differential
# (compiled_interpreter/ronsql_jit_plan.md). Runs the SAME tests as
# suite ronsql_cte (one-line mirrors that --source the originals, so test
# logic can never diverge) with the compiled interpreter ACTIVE,
# while ronsql_cte pins CompiledInterpreter=OFF. Each mirror brackets its
# test with a recorded JIT fallback-delta pin; the milestone goal is
# that EVERY query in this corpus runs on compiled interpreter code —
# census first (these pins), lower the gaps, then flip on
# program-level must-JIT enforcement.
!include suite/ronsql_cte/my.cnf

[cluster_config.1]
CompiledInterpreter=ON
