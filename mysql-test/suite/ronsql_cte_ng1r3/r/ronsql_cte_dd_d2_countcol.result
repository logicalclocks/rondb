=== D2a: COUNT(<col>) in CTE, AGGREGATING main (isolates COUNT(col) from the projection path) ===
== Query ==
WITH ord AS (
SELECT o_custkey AS k, COUNT(*) AS n_all, COUNT(o_clerk) AS n_clerk
FROM orders GROUP BY o_custkey)
SELECT c.c_mktsegment, SUM(ord.n_all), SUM(ord.n_clerk)
FROM customer AS c JOIN ord ON ord.k = c.c_custkey
GROUP BY c.c_mktsegment;

