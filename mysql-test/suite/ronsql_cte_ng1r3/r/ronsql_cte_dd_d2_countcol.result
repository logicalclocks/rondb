=== D2b: COUNT(<col>) in CTE, PROJECTION-ONLY main (original D2/agg-02 shape) ===
== Query ==
WITH ord AS (
SELECT o_custkey AS k, COUNT(*) AS n_all, COUNT(o_clerk) AS n_clerk
FROM orders GROUP BY o_custkey)
SELECT ord.k, ord.n_all, ord.n_clerk
FROM customer AS c JOIN ord ON ord.k = c.c_custkey
WHERE c.c_custkey <= 20;

