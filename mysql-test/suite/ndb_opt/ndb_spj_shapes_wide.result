CREATE TABLE seq (n INT NOT NULL PRIMARY KEY) ENGINE=NDB;
INSERT INTO seq
WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 100)
SELECT n FROM c;
CREATE TABLE wp (
id INT NOT NULL PRIMARY KEY,
fk INT NOT NULL,
vb VARBINARY(29900) NOT NULL
) ENGINE=NDB;
CREATE TABLE wc (
id INT NOT NULL PRIMARY KEY,
vb VARBINARY(29900) NOT NULL
) ENGINE=NDB;
INSERT INTO wp
SELECT n, 9 - n,
REPEAT(ELT(1 + (n - 1) % 4, x'0000E8FF', x'00E8FF00', x'E8FF0000', x'FF0000E8'),
IF(n <= 4, 300, 7450))
FROM seq WHERE n <= 8;
INSERT INTO wc
SELECT n,
REPEAT(ELT(1 + (n - 1) % 4, x'0000E8FF', x'00E8FF00', x'E8FF0000', x'FF0000E8'),
IF(n <= 4, 301, 7449))
FROM seq WHERE n <= 8;
CREATE TABLE drv (x INT NOT NULL) ENGINE=InnoDB;
INSERT INTO drv SELECT n FROM seq WHERE n <= 8;
ANALYZE TABLE wp, wc, drv;
Table	Op	Msg_type	Msg_text
test.wp	analyze	status	OK
test.wc	analyze	status	OK
test.drv	analyze	status	OK
SELECT id, LENGTH(vb), HEX(RIGHT(vb, 4)) FROM wc ORDER BY id;
id	LENGTH(vb)	HEX(RIGHT(vb, 4))
1	1204	0000E8FF
2	1204	00E8FF00
3	1204	E8FF0000
4	1204	FF0000E8
5	29796	0000E8FF
6	29796	00E8FF00
7	29796	E8FF0000
8	29796	FF0000E8
#
# Pushed scan queries (rows carry a correlation)
#
# W5-scan-query-wide-child: rows=8 pushed=2 exec=1
# W6-scan-query-wide-root-left: rows=8 pushed=2 exec=1
#
# Wide linked keys: the parent row sent to DBSPJ is fragmented too
# (VM_TRACE builds)
#
CREATE TABLE kp (
id INT NOT NULL PRIMARY KEY,
k VARBINARY(1300) NOT NULL
) ENGINE=NDB;
CREATE TABLE kc (
k VARBINARY(1300) NOT NULL PRIMARY KEY,
k2 VARBINARY(1300) NOT NULL,
val INT NOT NULL,
KEY ix_k2 (k2)
) ENGINE=NDB;
INSERT INTO kp SELECT n, CONCAT(REPEAT(x'00E8FF00', 300), LPAD(n % 20, 4, '0'))
FROM seq WHERE n <= 60;
INSERT INTO kc SELECT CONCAT(REPEAT(x'00E8FF00', 300), LPAD(n, 4, '0')),
CONCAT(REPEAT(x'00E8FF00', 300), LPAD(n, 4, '0')), n
FROM seq WHERE n <= 15;
ANALYZE TABLE kp, kc;
Table	Op	Msg_type	Msg_text
test.kp	analyze	status	OK
test.kc	analyze	status	OK
# W7-wide-linked-pk-lookup: rows=60 pushed=2 exec=1
# W8-wide-linked-index-scan: rows=45 pushed=2 exec=1
#
# Pushed lookup queries (no correlation in the rows)
#
# W1-lookup-query-wide-child: rows=8 pushed=2 exec=1
# W2-lookup-query-wide-root: rows=8 pushed=2 exec=1
# W3-lookup-query-wide-raw: rows=8 pushed=2 exec=1
# W4-lookup-root-const-1: rows=1 pushed=2 exec=1
# W4-lookup-root-const-2: rows=1 pushed=2 exec=1
# W4-lookup-root-const-3: rows=1 pushed=2 exec=1
# W4-lookup-root-const-4: rows=1 pushed=2 exec=1
# W4-lookup-root-const-5: rows=1 pushed=2 exec=1
# W4-lookup-root-const-6: rows=1 pushed=2 exec=1
# W4-lookup-root-const-7: rows=1 pushed=2 exec=1
# W4-lookup-root-const-8: rows=1 pushed=2 exec=1
DROP TABLE seq, wp, wc, drv, kp, kc;
