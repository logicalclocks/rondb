# N2_lookup_left: rows=1000 pushed=2 exec=1
# N3_lookup_root_null_child_key: rows=1 pushed=2 exec=1
#
# NULL linked key into an ordered-index (ref) scan child
#
# N4_scan_inner: rows=19511 pushed=2 exec=1
# N5_scan_left: rows=19653 pushed=2 exec=1
#
# Composite keys where one part of the linked key is NULL
#
