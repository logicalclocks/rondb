#
# Tables and data
#
CREATE TABLE seq (n INT NOT NULL PRIMARY KEY) ENGINE=NDB;
INSERT INTO seq
WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 3000)
SELECT n FROM c;
CREATE TABLE p (
id INT NOT NULL PRIMARY KEY,
a INT NULL,
b INT NULL,
c INT NULL,
u INT NULL,
v VARCHAR(10) NULL,
KEY ix_pb (b, id)
) ENGINE=NDB;
INSERT INTO p
SELECT n,
IF(n % 5 = 0, NULL, (n * 7) % 700 + 1),
IF(n % 7 = 0, NULL, n % 50),
IF(n % 3 = 0, NULL, n % 4),
IF(n % 4 = 0, NULL, n),
IF(n % 9 = 0, NULL, CONCAT('k', n % 80))
FROM seq WHERE n <= 1000;
CREATE TABLE c1 (
id INT NOT NULL PRIMARY KEY,
x INT NOT NULL,
y INT NULL
) ENGINE=NDB;
INSERT INTO c1
SELECT n, n % 13, IF(n % 6 = 0, NULL, n % 45) FROM seq WHERE n <= 600;
CREATE TABLE c2 (
id INT NOT NULL PRIMARY KEY,
b INT NULL,
c INT NULL,
w INT NOT NULL,
KEY ix_b (b),
KEY ix_bc (b, c)
) ENGINE=NDB;
INSERT INTO c2
SELECT n, IF(n % 11 = 0, NULL, n % 60), IF(n % 5 = 0, NULL, n % 4), n
FROM seq WHERE n <= 1500;
CREATE TABLE cu (
id INT NOT NULL PRIMARY KEY,
u INT NULL,
z INT NOT NULL,
UNIQUE KEY uk_u (u)
) ENGINE=NDB;
INSERT INTO cu SELECT n, IF(n % 10 = 0, NULL, n), n % 17 FROM seq WHERE n <= 800;
CREATE TABLE cpk2 (
k1 INT NOT NULL,
k2 INT NOT NULL,
val INT NOT NULL,
PRIMARY KEY (k1, k2)
) ENGINE=NDB;
INSERT INTO cpk2
SELECT s1.n, s2.n - 1, s1.n * 10 + s2.n
FROM seq s1, seq s2 WHERE s1.n <= 700 AND s2.n <= 4;
CREATE TABLE cv (
k VARCHAR(10) NOT NULL PRIMARY KEY,
z INT NOT NULL
) ENGINE=NDB;
INSERT INTO cv SELECT CONCAT('k', n - 1), n FROM seq WHERE n <= 70;
CREATE TABLE c3 (
b INT NOT NULL,
id INT NOT NULL,
val INT NOT NULL,
PRIMARY KEY (b, id)
) ENGINE=NDB PARTITION BY KEY (b);
INSERT INTO c3 SELECT n % 60, n, n % 23 FROM seq WHERE n <= 1200;
ANALYZE TABLE p, c1, c2, cu, cpk2, cv, c3;
Table	Op	Msg_type	Msg_text
test.p	analyze	status	OK
test.c1	analyze	status	OK
test.c2	analyze	status	OK
test.cu	analyze	status	OK
test.cpk2	analyze	status	OK
test.cv	analyze	status	OK
test.c3	analyze	status	OK
#
