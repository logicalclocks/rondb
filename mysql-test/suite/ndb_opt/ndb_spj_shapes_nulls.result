# N7_scan_composite_partial_null_left: rows=5886 pushed=2 exec=1
# N8_lookup_composite_pk_partial_null: rows=1000 pushed=2 exec=1
# N9_scan_linked_and_const: rows=4711 pushed=2 exec=1
#
# NULL in a nullable unique index and in a VARCHAR PK link
#
# N10_unique_lookup_left: rows=1000 pushed=2 exec=1
# N11_varchar_pk_lookup_left: rows=1000 pushed=2 exec=1
#
# NULL linked keys taken from an intermediate lookup and from a
# grandparent
#
# N12_chain_lookup_then_scan: rows=12960 pushed=3 exec=1
# N13_chain_left_left: rows=13390 pushed=3 exec=1
# N14_key_from_parent_and_grandparent: rows=207 pushed=3 exec=1
# N15_key_from_parent_and_grandparent_left: rows=1000 pushed=3 exec=1
#
# Pruned scan child, NULL prune key
#
# N16_pruned_scan_child_left: rows=17302 pushed=2 exec=1
#
# NULL-safe equality '<=>' as ref key: NULL <=> NULL is TRUE, so
# the rows with p.b IS NULL must match the rows with c2.b IS NULL.
#
# N17_nullsafe_ref_inner: rows=38823 pushed=0 exec=0
# N18_nullsafe_ref_left: rows=38823 pushed=0 exec=0
# N19_nullsafe_composite: rows=7700 pushed=0 exec=0
# N20_nullsafe_unique: rows=20560 pushed=0 exec=0
#
# NULL bounds and NULL-first ordering in the root's ordered index
#
# N21_root_is_null_bound: rows=96 pushed=2 exec=1
# N22_root_range_excludes_null: rows=1983 pushed=2 exec=1
# N23_root_range_or_null: rows=148 pushed=2 exec=1
# N24_root_sorted_nulls_first: rows=131 pushed=2 exec=1
#
# Semi-join and antijoin over nullable linked columns
#
# N25_in_subquery_nullable: rows=858 pushed=2 exec=1
# N26_not_exists_nullable: rows=142 pushed=2 exec=1
# N27_not_in_subquery_with_null: rows=0 pushed=0 exec=0
# N28_not_in_subquery_not_null: rows=0 pushed=0 exec=0
# N29_left_join_is_null_antijoin: rows=142 pushed=2 exec=1
#
# Cleanup
#
DROP TABLE seq, p, c1, c2, cu, cpk2, cv, c3;
