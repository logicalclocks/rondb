CREATE TABLE seq (n INT NOT NULL PRIMARY KEY) ENGINE=NDB;
INSERT INTO seq
WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 2000)
SELECT n FROM c;
CREATE TABLE p (
id INT NOT NULL PRIMARY KEY,
a INT NOT NULL,
ab INT NOT NULL,
pu INT NOT NULL,
b INT NOT NULL,
KEY ix_b (b)
) ENGINE=NDB;
INSERT INTO p
SELECT n, n % 320 + 1, (n % 320 + 1) % 40, n % 320 + 1001, n % 45
FROM seq WHERE n <= 600;
ANALYZE TABLE p;
Table	Op	Msg_type	Msg_text
test.p	analyze	status	OK
