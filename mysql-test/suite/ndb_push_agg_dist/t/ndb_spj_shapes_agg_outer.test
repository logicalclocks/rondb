#
# ndb_spj_shapes_agg_outer: the outer-join shapes of ndb_spj_shapes_agg
# whose pushed join aggregation still returns wrong results.  Disabled in
# collections/disabled_ndb.def until they are fixed; run it with
# --enable-disabled.  Move a shape back to ndb_spj_shapes_agg once it
# passes.
#
# Same method as ndb_spj_shapes_agg: a reference run without any pushdown,
# and a checked run with ndb_join_pushdown, ndb_join_pushdown_aggregate
# and ndb_join_pushdown_aggregate_outer_join ON (the last two default to
# OFF, so mysqld does not push these shapes by default).
#
# Findings (storage/ndb/claude_files/dbspj/README.md):
#  E-9  two outer-joined lookups that both hang off the root: mysqld
#       re-parents them into a chain for the aggregation
#  E-8  inner join nest inside an outer join, and an inner join after an
#       outer join: the join nests are not sent to the data nodes
# E-3 and E-6 (lookup leaf) pass since the kernel fixes of 2026-11-02 and
# are back in ndb_spj_shapes_agg.
#

--source include/have_ndb.inc
--source suite/ndb_opt/ndb_spj_shapes_init.inc

--let $join_pushdown = `SELECT @@ndb_join_pushdown`
if (!$join_pushdown)
{
  --skip ndb_join_pushdown must be enabled
}

--echo #
--echo # Tables and data
--echo #
--source suite/ndb_push_agg_dist/include/spj_shapes_agg_tables.inc

--echo #
--echo # E-9: two outer-joined lookups that both hang off the root
--echo #
let $spj_label= E-9a-left-left-siblings;
let $spj_query= SELECT d.g, COUNT(*), COUNT(l1.pk), COUNT(l2.pk), SUM(l2.v)
  FROM d LEFT JOIN l1 ON l1.pk = d.a
         LEFT JOIN l2 ON l2.pk = d.b
  GROUP BY d.g;
let $spj_agg= 1;
--source suite/ndb_opt/ndb_spj_shapes_check.inc

--echo #
--echo # E-8: join nests
--echo #
# Inner join nest inside the outer join: (l1, l2, l3) is NULL-extended as a
# whole when any of its inner joins has no match
let $spj_label= E-8a-left-nest-inner-chain;
let $spj_query= SELECT d.g, COUNT(*), COUNT(l1.pk), COUNT(l3.pk), SUM(l3.v)
  FROM d LEFT JOIN (l1 JOIN l2 ON l2.pk = l1.b JOIN l3 ON l3.pk = l2.c)
         ON l1.pk = d.a
  GROUP BY d.g;
let $spj_agg= 1;
--source suite/ndb_opt/ndb_spj_shapes_check.inc

# Inner join after an outer join, referring to the root
let $spj_label= E-8b-left-then-inner-on-root;
let $spj_query= SELECT d.g, COUNT(*), COUNT(l1.pk), SUM(l2.v)
  FROM d LEFT JOIN l1 ON l1.pk = d.a
         JOIN l2 ON l2.pk = d.b
  GROUP BY d.g;
let $spj_agg= 1;
--source suite/ndb_opt/ndb_spj_shapes_check.inc

DROP TABLE seq, d, l1, l2, l3, f, reg;
--source suite/ndb_opt/ndb_spj_shapes_end.inc
