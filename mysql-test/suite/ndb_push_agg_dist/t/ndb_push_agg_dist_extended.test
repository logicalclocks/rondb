--source include/have_ndb.inc

--echo ############################################################
--echo # RONDB-1036: Extended Multi-Node Aggregation Tests
--echo ############################################################
--echo #
--echo # Tests inner join, outer join, subqueries, and larger datasets
--echo # across 2 data nodes. Each test runs with pushdown OFF then ON
--echo # and compares results.
--echo #

# Verify ndb_join_pushdown is enabled
--let $join_pushdown = `SELECT @@ndb_join_pushdown`
if (!$join_pushdown)
{
  --skip ndb_join_pushdown must be enabled
}

--echo ############################################################
--echo # Setup: Create tables and load data
--echo ############################################################

CREATE TABLE nations (
  nation_id INT PRIMARY KEY,
  name VARCHAR(20) NOT NULL,
  region VARCHAR(20) NOT NULL
) ENGINE=NDB;

INSERT INTO nations VALUES
  (1, 'Sweden',  'Europe'),
  (2, 'Germany', 'Europe'),
  (3, 'Japan',   'Asia'),
  (4, 'Brazil',  'Americas'),
  (5, 'Kenya',   'Africa');

CREATE TABLE customers (
  cust_id INT PRIMARY KEY,
  nation_id INT NOT NULL,
  segment VARCHAR(20) NOT NULL,
  INDEX idx_nation_id (nation_id)
) ENGINE=NDB;

CREATE TABLE orders (
  order_id INT PRIMARY KEY,
  cust_id INT NOT NULL,
  status CHAR(1) NOT NULL,
  total INT NOT NULL,
  INDEX idx_cust_id (cust_id)
) ENGINE=NDB;

CREATE TABLE items (
  item_id INT PRIMARY KEY,
  order_id INT NOT NULL,
  product VARCHAR(20) NOT NULL,
  price INT NOT NULL,
  qty INT NOT NULL,
  INDEX idx_order_id (order_id)
) ENGINE=NDB;

# Load 50 customers across 5 nations and 3 segments.
# cust_id 46-50 will have NO orders (for outer join tests).
--disable_query_log
let $i = 1;
while ($i <= 50) {
  eval INSERT INTO customers VALUES (
    $i,
    (($i - 1) % 5) + 1,
    ELT((($i - 1) % 3) + 1, 'Consumer', 'Business', 'Government'));
  inc $i;
}

# Load 200 orders for customers 1-45 only (cust 46-50 have no orders).
# Orders 181-200 go to customers with few orders (for skewed distribution).
# status cycles: O, F, P (Open, Fulfilled, Pending)
let $i = 1;
while ($i <= 200) {
  eval INSERT INTO orders VALUES (
    $i,
    LEAST((($i - 1) % 45) + 1, 45),
    ELT((($i - 1) % 3) + 1, 'O', 'F', 'P'),
    ($i * 10) + (($i % 7) * 100));
  inc $i;
}

# Load 500 items across orders 1-180 only (orders 181-200 have no items).
# product cycles across 4 values, price and qty deterministic from item_id.
let $i = 1;
while ($i <= 500) {
  eval INSERT INTO items VALUES (
    $i,
    (($i - 1) % 180) + 1,
    ELT((($i - 1) % 4) + 1, 'Widget', 'Gadget', 'Doohickey', 'Thingamajig'),
    (($i % 50) + 1) * 10,
    ($i % 20) + 1);
  inc $i;
}
--enable_query_log

--echo # Data loaded: 5 nations, 50 customers, 200 orders, 500 items
SELECT COUNT(*) AS nation_cnt FROM nations;
SELECT COUNT(*) AS cust_cnt FROM customers;
SELECT COUNT(*) AS order_cnt FROM orders;
SELECT COUNT(*) AS item_cnt FROM items;

--echo ############################################################
--echo # Test 1: EXPLAIN — inner 2-way join aggregation pushed
--echo ############################################################
SET ndb_join_pushdown_aggregate=ON;
--sorted_result
--replace_column 4 # 7 # 8 # 9 # 10 # 11 #
EXPLAIN SELECT o.status, SUM(o.total), COUNT(*)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
GROUP BY o.status;

--echo ############################################################
--echo # Test 2: Inner 2-way join — SUM + COUNT, 200 rows
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT o.status, SUM(o.total), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT o.status, SUM(o.total), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;

--echo ############################################################
--echo # Test 3: Inner 3-way join — GROUP BY nation, 500 items
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT n.name, SUM(i.price), COUNT(*), MIN(i.price), MAX(i.price)
FROM nations n
  JOIN customers c ON c.nation_id = n.nation_id
  JOIN orders o ON o.cust_id = c.cust_id
  JOIN items i ON i.order_id = o.order_id
GROUP BY n.name;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT n.name, SUM(i.price), COUNT(*), MIN(i.price), MAX(i.price)
FROM nations n
  JOIN customers c ON c.nation_id = n.nation_id
  JOIN orders o ON o.cust_id = c.cust_id
  JOIN items i ON i.order_id = o.order_id
GROUP BY n.name;

--echo ############################################################
--echo # Test 4: Inner join — high-cardinality GROUP BY + HAVING + LIMIT
--echo # GROUP BY order_id gives up to 180 groups
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT o.order_id, SUM(i.price * i.qty) AS revenue, COUNT(*) AS line_cnt
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.order_id
HAVING line_cnt >= 3
ORDER BY revenue DESC
LIMIT 5;

SET ndb_join_pushdown_aggregate=ON;
SELECT o.order_id, SUM(i.price * i.qty) AS revenue, COUNT(*) AS line_cnt
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.order_id
HAVING line_cnt >= 3
ORDER BY revenue DESC
LIMIT 5;

--echo ############################################################
--echo # Test 5: EXPLAIN — outer join aggregation pushed
--echo ############################################################
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
--sorted_result
--replace_column 4 # 7 # 8 # 9 # 10 # 11 #
EXPLAIN SELECT c.segment, COUNT(*), COUNT(o.order_id)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;

--echo ############################################################
--echo # Test 6: Outer 2-way — COUNT(*) vs COUNT(col)
--echo # Customers 46-50 have no orders: COUNT(*) includes them,
--echo # COUNT(order_id) does not
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
--sorted_result
SELECT c.segment, COUNT(*), COUNT(o.order_id), COUNT(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;

SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
--sorted_result
SELECT c.segment, COUNT(*), COUNT(o.order_id), COUNT(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;

--echo ############################################################
--echo # Test 7: Outer 2-way — SUM on child column
--echo # SUM(total) for customers with no orders should be NULL,
--echo # which gets absorbed into the group SUM
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
--sorted_result
SELECT c.segment, SUM(o.total), MIN(o.total), MAX(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;

SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
--sorted_result
SELECT c.segment, SUM(o.total), MIN(o.total), MAX(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;

--echo ############################################################
--echo # Test 8: Outer join — implicit aggregation (no GROUP BY)
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id;

SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
SELECT COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id;

# Test 9: Disabled — known DBSPJ issue with multi-table outer join
# COUNT(*) mismatch when inner JOIN + LEFT JOIN are pushed together.
# Will be fixed in a separate branch.
#--echo ############################################################
