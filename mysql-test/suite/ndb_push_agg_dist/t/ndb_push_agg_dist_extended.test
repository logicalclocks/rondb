--echo ############################################################
--echo # Test 16: Without indexes — inner 2-way join EXPLAIN
--echo # Drop secondary indexes and verify optimizer behavior
--echo ############################################################
ALTER TABLE items DROP INDEX idx_order_id;
ALTER TABLE orders DROP INDEX idx_cust_id;
ALTER TABLE customers DROP INDEX idx_nation_id;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
--replace_column 4 # 7 # 8 # 9 # 10 # 11 #
EXPLAIN SELECT o.status, SUM(o.total), COUNT(*)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
GROUP BY o.status;

--echo ############################################################
--echo # Test 17: Without indexes — inner 2-way join execution
--echo # Compare OFF vs ON without ref access on child
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT o.status, SUM(o.total), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT o.status, SUM(o.total), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;

--echo ############################################################
--echo # Test 18: Without indexes — outer join EXPLAIN
--echo # LEFT JOIN without index on orders.cust_id
--echo ############################################################
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
--sorted_result
--replace_column 4 # 7 # 8 # 9 # 10 # 11 #
EXPLAIN SELECT c.segment, COUNT(*), COUNT(o.order_id)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;

--echo ############################################################
--echo # Test 19: Without indexes — outer 2-way join execution
--echo # COUNT(*) vs COUNT(col) without pushable outer join
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
--sorted_result
SELECT c.segment, COUNT(*), COUNT(o.order_id), COUNT(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;

SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
--sorted_result
SELECT c.segment, COUNT(*), COUNT(o.order_id), COUNT(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;

--echo ############################################################
--echo # Test 20: Without indexes — subquery + join
--echo # Tests 11/12 equivalent without indexes
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT o.status, COUNT(*), SUM(i.price)
FROM orders o JOIN items i ON i.order_id = o.order_id
WHERE o.total > (SELECT AVG(total) FROM orders)
GROUP BY o.status;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT o.status, COUNT(*), SUM(i.price)
FROM orders o JOIN items i ON i.order_id = o.order_id
WHERE o.total > (SELECT AVG(total) FROM orders)
GROUP BY o.status;

--echo ############################################################
--echo # Test 21: Without indexes — filtered join
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT c.segment, COUNT(*), SUM(o.total)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
WHERE o.status = 'F'
GROUP BY c.segment;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT c.segment, COUNT(*), SUM(o.total)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
WHERE o.status = 'F'
GROUP BY c.segment;

--echo ############################################################
--echo # Test 22: Without indexes — 3-way inner + outer
--echo # nations JOIN customers LEFT JOIN orders, no indexes
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
--sorted_result
SELECT n.region, COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM nations n
  JOIN customers c ON c.nation_id = n.nation_id
  LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY n.region;

SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
--sorted_result
SELECT n.region, COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM nations n
  JOIN customers c ON c.nation_id = n.nation_id
  LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY n.region;

--echo ############################################################
--echo # Cleanup
--echo ############################################################
SET ndb_join_pushdown_aggregate_outer_join=OFF;
DROP TABLE items, orders, customers, nations;
