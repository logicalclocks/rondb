#SET ndb_join_pushdown_aggregate=ON;
#SET ndb_join_pushdown_aggregate_outer_join=ON;
#--sorted_result
#SELECT n.region, COUNT(*), COUNT(o.order_id), SUM(o.total)
#FROM nations n
#  JOIN customers c ON c.nation_id = n.nation_id
#  LEFT JOIN orders o ON o.cust_id = c.cust_id
#GROUP BY n.region;

--echo ############################################################
--echo # Test 10: Outer join — HAVING + ORDER BY on outer join agg
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT c.cust_id, COUNT(o.order_id) AS order_cnt, SUM(o.total) AS spend
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.cust_id
HAVING order_cnt = 0
ORDER BY c.cust_id;

SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
SELECT c.cust_id, COUNT(o.order_id) AS order_cnt, SUM(o.total) AS spend
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.cust_id
HAVING order_cnt = 0
ORDER BY c.cust_id;

--echo ############################################################
--echo # Test 11: Subquery in WHERE — scalar comparison
--echo # Inner query is a single-table aggregate, outer query is
--echo # a pushed join aggregate. MySQL evaluates subquery first.
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT o.status, COUNT(*), SUM(i.price)
FROM orders o JOIN items i ON i.order_id = o.order_id
WHERE o.total > (SELECT AVG(total) FROM orders)
GROUP BY o.status;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT o.status, COUNT(*), SUM(i.price)
FROM orders o JOIN items i ON i.order_id = o.order_id
WHERE o.total > (SELECT AVG(total) FROM orders)
GROUP BY o.status;

--echo ############################################################
--echo # Test 12: Subquery IN — only fulfilled orders
--echo # MySQL may convert to semi-join; aggregation may or may
--echo # not be pushed depending on optimizer choice
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT c.segment, COUNT(*), SUM(o.total)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
WHERE o.status = 'F'
GROUP BY c.segment;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT c.segment, COUNT(*), SUM(o.total)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
WHERE o.status = 'F'
GROUP BY c.segment;

--echo ############################################################
--echo # Test 13: Inner join — GROUP BY expression with
--echo # arithmetic in aggregated value
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT o.status, SUM(i.price * i.qty), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT o.status, SUM(i.price * i.qty), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;

--echo ############################################################
--echo # Test 14: Large result — 200 groups (one per order)
--echo # Exercises hash table sizing across 2 nodes
--echo ############################################################
SET ndb_join_pushdown_aggregate=OFF;
--sorted_result
SELECT o.order_id, SUM(i.price), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.order_id;

SET ndb_join_pushdown_aggregate=ON;
--sorted_result
SELECT o.order_id, SUM(i.price), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.order_id;

