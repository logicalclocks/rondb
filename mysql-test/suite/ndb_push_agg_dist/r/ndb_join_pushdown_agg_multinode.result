############################################################
# Test 5: Global aggregation (no GROUP BY)
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT COUNT(*), SUM(t3.amount), MIN(t3.amount), MAX(t3.amount)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk;
COUNT(*)	SUM(t3.amount)	MIN(t3.amount)	MAX(t3.amount)
100	505000	100	10000
SET ndb_join_pushdown_aggregate=ON;
SELECT COUNT(*), SUM(t3.amount), MIN(t3.amount), MAX(t3.amount)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk;
COUNT(*)	SUM(t3.amount)	MIN(t3.amount)	MAX(t3.amount)
100	505000	100	10000
############################################################
# Test 6: HAVING + ORDER BY + LIMIT
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT t1.grp, SUM(t3.amount) AS total, COUNT(*) AS cnt
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp
HAVING cnt >= 10
ORDER BY total ASC
LIMIT 3;
grp	total	cnt
1	46000	10
2	47000	10
3	48000	10
SET ndb_join_pushdown_aggregate=ON;
SELECT t1.grp, SUM(t3.amount) AS total, COUNT(*) AS cnt
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp
HAVING cnt >= 10
ORDER BY total ASC
LIMIT 3;
grp	total	cnt
1	46000	10
2	47000	10
3	48000	10
