############################################################
# RONDB-733 Step 4b: Multi-Node Aggregation Pushdown
############################################################
#
# Tests pushed join aggregation across 2 data nodes.
# Data is distributed across both nodes; each node runs
# independent aggregation, and COMPLETE merges results.
#
# Runs under the standard ndb suite (2 data nodes).
#
############################################################
# Setup: Create tables and load data
############################################################
# 100 rows in parent, spread across 2 data nodes via hash
# distribution on PK. Child tables use PK lookups.
CREATE TABLE t1 (
pk INT PRIMARY KEY,
grp INT NOT NULL,
region VARCHAR(20) NOT NULL
) ENGINE=NDB;
CREATE TABLE t2 (
pk INT PRIMARY KEY,
cat VARCHAR(20) NOT NULL,
discount INT NOT NULL
) ENGINE=NDB;
CREATE TABLE t3 (
pk INT PRIMARY KEY,
amount INT NOT NULL,
qty INT NOT NULL
) ENGINE=NDB;
############################################################
# Test 1: 2-way join, SUM + COUNT GROUP BY
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT t1.grp, SUM(t2.discount), COUNT(*)
FROM t1 JOIN t2 ON t2.pk = t1.pk
GROUP BY t1.grp;
grp	SUM(t2.discount)	COUNT(*)
1	920	10
10	1100	10
2	940	10
3	960	10
4	980	10
5	1000	10
6	1020	10
7	1040	10
8	1060	10
9	1080	10
SET ndb_join_pushdown_aggregate=ON;
SELECT t1.grp, SUM(t2.discount), COUNT(*)
FROM t1 JOIN t2 ON t2.pk = t1.pk
GROUP BY t1.grp;
grp	SUM(t2.discount)	COUNT(*)
1	920	10
10	1100	10
2	940	10
3	960	10
4	980	10
5	1000	10
6	1020	10
7	1040	10
8	1060	10
9	1080	10
############################################################
# Test 2: 3-way join, SUM + COUNT GROUP BY root column
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT t1.grp, SUM(t3.amount), COUNT(*)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp;
grp	SUM(t3.amount)	COUNT(*)
1	46000	10
10	55000	10
2	47000	10
3	48000	10
4	49000	10
5	50000	10
6	51000	10
7	52000	10
8	53000	10
9	54000	10
SET ndb_join_pushdown_aggregate=ON;
SELECT t1.grp, SUM(t3.amount), COUNT(*)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp;
grp	SUM(t3.amount)	COUNT(*)
1	46000	10
10	55000	10
2	47000	10
3	48000	10
4	49000	10
5	50000	10
6	51000	10
7	52000	10
8	53000	10
9	54000	10
############################################################
# Test 3: All 4 aggregate functions
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT t1.grp, SUM(t3.amount), COUNT(*), MIN(t3.amount), MAX(t3.amount)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp;
grp	SUM(t3.amount)	COUNT(*)	MIN(t3.amount)	MAX(t3.amount)
1	46000	10	100	9100
10	55000	10	1000	10000
2	47000	10	200	9200
3	48000	10	300	9300
4	49000	10	400	9400
5	50000	10	500	9500
6	51000	10	600	9600
7	52000	10	700	9700
8	53000	10	800	9800
9	54000	10	900	9900
SET ndb_join_pushdown_aggregate=ON;
SELECT t1.grp, SUM(t3.amount), COUNT(*), MIN(t3.amount), MAX(t3.amount)
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp;
grp	SUM(t3.amount)	COUNT(*)	MIN(t3.amount)	MAX(t3.amount)
1	46000	10	100	9100
10	55000	10	1000	10000
2	47000	10	200	9200
3	48000	10	300	9300
