############################################################
# RONDB-1036: Extended Multi-Node Aggregation Tests
############################################################
#
# Tests inner join, outer join, subqueries, and larger datasets
# across 2 data nodes. Each test runs with pushdown OFF then ON
# and compares results.
#
############################################################
# Setup: Create tables and load data
############################################################
CREATE TABLE nations (
nation_id INT PRIMARY KEY,
name VARCHAR(20) NOT NULL,
region VARCHAR(20) NOT NULL
) ENGINE=NDB;
INSERT INTO nations VALUES
(1, 'Sweden',  'Europe'),
(2, 'Germany', 'Europe'),
(3, 'Japan',   'Asia'),
(4, 'Brazil',  'Americas'),
(5, 'Kenya',   'Africa');
CREATE TABLE customers (
cust_id INT PRIMARY KEY,
nation_id INT NOT NULL,
segment VARCHAR(20) NOT NULL,
INDEX idx_nation_id (nation_id)
) ENGINE=NDB;
CREATE TABLE orders (
order_id INT PRIMARY KEY,
cust_id INT NOT NULL,
status CHAR(1) NOT NULL,
total INT NOT NULL,
INDEX idx_cust_id (cust_id)
) ENGINE=NDB;
CREATE TABLE items (
item_id INT PRIMARY KEY,
order_id INT NOT NULL,
product VARCHAR(20) NOT NULL,
price INT NOT NULL,
qty INT NOT NULL,
INDEX idx_order_id (order_id)
) ENGINE=NDB;
# Data loaded: 5 nations, 50 customers, 200 orders, 500 items
SELECT COUNT(*) AS nation_cnt FROM nations;
nation_cnt
5
SELECT COUNT(*) AS cust_cnt FROM customers;
cust_cnt
50
SELECT COUNT(*) AS order_cnt FROM orders;
order_cnt
200
SELECT COUNT(*) AS item_cnt FROM items;
item_cnt
500
############################################################
# Test 1: EXPLAIN — inner 2-way join aggregation pushed
############################################################
SET ndb_join_pushdown_aggregate=ON;
EXPLAIN SELECT o.status, SUM(o.total), COUNT(*)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
GROUP BY o.status;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	c	#	ALL	PRIMARY	#	#	#	#	#	Parent of 2 pushed join@1; Using pushed join aggregation; Using temporary
1	SIMPLE	o	#	ref	idx_cust_id	#	#	#	#	#	Child of 'c' in pushed join@1
Note	1003	/* select#1 */ select `test`.`o`.`status` AS `status`,sum(`test`.`o`.`total`) AS `SUM(o.total)`,count(0) AS `COUNT(*)` from `test`.`customers` `c` join `test`.`orders` `o` where (`test`.`o`.`cust_id` = `test`.`c`.`cust_id`) group by `test`.`o`.`status`
Warnings:
############################################################
# Test 2: Inner 2-way join — SUM + COUNT, 200 rows
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT o.status, SUM(o.total), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;
status	SUM(o.total)	COUNT(*)
F	191770	167
O	189500	167
P	193230	166
SET ndb_join_pushdown_aggregate=ON;
SELECT o.status, SUM(o.total), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;
status	SUM(o.total)	COUNT(*)
F	191770	167
O	189500	167
P	193230	166
############################################################
# Test 3: Inner 3-way join — GROUP BY nation, 500 items
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT n.name, SUM(i.price), COUNT(*), MIN(i.price), MAX(i.price)
FROM nations n
JOIN customers c ON c.nation_id = n.nation_id
JOIN orders o ON o.cust_id = c.cust_id
JOIN items i ON i.order_id = o.order_id
GROUP BY n.name;
name	SUM(i.price)	COUNT(*)	MIN(i.price)	MAX(i.price)
Brazil	27500	100	50	500
Germany	25500	100	30	480
Japan	26500	100	40	490
Kenya	23500	100	10	460
Sweden	24500	100	20	470
SET ndb_join_pushdown_aggregate=ON;
SELECT n.name, SUM(i.price), COUNT(*), MIN(i.price), MAX(i.price)
FROM nations n
JOIN customers c ON c.nation_id = n.nation_id
JOIN orders o ON o.cust_id = c.cust_id
JOIN items i ON i.order_id = o.order_id
GROUP BY n.name;
name	SUM(i.price)	COUNT(*)	MIN(i.price)	MAX(i.price)
Brazil	27500	100	50	500
Germany	25500	100	30	480
Japan	26500	100	40	490
Kenya	23500	100	10	460
Sweden	24500	100	20	470
############################################################
# Test 4: Inner join — high-cardinality GROUP BY + HAVING + LIMIT
# GROUP BY order_id gives up to 180 groups
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT o.order_id, SUM(i.price * i.qty) AS revenue, COUNT(*) AS line_cnt
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.order_id
HAVING line_cnt >= 3
ORDER BY revenue DESC
LIMIT 5;
order_id	revenue	line_cnt
39	22000	3
139	22000	3
38	20330	3
138	20330	3
19	20000	3
SET ndb_join_pushdown_aggregate=ON;
SELECT o.order_id, SUM(i.price * i.qty) AS revenue, COUNT(*) AS line_cnt
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.order_id
HAVING line_cnt >= 3
ORDER BY revenue DESC
LIMIT 5;
order_id	revenue	line_cnt
39	22000	3
139	22000	3
38	20330	3
138	20330	3
19	20000	3
############################################################
# Test 5: EXPLAIN — outer join aggregation pushed
############################################################
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
EXPLAIN SELECT c.segment, COUNT(*), COUNT(o.order_id)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	c	#	ALL	NULL	#	#	#	#	#	Parent of 2 pushed join@1; Using pushed join aggregation; Using temporary
1	SIMPLE	o	#	ref	idx_cust_id	#	#	#	#	#	Child of 'c' in pushed join@1
Note	1003	/* select#1 */ select `test`.`c`.`segment` AS `segment`,count(0) AS `COUNT(*)`,count(`test`.`o`.`order_id`) AS `COUNT(o.order_id)` from `test`.`customers` `c` left join `test`.`orders` `o` on((`test`.`o`.`cust_id` = `test`.`c`.`cust_id`)) where true group by `test`.`c`.`segment`
Warnings:
############################################################
# Test 6: Outer 2-way — COUNT(*) vs COUNT(col)
# Customers 46-50 have no orders: COUNT(*) includes them,
# COUNT(order_id) does not
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT c.segment, COUNT(*), COUNT(o.order_id), COUNT(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;
segment	COUNT(*)	COUNT(o.order_id)	COUNT(o.total)
Business	69	67	67
Consumer	69	67	67
Government	67	66	66
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
SELECT c.segment, COUNT(*), COUNT(o.order_id), COUNT(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;
segment	COUNT(*)	COUNT(o.order_id)	COUNT(o.total)
Business	69	67	67
Consumer	69	67	67
Government	67	66	66
############################################################
# Test 7: Outer 2-way — SUM on child column
# SUM(total) for customers with no orders should be NULL,
# which gets absorbed into the group SUM
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT c.segment, SUM(o.total), MIN(o.total), MAX(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;
segment	SUM(o.total)	MIN(o.total)	MAX(o.total)
Business	87770	140	2480
Consumer	86700	70	2410
Government	86330	210	2550
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
SELECT c.segment, SUM(o.total), MIN(o.total), MAX(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.segment;
segment	SUM(o.total)	MIN(o.total)	MAX(o.total)
Business	87770	140	2480
Consumer	86700	70	2410
Government	86330	210	2550
