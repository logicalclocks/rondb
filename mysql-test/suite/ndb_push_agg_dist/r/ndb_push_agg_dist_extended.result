O	464490	167
P	460910	166
SET ndb_join_pushdown_aggregate=ON;
SELECT o.status, SUM(i.price * i.qty), COUNT(*)
FROM orders o JOIN items i ON i.order_id = o.order_id
GROUP BY o.status;
status	SUM(i.price * i.qty)	COUNT(*)
F	454600	167
O	464490	167
P	460910	166
