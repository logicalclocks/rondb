# Test 8: Outer join — implicit aggregation (no GROUP BY)
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id;
COUNT(*)	COUNT(o.order_id)	SUM(o.total)
205	200	260800
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
SELECT COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id;
COUNT(*)	COUNT(o.order_id)	SUM(o.total)
205	200	260800
############################################################
# Test 9: Outer join — GROUP BY on nation (through nations table)
# nations JOIN customers LEFT JOIN orders
# All customers have a nation, but some have no orders
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT n.region, COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM nations n
JOIN customers c ON c.nation_id = n.nation_id
LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY n.region;
region	COUNT(*)	COUNT(o.order_id)	SUM(o.total)
Africa	41	40	53400
Americas	41	40	52500
Asia	41	40	52300
Europe	82	80	102600
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
SELECT n.region, COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM nations n
JOIN customers c ON c.nation_id = n.nation_id
LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY n.region;
region	COUNT(*)	COUNT(o.order_id)	SUM(o.total)
Africa	40	40	53400
Americas	48	40	52500
Asia	56	40	52300
Europe	97	80	102600
############################################################
# Test 10: Outer join — HAVING + ORDER BY on outer join agg
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT c.cust_id, COUNT(o.order_id) AS order_cnt, SUM(o.total) AS spend
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.cust_id
HAVING order_cnt = 0
ORDER BY c.cust_id;
cust_id	order_cnt	spend
46	0	NULL
47	0	NULL
48	0	NULL
49	0	NULL
50	0	NULL
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
SELECT c.cust_id, COUNT(o.order_id) AS order_cnt, SUM(o.total) AS spend
FROM customers c LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY c.cust_id
HAVING order_cnt = 0
ORDER BY c.cust_id;
cust_id	order_cnt	spend
46	0	NULL
47	0	NULL
48	0	NULL
49	0	NULL
50	0	NULL
############################################################
# Test 11: Subquery in WHERE — scalar comparison
# Inner query is a single-table aggregate, outer query is
# a pushed join aggregate. MySQL evaluates subquery first.
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT o.status, COUNT(*), SUM(i.price)
FROM orders o JOIN items i ON i.order_id = o.order_id
WHERE o.total > (SELECT AVG(total) FROM orders)
GROUP BY o.status;
status	COUNT(*)	SUM(i.price)
F	68	17490
O	68	18080
P	64	16430
SET ndb_join_pushdown_aggregate=ON;
SELECT o.status, COUNT(*), SUM(i.price)
FROM orders o JOIN items i ON i.order_id = o.order_id
WHERE o.total > (SELECT AVG(total) FROM orders)
GROUP BY o.status;
status	COUNT(*)	SUM(i.price)
############################################################
# Test 12: Subquery IN — only fulfilled orders
# MySQL may convert to semi-join; aggregation may or may
# not be pushed depending on optimizer choice
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT c.segment, COUNT(*), SUM(o.total)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
WHERE o.status = 'F'
GROUP BY c.segment;
segment	COUNT(*)	SUM(o.total)
Business	67	87770
SET ndb_join_pushdown_aggregate=ON;
SELECT c.segment, COUNT(*), SUM(o.total)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
WHERE o.status = 'F'
GROUP BY c.segment;
segment	COUNT(*)	SUM(o.total)
Business	67	87770
Consumer	67	86700
Government	66	86330
