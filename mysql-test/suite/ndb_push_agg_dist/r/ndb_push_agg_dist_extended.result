# Test 22: Without indexes — 3-way inner + outer
# nations JOIN customers LEFT JOIN orders, no indexes
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT n.region, COUNT(*), COUNT(o.order_id), SUM(o.total)
FROM nations n
JOIN customers c ON c.nation_id = n.nation_id
LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY n.region;
