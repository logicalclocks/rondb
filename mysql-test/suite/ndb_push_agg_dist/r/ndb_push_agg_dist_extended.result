############################################################
# Test 15: Combined inner + outer + HAVING + ORDER BY + LIMIT
# nations JOIN customers LEFT JOIN orders, top 3 regions
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SET ndb_join_pushdown_aggregate_outer_join=OFF;
SELECT n.name, COUNT(*) AS total_rows, COUNT(o.order_id) AS with_orders,
SUM(o.total) AS revenue
FROM nations n
JOIN customers c ON c.nation_id = n.nation_id
LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY n.name
HAVING with_orders > 0
ORDER BY revenue DESC
LIMIT 3;
name	total_rows	with_orders	revenue
Kenya	41	40	53400
Brazil	41	40	52500
Japan	41	40	52300
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
SELECT n.name, COUNT(*) AS total_rows, COUNT(o.order_id) AS with_orders,
SUM(o.total) AS revenue
FROM nations n
JOIN customers c ON c.nation_id = n.nation_id
LEFT JOIN orders o ON o.cust_id = c.cust_id
GROUP BY n.name
HAVING with_orders > 0
ORDER BY revenue DESC
LIMIT 3;
name	total_rows	with_orders	revenue
Kenya	40	40	53400
Brazil	48	40	52500
Japan	56	40	52300
############################################################
# Test 16: Without indexes — inner 2-way join EXPLAIN
# Drop secondary indexes and verify optimizer behavior
############################################################
ALTER TABLE items DROP INDEX idx_order_id;
ALTER TABLE orders DROP INDEX idx_cust_id;
ALTER TABLE customers DROP INDEX idx_nation_id;
SET ndb_join_pushdown_aggregate=ON;
EXPLAIN SELECT o.status, SUM(o.total), COUNT(*)
FROM customers c JOIN orders o ON o.cust_id = c.cust_id
GROUP BY o.status;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	c	#	eq_ref	PRIMARY	#	#	#	#	#	Child of 'o' in pushed join@1
1	SIMPLE	o	#	ALL	NULL	#	#	#	#	#	Parent of 2 pushed join@1; Using pushed join aggregation; Using temporary
