#
# 8 workers * 50 unique fields + 10 shared fields = 410 distinct.
#
concurrent_hsets life:concur workers=8 unique=50 shared=10 distinct=410
SELECT redis_key, field_count FROM redis_0.hset_keys
WHERE redis_key = 'life:concur';
redis_key	field_count
life:concur	410
SELECT COUNT(*) FROM redis_0.string_keys
WHERE redis_key_id = (SELECT redis_key_id FROM redis_0.hset_keys
WHERE redis_key = 'life:concur');
COUNT(*)
410
#
# Re-run all 8 workers with the same field sets. All HSETs are
# pure overwrites; field_count must stay at 410.
#
concurrent_hsets life:concur workers=8 unique=50 shared=10 distinct=410
SELECT redis_key, field_count FROM redis_0.hset_keys
WHERE redis_key = 'life:concur';
redis_key	field_count
life:concur	410
SELECT COUNT(*) FROM redis_0.string_keys
WHERE redis_key_id = (SELECT redis_key_id FROM redis_0.hset_keys
WHERE redis_key = 'life:concur');
COUNT(*)
410
