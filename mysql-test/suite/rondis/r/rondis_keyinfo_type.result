#
# Set up: a string, a populated hash, a hash about to be emptied.
#
OK
1
1
1
#
# Existing string key.
#
string
#
# Existing hash.
#
hash
#
# Fully-HDEL'd hash. Row exists with field_count=0; TYPE returns
# none (matching EXISTS = 0).
#
SELECT redis_key, field_count FROM redis_0.hset_keys
WHERE redis_key = 'hash_empty';
redis_key	field_count
hash_empty	0
none
#
# Missing key.
#
none
#
# 1.10c.7a: HSET on an existing string silently replaces the
# string with a hash. TYPE flips from "string" to "hash" in
# a single step (no WRONGTYPE).
#
OK
string
1
hash
#
# After DEL of the now-hash, TYPE reports "none".
#
1
none
