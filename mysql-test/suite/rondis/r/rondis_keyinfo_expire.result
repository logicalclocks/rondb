#
# Set up: a string, a populated hash, an emptied hash.
#
OK
1
1
1
#
# EXPIRE on existing string -> :1; expiry_date is set in the
# window [now, now + 60 + 2].
#
1
str_a_in_window=1
#
# EXPIRE on existing hash -> :1; hset_keys.expiry_date set.
#
1
hash_a_in_window=1
#
# EXPIRE on a fully-HDEL'd hash -> :0 (matches EXISTS = 0).
#
0
#
# EXPIRE on a missing key -> :0.
#
0
#
# EXPIRE 0 deletes an existing key immediately; a second
# non-positive EXPIRE on the now-missing key returns :0.
#
1
0
#
# End-to-end: EXPIRE then TTL on the same key falls in window.
#
OK
1
TTL ttl_round in_window=1
