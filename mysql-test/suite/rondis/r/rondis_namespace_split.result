#
# SET claims the name as a string. The hset_keys row carries
# redis_key_id = 0 alongside the string_keys row.
#
ERR Failed to create hset string-claim code; NDB(4518) Too many instructions in interpreted program

SELECT redis_key_id FROM redis_0.hset_keys WHERE redis_key = 'shared';
redis_key_id
#
# HSET against the same name -> WRONGTYPE (refuses to corrupt
# the existing string row by overwriting redis_key_id).
#
1
#
# The string is intact: GET still works, hset_keys still
# carries redis_key_id = 0.
#

SELECT redis_key_id FROM redis_0.hset_keys WHERE redis_key = 'shared';
redis_key_id
1
#
# Mirror case: HSET first claims the name as a hash, then
# SET against the same name -> WRONGTYPE.
#
1
ERR Failed to create hset string-claim code; NDB(4518) Too many instructions in interpreted program

#
# The hash is intact: HGET still works, hset_keys row keeps
# its non-zero redis_key_id.
#
hash-field-value
SELECT redis_key_id > 0 FROM redis_0.hset_keys WHERE redis_key = 'shared_h';
redis_key_id > 0
1
