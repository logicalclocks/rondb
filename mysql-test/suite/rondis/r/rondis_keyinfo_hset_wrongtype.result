#
# SET claims a string row in both tables.
#
OK
SELECT redis_key, redis_key_id IS NULL AS id_null
FROM redis_0.hset_keys WHERE redis_key = 'sk';
redis_key	id_null
sk	1
#
# HSET on the existing string -> -WRONGTYPE.
#
ERR Failed to execute MSET operation; NDB(878)

#
# The string is intact: GET still returns the original value.
# The hset_keys row still has redis_key_id IS NULL.
#
original
SELECT redis_key, redis_key_id IS NULL AS id_null
FROM redis_0.hset_keys WHERE redis_key = 'sk';
redis_key	id_null
sk	1
#
# HMSET (multi-field) on the existing string -> -WRONGTYPE.
# The reject lands in Phase 1's lock-claim, before any field
# write reaches string_keys, so no field rows leak.
#
ERR Failed to execute MSET operation; NDB(878)

#
# Still intact - GET returns original, no field rows under
# any redis_key_id for sk.
#
original
SELECT COUNT(*) AS field_rows_for_sk
FROM redis_0.string_keys WHERE redis_key = 'sk' AND redis_key_id != 0;
field_rows_for_sk
0
#
# Sanity: HSET on a fresh hash name still works (the rejection
# is specific to existing-string collision, not a blanket HSET
# block).
#
1
v
SELECT redis_key_id IS NULL AS id_null, field_count
FROM redis_0.hset_keys WHERE redis_key = 'fresh_h';
id_null	field_count
0	1
