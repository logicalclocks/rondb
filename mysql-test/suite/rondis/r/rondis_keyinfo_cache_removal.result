#
# 1. HGET on a never-existed hash returns nil; no hset_keys row.
#

SELECT COUNT(*) AS hset_keys_for_nope
FROM redis_0.hset_keys WHERE redis_key = 'nope';
hset_keys_for_nope
0
#
# HMGET on a never-existed hash returns array of nils, no row.
#



SELECT COUNT(*) AS hset_keys_for_nope_after_hmget
FROM redis_0.hset_keys WHERE redis_key = 'nope';
hset_keys_for_nope_after_hmget
0
#
# HINCRBY / HDECRBY on a never-existed hash create the hash
# and field, matching Redis HINCRBY semantics.
#
5
2
SELECT COUNT(*) AS hset_keys_for_nope_after_hincr
FROM redis_0.hset_keys WHERE redis_key = 'nope';
hset_keys_for_nope_after_hincr
1
#
# 2. Same-process HGET after DEL must miss; the cache used to
#    hold the hash's id from the warming HSET.
#
1
warmup
1

SELECT COUNT(*) AS hset_keys_for_h1_after_del
FROM redis_0.hset_keys WHERE redis_key = 'h1';
hset_keys_for_h1_after_del
0
#
# 3. HDEL of last field drops the hset_keys row in the same
#    trans (1.10c.8/D). Read paths see "missing" because the
#    row is gone, not because of any field_count masking.
#
1
1
SELECT COUNT(*) AS h2_rows
FROM redis_0.hset_keys WHERE redis_key = 'h2';
h2_rows
0



