--source include/not_parallel.inc
--source include/have_ndb.inc
--source suite/rondis/include/rondis_setup.inc

#
# Phase 1.10c.1 - namespace unification.
#
# This test originally pinned Rondis's namespace-split design, where
# the same key name could simultaneously live as a string value and
# as a hash. As of Phase 1.10c.1 strings and hashes share the
# hset_keys row as the unique-name registry; cross-type writes are
# rejected with Redis-canonical WRONGTYPE.
#
# Phase 1.10c.6 will replace WRONGTYPE with silent type replacement
# (real Redis: SET on a hash drops the hash; HSET on a string drops
# the string). Until then this test pins the WRONGTYPE
# intermediate behavior.
#

--echo #
--echo # SET claims the name as a string. The hset_keys row carries
--echo # redis_key_id = 0 alongside the string_keys row.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET shared "string-value"
SELECT redis_key_id FROM redis_0.hset_keys WHERE redis_key = 'shared';

--echo #
--echo # HSET against the same name -> WRONGTYPE (refuses to corrupt
--echo # the existing string row by overwriting redis_key_id).
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET shared field1 "hash-field-value"

--echo #
--echo # The string is intact: GET still works, hset_keys still
--echo # carries redis_key_id = 0.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT GET shared
SELECT redis_key_id FROM redis_0.hset_keys WHERE redis_key = 'shared';

--echo #
--echo # Mirror case: HSET first claims the name as a hash, then
--echo # SET against the same name -> WRONGTYPE.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET shared_h field1 "hash-field-value"
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET shared_h "string-value"

--echo #
--echo # The hash is intact: HGET still works, hset_keys row keeps
--echo # its non-zero redis_key_id.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HGET shared_h field1
SELECT redis_key_id > 0 FROM redis_0.hset_keys WHERE redis_key = 'shared_h';

--disable_query_log
DROP DATABASE IF EXISTS redis_0;
--enable_query_log
