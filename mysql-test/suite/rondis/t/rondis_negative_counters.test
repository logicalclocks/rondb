--source include/have_ndb.inc
--source suite/rondis/include/rondis_setup.inc

#
# Negative-path coverage for INCR / INCRBY / DECR / DECRBY and their
# hash counterparts.
#
# Expected canonical reply on all parse / overflow errors:
#   (error) ERR value is not an integer or out of range
#

--echo #
--echo # Non-numeric stored value - INCR / DECR.
--echo # Fixed by C5a: NDB error 853 from the interpreted-code
--echo # str_to_int64 instruction is now mapped to the canonical reply.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET nonnum "abc"
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT INCR nonnum 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DECR nonnum 2>&1

--echo #
--echo # Non-numeric increment argument - INCRBY / DECRBY.
--echo # Fixed by Phase 0 / C1: FAILED_INCRBY_DECRBY_PARAMETER now
--echo # emits the canonical string.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET num 10
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT INCRBY num abc 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DECRBY num 3.14 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT INCRBY num 9999999999999999999999 2>&1

--echo #
--echo # INT64 boundaries: INCR at MAX-1 succeeds, next INCR overflows.
--echo # NDB error 854 (ZCALC_OVERFLOW_ERROR from the ADD_REG_REG /
--echo # SUB_REG_REG interpreter opcodes) is mapped to the canonical
--echo # Redis overflow reply by the C5b fix.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET bignum 9223372036854775806
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT INCR bignum
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT INCR bignum 2>&1

--echo #
--echo # INT64 underflow - DECR at MIN+1 succeeds, next DECR underflows.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET smallnum -9223372036854775807
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DECR smallnum
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DECR smallnum 2>&1

--echo #
--echo # String counters on a hash key return WRONGTYPE and leave the
--echo # hash intact. SET is the only string write that silently
--echo # replaces hashes.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET counter_hash f 1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT INCR counter_hash 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT INCRBY counter_hash 5 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DECR counter_hash 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DECRBY counter_hash 5 2>&1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HGET counter_hash f

--echo #
--echo # HINCRBY / HDECRBY non-numeric delta.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET h f 10
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HINCRBY h f abc 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDECRBY h f 3.14 2>&1

--echo #
--echo # HINCR on a non-numeric hash field - parallels C5a on strings.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET h g "abc"
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HINCR h g 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDECR h g 2>&1

--echo #
--echo # Cleanup.
--echo #
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DEL nonnum num bignum smallnum 2>&1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDEL h f g
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDEL counter_hash f

--disable_query_log
DROP DATABASE IF EXISTS redis_0;
--enable_query_log
