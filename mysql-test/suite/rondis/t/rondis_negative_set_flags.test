--source include/not_parallel.inc
--source include/have_ndb.inc
--source suite/rondis/include/rondis_setup.inc

#
# Negative-path coverage for SET flag combinations: conflicting flags,
# bad integer arguments, and suspicious TTL values.
#
# Expected canonical Redis replies:
#   (error) ERR syntax error
#   (error) ERR value is not an integer or out of range
#
# Some current Rondis behaviors that diverge from Redis are captured
# as-is and flagged in-line:
#   - EX -1 is accepted by Rondis and conflates with the "never expires"
#     sentinel inside generate_expire_at; Redis would reject it.
#   - EX 0 is accepted by Rondis (expires now); Redis rejects.
#

--echo #
--echo # Conflicting flags: NX + XX can never both hold. Syntax error.
--echo #
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k v NX XX 2>&1

--echo #
--echo # KEEPTTL combined with EX (or any explicit TTL) is mutually
--echo # exclusive. Syntax error.
--echo #
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k v KEEPTTL EX 10 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k v EX 10 KEEPTTL 2>&1

--echo #
--echo # Non-integer TTL argument - canonical integer error.
--echo #
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k v EX abc 2>&1
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k v PX 1.5 2>&1

--echo #
--echo # Unknown trailing flag - syntax error.
--echo #
--error 0,1
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k v BOGUS 2>&1

--echo #
--echo # Negative EX - Redis emits 'ERR invalid expire time in set'.
--echo # Rondis currently accepts EX -1 and conflates with the "never
--echo # expires" sentinel (generate_expire_at at commands.cc:280
--echo # treats ttl == -1 as "never expires"), so the key ends up with
--echo # expiry_date = g_max_expire_at (2038-01-19). This is divergent
--echo # and should be tightened; see plan entry C12.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k_neg "value" EX -1
SELECT UNIX_TIMESTAMP(expiry_date) = 2147483647 AS clamped_to_2038
  FROM redis_0.string_keys WHERE redis_key = 'k_neg';

--echo #
--echo # Zero EX - Redis emits the same invalid-expire error. Rondis
--echo # accepts it and stamps expiry at the current time (expired
--echo # immediately). Another C12-bucket divergence.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k_zero "value" EX 0

--echo #
--echo # Cleanup.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DEL k_neg k_zero

--disable_query_log
DROP DATABASE IF EXISTS redis_0;
--enable_query_log
