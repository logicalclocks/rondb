--source include/not_parallel.inc
--source include/have_ndb.inc

#
# Drive the legacy shell-based Rondis hash stress harness
# (storage/ndb/src/rondis/tests/hget_hset.sh) from MTR.
#
# See rondis_stress_strings.test for the rationale behind exec-only
# gating and the redis-cli dependency.
#

--source suite/rondis/include/create_rondis_tables.inc

--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT PING > /dev/null

--let $script = $MYSQL_TEST_DIR/../storage/ndb/src/rondis/tests/hget_hset.sh
--let $log    = $MYSQLTEST_VARDIR/tmp/rondis_stress_hashes.log

--echo # Running hget_hset.sh (per-op PASS/FAIL diverted to var/tmp/ on failure)
--exec bash $script > $log 2>&1
--echo # hget_hset.sh completed successfully

# Drop the log on success; check-testcase fails on leftover files in var/tmp.
--remove_file $log

--disable_query_log
DROP DATABASE IF EXISTS redis_0;
--enable_query_log
