--source include/not_parallel.inc
--source include/have_ndb.inc
--source suite/rondis/include/rondis_setup.inc

#
# Phase 1.10c.2 - DEL drops the matching hset_keys row alongside
# the string_keys row.
#
# Phase 1.10c.1 made SET / MSET dual-write to (string_keys,
# hset_keys); without 1.10c.2 every DEL'd string would leak its
# hset_keys row. This test pins the cleanup: SET then DEL leaves
# zero rows in either table.
#
# Hash-name DEL handling (drop hset_keys row + orphan field rows)
# is a separate sub-phase (1.10c.2b) and is NOT covered here.
#

--echo #
--echo # SET k1; both rows present.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SET k1 "v1"
SELECT redis_key FROM redis_0.string_keys WHERE redis_key = 'k1';
SELECT redis_key, redis_key_id IS NULL AS id_null
  FROM redis_0.hset_keys WHERE redis_key = 'k1';

--echo #
--echo # DEL k1 returns :1 (one key removed) and both rows are gone.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DEL k1
SELECT COUNT(*) AS string_keys_left
  FROM redis_0.string_keys WHERE redis_key = 'k1';
SELECT COUNT(*) AS hset_keys_left
  FROM redis_0.hset_keys WHERE redis_key = 'k1';

--echo #
--echo # DEL on a missing key returns :0 and creates no rows.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DEL nope
SELECT COUNT(*) AS hset_keys_for_nope
  FROM redis_0.hset_keys WHERE redis_key = 'nope';

--echo #
--echo # Multi-key DEL: MSET then DEL of all - reply :3, both tables
--echo # empty afterwards.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT MSET a "1" b "2" c "3"
SELECT COUNT(*) AS hset_keys_after_mset
  FROM redis_0.hset_keys WHERE redis_key IN ('a','b','c');
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DEL a b c
SELECT COUNT(*) AS string_keys_after_del
  FROM redis_0.string_keys WHERE redis_key IN ('a','b','c');
SELECT COUNT(*) AS hset_keys_after_del
  FROM redis_0.hset_keys WHERE redis_key IN ('a','b','c');

--echo #
--echo # DEL on a hash key (Phase 1.10c.2b - hset_keys row stays
--echo # for now). Reply :0 because no string_keys row was touched.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET h1 f v
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT DEL h1
SELECT COUNT(*) AS hset_keys_for_h1
  FROM redis_0.hset_keys WHERE redis_key = 'h1';

--disable_query_log
DROP DATABASE IF EXISTS redis_0;
--enable_query_log
