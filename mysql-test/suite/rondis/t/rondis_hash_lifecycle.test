--source include/have_ndb.inc
--source suite/rondis/include/rondis_setup.inc

#
# Lifecycle test for the single-trans HSET / HDEL pipeline.
# Asserts that hset_keys.field_count is maintained correctly across:
#   - HSET on a new hash             (delta = N, Phase 3 sets count = N)
#   - Pure overwrite                 (delta = 0, Phase 3 skips update)
#   - Mixed new + overwrite          (delta = #new only)
#   - Single field > INLINE_VALUE_LEN (Phase 2 ext-row branch)
#   - HSET > MAX_PARALLEL_KEY_OPS    (Phase 2/3 chunk loop)
#   - HDEL one of N fields           (delta = -1, row stays)
#   - HDEL the rest down to 0        (row dropped on the same trans;
#                                     1.10c.8/D retired the persistent
#                                     empty-row contract once the
#                                     local cache went away)
#   - HDEL on a hash that never existed (no hset_keys row created)
#   - HSET re-creates the hash with a fresh redis_key_id
#   - HDEL of an ext-row field       (row dropped + string_values rows
#                                     cleaned up)
#
# The cases that need shell substitution to build a large value or a
# long argv go through hash_lifecycle.sh.
#

--echo #
--echo # Step 1: HSET 3 NEW fields on a fresh hash.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET life:1 a A b B c C
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:1';
SELECT redis_key, value_start FROM redis_0.string_keys
 WHERE redis_key_id = (SELECT redis_key_id FROM redis_0.hset_keys
                        WHERE redis_key = 'life:1')
 ORDER BY redis_key;
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HGET life:1 a

--echo #
--echo # Step 2: HSET overwriting all 3 fields. delta=0; field_count
--echo # stays at 3.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET life:1 a A2 b B2 c C2
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:1';

--echo #
--echo # Step 3: HSET mixing existing (a, b) with new (d, e). field_count
--echo # 3 -> 5.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET life:1 a A3 b B3 d D e E
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:1';

--let $script = $MYSQL_TEST_DIR/../storage/ndb/src/rondis/tests/hash_lifecycle.sh

--echo #
--echo # Step 4: HSET single field with value > INLINE_VALUE_LEN (4096).
--echo # field_count = 1 and the row carries num_rows >= 1 ext rows.
--echo #
--exec bash $script large_value life:big f 5000
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:big';
SELECT redis_key, num_rows, tot_value_len FROM redis_0.string_keys
 WHERE redis_key_id = (SELECT redis_key_id FROM redis_0.hset_keys
                        WHERE redis_key = 'life:big');

--echo #
--echo # Step 5: HSET 300 fields (> MAX_PARALLEL_KEY_OPS = 256). Phase 2
--echo # and Phase 3 each iterate the chunk loop. field_count = 300.
--echo #
--exec bash $script many_fields life:many 300
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:many';
SELECT COUNT(*) FROM redis_0.string_keys
 WHERE redis_key_id = (SELECT redis_key_id FROM redis_0.hset_keys
                        WHERE redis_key = 'life:many');

--echo #
--echo # Step 6: re-HSET the same 300 fields, all overwrites. field_count
--echo # stays at 300.
--echo #
--exec bash $script many_fields life:many 300
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:many';

--echo #
--echo # Step 7: HSET life:hd with 3 fields, then HDEL one. Reply :1,
--echo # field_count 3 -> 2, hset_keys row still present.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET life:hd a A b B c C
--let $life_hd_id_before = `SELECT redis_key_id FROM redis_0.hset_keys WHERE redis_key = 'life:hd'`
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDEL life:hd a
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:hd';
SELECT redis_key FROM redis_0.string_keys
 WHERE redis_key_id = (SELECT redis_key_id FROM redis_0.hset_keys
                        WHERE redis_key = 'life:hd')
 ORDER BY redis_key;

--echo #
--echo # Step 8: HDEL of two fields, one missing. Reply :1 (only 'b' was
--echo # present); field_count 2 -> 1.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDEL life:hd b nope
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:hd';

--echo #
--echo # Step 9: HDEL the last remaining field. The hset_keys row is
--echo # dropped in the same trans (1.10c.8/D); no rows remain in
--echo # either table.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDEL life:hd c
SELECT COUNT(*) AS hset_keys_rows FROM redis_0.hset_keys
 WHERE redis_key = 'life:hd';

--echo #
--echo # Step 10: HDEL on a hash that never existed. Reply :0 and no
--echo # hset_keys row is created (Phase 1 reads, doesn't insert).
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDEL life:nope x y z
SELECT COUNT(*) FROM redis_0.hset_keys
 WHERE redis_key = 'life:nope';

--echo #
--echo # Step 11: HSET on the now-missing life:hd. A fresh hset_keys
--echo # row is INSERTed via Phase 1's lock-claim INSERT branch with
--echo # a new redis_key_id; field_count = 2.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HSET life:hd x X y Y
--let $life_hd_id_after = `SELECT redis_key_id FROM redis_0.hset_keys WHERE redis_key = 'life:hd'`
--let $assert_text = redis_key_id is fresh after row-drop and re-create
--let $assert_cond = $life_hd_id_before <> $life_hd_id_after
--source include/assert.inc
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:hd';

--echo #
--echo # Step 12: HDEL of an ext-row field (>INLINE_VALUE_LEN). Capture
--echo # the rondb_key BEFORE the HDEL (the hset_keys + string_keys
--echo # rows go away on the HDEL), then verify the string_values
--echo # ordinals were cleaned up alongside.
--echo #
--exec bash $script large_value life:big2 f 5000
SELECT redis_key, field_count FROM redis_0.hset_keys
 WHERE redis_key = 'life:big2';
--disable_query_log
SET @life_big2_rk = (
  SELECT rondb_key FROM redis_0.string_keys
   WHERE redis_key = 'f' AND redis_key_id =
     (SELECT redis_key_id FROM redis_0.hset_keys
       WHERE redis_key = 'life:big2'));
--enable_query_log
SELECT COUNT(*) AS pre_hdel_ext_rows FROM redis_0.string_values
 WHERE rondb_key = @life_big2_rk;
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT HDEL life:big2 f
SELECT COUNT(*) AS hset_keys_rows FROM redis_0.hset_keys
 WHERE redis_key = 'life:big2';
SELECT COUNT(*) AS string_values_rows FROM redis_0.string_values
 WHERE rondb_key = @life_big2_rk;

--disable_query_log
DROP DATABASE IF EXISTS redis_0;
--enable_query_log
