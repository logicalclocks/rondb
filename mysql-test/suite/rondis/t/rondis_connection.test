--source include/not_parallel.inc
--source include/have_ndb.inc
--source suite/rondis/include/rondis_setup.inc

#
# Positive-path coverage for Rondis connection / admin commands.
#
# Driven via redis-cli so the output matches canonical Redis rendering
# (bulk strings unquoted in non-TTY mode, arrays as "N) <value>").
#
# Commands covered: PING, ECHO, CONFIG GET, SELECT
#

--echo #
--echo # PING - baseline
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT PING

--echo #
--echo # ECHO - short arg, with spaces, empty string, digit-like arg
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT ECHO hello
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT ECHO "with spaces"
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT ECHO ""
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT ECHO 12345

--echo #
--echo # CONFIG GET - Rondis returns the parameter name paired with an
--echo # empty array (divergent from real Redis, which returns
--echo # name/value pairs). Any parameter name is accepted.
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT CONFIG GET maxmemory
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT CONFIG GET save
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT CONFIG GET does-not-exist

--echo #
--echo # SELECT - valid database (Rondis exposes at least db 0)
--echo #
--exec redis-cli -h $RONDIS_HOST -p $RONDIS_PORT SELECT 0

--disable_query_log
DROP DATABASE IF EXISTS redis_0;
--enable_query_log
