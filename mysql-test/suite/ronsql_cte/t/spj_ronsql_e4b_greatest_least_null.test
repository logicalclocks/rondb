# spj_ronsql_e4b_greatest_least_null
#
# The GREATEST / LEAST sibling of E-4 (spj_ronsql_e4_case_null): an
# aggregate over GREATEST / LEAST over a LEFT JOIN.  In SQL, GREATEST and
# LEAST are NULL when any argument is NULL, so on a NULL-extended row
# GREATEST(o.col, c.col) is NULL whatever the order of the arguments.
#
# RonSQL lowers GREATEST(x, y) to an aggregation program that loads x
# into register d and y into register s, then an embedded program
# (READ_AGG_REG_TO_REG d and s, BRANCH_REG_EQ_NULL guards when an operand
# can be NULL, a register compare) and a conditional Mov(d, s), with a
# SetRegNull(d) arm for a NULL operand.  On a NULL-extended row the
# kernel evaluates the embedded program with
# JoinAggInterpreter::evalEmbeddedForNullRow.  Two causes, fixed in two
# places:
#
# 1. The kernel: evalEmbeddedForNullRow returned
#    EMB_NULL_ROW_UNSUPPORTED for READ_AGG_REG_TO_REG, and ProcessRec
#    then skipped the embedded program and ran Mov(d, s), so the result
#    was always the right argument: GREATEST(o.amt, c.fl) gave c.fl
#    where SQL gives NULL, and GREATEST(c.fl, o.amt) gave NULL only by
#    accident.  Fix: evalEmbeddedForNullRow reads the aggregation
#    registers as Dbtup's handleReadAggRegToReg does.
# 2. RonSQL: the NULL guards were emitted only for a nullable column.
#    A NOT NULL column of the LEFT-joined table is NULL in a
#    NULL-extended row too, and without the guard the register compare
#    with a NULL operand is not taken, so Mov(d, s) runs as before.  Fix:
#    compute_pair_op_needs_null_check counts every column of an
#    outer-joined table as nullable.
#
# Data: glo_c rows (id, fl, oref): (1,10,1) (2,20,3) (3,30,99)
# (4,40,NULL) (5,50,4).  glo_o rows (id, cid, amt, amt_nn): (1,1,5,5)
# (2,1,15,15) (3,2,NULL,25) (4,4,45,35).  On o.cid = c.id, customers 3
# and 5 have no order (DBSPJ sends the NULL rows of the scan leaf), and
# customer 2's order has amt NULL (a real row, evaluated by DBTUP).  On
# o.id = c.oref, oref 99 misses (DBLQH sends the NULL row) and oref NULL
# is a NULL key (DBSPJ sends the NULL row).
#
#   gl-1  nullable o.amt, both argument orders, grouped.
#         Expected (MySQL): (id, g_oc, g_co, l_oc, l_co, n) =
#         (1,25,25,2,2,2) (2,NULL,NULL,0,0,1) (3,NULL,NULL,0,0,1)
#         (4,45,45,1,1,1) (5,NULL,NULL,0,0,1).
#         Expected before the kernel fix: (3,30,NULL,1,0,1) and
#         (5,50,NULL,1,0,1).
#   gl-2  NOT NULL o.amt_nn, both argument orders, grouped.
#         Expected (MySQL): (1,25,25,2,2,2) (2,25,25,1,1,1)
#         (3,NULL,NULL,0,0,1) (4,40,40,1,1,1) (5,NULL,NULL,0,0,1).
#         Expected before the RonSQL fix (with or without the kernel
#         fix): (3,30,NULL,1,0,1) and (5,50,NULL,1,0,1).
#   gl-3  a constant operand, n-ary forms, MIN and MAX.
#         Expected (MySQL): (id, gk, lmax, gmin, n) = (1,60,10,10,2)
#         (2,30,NULL,25,1) (3,NULL,NULL,NULL,1) (4,35,40,40,1)
#         (5,NULL,NULL,NULL,1).
#         Expected before the fixes: (3,30,100,0,1) and (5,30,100,0,1).
#   gl-4  gl-1 and gl-2 without GROUP BY.
#         Expected (MySQL): (g_oc, gn_oc, ln_oc, n) = (70, 90, 4, 6).
#         Expected before the fixes: (150, 170, 6, 6).
#   gl-5  PK_LOOKUP leaf: a missed key and a NULL key.
#         Expected (MySQL): (id, gn, g, ln, n) = (1,10,10,1,1)
#         (2,25,NULL,1,1) (3,NULL,NULL,0,1) (4,NULL,NULL,0,1)
#         (5,50,50,1,1).
#         Expected before the fixes: (3,30,30,1,1) and (4,40,40,1,1).
#   gl-6  no DBSPJ request left behind.
# A CTE body cannot hold the pair-op yet: a CTE output must be an
# aggregate of a column ("CTE aggregate over complex expression not yet
# supported"), so only the main query's join plan reaches
# compute_pair_op_needs_null_check.
# The test stops at the first difference, so it fails at gl-1 until the
# kernel fix and at gl-2 until the RonSQL fix.
#
# A failing grep at gl-0 means RonSQL chose another plan: adjust the test.
#
# Run:    ./mtr --suite=ronsql_cte spj_ronsql_e4b_greatest_least_null
# Record: ./mtr --suite=ronsql_cte --record spj_ronsql_e4b_greatest_least_null

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/spj-ronsql-e4b-explain.out

--disable_query_log
--disable_warnings

CREATE TABLE glo_c (
  id   INT NOT NULL,
  fl   INT NOT NULL,
  oref INT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

CREATE TABLE glo_o (
  id     INT NOT NULL,
  cid    INT NOT NULL,
  amt    INT NULL,
  amt_nn INT NOT NULL,
  PRIMARY KEY USING HASH (id),
  INDEX ix_glo_o_cid (cid)
) ENGINE=NDB;

INSERT INTO glo_c VALUES
  (1, 10, 1), (2, 20, 3), (3, 30, 99), (4, 40, NULL), (5, 50, 4);
INSERT INTO glo_o VALUES
  (1, 1, 5, 5), (2, 1, 15, 15), (3, 2, NULL, 25), (4, 4, 45, 35);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === gl-0: the plans: LEFT JOIN INDEX_SCAN and PK_LOOKUP aggregate leaves ===
let $QUERY=
SELECT c.id,
       SUM(GREATEST(o.amt, c.fl)) AS g_oc,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id
GROUP BY c.id;|
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF '[LEFT JOIN] INDEX_SCAN glo_o AS o  <- c' $EXPLAIN_FILE
--remove_file $EXPLAIN_FILE
let $QUERY=
SELECT c.id,
       SUM(GREATEST(o.amt, c.fl)) AS g_oc,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.id = c.oref
GROUP BY c.id;|
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF '[LEFT JOIN] PK_LOOKUP glo_o AS o  <- c' $EXPLAIN_FILE
--remove_file $EXPLAIN_FILE

--echo
--echo === gl-1: nullable inner column, both argument orders, grouped ===
let $QUERY=
SELECT c.id,
       SUM(GREATEST(o.amt, c.fl)) AS g_oc,
       SUM(GREATEST(c.fl, o.amt)) AS g_co,
       COUNT(LEAST(o.amt, c.fl)) AS l_oc,
       COUNT(LEAST(c.fl, o.amt)) AS l_co,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id
GROUP BY c.id;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT c.id,
       SUM(GREATEST(o.amt, c.fl)) AS g_oc,
       SUM(GREATEST(c.fl, o.amt)) AS g_co,
       COUNT(LEAST(o.amt, c.fl)) AS l_oc,
       COUNT(LEAST(c.fl, o.amt)) AS l_co,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id
GROUP BY c.id|

--echo
--echo === gl-2: NOT NULL inner column, both argument orders, grouped ===
let $QUERY=
SELECT c.id,
       SUM(GREATEST(o.amt_nn, c.fl)) AS g_oc,
       SUM(GREATEST(c.fl, o.amt_nn)) AS g_co,
       COUNT(LEAST(o.amt_nn, c.fl)) AS l_oc,
       COUNT(LEAST(c.fl, o.amt_nn)) AS l_co,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id
GROUP BY c.id;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT c.id,
       SUM(GREATEST(o.amt_nn, c.fl)) AS g_oc,
       SUM(GREATEST(c.fl, o.amt_nn)) AS g_co,
       COUNT(LEAST(o.amt_nn, c.fl)) AS l_oc,
       COUNT(LEAST(c.fl, o.amt_nn)) AS l_co,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id
GROUP BY c.id|

--echo
--echo === gl-3: constant operand, n-ary forms, MIN and MAX ===
let $QUERY=
SELECT c.id,
       SUM(GREATEST(o.amt_nn, 30)) AS gk,
       MAX(LEAST(o.amt, c.fl, 100)) AS lmax,
       MIN(GREATEST(o.amt_nn, c.fl, 0)) AS gmin,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id
GROUP BY c.id;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT c.id,
       SUM(GREATEST(o.amt_nn, 30)) AS gk,
       MAX(LEAST(o.amt, c.fl, 100)) AS lmax,
       MIN(GREATEST(o.amt_nn, c.fl, 0)) AS gmin,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id
GROUP BY c.id|

--echo
--echo === gl-4: nullable and NOT NULL inner columns without GROUP BY ===
let $QUERY=
SELECT SUM(GREATEST(o.amt, c.fl)) AS g_oc,
       SUM(GREATEST(o.amt_nn, c.fl)) AS gn_oc,
       COUNT(LEAST(o.amt_nn, c.fl)) AS ln_oc,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
SELECT SUM(GREATEST(o.amt, c.fl)) AS g_oc,
       SUM(GREATEST(o.amt_nn, c.fl)) AS gn_oc,
       COUNT(LEAST(o.amt_nn, c.fl)) AS ln_oc,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id|

--echo
--echo === gl-5: PK_LOOKUP leaf, a missed key and a NULL key ===
let $QUERY=
SELECT c.id,
       SUM(GREATEST(o.amt_nn, c.fl)) AS gn,
       SUM(GREATEST(o.amt, c.fl)) AS g,
       COUNT(LEAST(o.amt_nn, c.fl)) AS ln,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.id = c.oref
GROUP BY c.id;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT c.id,
       SUM(GREATEST(o.amt_nn, c.fl)) AS gn,
       SUM(GREATEST(o.amt, c.fl)) AS g,
       COUNT(LEAST(o.amt_nn, c.fl)) AS ln,
       COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.id = c.oref
GROUP BY c.id|

DELIMITER ;|

--echo
--echo === gl-6: no DBSPJ request left behind ===
--exec $NDB_MGM -e "ALL DUMP 2650" > /dev/null

--disable_query_log
DROP TABLE glo_o;
DROP TABLE glo_c;
--enable_query_log
