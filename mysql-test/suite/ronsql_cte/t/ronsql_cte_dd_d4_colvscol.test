# D4/D12 regression — signed-int column-vs-column WHERE in a CTE body is now
# SUPPORTED (F-colvscol tier (a), cte_body_colvscol_plan.md) and this test
# pins the two original repro shapes as value compares vs MySQL.
#
# Findings D4 + D12 (cte_test_driven_findings.md) / fix-plan H3 history.  A
# col-vs-col predicate in a CTE-body WHERE used to misbehave two ways
# depending on whether the left column is indexed:
#   D4a/D12 (orders, o_custkey < o_orderkey): o_custkey is indexed, so the
#       conjunct was mis-classified as an index bound and encode_constant()
#       failed on the column RHS, thrown as the RETRYABLE RonSQLMaybeStaleSchema
#       -> RDRS retried it 10x before giving up (hang-like).  Fixed by the
#       join-root non-constant-RHS bound hardening; the conjunct now routes
#       to the residual filter (TABLE_SCAN body).
#   D4b/D4 (lineitem, l_quantity < l_partkey): the TABLE_SCAN body's
#       NdbScanFilter attr-vs-attr program was recorded as HANGING the data
#       node in June 2026 — re-verified September 2026 as a stale-binary
#       artifact (W0 probe green on current binaries; D19/D20 precedent).
# Both compare two SIGNED INT columns.  The gate is
# RonSQLPreparer::check_cte_body_col_vs_col: identical-type stored-column
# pairs on the body root op (NdbDictionary::Column::isBindable) are accepted
# and emit BRANCH_ATTR_OP_ATTR via apply_filter_cmp; mixed-type and
# non-root-op pairs stay rejected (body_filter.inc Group 8 probes).

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings
--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--source suite/ronsql_cte/include/cte_schema.inc
--source suite/ronsql_cte/include/cte_data.inc

DELIMITER |;

--echo
--echo === D4a/D12: CTE-body col-vs-col on orders (o_custkey < o_orderkey, indexed left) ===
let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, COUNT(*) AS n, SUM(o_shippriority) AS t
  FROM orders WHERE o_custkey < o_orderkey GROUP BY o_custkey)
SELECT sums.k, SUM(sums.n), SUM(sums.t)
FROM customer AS c JOIN sums ON sums.k = c.c_custkey GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, COUNT(*) AS n, SUM(o_shippriority) AS t
  FROM orders WHERE o_custkey < o_orderkey GROUP BY o_custkey)
SELECT sums.k, SUM(sums.n), SUM(sums.t)
FROM customer AS c JOIN sums ON sums.k = c.c_custkey GROUP BY sums.k|

--echo
--echo === D4b/D4: CTE-body col-vs-col on lineitem (l_quantity < l_partkey, non-indexed left) ===
let $QUERY=
WITH liq AS (
  SELECT l_orderkey AS k, COUNT(*) AS n, SUM(l_quantity) AS q
  FROM lineitem WHERE l_quantity < l_partkey GROUP BY l_orderkey)
SELECT o.o_custkey, SUM(liq.n), SUM(liq.q)
FROM orders AS o JOIN liq ON liq.k = o.o_orderkey GROUP BY o.o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH liq AS (
  SELECT l_orderkey AS k, COUNT(*) AS n, SUM(l_quantity) AS q
  FROM lineitem WHERE l_quantity < l_partkey GROUP BY l_orderkey)
SELECT o.o_custkey, SUM(liq.n), SUM(liq.q)
FROM orders AS o JOIN liq ON liq.k = o.o_orderkey GROUP BY o.o_custkey|

DELIMITER ;|

--source suite/ronsql_cte/include/cte_drop.inc
