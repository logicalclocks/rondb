# spj_state_s6_cte_body_null_row
#
# Finding S-6 (storage/ndb/claude_files/dbspj/dbspj_state_machine.html,
# section 10): when a CTE body LEFT JOINs another CTE and carries its
# aggregation on that CTE_LOOKUP leaf, a probe miss (execCTE_LOOKUP_REF,
# GROUP_NOT_FOUND) or a NULL join key (cte_lookup_send, keyIsNull)
# injects the NULL-extended parent row through sendJoinAggNullRow().
# The row must go to the enclosing CTE's aggregator (cte1 below), as
# cte_outer_join_phase_5.md intended.  The other coverage
# (ronsql_cte_outer_join Test 5, testCteNdbApiOuterJoin Test 5) only has
# the LEFT JOIN in the MAIN query, where the main aggregator is the
# right target.
#
# Before the fixes (2026-10-29) the test found two bugs:
#   S-6:  sendJoinAggNullRow() always addressed the MAIN aggregation
#         (main aggStateKey, identity word with cteId RNIL,
#         ndbrequire(m_aggNodes.get(ownNodeId))).  s6-1 returned
#         COUNT(*) 5, SUM(cnt) 3: the three NULL-extended rows went to
#         the main aggregation.  Fixed: a node with m_cteId != RNIL
#         sends to its CTE's aggregation.
#   S-6b: validateAggregateFlags() set T_BUFFER_ROW | T_BUFFER_MAP on
#         the parent of an outer-joined CTE_LOOKUP aggregate leaf only
#         under RT_AGGREGATE, which only main-query aggregation sets.
#         s6-2 stopped both data nodes at
#         ndbassert(parentPtr.p->m_bits & T_BUFFER_ROW) in
#         execCTE_LOOKUP_REF.  Fixed: that buffering is set for every
#         request.
#
# Data: cte0 = {(1,30), (2,70), (3,50)}.  s6_rhs rows (id, g, ref):
# (1,1,1) (2,1,3) (3,1,5) (4,2,2) (5,2,NULL) (6,2,7): refs 5 and 7 miss,
# ref NULL is a NULL key.
#   cte1 = SELECT r.g, COUNT(*), SUM(cte0.total) FROM s6_rhs r
#          LEFT JOIN cte0 ON cte0.k = r.ref GROUP BY r.g
#        = {(1, 3, 80), (2, 3, 70)}
#
# s6-1 (aggregating main, so the main state exists):
#   Expected (MySQL): COUNT(*) = 2, SUM(cnt) = 6, SUM(s) = 150.
# s6-2 (projection-only main over cte1, no main aggregation, so
# Request::m_aggNodes is empty and RT_AGGREGATE is not set):
#   Expected (MySQL): (1, 3, 80) and (2, 3, 70).
#   It runs last because a regression stops a data node.
#
# Run:    ./mtr --suite=ronsql_cte spj_state_s6_cte_body_null_row
# Record: ./mtr --suite=ronsql_cte --record spj_state_s6_cte_body_null_row

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/spj-state-s6-explain.out

--disable_query_log
--disable_warnings

CREATE TABLE s6_src (
  id  INT NOT NULL,
  grp INT NOT NULL,
  val INT NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

CREATE TABLE s6_rhs (
  id  INT NOT NULL,
  g   INT NOT NULL,
  ref INT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

INSERT INTO s6_src VALUES
  (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40), (5, 3, 50);

INSERT INTO s6_rhs VALUES
  (1, 1, 1), (2, 1, 3), (3, 1, 5),
  (4, 2, 2), (5, 2, NULL), (6, 2, 7);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === s6-0: the CTE body really is s6_rhs LEFT JOIN CTE_LOOKUP(cte0) ===
let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM s6_src GROUP BY grp),
     cte1 AS (SELECT r.g AS g, COUNT(*) AS cnt, SUM(cte0.total) AS s
              FROM s6_rhs AS r
              LEFT JOIN cte0 ON cte0.k = r.ref
              GROUP BY r.g)
SELECT COUNT(*), SUM(cnt), SUM(s) FROM cte1;|
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF 'Body join plan (2 operations):' $EXPLAIN_FILE
--exec grep -qF '[LEFT JOIN] CTE_LOOKUP CTE:cte0' $EXPLAIN_FILE
--remove_file $EXPLAIN_FILE

--echo
--echo === s6-1: aggregating main over a CTE whose body LEFT JOINs a CTE ===
let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM s6_src GROUP BY grp),
     cte1 AS (SELECT r.g AS g, COUNT(*) AS cnt, SUM(cte0.total) AS s
              FROM s6_rhs AS r
              LEFT JOIN cte0 ON cte0.k = r.ref
              GROUP BY r.g)
SELECT COUNT(*), SUM(cnt), SUM(s) FROM cte1;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM s6_src GROUP BY grp),
     cte1 AS (SELECT r.g AS g, COUNT(*) AS cnt, SUM(cte0.total) AS s
              FROM s6_rhs AS r
              LEFT JOIN cte0 ON cte0.k = r.ref
              GROUP BY r.g)
SELECT COUNT(*), SUM(cnt), SUM(s) FROM cte1|

--echo
--echo === s6-2: projection-only main over the same CTE (no main aggregation) ===
let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM s6_src GROUP BY grp),
     cte1 AS (SELECT r.g AS g, COUNT(*) AS cnt, SUM(cte0.total) AS s
              FROM s6_rhs AS r
              LEFT JOIN cte0 ON cte0.k = r.ref
              GROUP BY r.g)
SELECT g, cnt, s FROM cte1;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM s6_src GROUP BY grp),
     cte1 AS (SELECT r.g AS g, COUNT(*) AS cnt, SUM(cte0.total) AS s
              FROM s6_rhs AS r
              LEFT JOIN cte0 ON cte0.k = r.ref
              GROUP BY r.g)
SELECT g, cnt, s FROM cte1|

DELIMITER ;|

--echo
--echo === s6-3: no DBSPJ request left behind ===
--exec $NDB_MGM -e "ALL DUMP 2650" > /dev/null

--disable_query_log
DROP TABLE s6_rhs;
DROP TABLE s6_src;
--enable_query_log
