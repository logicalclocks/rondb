# spj_ronsql_e4_case_null
#
# Finding E-4 (storage/ndb/claude_files/dbspj/dbspj_query_execution.html,
# section 8), reached from RonSQL: a CASE inside an aggregate over a LEFT
# JOIN.  On a NULL-extended row the right table's columns are NULL, and in
# SQL a comparison with NULL is UNKNOWN, so the CASE takes ELSE.  Two
# causes, fixed in two places:
#
# 1. RonSQL (RonSQLPreparer.cpp, the CASE condition code) emits every
#    comparison with Interpreter::NULL_CMP_EQUAL and no NULL guard.  In
#    that mode NULL equals NULL and is less than any value, so
#    "i.v < 15" and "i.v <> 10" hold for a NULL i.v and the CASE takes
#    THEN.  This holds for a real row whose i.v is NULL as well as for a
#    NULL-extended row (the kernel E-4 fix, evalEmbeddedForNullRow,
#    follows each instruction's NULL mode).  Fix: emit the SQL NULL mode.
# 2. The kernel (JoinAggInterpreter::ProcessRec): a CASE on a column of
#    an ancestor (READ_LINKED_TO_MEM) is EMB_NULL_ROW_UNSUPPORTED, so for
#    a NULL-extended row the condition is skipped and THEN is taken,
#    whatever the value of the parent column.  Fix (2026-11-02):
#    evalEmbeddedForNullRow reads and compares the parent columns of the
#    row's linked data as the DBTUP handlers do (BRANCH_MEM_OP_ARG with
#    the type from the parent table, READ_LINKED_COLUMN_TO_REG and the
#    typed register compares).
#
# Data: e4_o rows (id, g, x, ref, d): (1,1,3,1,1.5) (2,1,9,2,3.5)
# (3,1,2,99,4.5) (4,2,8,98,0.5) (5,2,1,NULL,3.0) (6,3,7,3,2.0).  e4_i
# rows (id, v): (1,10) (2,20) (3,NULL).  Refs 99 and 98 miss (DBLQH
# sends the NULL row), ref NULL is a NULL key (DBSPJ sends the NULL
# row), ref 3 matches a row whose v is NULL.
#
#   e4-1  Cause 1, grouped: CASEs on the leaf column i.v.
#         Expected (MySQL): (g, lv, nv, n) = (1,1,1,3) (2,0,0,2) (3,0,0,1).
#         Observed before a fix (2026-10-31): lv = nv = 2, 2, 1.
#   e4-2  Cause 1 without GROUP BY.  Expected (MySQL): (1, 1, 6).
#   e4-3  Cause 2: a CASE on the root column o.x, which is never NULL
#         (READ_LINKED_TO_MEM + BRANCH_MEM_OP_ARG).
#         Expected (MySQL): (g, hx, n) = (1,1,3) (2,1,2) (3,1,1).
#         Observed before a fix: hx = 2, 2, 1 (rows 3 and 5 counted).
#   e4-4  Cause 2 on the register path: the root DOUBLE o.d against a
#         constant (READ_LINKED_COLUMN_TO_REG, LOAD_DOUBLE_CONST and a
#         register compare).
#         Expected (MySQL): (g, hd, n) = (1,2,3) (2,0,2) (3,0,1).
#         Expected before the kernel fix: hd = 2 for g = 2.
#   e4-5  Cause 2 with two root columns, o.x > o.g (two
#         READ_LINKED_COLUMN_TO_REG and a register compare).
#         Expected (MySQL): (g, xg, n) = (1,3,3) (2,1,2) (3,1,1).
#         Expected before the kernel fix: xg = 2 for g = 2.
# The test stops at the first difference, so it fails at e4-1 until the
# RonSQL fix and at e4-3 until the kernel fix.
#
# A failing grep at e4-0 means RonSQL chose another plan: adjust the test.
#
# Run:    ./mtr --suite=ronsql_cte spj_ronsql_e4_case_null
# Record: ./mtr --suite=ronsql_cte --record spj_ronsql_e4_case_null

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/spj-ronsql-e4-explain.out

--disable_query_log
--disable_warnings

CREATE TABLE e4_o (
  id  INT NOT NULL,
  g   INT NOT NULL,
  x   INT NOT NULL,
  ref INT NULL,
  d   DOUBLE NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

CREATE TABLE e4_i (
  id INT NOT NULL,
  v  INT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

INSERT INTO e4_o VALUES
  (1, 1, 3, 1, 1.5), (2, 1, 9, 2, 3.5), (3, 1, 2, 99, 4.5),
  (4, 2, 8, 98, 0.5), (5, 2, 1, NULL, 3.0), (6, 3, 7, 3, 2.0);
INSERT INTO e4_i VALUES (1, 10), (2, 20), (3, NULL);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === e4-0: the plan is root scan -> LEFT JOIN PK_LOOKUP aggregate leaf ===
let $QUERY=
SELECT o.g,
       SUM(CASE WHEN i.v < 15 THEN 1 ELSE 0 END) AS lv,
       SUM(CASE WHEN i.v <> 10 THEN 1 ELSE 0 END) AS nv,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g;|
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF '[LEFT JOIN] PK_LOOKUP e4_i AS i  <- o' $EXPLAIN_FILE
--remove_file $EXPLAIN_FILE

--echo
--echo === e4-1: CASE on the leaf column, NULL rows and a NULL value, grouped ===
let $QUERY=
SELECT o.g,
       SUM(CASE WHEN i.v < 15 THEN 1 ELSE 0 END) AS lv,
       SUM(CASE WHEN i.v <> 10 THEN 1 ELSE 0 END) AS nv,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT o.g,
       SUM(CASE WHEN i.v < 15 THEN 1 ELSE 0 END) AS lv,
       SUM(CASE WHEN i.v <> 10 THEN 1 ELSE 0 END) AS nv,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g|

--echo
--echo === e4-2: the same CASEs without GROUP BY ===
let $QUERY=
SELECT SUM(CASE WHEN i.v < 15 THEN 1 ELSE 0 END) AS lv,
       SUM(CASE WHEN i.v <> 10 THEN 1 ELSE 0 END) AS nv,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
SELECT SUM(CASE WHEN i.v < 15 THEN 1 ELSE 0 END) AS lv,
       SUM(CASE WHEN i.v <> 10 THEN 1 ELSE 0 END) AS nv,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref|

--echo
--echo === e4-3: CASE on the root column over the NULL rows, grouped ===
let $QUERY=
SELECT o.g,
       SUM(CASE WHEN o.x > 5 THEN 1 ELSE 0 END) AS hx,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT o.g,
       SUM(CASE WHEN o.x > 5 THEN 1 ELSE 0 END) AS hx,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g|

--echo
--echo === e4-4: CASE on a root DOUBLE column, register path ===
let $QUERY=
SELECT o.g,
       SUM(CASE WHEN o.d > 3 THEN 1 ELSE 0 END) AS hd,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT o.g,
       SUM(CASE WHEN o.d > 3 THEN 1 ELSE 0 END) AS hd,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g|

--echo
--echo === e4-5: CASE comparing two root columns ===
let $QUERY=
SELECT o.g,
       SUM(CASE WHEN o.x > o.g THEN 1 ELSE 0 END) AS xg,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT o.g,
       SUM(CASE WHEN o.x > o.g THEN 1 ELSE 0 END) AS xg,
       COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g|

DELIMITER ;|

--echo
--echo === e4-6: no DBSPJ request left behind ===
--exec $NDB_MGM -e "ALL DUMP 2650" > /dev/null

--disable_query_log
DROP TABLE e4_o;
DROP TABLE e4_i;
--enable_query_log
