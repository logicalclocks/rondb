# cte_large_output_row
#
# CTE output rows larger than MAX_TRANSID_AI_SIZE.  DBLQH's
# emitCteGroupOutput sent each CTE row (the FLUSH_AI part to the API,
# directly or routed through DBTC, and the residual to DBSPJ) as one
# unfragmented signal, while its output buffer holds ZATTR_BUFFER_SIZE
# (32768) words, four times one transporter message: a larger row to
# another node would stop the data node ("Message too big in
# sendSignal").  Dblqh::sendCteTransIdAI now sends a row over
# MAX_TRANSID_AI_SIZE as a batched fragmented signal, as DBTUP does for
# table rows, and the G2b probe-result cache only captures a payload
# that fits one message (CTE_LOOKUP_CONF carries it and DBSPJ replays
# it unfragmented).
#
# One CTE body is one aggregator, and NdbAggregator::Finalize caps its
# group at 16 KB at the declared sizes, so with RonSQL a CTE row stays
# under one message: in release builds (MAX_TRANSID_AI_SIZE 7400 words)
# these rows go unfragmented.  In VM_TRACE builds MAX_TRANSID_AI_SIZE is
# 240 words, and every row here (about 2000 words) takes the fragmented
# path.
#
# Data: lr_src.s and lr_src.t are VARCHAR(4000) latin1 with values of
# about 3990 bytes; groups k = 1, 2, 3.  lr_drv probes k = 1 eight
# times, k = 2, 3 once and k = 4 (no group) once.
#
#   lr-1  CTE_SCAN root, pass-through: three rows of about 2000 words
#         to the API (emitCteGroupOutput's FLUSH_AI arm).
#   lr-2  pass-through join to a single-group CTE (k = 1): a
#         row-delivery CTE_LOOKUP leaf probed with the same key eight
#         times; the fill probe's payload is captured for the G2b
#         cache and later hits are served from DBSPJ.
#   lr-3  pass-through join to the grouped CTE: every probe goes to
#         DBLQH (cteLookupEmitResult).
# Each case is compared with MySQL; the result file holds line counts.
#
# Run:    ./mtr --suite=ronsql_cte cte_large_output_row
# Record: ./mtr --suite=ronsql_cte --record cte_large_output_row

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# Joins: compare the mysql client against RDRS only (the ronsql suite's
# CTE convention).
--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--disable_query_log
--disable_warnings

CREATE TABLE lr_src (
  id INT NOT NULL,
  k  INT NOT NULL,
  s  VARCHAR(4000) CHARACTER SET latin1 NOT NULL,
  t  VARCHAR(4000) CHARACTER SET latin1 NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

CREATE TABLE lr_drv (
  id INT NOT NULL,
  k  INT NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

INSERT INTO lr_src VALUES
  (1, 1, CONCAT(REPEAT('a', 3985), 'k1-s1'), CONCAT(REPEAT('m', 3985), 'k1-t1')),
  (2, 1, CONCAT(REPEAT('b', 3985), 'k1-s2'), CONCAT(REPEAT('n', 3985), 'k1-t2')),
  (3, 2, CONCAT(REPEAT('c', 3985), 'k2-s1'), CONCAT(REPEAT('o', 3985), 'k2-t1')),
  (4, 2, CONCAT(REPEAT('d', 3985), 'k2-s2'), CONCAT(REPEAT('p', 3985), 'k2-t2')),
  (5, 3, CONCAT(REPEAT('e', 3985), 'k3-s1'), CONCAT(REPEAT('q', 3985), 'k3-t1'));

INSERT INTO lr_drv VALUES
  (1, 1), (2, 1), (3, 1), (4, 1), (5, 1), (6, 1), (7, 1), (8, 1),
  (9, 2), (10, 3), (11, 4);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === lr-1: CTE_SCAN root, rows of about 2000 words ===
let $QUERY=
WITH c AS (SELECT k, MAX(s) AS ms, MIN(t) AS mt
           FROM lr_src GROUP BY k)
SELECT k, ms, mt FROM c;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === lr-2: join to a single-group CTE, repeated hits (G2b cache) ===
let $QUERY=
WITH c AS (SELECT k, MAX(s) AS ms, MIN(t) AS mt
           FROM lr_src WHERE k = 1 GROUP BY k)
SELECT d.id AS id, c.ms AS ms, c.mt AS mt
FROM lr_drv AS d JOIN c ON c.k = d.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === lr-3: join to the grouped CTE ===
let $QUERY=
WITH c AS (SELECT k, MAX(s) AS ms, MIN(t) AS mt
           FROM lr_src GROUP BY k)
SELECT d.id AS id, c.k AS k, c.ms AS ms, c.mt AS mt
FROM lr_drv AS d JOIN c ON c.k = d.k;|
--source suite/ronsql/include/ronsql_compare.inc

DELIMITER ;|

--disable_query_log
DROP TABLE lr_drv;
DROP TABLE lr_src;
--enable_query_log
