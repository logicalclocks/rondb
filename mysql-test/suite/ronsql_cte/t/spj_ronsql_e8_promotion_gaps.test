# spj_ronsql_e8_promotion_gaps
#
# Finding E-8 (storage/ndb/claude_files/dbspj/dbspj_query_execution.html,
# section 8), reached from RonSQL: an inner join below an outer join.
# SQL is left-associative, so "t LEFT JOIN c ... JOIN n ON n.nk = c.nk"
# means "(t LEFT c) INNER n", which with null-rejecting equality
# conditions is all INNER.  DBSPJ has no join nests: a tree with n as an
# INNER child of the LEFT JOIN c means "t LEFT (c INNER n)" and keeps the
# t rows without a c match.  RonSQL avoids this by promoting the LEFT
# JOINs above an INNER one to INNER (promote_left_joins, the Part B fix
# that body_nest_semantics ns-1..8 test).  Two gaps remain:
#
#   e8-1  WHERE promotion (promote_left_to_inner_for_where): a
#         null-rejecting WHERE on n turns only n into INNER, not the LEFT
#         JOIN c above it.
#         Expected (MySQL): cnt = 10.  Expected before a fix: 30,
#         observed 2026-10-31 (the test stops there, so e8-2 and e8-3
#         have not run yet).
#   e8-2  CTE bodies: promote_left_joins only walks the main query's
#         joins, build_cte_scopes never calls it.
#         Expected (MySQL): s = 10.  Expected before a fix: 30.
#         With the RonSQL fix (2026-11-01) the body is all INNER, and
#         the data nodes failed it with error 1869 (2026-11-02): the
#         intermediate lookup c had T_CTE_SCAN, so DBSPJ sent it with
#         JoinAggFlag and its row went through the aggregation program
#         of n instead of driving n (E-8b).  Kernel fix (2026-11-02): the
#         real-table nodes between the root and the aggregate leaf of a
#         CTE body are T_CTE_INDIRECT_FEED, which lookup_send now checks.
#         Expected after it: s = 10.
#   e8-3  control: the e8-2 chain in the main query, which is promoted.
#         Expected (MySQL): 10.
#
# Data (as nestp in body_nest_semantics): e8_t has 30 rows, p_id 1..10
# with ref = p_id (e8_c matches), 11..20 with a dangling ref, 21..30 with
# ref NULL.  e8_c.ck = 1..10 with nk = ck % 3 + 1; e8_n.nk = 1..3.
#
# The greps pin the shape of the tree, not the join types, which the fix
# changes.  A failing grep means RonSQL chose another plan: adjust the
# test.
#
# Run:    ./mtr --suite=ronsql_cte spj_ronsql_e8_promotion_gaps
# Record: ./mtr --suite=ronsql_cte --record spj_ronsql_e8_promotion_gaps

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/spj-ronsql-e8-explain.out

--disable_query_log
--disable_warnings

CREATE TABLE e8_t (
  p_id INT NOT NULL,
  grp  INT NOT NULL,
  ref  INT NULL,
  PRIMARY KEY USING HASH (p_id)
) ENGINE=NDB;

CREATE TABLE e8_c (
  ck INT NOT NULL,
  nk INT NOT NULL,
  PRIMARY KEY USING HASH (ck)
) ENGINE=NDB;

CREATE TABLE e8_n (
  nk INT NOT NULL,
  r  INT NOT NULL,
  PRIMARY KEY USING HASH (nk)
) ENGINE=NDB;

INSERT INTO e8_t VALUES
  (1,1,1), (2,2,2), (3,0,3), (4,1,4), (5,2,5),
  (6,0,6), (7,1,7), (8,2,8), (9,0,9), (10,1,10),
  (11,2,9011), (12,0,9012), (13,1,9013), (14,2,9014), (15,0,9015),
  (16,1,9016), (17,2,9017), (18,0,9018), (19,1,9019), (20,2,9020),
  (21,0,NULL), (22,1,NULL), (23,2,NULL), (24,0,NULL), (25,1,NULL),
  (26,2,NULL), (27,0,NULL), (28,1,NULL), (29,2,NULL), (30,0,NULL);
INSERT INTO e8_c VALUES
  (1,2), (2,3), (3,1), (4,2), (5,3), (6,1), (7,2), (8,3), (9,1), (10,2);
INSERT INTO e8_n VALUES (1,10), (2,20), (3,30);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === e8-0: the trees are chains t -> c -> n ===
let $QUERY=
SELECT COUNT(*) AS cnt, SUM(n.r) AS s
FROM e8_t AS t
LEFT JOIN e8_c AS c ON c.ck = t.ref
LEFT JOIN e8_n AS n ON n.nk = c.nk
WHERE n.r >= 0;|
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF 'Join plan (3 operations):' $EXPLAIN_FILE
--exec grep -qF 'PK_LOOKUP e8_n AS n  <- c' $EXPLAIN_FILE
--remove_file $EXPLAIN_FILE

let $QUERY=
WITH e8_b AS (SELECT t.grp AS g, COUNT(*) AS cnt
              FROM e8_t AS t
              LEFT JOIN e8_c AS c ON c.ck = t.ref
              JOIN e8_n AS n ON n.nk = c.nk
              GROUP BY t.grp)
SELECT SUM(cnt) AS s FROM e8_b;|
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF 'Body join plan (3 operations):' $EXPLAIN_FILE
--exec grep -qF 'PK_LOOKUP e8_n AS n  <- c' $EXPLAIN_FILE
--remove_file $EXPLAIN_FILE

--echo
--echo === e8-1: a null-rejecting WHERE on the last table of a LEFT-LEFT chain ===
let $QUERY=
SELECT COUNT(*) AS cnt, SUM(n.r) AS s
FROM e8_t AS t
LEFT JOIN e8_c AS c ON c.ck = t.ref
LEFT JOIN e8_n AS n ON n.nk = c.nk
WHERE n.r >= 0;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
SELECT COUNT(*) AS cnt, SUM(n.r) AS s
FROM e8_t AS t
LEFT JOIN e8_c AS c ON c.ck = t.ref
LEFT JOIN e8_n AS n ON n.nk = c.nk
WHERE n.r >= 0|

--echo
--echo === e8-2: an INNER JOIN after a LEFT JOIN inside a CTE body ===
let $QUERY=
WITH e8_b AS (SELECT t.grp AS g, COUNT(*) AS cnt
              FROM e8_t AS t
              LEFT JOIN e8_c AS c ON c.ck = t.ref
              JOIN e8_n AS n ON n.nk = c.nk
              GROUP BY t.grp)
SELECT SUM(cnt) AS s FROM e8_b;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
WITH e8_b AS (SELECT t.grp AS g, COUNT(*) AS cnt
              FROM e8_t AS t
              LEFT JOIN e8_c AS c ON c.ck = t.ref
              JOIN e8_n AS n ON n.nk = c.nk
              GROUP BY t.grp)
SELECT SUM(cnt) AS s FROM e8_b|

--echo
--echo === e8-3: control, the same chain in the main query ===
let $QUERY=
SELECT COUNT(*) AS cnt
FROM e8_t AS t
LEFT JOIN e8_c AS c ON c.ck = t.ref
JOIN e8_n AS n ON n.nk = c.nk;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
SELECT COUNT(*) AS cnt
FROM e8_t AS t
LEFT JOIN e8_c AS c ON c.ck = t.ref
JOIN e8_n AS n ON n.nk = c.nk|

DELIMITER ;|

--echo
--echo === e8-4: no DBSPJ request left behind ===
--exec $NDB_MGM -e "ALL DUMP 2650" > /dev/null

--disable_query_log
DROP TABLE e8_t;
DROP TABLE e8_c;
DROP TABLE e8_n;
--enable_query_log
