# spj_ronsql_e5_cte_collation
#
# Finding E-5 = Q-3 (storage/ndb/claude_files/dbspj/dbspj_query_execution.html,
# section 8), the kernel part, reached from RonSQL CTEs: GROUP BY values
# that are equal under the collation must form one group.
#
# The kernel group hash table (findInBucket, AggHashTable.hpp) compares the
# key length in words and the data size in words before it compares the
# values with the collation.  Equal values whose stored lengths differ in
# word count therefore split into several groups: 'abc' takes 4 bytes
# with its length byte (1 word) and 'ábc' takes 5 (2 words).  Values in
# the same word ('a' and 'á') do not split.
#
# The pushed-join results are merged with the collation in the API since
# the E-5 API fix (NdbAggregator::initForResults), but CTE groups never
# reach the API: they are redistributed and merged in the data nodes,
# which hash with the collation (both halves reach the same owner) and
# merge with findInBucket again, so they stay split.
#
# Data: e5_t.v (utf8mb4_0900_ai_ci) = 'abc' 'ABC' 'Abc' 'ábc' 'Ábc' 'ÁBC'
# 'xyz' 'XYZ'; e5_d.v = 'abc' 'ÁBC' 'xyz' 'zzz'.
#
#   e5-1  CTE grouped by v, main counts the groups.
#         Expected (MySQL): (ng, s, mx) = (2, 8, 6).
#         Expected before a fix: (3, 8, 3), observed 2026-10-31.
#   e5-2  CTE_LOOKUP into the same CTE.
#         Expected (MySQL): (1, 6) (2, 6) (3, 2).
#         Expected before a fix: (1, 3) (2, 3) (3, 2).
# Kernel fix (2026-11-02, GBHashTable::findInBucket): string columns are
# compared with the collation only, whatever their lengths.  Expected
# after it: the MySQL results.
#
# A failing grep at e5-0 means RonSQL chose another plan: adjust the test.
#
# Run:    ./mtr --suite=ronsql_cte spj_ronsql_e5_cte_collation
# Record: ./mtr --suite=ronsql_cte --record spj_ronsql_e5_cte_collation

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/spj-ronsql-e5-explain.out

--disable_query_log
--disable_warnings

CREATE TABLE e5_t (
  id INT NOT NULL,
  v  VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

CREATE TABLE e5_d (
  id INT NOT NULL,
  v  VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

# The accented values are given in hex (C3A1 = á, C381 = Á) so that the
# connection character set does not matter.
INSERT INTO e5_t VALUES
  (1, 'abc'), (2, 'ABC'), (3, 'Abc'),
  (4, CONVERT(X'C3A16263' USING utf8mb4)),
  (5, CONVERT(X'C3816263' USING utf8mb4)),
  (6, CONVERT(X'C3814243' USING utf8mb4)),
  (7, 'xyz'), (8, 'XYZ');
INSERT INTO e5_d VALUES
  (1, 'abc'), (2, CONVERT(X'C3814243' USING utf8mb4)), (3, 'xyz'), (4, 'zzz');

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === e5-0: e5-2 is a CTE_LOOKUP into the grouped CTE ===
let $QUERY=
WITH e5_c AS (SELECT v, COUNT(*) AS n FROM e5_t GROUP BY v)
SELECT d.id, e5_c.n FROM e5_d AS d JOIN e5_c ON e5_c.v = d.v;|
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF '[INNER] CTE_LOOKUP CTE:e5_c' $EXPLAIN_FILE
--remove_file $EXPLAIN_FILE

--echo
--echo === e5-1: CTE GROUP BY a string, values equal under the collation ===
let $QUERY=
WITH e5_c AS (SELECT v, COUNT(*) AS n FROM e5_t GROUP BY v)
SELECT COUNT(*) AS ng, SUM(n) AS s, MAX(n) AS mx FROM e5_c;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
WITH e5_c AS (SELECT v, COUNT(*) AS n FROM e5_t GROUP BY v)
SELECT COUNT(*) AS ng, SUM(n) AS s, MAX(n) AS mx FROM e5_c|

--echo
--echo === e5-2: CTE_LOOKUP into the same CTE ===
let $QUERY=
WITH e5_c AS (SELECT v, COUNT(*) AS n FROM e5_t GROUP BY v)
SELECT d.id, e5_c.n FROM e5_d AS d JOIN e5_c ON e5_c.v = d.v;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH e5_c AS (SELECT v, COUNT(*) AS n FROM e5_t GROUP BY v)
SELECT d.id, e5_c.n FROM e5_d AS d JOIN e5_c ON e5_c.v = d.v|

DELIMITER ;|

--echo
--echo === e5-3: no DBSPJ request left behind ===
--exec $NDB_MGM -e "ALL DUMP 2650" > /dev/null

--disable_query_log
DROP TABLE e5_t;
DROP TABLE e5_d;
--enable_query_log
