# ORDER BY / LIMIT in a SUBQUERY is cleanly + PERMANENTLY rejected
# (was: parsed and SILENTLY IGNORED — wrong results vs MySQL).
#
# Phase 0 of ronsql_orderby_limit_plan.md.  The grammar stores
# orderby_columns / limit on every SELECT body; the main SELECT's are
# applied by ResultPrinter, and CTE BODIES apply them in the kernel
# since cte_orderby_limit_plan.md L4 (single-owner redistribution +
# top-N at the CTE finalize barrier) — the former body arms obl-1..3
# are therefore RETIRED, with the full body coverage (acceptance and
# the rejections that remain valid) in ronsql_cte_dd_orderby_limit_cte
# (obc-1..21 + obc-P1..P7).  Subqueries still never apply them: the
# decorrelation rewrites additionally strip GROUP BY / ORDER BY / LIMIT
# textually from EXISTS / correlated-scalar subqueries, so RonSQL
# rejects those at prepare time with a clean RonSQLPermanentError
# (reject_ignored_orderby_limit, checked on the ORIGINAL parsed
# statements in analyze_subqueries_ce / analyze_select_subqueries —
# before any rewrite can strip them).
#
# This is a rejection-assert regression (prepare-time error -> no data
# touched), run via $RONSQL_CLI_EXE with --error 1, mirroring
# ronsql_cte_dd_d4_colvscol.test.  --record to refresh r/ when the
# message changes.

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--source suite/ronsql_cte/include/cte_schema.inc
--source suite/ronsql_cte/include/cte_data.inc

--echo
--echo === obl-1..3: RETIRED — CTE-body ORDER BY / LIMIT is now supported ===
--echo === (cte_orderby_limit_plan.md; see ronsql_cte_dd_orderby_limit_cte) ===

--echo
--echo === obl-4: scalar subquery with LIMIT — permanent rejection ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT COUNT(*) FROM orders WHERE o_totalprice < (SELECT MAX(o_totalprice) FROM orders LIMIT 1);' 2>&1

--echo
--echo === obl-5: IN subquery with ORDER BY + LIMIT — permanent rejection ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT COUNT(*) FROM orders WHERE o_custkey IN (SELECT c_custkey FROM customer ORDER BY c_acctbal DESC LIMIT 5);' 2>&1

--echo
--echo === obl-6: EXISTS subquery with LIMIT — permanent rejection ===
# The EXISTS body mirrors the green ronsql_cte_subquery Test 3 shape
# (column output, not SELECT 1 — a bare literal output does not parse).
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT COUNT(*) FROM orders AS o WHERE EXISTS (SELECT l_orderkey FROM lineitem WHERE l_orderkey = o.o_orderkey LIMIT 1);' 2>&1

--echo
--echo === obl-7: SELECT-list subquery with LIMIT — permanent rejection ===
# Mirrors the green ronsql_subquery_agg shape (qualified refs + AS alias
# — an unaliased SELECT-list subquery does not parse).
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT c.c_custkey, (SELECT COUNT(o.o_orderkey) FROM orders AS o WHERE o.o_custkey = c.c_custkey LIMIT 1) AS n FROM customer AS c;' 2>&1

--source suite/ronsql_cte/include/cte_drop.inc
