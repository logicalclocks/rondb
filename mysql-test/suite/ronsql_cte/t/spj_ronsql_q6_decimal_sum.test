# spj_ronsql_q6_decimal_sum
#
# Findings Q-6 / E-16 (storage/ndb/claude_files/dbspj/dbspj_query_execution.html,
# section 8), reached from RonSQL: SUM, AVG, MIN and MAX of a DECIMAL with
# scale > 0 are computed as DOUBLE in the kernel (decimal2double,
# AggColumnLoad.hpp) and printed as a double, so values with more than
# about 16 significant digits come out rounded.  mysqld no longer pushes
# such aggregates; RonSQL does not refuse them.  RonSQL findings F5 (wrong
# values beyond 2^53) and F21 (the last digit depends on the topology)
# are open and ask for exact DECIMAL.
#
# Disabled in suite/ronsql/disabled.def (imported by
# collections/disabled_ndb.def) until exact DECIMAL aggregation is done
# (its own round).  Run it with --enable-disabled.
#
# Data: q6_t.x is DECIMAL(38,6), three values of 14 integer digits per
# group, so every sum has 21 significant digits.
#
#   q6-1  join aggregation (DBSPJ), SUM, MIN and MAX.
#   q6-2  CTE aggregation.
#   q6-3  single-table aggregation (DBTUP), the same computation.
# Expected (MySQL): the exact sums, e.g. g = 1 -> 122222222122221.888888.
# Expected before a fix: the sums rounded to a double.
#
# Run:    ./mtr --suite=ronsql_cte --enable-disabled spj_ronsql_q6_decimal_sum
# Record: ./mtr --suite=ronsql_cte --enable-disabled --record spj_ronsql_q6_decimal_sum

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/spj-ronsql-q6-explain.out

--disable_query_log
--disable_warnings

CREATE TABLE q6_d (
  id INT NOT NULL,
  g  INT NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

CREATE TABLE q6_t (
  id  INT NOT NULL,
  did INT NOT NULL,
  g   INT NOT NULL,
  x   DECIMAL(38,6) NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

INSERT INTO q6_d VALUES (1, 1), (2, 2);
INSERT INTO q6_t VALUES
  (1, 1, 1, 12345678901234.123456),
  (2, 1, 1, 98765432109876.654321),
  (3, 1, 1, 11111111111111.111111),
  (4, 2, 2, 22222222222222.222222),
  (5, 2, 2, 33333333333333.333333),
  (6, 2, 2, 44444444444444.444445);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === q6-0: q6-1 is a pushed join ===
let $QUERY=
SELECT d.g, SUM(t.x) AS s, MIN(t.x) AS mn, MAX(t.x) AS mx
FROM q6_t AS t JOIN q6_d AS d ON d.id = t.did
GROUP BY d.g;|
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF 'Join plan (2 operations):' $EXPLAIN_FILE
--remove_file $EXPLAIN_FILE

--echo
--echo === q6-1: join aggregation of DECIMAL(38,6) ===
let $QUERY=
SELECT d.g, SUM(t.x) AS s, MIN(t.x) AS mn, MAX(t.x) AS mx
FROM q6_t AS t JOIN q6_d AS d ON d.id = t.did
GROUP BY d.g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT d.g, SUM(t.x) AS s, MIN(t.x) AS mn, MAX(t.x) AS mx
FROM q6_t AS t JOIN q6_d AS d ON d.id = t.did
GROUP BY d.g|

--echo
--echo === q6-2: CTE aggregation of DECIMAL(38,6) ===
let $QUERY=
WITH q6_c AS (SELECT g, SUM(x) AS s FROM q6_t GROUP BY g)
SELECT g, s FROM q6_c;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH q6_c AS (SELECT g, SUM(x) AS s FROM q6_t GROUP BY g)
SELECT g, s FROM q6_c|

--echo
--echo === q6-3: single-table aggregation of DECIMAL(38,6) ===
let $QUERY=
SELECT g, SUM(x) AS s FROM q6_t GROUP BY g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT g, SUM(x) AS s FROM q6_t GROUP BY g|

DELIMITER ;|

--echo
--echo === q6-4: no DBSPJ request left behind ===
--exec $NDB_MGM -e "ALL DUMP 2650" > /dev/null

--disable_query_log
DROP TABLE q6_t;
DROP TABLE q6_d;
--enable_query_log
