# D6 re-verification probe (run WITHOUT --record first; a data-node crash fails
# fast, no timeout needed).  Finding D6 / fix-plan H-crash.
#
# Scalar main aggregation over a CTE keyed by l_orderkey (1500 distinct) used as
# a CTE_LOOKUP child of a large orders root scan crashed BOTH data nodes with a
# DBSPJ ndbassert: Error 2343, DbspjMain.cpp:7825, "requestPtr.p->m_cnt_active
# == 0 failed".  The same scalar-agg shape keyed by o_custkey/300 -> small
# customer parent (agg-04) PASSES, so the trigger is the high-cardinality CTE +
# large root scan (suspected multi-batch teardown bug).
#
# This probe re-checks D6 against the freshly-built binaries (some earlier
# findings were stale-binary artifacts).  Two shapes:
#   D6a: CTE_LOOKUP child of a large orders root scan (agg-06 repro).
#   D6b: scalar agg directly over a high-cardinality lineitem CTE_SCAN root
#        (agg-19 shape).
# control: agg-04-style (300-key CTE -> small parent) which is known GREEN.
#
# Run: ../debug_build/mysql-test/mtr --suite=ronsql_cte ronsql_cte_dd_d6_crash
# If a data node crashes, read the assert + trace:
#   cat debug_build/mysql-test/var/log/ronsql_cte.ronsql_cte_dd_d6_crash/mysql_cluster.1/ndbd.*/ndb_*_error.log
#   ls -lt debug_build/mysql-test/var/log/ronsql_cte.ronsql_cte_dd_d6_crash/mysql_cluster.1/ndbd.*/ndb_*_trace*

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--source suite/ronsql_cte/include/cte_schema.inc
--source suite/ronsql_cte/include/cte_data.inc

DELIMITER |;

--echo
--echo === control (agg-04 shape): scalar agg over CTE keyed by o_custkey/300 -> small parent (known GREEN) ===
let $QUERY=
WITH cust AS (SELECT o_custkey AS k, SUM(o_shippriority) AS t FROM orders GROUP BY o_custkey)
SELECT SUM(cust.t) FROM customer AS c JOIN cust ON cust.k = c.c_custkey;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH cust AS (SELECT o_custkey AS k, SUM(o_shippriority) AS t FROM orders GROUP BY o_custkey)
SELECT SUM(cust.t) FROM customer AS c JOIN cust ON cust.k = c.c_custkey|

--echo
--echo === D6a: CTE_LOOKUP child of large orders root, high-cardinality lineitem CTE (agg-06) ===
let $QUERY=
WITH li AS (SELECT l_orderkey AS k, MIN(l_quantity) AS mn, MAX(l_quantity) AS mx, SUM(l_quantity) AS sq
            FROM lineitem GROUP BY l_orderkey)
SELECT MIN(li.mn), MAX(li.mx), SUM(li.sq) FROM orders AS o JOIN li ON li.k = o.o_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH li AS (SELECT l_orderkey AS k, MIN(l_quantity) AS mn, MAX(l_quantity) AS mx, SUM(l_quantity) AS sq
            FROM lineitem GROUP BY l_orderkey)
SELECT MIN(li.mn), MAX(li.mx), SUM(li.sq) FROM orders AS o JOIN li ON li.k = o.o_orderkey|

--echo
--echo === D6b: scalar agg over a high-cardinality lineitem CTE_SCAN root (agg-19 shape) ===
let $QUERY=
WITH li AS (SELECT l_orderkey AS k, SUM(l_quantity) AS sq FROM lineitem GROUP BY l_orderkey)
SELECT COUNT(*), SUM(li.sq), MIN(li.sq), MAX(li.sq) FROM li;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
WITH li AS (SELECT l_orderkey AS k, SUM(l_quantity) AS sq FROM lineitem GROUP BY l_orderkey)
SELECT COUNT(*), SUM(li.sq), MIN(li.sq), MAX(li.sq) FROM li|
DELIMITER ;|

--source suite/ronsql_cte/include/cte_drop.inc
