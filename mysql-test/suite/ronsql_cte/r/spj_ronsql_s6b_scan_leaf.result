=== s6b-1: control, aggregating main over the CTE ===
== Query ==
WITH pc AS (SELECT p.id AS k, COUNT(*) AS n, SUM(c.val) AS s
FROM s6b_p AS p
LEFT JOIN s6b_c AS c ON c.pid = p.id
GROUP BY p.id)
SELECT COUNT(*), SUM(n), SUM(s) FROM pc;

