=== s5-3: aggregating form of the same star ===
== Query ==
WITH pc AS (SELECT o_custkey AS k, COUNT(*) AS cnt
FROM orders GROUP BY o_custkey)
SELECT COUNT(*), SUM(o.o_shippriority)
FROM customer AS c
JOIN pc ON pc.k = c.c_custkey
JOIN orders AS o ON o.o_custkey = c.c_custkey
WHERE c.c_custkey <= 20;

