=== nko-1: scalar aggregate, LEFT JOIN cte ON a nullable key ===
== Query ==
WITH cl AS (SELECT o_clerk AS k, COUNT(*) AS n
FROM orders WHERE o_clerk IS NOT NULL GROUP BY o_clerk)
SELECT COUNT(*), SUM(cl.n)
FROM orders AS o LEFT JOIN cl ON cl.k = o.o_clerk;

