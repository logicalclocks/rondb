=== Example 14: Category profile of the current session ===
== Query ==
WITH recent_clicks AS (
  SELECT user_id, event_time, category_id, dwell_ms
  FROM clicks_1
  WHERE user_id = 17
  ORDER BY event_time DESC
  LIMIT 20)
SELECT category_id, COUNT(*) AS n_clicks,
       SUM(dwell_ms) AS total_dwell_ms
FROM recent_clicks
GROUP BY category_id;

