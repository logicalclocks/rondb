=== Example 3: Transaction velocity in several time windows ===
== Query ==
WITH w1h AS (
  SELECT COUNT(*) AS n_1h, SUM(amount) AS amt_1h
  FROM transactions_1
  WHERE cc_num = 4242 AND event_time >= '2026-09-29 11:00:00'),
     w24h AS (
  SELECT COUNT(*) AS n_24h, SUM(amount) AS amt_24h
  FROM transactions_1
  WHERE cc_num = 4242 AND event_time >= '2026-09-28 12:00:00'),
     w7d AS (
  SELECT COUNT(*) AS n_7d, MAX(amount) AS max_amount_7d
  FROM transactions_1
  WHERE cc_num = 4242 AND event_time >= '2026-09-22 12:00:00')
SELECT w1h.n_1h, w1h.amt_1h, w24h.n_24h, w24h.amt_24h,
       w7d.n_7d, w7d.max_amount_7d
FROM w1h, w24h, w7d;

Number of output lines, including header: 2

== Diff ==
==========




=== Example 4: Spending above the 90-day maximum ===
== Query ==
WITH hist AS (
  SELECT MAX(amount) AS max_amount_90d
  FROM transactions_1
  WHERE cc_num = 4242
    AND event_time >= '2026-07-01 00:00:00'
    AND event_time < '2026-09-29 00:00:00')
SELECT COUNT(*) AS n_above_max, SUM(t.amount) AS amt_above_max
FROM transactions_1 AS t, hist
WHERE t.cc_num = 4242
  AND t.event_time >= '2026-09-29 00:00:00'
  AND t.amount > hist.max_amount_90d;

Number of output lines, including header: 2

== Diff ==
==========




=== Example 5: Transactions abroad ===
== Query ==
WITH card AS (
  SELECT home_country
  FROM cards_1
  WHERE cc_num = 4242)
SELECT COUNT(*) AS n_abroad_24h
FROM transactions_1 AS t, card
WHERE t.cc_num = 4242
  AND t.event_time >= '2026-09-28 12:00:00'
  AND t.country <> card.home_country;

Number of output lines, including header: 2

