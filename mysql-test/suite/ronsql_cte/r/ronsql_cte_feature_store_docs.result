=== Example 15: Sensor statistics for a machine ===
== Query ==
SELECT sensor_id,
       MIN(temperature) AS min_temperature,
       MAX(temperature) AS max_temperature,
       AVG(vibration) AS avg_vibration
FROM sensor_readings_1
WHERE sensor_id IN (11, 12, 13, 14)
  AND event_time >= '2026-09-29 11:00:00'
GROUP BY sensor_id;

