=== e4-1: CASE on the leaf column, NULL rows and a NULL value, grouped ===
== Query ==
SELECT o.g,
SUM(CASE WHEN i.v < 15 THEN 1 ELSE 0 END) AS lv,
SUM(CASE WHEN i.v <> 10 THEN 1 ELSE 0 END) AS nv,
COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT o.g,
SUM(CASE WHEN i.v < 15 THEN 1 ELSE 0 END) AS lv,
SUM(CASE WHEN i.v <> 10 THEN 1 ELSE 0 END) AS nv,
COUNT(*) AS n
FROM e4_o AS o
LEFT JOIN e4_i AS i ON i.id = o.ref
GROUP BY o.g|
g	lv	nv	n
1	1	1	3
2	0	0	2
3	0	0	1

