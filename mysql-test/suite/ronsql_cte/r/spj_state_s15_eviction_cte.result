=== s15c-1: control, no forced eviction ===
== Query ==
WITH c0 AS (SELECT grp AS k, SUM(val) AS total
FROM s15c_src GROUP BY grp)
SELECT r.g, COUNT(*), SUM(c0.total)
FROM c0 JOIN s15c_rhs AS r ON r.id = c0.k
GROUP BY r.g;

