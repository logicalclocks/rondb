=== gl-1: nullable inner column, both argument orders, grouped ===
== Query ==
SELECT c.id,
SUM(GREATEST(o.amt, c.fl)) AS g_oc,
SUM(GREATEST(c.fl, o.amt)) AS g_co,
COUNT(LEAST(o.amt, c.fl)) AS l_oc,
COUNT(LEAST(c.fl, o.amt)) AS l_co,
COUNT(*) AS n
FROM glo_c AS c
LEFT JOIN glo_o AS o ON o.cid = c.id
GROUP BY c.id;

