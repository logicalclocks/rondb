=== e3-1: LEFT-LEFT lookup chain over a 20000-row root, grouped ===
== Query ==
SELECT r.g, COUNT(*) AS n, COUNT(m.pk) AS nm, COUNT(l.pk) AS nl,
SUM(l.v) AS s
FROM e3_r AS r
LEFT JOIN e3_m AS m ON m.pk = r.a
LEFT JOIN e3_l AS l ON l.pk = m.b
GROUP BY r.g;

