=== crp-1 (PG-1): wide GROUP BY CTE redistributed under ALL ERROR 5134 ===
== Query ==
WITH li AS (SELECT l_orderkey AS k, COUNT(*) AS n,
SUM(l_quantity) AS q, MIN(l_quantity) AS qmin,
MAX(l_quantity) AS qmax, SUM(l_partkey) AS pk,
SUM(l_suppkey) AS sk, MIN(l_shipdate) AS d1,
MAX(l_shipdate) AS d2
FROM lineitem GROUP BY l_orderkey)
SELECT o.o_orderstatus, COUNT(*), SUM(li.n), SUM(li.q), SUM(li.qmin),
SUM(li.qmax), SUM(li.pk), SUM(li.sk), MIN(li.d1), MAX(li.d2)
FROM orders AS o JOIN li ON li.k = o.o_orderkey
GROUP BY o.o_orderstatus;

