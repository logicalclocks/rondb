--enable_warnings
--enable_query_log

--echo #
--echo # Setup: Create test database and table
--echo #

CREATE DATABASE cli_test;
USE cli_test;

CREATE TABLE batch_test (
  id INT PRIMARY KEY,
  name VARCHAR(100),
  value INT
) ENGINE=NDB;

# Set up rondb-cli commands
--let $API_KEY=bkYjEz6OTZyevbqt.ocHajJhnE0ytBh8zbYj3IXupyMqeMZp8PW464eTxzxqP5afBjodEQUgY0lmL33ub
--let $RONDB_SQL=$RONDB_CLI --host=127.0.0.1 --mysql-port=$MASTER_MYPORT --no-rdrs --no-rondis --quiet
--let $RONDB_BATCH=$RONDB_CLI --host=127.0.0.1 --mysql-port=$MASTER_MYPORT --rdrs-host=$RDRS_HOST --rdrs-port=$RDRS_PORT --rdrs-api-key=$API_KEY --no-rondis --quiet

--echo #
--echo # Test 1: INSERT using rondb-cli SQL
--echo #

--exec $RONDB_SQL -e "INSERT INTO cli_test.batch_test VALUES (1, 'Alice', 100);"
--exec $RONDB_SQL -e "INSERT INTO cli_test.batch_test VALUES (2, 'Bob', 200);"
--exec $RONDB_SQL -e "INSERT INTO cli_test.batch_test VALUES (3, 'Charlie', 300);"

--echo #
--echo # Test 2: SELECT using rondb-cli SQL
--echo #

--exec $RONDB_SQL -e "SELECT * FROM cli_test.batch_test ORDER BY id;"

--echo #
--echo # Test 3: Verify data with native MySQL
--echo #

SELECT * FROM batch_test ORDER BY id;

--echo #
--echo # Test 4: UPDATE using rondb-cli SQL
--echo #

--exec $RONDB_SQL -e "UPDATE cli_test.batch_test SET value = 150 WHERE id = 1;"

--echo # Verify update
SELECT * FROM batch_test WHERE id = 1;

--echo #
--echo # Test 5: DELETE using rondb-cli SQL
--echo #

--exec $RONDB_SQL -e "DELETE FROM cli_test.batch_test WHERE id = 2;"

--echo # Verify deletion
SELECT * FROM batch_test ORDER BY id;

--echo #
--echo # Test 6: READ using rondb-cli REST API (pk-read)
--echo #

--exec $RONDB_BATCH -e "READ cli_test.batch_test name, value FILTER id=1;"
--exec $RONDB_BATCH -e "READ cli_test.batch_test name, value FILTER id=3;"

--echo #
--echo # Test 7: BATCH READ using rondb-cli REST API
--echo #

--exec $RONDB_BATCH -e "BATCH READ cli_test.batch_test name, value FILTER id=1 READ cli_test.batch_test name, value FILTER id=3;"

--echo #
--echo # Test 8: BATCH WRITE (INSERT) using rondb-cli REST API
--echo #

--exec $RONDB_BATCH -e "BATCH WRITE cli_test.batch_test name='David', value=400 FILTER id=4;"

--echo # Verify BATCH WRITE (INSERT)
SELECT * FROM batch_test WHERE id = 4;

--echo #
--echo # Test 9: BATCH WRITE (UPDATE) using rondb-cli REST API
--echo #

--exec $RONDB_BATCH -e "BATCH WRITE cli_test.batch_test name='Charlie Updated', value=350 FILTER id=3;"

--echo # Verify BATCH WRITE (UPDATE)
SELECT * FROM batch_test WHERE id = 3;

--echo #
--echo # Test 10: BATCH DELETE using rondb-cli REST API
--echo #

--exec $RONDB_BATCH -e "BATCH DELETE cli_test.batch_test FILTER id=4;"

--echo # Verify BATCH DELETE
SELECT * FROM batch_test ORDER BY id;

--echo #
--echo # Cleanup
--echo #

DROP TABLE batch_test;
DROP DATABASE cli_test;
DROP DATABASE hopsworks;
