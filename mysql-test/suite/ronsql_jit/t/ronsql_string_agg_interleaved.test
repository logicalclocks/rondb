# Mirror of suite/ronsql/t/ronsql_string_agg_interleaved.test with the JIT
# active (CompiledInterpreter=ON) — the JIT arm of the RONDB-1056 RonSQL
# differential. Test logic lives ONLY in the sourced original.
#
# PIN-ONLY (no jit_strict_arm.inc). The "string agg, numeric agg, string
# MIN/MAX on the same register" shape used to be a bridge reject (the
# fused string-load lowering took only CONSECUTIVE consumers; recorded
# pin 100). ronsql_jit item 16 (2026-09-09) lowers non-adjacent string
# consumers where they occur, so the pin is 0 now. Before item 16 the
# MAX/SUM/COUNT(s_val) query also returned a WRONG count under ON (a bare
# COUNT on the string register counted NULL rows: 4 instead of 2), and
# the first recording of this mirror baked that into its "== Diff =="
# block — a non-empty diff block in a recorded result is a JIT wrong
# result, never an expectation. The crash this test
# guards against was in the interpreter (both arms exercise it: the
# interpreter directly under OFF, and any per-row fallback under ON).
# Re-record the pin deliberately when it moves.
SET @jit_c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
--source suite/ronsql/t/ronsql_string_agg_interleaved.test
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @jit_c0 AS SIGNED)
       AS ronsql_string_agg_interleaved_jit_fallback_delta;
