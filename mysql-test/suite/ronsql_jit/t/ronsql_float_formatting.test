# Share FLOAT display cases with the interpreter suite; require compiled programs.
SET @float_format_jit_c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
--source suite/ronsql_jit/include/jit_strict_arm.inc
--source suite/ronsql/t/ronsql_float_formatting.test
--source suite/ronsql_jit/include/jit_strict_disarm.inc
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @float_format_jit_c0 AS SIGNED)
       AS ronsql_float_formatting_jit_fallback_delta;
