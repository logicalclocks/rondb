# Mirror of suite/ronsql/t/ronsql_binary_passthrough.test with the JIT
# active (CompiledInterpreter=ON) — the JIT arm of the RONDB-1056 RonSQL
# differential. Test logic lives ONLY in the sourced original.
#
# PIN-ONLY. Pass-through projections carry no aggregation program; the
# snowflake cases compile the CTE body's COUNT(*) program. The recorded
# fallback delta below is the coverage pin: a change in EITHER direction
# is a coverage change — investigate, then re-record deliberately.
SET @jit_c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
--source suite/ronsql/t/ronsql_binary_passthrough.test
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @jit_c0 AS SIGNED)
       AS ronsql_binary_passthrough_jit_fallback_delta;
