# Mirror of suite/ronsql/t/ronsql_cte_minmax_string_redist.test with the
# JIT active (CompiledInterpreter=ON) — the JIT arm of the RONDB-1056
# RonSQL differential. Test logic lives ONLY in the sourced original.
#
# The compiled string MIN/MAX over a CTE result goes through the same
# side-table kernel (jitMinMaxStringLinked -> minMaxString), so the
# compares on the node that holds c2 groups only from redistribution are
# checked here on the JIT path.
#
# The recorded fallback delta below is the coverage pin for this
# test: every JIT program reject it causes (aggregation, scan
# filter — one count per compile attempt) is counted. A change in
# EITHER direction is a coverage change: investigate, then re-record
# deliberately.
SET @jit_c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
--source suite/ronsql_jit/include/jit_strict_arm.inc
--source suite/ronsql/t/ronsql_cte_minmax_string_redist.test
--source suite/ronsql_jit/include/jit_strict_disarm.inc
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @jit_c0 AS SIGNED)
       AS ronsql_cte_minmax_string_redist_jit_fallback_delta;
