=== Test 11: db-qualified stored table beside a CTE still reads the table ===
== Query ==
WITH c0 AS (
SELECT k AS k, SUM(val) AS s
FROM nr_base GROUP BY k)
SELECT c0.k, SUM(o.val) AS total
FROM test.nr_other AS o
JOIN c0 ON c0.k = o.k
GROUP BY c0.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH c0 AS (
SELECT k AS k, SUM(val) AS s
FROM nr_base GROUP BY k)
SELECT c0.k, SUM(o.val) AS total
FROM test.nr_other AS o
JOIN c0 ON c0.k = o.k
GROUP BY c0.k|
k	total
10	100
20	200
30	300

=== Cleanup ===
DROP TABLE nr_other;
DROP TABLE nr_base;
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @jit_c0 AS SIGNED)
AS ronsql_cte_name_resolution_jit_fallback_delta;
ronsql_cte_name_resolution_jit_fallback_delta
0
