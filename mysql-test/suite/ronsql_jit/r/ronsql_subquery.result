=== Test 44: EXISTS preserves nested predicates and SQL-looking string text ===
Expected: id=7, total=70
== Query ==
SELECT o.id, SUM(o.amount) AS total
FROM i1_outer AS o
WHERE EXISTS (
  SELECT i.val FROM i1_inner AS i
  WHERE (i.val = 10 OR i.val = 20)
    AND (i.id = o.id
      AND i.tag = 'A AND B WHERE GROUP BY ORDER BY LIMIT'
      AND i.val > 15)
)
GROUP BY o.id;

Number of output lines, including header: 2

== Diff ==
==========




=== Test 45: Scalar subquery preserves SELECT and predicate source spans ===
Expected: id=7, total=70
== Query ==
SELECT o.id, SUM(o.amount) AS total
FROM i1_outer AS o
WHERE o.amount > (
  SELECT
	SUM(i.val) AS `sum FROM value`
  FROM i1_inner AS i
  WHERE
	(i.val = 10 OR i.val = 20)
    AND (i.id = o.id
      AND i.tag = 'A AND B WHERE GROUP BY ORDER BY LIMIT'
      AND i.val > 15)
)
GROUP BY o.id;

Number of output lines, including header: 2

== Diff ==
==========




=== Test 46: EXISTS escapes generated table, column and alias identifiers ===
Expected: id=7, total=70
== Query ==
SELECT o.id, SUM(o.amount) AS total
FROM i1_outer AS o
WHERE EXISTS (
  SELECT `i``alias`.val FROM `i1``inner` AS `i``alias`
  WHERE `i``alias`.`i``key` = o.id AND `i``alias`.val < 100
)
GROUP BY o.id;

Number of output lines, including header: 2

