=== Cleanup ===
DROP TABLE empty_table;
DROP TABLE lineitem;
DROP TABLE orders;
DROP TABLE nq_inner;
DROP TABLE nq_outer;
DROP TABLE `i1``inner`;
DROP TABLE i1_inner;
DROP TABLE i1_outer;
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @jit_c0 AS SIGNED)
AS ronsql_subquery_jit_fallback_delta;
ronsql_subquery_jit_fallback_delta
