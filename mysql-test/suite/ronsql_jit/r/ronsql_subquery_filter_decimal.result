=== sd-4: filtered DECIMAL UNSIGNED SUM beside unfiltered aggregates ===
== Query ==
SELECT o.id,
(SELECT SUM(l.uprice) FROM sd_l AS l
WHERE l.order_id = o.id AND l.qty > o.min_qty) AS s,
(SELECT COUNT(*) FROM sd_l AS l2 WHERE l2.order_id = o.id) AS n_all,
(SELECT SUM(l3.price) FROM sd_l AS l3 WHERE l3.order_id = o.id) AS s_all
FROM sd_o AS o;

Number of output lines, including header: 6

== Diff ==
==========



== Expected result ==
SELECT o.id,
(SELECT SUM(l.uprice) FROM sd_l AS l
WHERE l.order_id = o.id AND l.qty > o.min_qty) AS s,
(SELECT COUNT(*) FROM sd_l AS l2 WHERE l2.order_id = o.id) AS n_all,
(SELECT SUM(l3.price) FROM sd_l AS l3 WHERE l3.order_id = o.id) AS s_all
FROM sd_o AS o|
