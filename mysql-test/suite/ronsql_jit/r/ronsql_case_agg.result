=== ca-6: AVG(CASE) in a join aggregate ===
== Query ==
SELECT p.lbl, AVG(CASE WHEN t.a > 50 THEN t.a ELSE t.b END)
FROM ca_p AS p JOIN ca_t AS t ON t.g = p.g
GROUP BY p.lbl;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT p.lbl, AVG(CASE WHEN t.a > 50 THEN t.a ELSE t.b END)
FROM ca_p AS p JOIN ca_t AS t ON t.g = p.g
GROUP BY p.lbl|
lbl	AVG(CASE WHEN t.a > 50 THEN t.a ELSE t.b END)
one	65.0000
three	55.0000
two	3.0000
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @jit_c0 AS SIGNED)
AS ronsql_case_agg_jit_fallback_delta;
ronsql_case_agg_jit_fallback_delta
0
