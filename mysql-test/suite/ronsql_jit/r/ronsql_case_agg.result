SET @jit_c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");

=== ca-1: AVG(CASE) with a constant ELSE, GROUP BY ===
== Query ==
SELECT g, AVG(CASE WHEN a > 50 THEN a ELSE 0 END)
FROM ca_t GROUP BY g;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT g, AVG(CASE WHEN a > 50 THEN a ELSE 0 END)
FROM ca_t GROUP BY g|
g	AVG(CASE WHEN a > 50 THEN a ELSE 0 END)
1	43.3333
2	0.0000
3	55.0000

