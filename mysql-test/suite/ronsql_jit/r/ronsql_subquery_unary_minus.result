=== um-8: WITH query joined to its CTE, minus over a DECIMAL MIN ===
== Query ==
WITH ls AS (SELECT ok AS k, COUNT(*) AS m FROM um_l GROUP BY ok)
SELECT o.c, SUM(ls.m) AS m_sum
FROM um_o AS o JOIN ls ON ls.k = o.id
WHERE o.total > -(SELECT MIN(price) FROM um_p)
GROUP BY o.c;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH ls AS (SELECT ok AS k, COUNT(*) AS m FROM um_l GROUP BY ok)
SELECT o.c, SUM(ls.m) AS m_sum
FROM um_o AS o JOIN ls ON ls.k = o.id
WHERE o.total > -(SELECT MIN(price) FROM um_p)
GROUP BY o.c|
c	m_sum
2	3
3	1
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @jit_c0 AS SIGNED)
AS ronsql_subquery_unary_minus_jit_fallback_delta;
ronsql_subquery_unary_minus_jit_fallback_delta
