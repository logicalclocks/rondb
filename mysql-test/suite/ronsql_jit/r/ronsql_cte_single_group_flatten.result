SET @jit_c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
CREATE TABLE sgf (
id INT NOT NULL,
ck INT NOT NULL,
tag VARCHAR(10) NOT NULL,
d DATE NOT NULL,
price DECIMAL(15,2) NOT NULL,
qty INT,
PRIMARY KEY (id),
KEY idx_sgf_ck (ck)
) ENGINE=NDB;
INSERT INTO sgf VALUES
(1, 1, 'a', '2026-01-03', 10.50, 2),
(2, 1, 'b', '2026-01-01', 20.25, 5),
(3, 1, 'a', '2026-01-07', 7.00, NULL),
(4, 1, 'c', '2026-01-05', 100.10, 1),
(5, 2, 'a', '2026-02-01', 3.30, NULL),
(6, 2, 'b', '2026-02-02', 4.40, NULL),
(7, 3, 'z', '2026-03-01', 1.00, 9);

=== sgf-1: the fs_point form (ck 1: 4 rows) + EXPLAIN pin ===
== Query ==
WITH cf AS (SELECT ck AS k, COUNT(*) AS n, SUM(price) AS s, MIN(d) AS d1, MAX(d) AS d2 FROM sgf WHERE ck = 1 GROUP BY ck) SELECT MAX(cf.n) AS mn, MAX(cf.s) AS ms, MIN(cf.d1) AS md1, MAX(cf.d2) AS md2 FROM cf;

Number of output lines, including header: 2

