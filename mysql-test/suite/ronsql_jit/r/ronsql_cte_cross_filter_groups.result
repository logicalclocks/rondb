=== ca-1: AVG as the only aggregate of the body ===
== Query ==
WITH ca AS (
SELECT o.id AS k, AVG(l.price) AS av
FROM cgo AS o JOIN cgl AS l ON l.oid = o.id
WHERE l.qty > o.lim + 0
GROUP BY o.id)
