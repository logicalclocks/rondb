SET @jit_c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");

=== cg-1: pass-through over the CTE, ORDER BY the key ===
== Query ==
WITH cg AS (
SELECT o.id AS k, COUNT(*) AS n, SUM(l.price) AS s
FROM cgo AS o JOIN cgl AS l ON l.oid = o.id
WHERE l.qty > o.lim + 0
GROUP BY o.id)
SELECT k, n, s FROM cg ORDER BY k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH cg AS (
SELECT o.id AS k, COUNT(*) AS n, SUM(l.price) AS s
FROM cgo AS o JOIN cgl AS l ON l.oid = o.id
WHERE l.qty > o.lim + 0
GROUP BY o.id)
SELECT k, n, s FROM cg ORDER BY k|
k	n	s
1	1	200
2	1	300
3	1	500

