=== cl-1: body ORDER BY n, k LIMIT 2, the drop runs first ===
== Query ==
WITH cl AS (
SELECT o.id AS k, COUNT(*) AS n, SUM(l.price) AS s
FROM cgo AS o JOIN cgl AS l ON l.oid = o.id
WHERE l.qty > o.lim + 0
GROUP BY o.id
ORDER BY n, k
LIMIT 2)
SELECT k, n, s FROM cl ORDER BY k;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH cl AS (
SELECT o.id AS k, COUNT(*) AS n, SUM(l.price) AS s
FROM cgo AS o JOIN cgl AS l ON l.oid = o.id
WHERE l.qty > o.lim + 0
GROUP BY o.id
ORDER BY n, k
LIMIT 2)
SELECT k, n, s FROM cl ORDER BY k|
k	n	s
