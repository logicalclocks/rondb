=== Test 2: CTE body with double-bounded range on indexed column ===
== Query ==
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
FROM ix_orders
WHERE o_grp >= 200 AND o_grp <= 300
GROUP BY o_grp)
