# ttl_nr_copy_window needs NoOfReplicas=2 with exactly 2 data nodes (one
# node group) so that restarting one node triggers a copy-fragment phase
# from the surviving replica.  Reuse the canonical 2-replica NDB config
# (same as ttl_node_restart_copyfrag and ttl_nr_copy_churn).
!include suite/ndb/my_2rpl.cnf
