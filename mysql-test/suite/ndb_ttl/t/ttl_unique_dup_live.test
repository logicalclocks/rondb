# ==========================================================================
# Bug #2: UNIQUE constraint silently bypassed on a TTL table (live owner)
# ==========================================================================
#
# Root cause (whole-path review 2026-06-29): a DBACC<->DBTUP is_ttl_table
# ASYMMETRY.
#   * Dblqh::is_ttl_table(table_id) (DblqhMain.cpp) returns the PRIMARY
#     table's TTL status for an internal index table (primaryTableId branch).
#     DBACC uses this, so on the unique-index table of a TTL base table it
#     treats the index as a TTL table and converts a duplicate index ZINSERT
#     into ZINSERT_TTL (the TTL insert-on-duplicate upsert), DbaccMain.cpp:1490.
#   * Dbtup::is_ttl_table(Tablerec*) (Dbtup.hpp) instead checks the index
#     table's OWN m_ttl_sec (= RNIL for an internal index), so DBTUP skips
#     checkTTL and applies the converted op as an UNCHECKED in-place update of
#     the index entry.
#   => the duplicate-key (1062) rejection is bypassed.
#
# Fix (B, "strict unique index"): DBLQH suppresses the upsert conversion for a
# TTL table's internal UNIQUE-index tables, so a duplicate surfaces as the
# normal 630 -> ZNOTUNIQUE(893) -> ER_DUP_ENTRY.
#
# These cases are fully deterministic (long TTL: the owner stays live), and
# cover single-column, composite (multi-column) and NULL unique values.
# --------------------------------------------------------------------------

--source include/have_ndb.inc

# TTL expiry is evaluated in the data node against UTC; pin the session to UTC
# so the freshly-inserted rows are unambiguously NOT expired (live owner).
SET time_zone = '+00:00';

--echo # ---- Case 1: single-column unique, duplicate vs a LIVE owner ----
CREATE TABLE t1 (
  id      INT PRIMARY KEY,
  ttl_col DATETIME,
  u       INT,
  UNIQUE KEY ux (u)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";

--echo # live owner of unique value 100 (TTL=3600s, nowhere near expiry)
INSERT INTO t1 VALUES (1, NOW(), 100);

--echo # second row with the SAME unique value while the owner is LIVE:
--echo # must be rejected with a duplicate-key error
--error ER_DUP_ENTRY
INSERT INTO t1 VALUES (2, NOW(), 100);

--echo # the unique constraint must hold: only id=1 is present, and a lookup
--echo # by the unique value returns exactly one row
SELECT id, u FROM t1 ORDER BY id;
SELECT id, u FROM t1 WHERE u = 100;

DROP TABLE t1;

--echo # ---- Case 2: composite (multi-column) unique, duplicate vs LIVE owner ----
CREATE TABLE t2 (
  id      INT PRIMARY KEY,
  ttl_col DATETIME,
  a       INT,
  b       INT,
  UNIQUE KEY ux (a, b)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";

INSERT INTO t2 VALUES (1, NOW(), 10, 20);

--echo # the SAME (a,b) tuple while the owner is LIVE must be rejected
--error ER_DUP_ENTRY
INSERT INTO t2 VALUES (2, NOW(), 10, 20);

--echo # a tuple that differs in one component is accepted
INSERT INTO t2 VALUES (3, NOW(), 10, 21);

SELECT id, a, b FROM t2 ORDER BY id;

DROP TABLE t2;

--echo # ---- Case 3: NULL in unique column -- multiple NULLs allowed ----
CREATE TABLE t3 (
  id      INT PRIMARY KEY,
  ttl_col DATETIME,
  u       INT,
  UNIQUE KEY ux (u)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";

--echo # NULL unique values do not collide (SQL NULL uniqueness semantics):
--echo # the fix must not turn NULLs into spurious duplicates
INSERT INTO t3 VALUES (1, NOW(), NULL);
INSERT INTO t3 VALUES (2, NOW(), NULL);
INSERT INTO t3 VALUES (3, NOW(), 100);

--echo # a non-NULL duplicate against the live owner is still rejected
--error ER_DUP_ENTRY
INSERT INTO t3 VALUES (4, NOW(), 100);

SELECT id, u FROM t3 ORDER BY id;

DROP TABLE t3;
