# Two data nodes in ONE node group (NoOfReplicas=2): restarting a single data
# node is recovered by copy-fragment from its surviving replica. Explicit data
# node ids populate $NDB_NDBD_1_NODEID / $NDB_NDBD_2_NODEID so the test can stop
# and restart exactly one node.
!include include/default_mysqld.cnf
!include include/default_ndbd.cnf

[cluster_config.1]
ndbd=,
ndb_mgmd=
mysqld=,
ndbapi=,,,,,,,,,,,
DefaultOperationRedoProblemAction=queue
NoOfReplicas=2
SchemaMemory=80M
DataMemory=200M

[cluster_config.ndbd.1.1]
NodeId=1

[cluster_config.ndbd.2.1]
NodeId=2

[cluster_config.ndb_mgmd.1.1]
NodeId=3

[cluster_config.mysqld.1.1]
NodeId=449

[cluster_config.mysqld.2.1]
NodeId=416

[cluster_config.ndbapi.1.1]
NodeId=432

[cluster_config.ndbapi.2.1]
NodeId=448

[cluster_config.ndbapi.3.1]
NodeId=463

[cluster_config.ndbapi.4.1]
NodeId=1274

[cluster_config.ndbapi.5.1]
NodeId=1924

[cluster_config.ndbapi.6.1]
NodeId=1228

[cluster_config.ndbapi.12.1]
NodeId=2039

[mysqld]
ndbcluster
ndb-wait-connected=30
ndb-wait-setup=120
ndb-cluster-connection-pool=3
ndb-extra-logging=99
log-error-verbosity=3
ndb-join-pushdown=1
local-infile=true

[mysqld.1.1]
ndb-cluster-connection-pool-nodeids=449,463,1274
skip-log-bin
skip-log-replica-updates

[mysqld.2.1]
ndb-cluster-connection-pool-nodeids=416,432,448
skip-log-bin
skip-log-replica-updates

[ENV]
NDB_CONNECTSTRING=             @mysql_cluster.1.ndb_connectstring
NDB_NDBD_1_NODEID=             @cluster_config.ndbd.1.1.NodeId
NDB_NDBD_2_NODEID=             @cluster_config.ndbd.2.1.NodeId
MASTER_MYSOCK=                 @mysqld.1.1.socket
MASTER_MYPORT=                 @mysqld.1.1.port
MASTER_MYPORT1=                @mysqld.2.1.port
NDB_BACKUP_DIR=                @cluster_config.ndbd.1.1.BackupDataDir
