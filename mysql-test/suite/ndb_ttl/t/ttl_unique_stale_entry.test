# ==========================================================================
# Stale unique-index entries after insert-over-expired changing the value.
#
# An INSERT over an expired-but-unpurged row (ZINSERT_TTL) physically
# updates the base row in place, but its unique-index maintenance used to
# fire as TE_INSERT (add-only): when the refresh CHANGED a unique value the
# old value's index entry was left behind with no reclaimer (the purge only
# removes expired BASE rows). Consequences before the fix:
#   (a) a unique lookup of the OLD value returned the refreshed row (a row
#       whose column value does not match the lookup!)
#   (b) another row could never reuse the old value (spurious ER_DUP_ENTRY
#       from the same-owner check) -- even after the owner row was DELETEd
#       (the delete removes only the CURRENT value's entry, orphaning the
#       stale one forever)
# The fix fires SECONDARY_INDEX maintenance for ZINSERT_TTL with UPDATE
# semantics (delete the old-value entry from the before-image + insert the
# new one; unchanged values suppressed), in both the immediate and the
# deferred (ndb_deferred_constraints=1) paths.
#
# Phase 4 guards what must NOT change: a DIFFERENT row inserting the unique
# value of an expired-unpurged row is still rejected (same-owner check), and
# a same-value refresh still works.
# ==========================================================================

--source include/have_ndb.inc

SET time_zone = '+00:00';

--disable_warnings
DROP TABLE IF EXISTS test.stale;
--enable_warnings

CREATE TABLE test.stale (
  col_a INT PRIMARY KEY,
  col_b TIMESTAMP NULL DEFAULT NULL,
  col_c INT,
  UNIQUE KEY uk_c (col_c)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=2@col_b";

--echo #
--echo # Phase 1 (immediate path): refresh-over-expired changing the unique
--echo # value must delete the old value's index entry
--echo #
INSERT INTO test.stale VALUES (1, NOW(), 100);

--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.stale WHERE col_a = 1
--let $ttl_wait_timeout = 20
--source suite/ndb_ttl/include/ttl_wait_expired.inc

INSERT INTO test.stale VALUES (1, NOW(), 200);

--echo # UK lookup of the NEW value returns the refreshed row:
SELECT col_a, col_c FROM test.stale WHERE col_c = 200;
--echo # UK lookup of the OLD value is empty (was: returned (1,200)):
SELECT col_a, col_c FROM test.stale WHERE col_c = 100;
--echo # The old value is reusable by another row (was: ER_DUP_ENTRY):
INSERT INTO test.stale VALUES (5, NOW(), 100);
SELECT col_a, col_c FROM test.stale ORDER BY col_a;

--echo #
--echo # Phase 2: deleting the refreshed owner leaves no orphaned entry
--echo #
DELETE FROM test.stale WHERE col_a = 1;
--echo # The deleted row's value is immediately reusable (was: ER_DUP_ENTRY
--echo # against the orphaned stale entry, even on an empty table):
INSERT INTO test.stale VALUES (9, NOW(), 200);
SELECT col_a, col_c FROM test.stale ORDER BY col_a;
DELETE FROM test.stale;

--echo #
--echo # Phase 3 (deferred path): same refresh with ndb_deferred_constraints=1
--echo #
SET ndb_deferred_constraints = 1;

INSERT INTO test.stale VALUES (21, NOW(), 2100);

--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.stale WHERE col_a = 21
--let $ttl_wait_timeout = 20
--source suite/ndb_ttl/include/ttl_wait_expired.inc

INSERT INTO test.stale VALUES (21, NOW(), 2200);

--echo # UK lookup of the OLD value is empty (deferred path):
SELECT col_a, col_c FROM test.stale WHERE col_c = 2100;
--echo # UK lookup of the NEW value returns the refreshed row:
SELECT col_a, col_c FROM test.stale WHERE col_c = 2200;
--echo # The old value is reusable (deferred path):
INSERT INTO test.stale VALUES (25, NOW(), 2100);
SELECT col_a, col_c FROM test.stale ORDER BY col_a;

SET ndb_deferred_constraints = 0;
DELETE FROM test.stale;

--echo #
--echo # Phase 4: preserved semantics
--echo #
INSERT INTO test.stale VALUES (31, NOW(), 3100);

--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.stale WHERE col_a = 31
--let $ttl_wait_timeout = 20
--source suite/ndb_ttl/include/ttl_wait_expired.inc

--echo # A DIFFERENT row inserting the expired-unpurged row's unique value is
--echo # still rejected (same-owner check unchanged):
--error ER_DUP_ENTRY
INSERT INTO test.stale VALUES (35, NOW(), 3100);
--echo # The owner itself can still refresh with the SAME value (suppressed
--echo # maintenance; entry untouched):
INSERT INTO test.stale VALUES (31, NOW(), 3100);
SELECT col_a, col_c FROM test.stale WHERE col_c = 3100;
SELECT col_a, col_c FROM test.stale ORDER BY col_a;

DROP TABLE test.stale;
