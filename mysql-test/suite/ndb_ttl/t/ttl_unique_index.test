# ttl_unique_index.test
#
# UNIQUE INDEX tests for TTL functionality (Cases 47, 50, 53).
# Migrated from ttl_test_suite.py (UNIQUE_INDEX category).
#
# Case 47: Unique index behavior with TTL -- insert, expire, re-insert same
#          unique value on different PK.
# Case 50: ALTER TABLE ADD UNIQUE INDEX on a TTL table, then TTL=OFF.
# Case 53: ALTER TABLE ADD INDEX (non-unique) on a TTL table, then TTL=OFF.
#
# Table: test.sz  (col_a INT PK, col_b TIMESTAMP TTL=5s, col_c INT UNIQUE)
# Table: test.sz1 (col_a INT PK, col_b TIMESTAMP TTL=5s, col_c INT) -- no
#        unique index initially; created per-case for Cases 50 & 53.
#
# The Python originals used requires_replica=True, but the replica aspect is
# NDB internal replication (FULLY_REPLICATED), not MySQL binlog replication.
# For this single-cluster ndb_ttl suite the tests are adapted so that both
# conn_a and conn_b connect to the same MySQL server.

--source include/have_ndb.inc
--source suite/ndb_ttl/include/ttl_create_table.inc

# Establish two sessions against the same MySQL server
connect (conn_a, localhost, root,,test,$MASTER_MYPORT,);
connect (conn_b, localhost, root,,test,$MASTER_MYPORT,);

###############################################################################
--echo #
--echo # Case 47: Unique index + TTL -- expired-but-unpurged value not reusable
--echo #
# Strict unique-index TTL semantics (Bug #2 fix): a row that has expired is still
# physically present (and still holds its unique value in the index) until the
# RDRS purge removes it. Reusing that unique value on a NEW primary key must be
# rejected with ER_DUP_ENTRY until the purge runs. No purge worker runs in this
# suite, so the expired owner's unique value stays reserved for the whole test.
#
# Thread A: INSERT PK=1 col_c=100, wait for TTL expiry, then attempt to reuse
#           col_c=100 on PK=2 -> must fail ER_DUP_ENTRY (owner still holds it).
# Thread B: verifies PK=1 visible before expiry and that PK=2 never appears.
###############################################################################

connection default;
DELETE FROM sz;

# --- Thread A: Insert first row (live owner of unique value 100) ---
connection conn_a;
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
COMMIT;

# --- Thread B: Verify PK=1 visible (before TTL) ---
connection conn_b;
SELECT col_a, col_c FROM sz WHERE col_a = 1;

# --- Wait for the owner (PK=1) to expire (TTL=5s) ---
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.sz WHERE col_a = 1
--let $ttl_wait_timeout = 15
--source suite/ndb_ttl/include/ttl_wait_expired.inc

# --- Thread A: the owner is now expired/invisible but NOT purged, so its unique
#     value 100 is still held in the index. Reusing 100 on a new PK must be
#     rejected with ER_DUP_ENTRY (strict unique-index TTL semantics). ---
connection conn_a;
SELECT col_a, col_c FROM sz WHERE col_a = 1;
--error ER_DUP_ENTRY
INSERT INTO sz VALUES(2, SYSDATE(), 100);

# The rejected insert is fully rolled back: PK=2 is absent.
SELECT col_a, col_c FROM sz WHERE col_a = 2;

# --- Thread B: also sees no PK=2 ---
connection conn_b;
SELECT col_a, col_c FROM sz WHERE col_a = 2;

# Cleanup
connection default;
DELETE FROM sz;

###############################################################################
--echo #
--echo # Case 50: ALTER TABLE ADD UNIQUE INDEX with TTL
--echo #
# Create sz1 WITHOUT unique index.
# Thread A: INSERT 4 rows (PK 1-4, col_c 100-400).
#   Row 3 has far-future timestamp (1 day ahead) so it survives TTL.
#   Wait for TTL -- rows 1,2,4 expire; row 3 survives.
#   ALTER TABLE ADD UNIQUE INDEX uk(col_c).
#   Verify via unique index lookups: only col_c=300 returns a row.
#   ALTER TABLE COMMENT to TTL=OFF.
#   Verify all 4 rows visible again (expired rows not purged).
# Thread B: After TTL=OFF, verify all 4 rows visible via index.
###############################################################################

--disable_warnings
DROP TABLE IF EXISTS test.sz1;
--enable_warnings

CREATE TABLE test.sz1 (
    col_a INT,
    col_b TIMESTAMP,
    col_c INT,
    PRIMARY KEY(col_a)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=TTL=66@col_b";

sleep 3;

ALTER TABLE test.sz1 COMMENT="NDB_TABLE=TTL=5@col_b";

sleep 3;

# --- Thread A: Insert 4 rows ---
connection conn_a;
BEGIN;
INSERT INTO sz1 VALUES(1, SYSDATE(), 100);
INSERT INTO sz1 VALUES(2, SYSDATE(), 200);
INSERT INTO sz1 VALUES(3, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 300);
INSERT INTO sz1 VALUES(4, SYSDATE(), 400);
COMMIT;

# Verify all 4 inserted
SELECT COUNT(*) FROM sz1;

# Wait for TTL -- rows 1,2,4 expire; row 3 survives (far-future timestamp)
--let $ttl_wait_condition = SELECT COUNT(*) = 1 FROM test.sz1
--let $ttl_wait_timeout = 15
--source suite/ndb_ttl/include/ttl_wait_expired.inc

SELECT COUNT(*) FROM sz1;
SELECT col_a FROM sz1;

# ADD UNIQUE INDEX on col_c
ALTER TABLE sz1 ADD UNIQUE INDEX uk(col_c);

# Verify via table scan: still 1 row
SELECT COUNT(*) FROM sz1;

# Verify via unique index lookups
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;

# Turn TTL OFF -- all 4 rows become visible again (not purged)
ALTER TABLE sz1 COMMENT="NDB_TABLE=TTL=OFF";

SELECT COUNT(*) FROM sz1;
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;

# --- Thread B: Verify after TTL=OFF ---
connection conn_b;
SELECT COUNT(*) FROM sz1;
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;

# Cleanup
connection default;
--disable_warnings
DROP TABLE IF EXISTS test.sz1;
--enable_warnings

###############################################################################
--echo #
--echo # Case 53: ALTER TABLE ADD INDEX (non-unique) with TTL
--echo #
# Same as Case 50 but with a non-unique (ordered) index instead of UNIQUE.
# Create sz1 WITHOUT secondary index.
# Thread A: INSERT 4 rows, wait for TTL, ADD INDEX, verify, TTL=OFF.
# Thread B: After TTL=OFF, verify all 4 rows visible via index.
###############################################################################

--disable_warnings
DROP TABLE IF EXISTS test.sz1;
--enable_warnings

CREATE TABLE test.sz1 (
    col_a INT,
    col_b TIMESTAMP,
    col_c INT,
    PRIMARY KEY(col_a)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=TTL=66@col_b";

sleep 3;

ALTER TABLE test.sz1 COMMENT="NDB_TABLE=TTL=5@col_b";

sleep 3;

# --- Thread A: Insert 4 rows ---
connection conn_a;
BEGIN;
INSERT INTO sz1 VALUES(1, SYSDATE(), 100);
INSERT INTO sz1 VALUES(2, SYSDATE(), 200);
INSERT INTO sz1 VALUES(3, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 300);
INSERT INTO sz1 VALUES(4, SYSDATE(), 400);
COMMIT;

# Verify all 4 inserted
SELECT COUNT(*) FROM sz1;

# Wait for TTL -- rows 1,2,4 expire; row 3 survives (far-future timestamp)
--let $ttl_wait_condition = SELECT COUNT(*) = 1 FROM test.sz1
--let $ttl_wait_timeout = 15
--source suite/ndb_ttl/include/ttl_wait_expired.inc

SELECT COUNT(*) FROM sz1;
SELECT col_a FROM sz1;

# ADD INDEX (non-unique) on col_c
ALTER TABLE sz1 ADD INDEX uk(col_c);

# Verify via table scan: still 1 row
SELECT COUNT(*) FROM sz1;

# Verify via index lookups
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;

# Turn TTL OFF -- all 4 rows become visible again (not purged)
ALTER TABLE sz1 COMMENT="NDB_TABLE=TTL=OFF";

SELECT COUNT(*) FROM sz1;
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;

# --- Thread B: Verify after TTL=OFF ---
connection conn_b;
SELECT COUNT(*) FROM sz1;
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;

# Cleanup
connection default;
--disable_warnings
DROP TABLE IF EXISTS test.sz1;
--enable_warnings

###############################################################################
# Final cleanup
###############################################################################

connection default;
disconnect conn_a;
disconnect conn_b;
DROP TABLE test.sz;
