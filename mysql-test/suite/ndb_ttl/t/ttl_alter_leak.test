# ttl_alter_leak.test
#
# Reproducer for AlterTabOperation pool leak in DBTUP for TTL-only ALTER TABLE.
#
# Each TTL-only ALTER TABLE seizes an AlterTabOperation record in DBTUP's
# handleAlterTablePrepare() but handleAlterTableCommit() never releases it.
# The pool has 16 records per DBTUP instance (cnoOfAlterTabOps = 16).
# After 16 TTL-only ALTERs, the 17th exhausts the pool and crashes data nodes
# with "Pointer too large" (error 2306) at DbtupMeta.cpp:1100.
#
# Before fix: Data nodes crash around the 17th ALTER.
# After fix: All ALTERs succeed.

--source include/have_ndb.inc

--echo #
--echo # Part 1: TTL-only ALTERs (pool leak reproducer)
--echo #

CREATE TABLE test.t1 (
    col_a INT,
    col_b TIMESTAMP,
    col_c INT,
    PRIMARY KEY(col_a)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=TTL=66@col_b";

# Do 20 TTL-only ALTERs to exhaust the AlterTabOperation pool (size 16).
# Alternate between TTL=5 and TTL=10 so each ALTER actually changes the value.

ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
# -- 16 ALTERs done, pool should be exhausted without the fix --
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";

--echo # All 20 TTL-only ALTERs succeeded

--echo #
--echo # Part 2: Combined AddAttr+TTL ALTERs
--echo #

# ADD COLUMN + TTL change in a single ALTER (sets both AddAttr and TTL flags).
# This exercises the combined path in handleAlterTableCommit.

ALTER TABLE test.t1 ADD COLUMN col_d INT, COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 ADD COLUMN col_e INT, COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 ADD COLUMN col_f INT, COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 ADD COLUMN col_g INT, COMMENT="NDB_TABLE=TTL=10@col_b";

--echo # All 4 combined AddAttr+TTL ALTERs succeeded

# Verify the table structure is correct after all ALTERs.
SELECT col_a, col_b, col_c, col_d, col_e, col_f, col_g FROM test.t1;

--echo #
--echo # Part 3: More TTL-only ALTERs after combined ALTERs
--echo #

# Ensure the pool is not exhausted after mixed operations.
# Another 20 TTL-only ALTERs to prove no cumulative leak.

ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";

--echo # All 20 post-combined TTL-only ALTERs succeeded

DROP TABLE test.t1;
