# ttl_nr_copy_churn needs NoOfReplicas=2 with exactly 2 data nodes (one node
# group) so that restarting one node triggers a copy-fragment phase from the
# surviving replica, plus enough DataMemory headroom for the churn volume.
# Reuse the canonical 2-replica NDB config (same as ttl_node_restart_copyfrag).
!include suite/ndb/my_2rpl.cnf
