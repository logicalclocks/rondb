# ttl_backup_metadata.test
#
# Cases 46c, 46d: TTL metadata preservation after backup/restore.
#
# Case 46c: TTLMetadataPreserved
#   Insert after restore still expires -> TTL is active on restored table.
#
# Case 46d: NullTTLColumnSurvives
#   Rows with NULL TTL column (never-expire) survive backup/restore cycle.
#
# NOTE: COUNT(*) uses an NDB access path that bypasses TTL filtering.
# All row-existence checks use SELECT col_a ... instead.

--source include/have_ndb.inc
--source suite/ndb_ttl/include/ttl_backup_restore_setup.inc

--disable_warnings
DROP DATABASE IF EXISTS ttl_backup;
--enable_warnings

CREATE DATABASE ttl_backup;

###############################################################################
# Case 46c: TTL metadata preserved - insert after restore still expires
###############################################################################

--echo #
--echo # Case 46c: TTL metadata preserved after backup/restore
--echo #

CREATE TABLE ttl_backup.sz1 (
    col_a INT,
    col_b TIMESTAMP,
    col_c INT,
    PRIMARY KEY(col_a),
    UNIQUE KEY(col_c)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=TTL=66@col_b";

sleep 3;
ALTER TABLE ttl_backup.sz1 COMMENT="NDB_TABLE=TTL=10@col_b";
sleep 3;

# Insert 1 future row (will survive TTL)
INSERT INTO ttl_backup.sz1 VALUES(1, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 100);
SELECT col_a, col_c FROM ttl_backup.sz1;

# Backup
--source include/ndb_backup.inc

# Drop and restore
DROP DATABASE ttl_backup;
sleep 3;

--exec $NDB_RESTORE -b $the_backup_id -n 1 -m --disable-indexes --include-databases=ttl_backup $NDB_BACKUPS-$the_backup_id >> $NDB_TOOLS_OUTPUT 2>&1
--exec $NDB_RESTORE -b $the_backup_id -n 1 -r --include-databases=ttl_backup $NDB_BACKUPS-$the_backup_id >> $NDB_TOOLS_OUTPUT 2>&1
--exec $NDB_RESTORE -b $the_backup_id -n 2 -r --include-databases=ttl_backup $NDB_BACKUPS-$the_backup_id >> $NDB_TOOLS_OUTPUT 2>&1
--exec $NDB_RESTORE -b $the_backup_id -n 1 --rebuild-indexes --include-databases=ttl_backup $NDB_BACKUPS-$the_backup_id >> $NDB_TOOLS_OUTPUT 2>&1

# Create database on mysqld side to enable NDB table discovery
--disable_warnings
CREATE DATABASE IF NOT EXISTS ttl_backup;
--enable_warnings

--let $ttl_sync_db = ttl_backup
--let $ttl_sync_table = sz1
--source suite/ndb_ttl/include/ttl_backup_wait_schema_sync.inc

# Verify restored row is still there
SELECT col_a, col_c FROM ttl_backup.sz1;

# Now insert 2 new rows: 1 SYSDATE (will expire), 1 future (will survive)
INSERT INTO ttl_backup.sz1 VALUES(11, SYSDATE(), 1100);
INSERT INTO ttl_backup.sz1 VALUES(12, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 1200);

# Wait for TTL expiry of row 11 (uses col_a check, not COUNT(*))
--let $ttl_wait_timeout = 20
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM ttl_backup.sz1 WHERE col_a = 11
--source suite/ndb_ttl/include/ttl_wait_expired.inc

# Verify TTL is still active: 2 rows (1 and 12)
SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;

# Cleanup between cases
DROP DATABASE ttl_backup;
--source suite/ndb/include/backup_restore_cleanup.inc

###############################################################################
# Case 46d: NULL TTL column rows survive backup/restore
###############################################################################

--echo #
--echo # Case 46d: NULL TTL column rows survive backup/restore
--echo #

CREATE DATABASE ttl_backup;

CREATE TABLE ttl_backup.sz1 (
    col_a INT,
    col_b TIMESTAMP NULL,
    col_c INT,
    PRIMARY KEY(col_a)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=TTL=66@col_b";

sleep 3;
ALTER TABLE ttl_backup.sz1 COMMENT="NDB_TABLE=TTL=10@col_b";
sleep 3;

# Insert 4 rows: 2 NULL (never expire), 1 SYSDATE (expires), 1 future
INSERT INTO ttl_backup.sz1 VALUES(1, NULL, 100);
INSERT INTO ttl_backup.sz1 VALUES(2, NULL, 200);
INSERT INTO ttl_backup.sz1 VALUES(3, SYSDATE(), 300);
INSERT INTO ttl_backup.sz1 VALUES(4, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 400);

# Wait for TTL expiry of row 3
--let $ttl_wait_timeout = 20
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM ttl_backup.sz1 WHERE col_a = 3
--source suite/ndb_ttl/include/ttl_wait_expired.inc

SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;

# Backup
--source include/ndb_backup.inc

# Drop and restore
DROP DATABASE ttl_backup;
sleep 3;

--exec $NDB_RESTORE -b $the_backup_id -n 1 -m --disable-indexes --include-databases=ttl_backup $NDB_BACKUPS-$the_backup_id >> $NDB_TOOLS_OUTPUT 2>&1
--exec $NDB_RESTORE -b $the_backup_id -n 1 -r --include-databases=ttl_backup $NDB_BACKUPS-$the_backup_id >> $NDB_TOOLS_OUTPUT 2>&1
--exec $NDB_RESTORE -b $the_backup_id -n 2 -r --include-databases=ttl_backup $NDB_BACKUPS-$the_backup_id >> $NDB_TOOLS_OUTPUT 2>&1
--exec $NDB_RESTORE -b $the_backup_id -n 1 --rebuild-indexes --include-databases=ttl_backup $NDB_BACKUPS-$the_backup_id >> $NDB_TOOLS_OUTPUT 2>&1

# Create database on mysqld side to enable NDB table discovery
--disable_warnings
CREATE DATABASE IF NOT EXISTS ttl_backup;
--enable_warnings

--let $ttl_sync_db = ttl_backup
--let $ttl_sync_table = sz1
--source suite/ndb_ttl/include/ttl_backup_wait_schema_sync.inc

# Verify: 3 rows restored (1, 2, 4)
SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;

# Verify NULL col_b rows are present
SELECT col_a FROM ttl_backup.sz1 WHERE col_b IS NULL ORDER BY col_a;

###############################################################################
# Cleanup
###############################################################################

DROP DATABASE ttl_backup;
--remove_file $NDB_TOOLS_OUTPUT
--source suite/ndb/include/backup_restore_cleanup.inc
