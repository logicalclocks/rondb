# ttl_query_thread_lock_queue.test
#
# Committed reads run by a query block (DBQLQH/DBQACC) on rows of a TTL
# table that other transactions hold shared locks on.
#
# Dbacc::accIsLockedLab (key reads) and Dbacc::WhetherSkipTTL (scans that
# meet an expired row) walk the row's lock queue to find out whether the
# reader's transaction holds a lock on the row; if it does, TTL expiry is
# ignored for it. The queue is made of operation records of the LDM
# instance that owns the fragment, and getElement finds the lock owner in
# that instance's pool (m_ldm_instance_used). The walk looked the records
# up in m_curr_acc->oprec_pool instead. For a committed read in a query
# block, m_curr_acc is the query block's own DBQACC, which has no live
# record at those i-values (the LDM's DBACC keeps its first records seized
# for copy fragment locks, DBQACC does not). getValidPtr then failed and
# the data node stopped with error 2341:
#   DBQACC (Line: 2154) Check m_curr_acc->oprec_pool.getValidPtr(loopPtr)
# or the same check on lastOpPtr when two transactions share the lock.
#
# At low load DBTC sends every read to the LDM threads, so an idle cluster
# never runs these reads in a query block. ERROR_INSERT 8318 makes DBTC
# send each read that may use a query thread to a query block. Every read
# below then meets a queued shared lock in a query block, and without the
# fix the first one stops the data node.
#
# Part 1: key reads (accIsLockedLab) of rows that are not expired, with one
#         and with two shared lockers.
# Part 2: index scans (WhetherSkipTTL) and key reads of rows that expired
#         while locked. The locking transaction still sees the rows it has
#         locked; other transactions do not.
#
# Needs a debug (ERROR_INSERT) build, ndbmtd (query blocks) and one data
# node (ttl_query_thread_lock_queue.cnf).

--source include/have_ndb.inc
--source include/have_ndb_debug.inc

# Without query blocks (ndbd) the reads never leave the LDM block and the
# test would pass without testing anything.
let $query_blocks = `SELECT COUNT(*) FROM ndbinfo.threadblocks WHERE block_name = 'DBQLQH'`;
if (!$query_blocks)
{
  --skip Test requires query blocks (ndbmtd)
}

connect (lock1, localhost, root,,test,$MASTER_MYPORT,);
connect (lock2, localhost, root,,test,$MASTER_MYPORT,);
connect (reader, localhost, root,,test,$MASTER_MYPORT,);

--echo #
--echo # Part 1: committed key reads of locked rows that are not expired
--echo #
--connection default
SET time_zone = '+00:00';
CREATE TABLE t1 (
  a INT PRIMARY KEY,
  b TIMESTAMP NOT NULL,
  c INT
) ENGINE = NDB COMMENT = 'NDB_TABLE=TTL=3600@b';
INSERT INTO t1 VALUES
  (1, SYSDATE(), 1), (2, SYSDATE(), 2), (3, SYSDATE(), 3), (4, SYSDATE(), 4),
  (5, SYSDATE(), 5), (6, SYSDATE(), 6), (7, SYSDATE(), 7), (8, SYSDATE(), 8);

--echo # lock1 takes shared locks on rows 1-8 and lock2 on rows 5-8, held
--echo # until commit. They are taken before the error insert is set, so
--echo # they run in the LDM threads.
--connection lock1
BEGIN;
--sorted_result
SELECT a, c FROM t1 WHERE a IN (1,2,3,4,5,6,7,8) FOR SHARE;
--connection lock2
BEGIN;
--sorted_result
SELECT a, c FROM t1 WHERE a IN (5,6,7,8) FOR SHARE;

--echo # Send the reads that may use a query thread to a query block
--exec $NDB_MGM -e "ALL ERROR 8318" > /dev/null

--echo # Committed key reads in a query block. Rows 1-4 have one shared
--echo # locker (lock1), rows 5-8 two (lock1 and lock2).
--connection reader
let $i = 1;
while ($i <= 8)
{
  --eval SELECT a, c FROM t1 WHERE a = $i
  --inc $i
}

--echo # The lockers' own committed key reads
--connection lock1
SELECT a, c FROM t1 WHERE a = 3;
SELECT a, c FROM t1 WHERE a = 7;
--connection lock2
SELECT a, c FROM t1 WHERE a = 7;

--exec $NDB_MGM -e "ALL ERROR 0" > /dev/null
--connection lock1
COMMIT;
--connection lock2
COMMIT;

--echo #
--echo # Part 2: committed reads of locked rows that expired while locked
--echo #
--connection default
CREATE TABLE t2 (
  a INT PRIMARY KEY,
  b TIMESTAMP NOT NULL,
  c INT
) ENGINE = NDB COMMENT = 'NDB_TABLE=TTL=5@b';
INSERT INTO t2 VALUES
  (1, SYSDATE(), 1), (2, SYSDATE(), 2), (3, SYSDATE(), 3),
  (4, SYSDATE(), 4), (5, SYSDATE(), 5), (6, SYSDATE(), 6);

--echo # lock1 takes shared locks on rows 1-3 and lock2 on row 3
--connection lock1
BEGIN;
--sorted_result
SELECT a, c FROM t2 WHERE a IN (1,2,3) FOR SHARE;
--connection lock2
BEGIN;
SELECT a, c FROM t2 WHERE a = 3 FOR SHARE;

--echo # Let all rows expire (TTL=5) while the locks are held
--connection default
sleep 7;

--exec $NDB_MGM -e "ALL ERROR 8318" > /dev/null

--echo # Committed index scans in a query block meet the expired rows, rows
--echo # 1-3 locked. Each transaction sees the expired rows it has locked.
--connection lock1
--sorted_result
SELECT a, c FROM t2 FORCE INDEX (PRIMARY) WHERE a BETWEEN 1 AND 6;
SELECT a, c FROM t2 WHERE a = 2;
--connection lock2
--sorted_result
SELECT a, c FROM t2 FORCE INDEX (PRIMARY) WHERE a BETWEEN 1 AND 6;
SELECT a, c FROM t2 WHERE a = 3;
--connection reader
SELECT COUNT(*) FROM t2 FORCE INDEX (PRIMARY) WHERE a BETWEEN 1 AND 6;
SELECT COUNT(*) FROM t2 WHERE a = 2;
SELECT COUNT(*) FROM t2 WHERE a = 3;

--exec $NDB_MGM -e "ALL ERROR 0" > /dev/null
--connection lock1
COMMIT;
--connection lock2
COMMIT;

--echo # With the locks released the rows are expired for everyone
--connection default
SELECT COUNT(*) FROM t2;

DROP TABLE t1, t2;
--disconnect lock1
--disconnect lock2
--disconnect reader
