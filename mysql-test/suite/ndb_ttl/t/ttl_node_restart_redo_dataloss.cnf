# REDO-replay data-loss repro: 2 data nodes with NoOfReplicas=1 (two node
# groups). With a single replica a SYSTEM restart recovers every node purely
# from its own LCP + REDO (there is NO copy-fragment phase), so the logged
# refresh UPDATE is replayed locally -- which is exactly the path under test.
# TimeBetweenLocalCheckpoints is maxed so no AUTO LCP captures the post-refresh
# value during the test window; the one LCP the test needs is forced (dump 7099).
# (Self-contained copy of suite/ndb/my_2rpl.cnf with NoOfReplicas=1.)
!include include/default_mysqld.cnf
!include include/default_ndbd.cnf

[cluster_config.1]
ndbd=,
ndb_mgmd=
mysqld=,
ndbapi=,,,,,,,,,,,
DefaultOperationRedoProblemAction=queue
NoOfReplicas=1
SchemaMemory=80M
DataMemory=200M
# Maxed so no auto-LCP fires during the ~60s test window (the test forces the
# single LCP it needs via "dump 7099"); a forced LCP ignores this threshold.
TimeBetweenLocalCheckpoints=31

[cluster_config.mysqld.1.1]
NodeId=449

[cluster_config.mysqld.2.1]
NodeId=416

[cluster_config.ndbapi.1.1]
NodeId=432

[cluster_config.ndbapi.2.1]
NodeId=448

[cluster_config.ndbapi.3.1]
NodeId=463

[cluster_config.ndbapi.4.1]
NodeId=1274

[cluster_config.ndbapi.5.1]
NodeId=1924

[cluster_config.ndbapi.6.1]
NodeId=1228

[cluster_config.ndbapi.12.1]
NodeId=2039

[mysqld]
# Make all mysqlds use cluster
ndbcluster
ndb-wait-connected=30
ndb-wait-setup=120
ndb-cluster-connection-pool=3
ndb-extra-logging=99
log-error-verbosity=3
ndb-join-pushdown=1
local-infile=true

[mysqld.1.1]
ndb-cluster-connection-pool-nodeids=449,463,1274
skip-log-bin
skip-log-replica-updates

[mysqld.2.1]
ndb-cluster-connection-pool-nodeids=416,432,448
skip-log-bin
skip-log-replica-updates

[ENV]
NDB_CONNECTSTRING=             @mysql_cluster.1.ndb_connectstring
MASTER_MYSOCK=                 @mysqld.1.1.socket
MASTER_MYPORT=                 @mysqld.1.1.port
MASTER_MYPORT1=                @mysqld.2.1.port

NDB_BACKUP_DIR=                @cluster_config.ndbd.1.1.BackupDataDir
