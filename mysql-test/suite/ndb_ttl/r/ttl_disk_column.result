CREATE LOGFILE GROUP lg_1
ADD UNDOFILE 'lg_1_undofile.dat'
  INITIAL_SIZE 16M
UNDO_BUFFER_SIZE 1M
ENGINE NDB;
CREATE TABLESPACE ts_1
ADD DATAFILE 'ts_1_datafile.dat'
  USE LOGFILE GROUP lg_1
INITIAL_SIZE 64M
ENGINE NDB;
#
# Case 51: Disk column table with ADD UNIQUE INDEX
#
DROP TABLE IF EXISTS test.sz1;
CREATE TABLE test.sz1 (
col_a INT,
col_b TIMESTAMP,
col_c INT,
col_d INT STORAGE DISK,
PRIMARY KEY(col_a)
) TABLESPACE ts_1,
ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE test.sz1 COMMENT="NDB_TABLE=TTL=5@col_b";
BEGIN;
INSERT INTO sz1 VALUES(1, SYSDATE(), 100, 10000);
INSERT INTO sz1 VALUES(2, SYSDATE(), 200, 20000);
INSERT INTO sz1 VALUES(3, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 300, 30000);
INSERT INTO sz1 VALUES(4, SYSDATE(), 400, 40000);
COMMIT;
SELECT COUNT(*) FROM sz1;
COUNT(*)
4
SELECT COUNT(*) FROM sz1;
COUNT(*)
1
SELECT col_a FROM sz1;
col_a
3
ALTER TABLE sz1 ADD UNIQUE INDEX uk(col_c);
SELECT COUNT(*) FROM sz1;
COUNT(*)
1
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
COUNT(*)
0
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
COUNT(*)
0
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
COUNT(*)
1
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;
COUNT(*)
0
ALTER TABLE sz1 COMMENT="NDB_TABLE=TTL=OFF";
SELECT COUNT(*) FROM sz1;
COUNT(*)
4
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
COUNT(*)
1
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
COUNT(*)
1
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
COUNT(*)
1
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;
COUNT(*)
1
SELECT COUNT(*) FROM sz1;
COUNT(*)
4
SELECT COUNT(*) FROM sz1 WHERE col_c = 100;
COUNT(*)
1
SELECT COUNT(*) FROM sz1 WHERE col_c = 200;
COUNT(*)
1
SELECT COUNT(*) FROM sz1 WHERE col_c = 300;
COUNT(*)
1
SELECT COUNT(*) FROM sz1 WHERE col_c = 400;
COUNT(*)
1
DROP TABLE test.sz1;
#
# Case 52: Disk column table ALTER restrictions
#
DROP TABLE IF EXISTS test.sz1;
CREATE TABLE test.sz1 (
col_a INT,
col_b TIMESTAMP,
col_c INT,
col_d INT STORAGE DISK,
PRIMARY KEY(col_a)
) TABLESPACE ts_1,
ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE test.sz1 COMMENT="NDB_TABLE=TTL=5@col_b";
BEGIN;
INSERT INTO sz1 VALUES(1, SYSDATE(), 100, 10000);
INSERT INTO sz1 VALUES(2, SYSDATE(), 200, 20000);
INSERT INTO sz1 VALUES(3, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 300, 30000);
INSERT INTO sz1 VALUES(4, SYSDATE(), 400, 40000);
COMMIT;
SELECT COUNT(*) FROM sz1;
COUNT(*)
4
ALTER TABLE sz1 CHANGE COLUMN col_b col_b INT STORAGE DISK;
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'Invalid TTL format, column type must be DATETIME/TIMESTAMP'
ALTER TABLE sz1 STORAGE DISK;
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'TTL column can't be an on-disk column'
SELECT COUNT(*) FROM sz1;
COUNT(*)
1
DROP TABLE test.sz1;
ALTER TABLESPACE ts_1 DROP DATAFILE 'ts_1_datafile.dat';
DROP TABLESPACE ts_1;
DROP LOGFILE GROUP lg_1 ENGINE NDB;
