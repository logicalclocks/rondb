# TTL = RNIL (4294967040) must be rejected on CREATE (not silently stored
# as the no-TTL sentinel).
CREATE TABLE test.sz (
a INT PRIMARY KEY,
b TIMESTAMP NULL DEFAULT NULL
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=4294967040@b";
