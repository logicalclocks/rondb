#
# Part 1: TTL-only ALTERs (pool leak reproducer)
#
CREATE TABLE test.t1 (
col_a INT,
col_b TIMESTAMP,
col_c INT,
PRIMARY KEY(col_a)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=5@col_b";
ALTER TABLE test.t1 COMMENT="NDB_TABLE=TTL=10@col_b";
