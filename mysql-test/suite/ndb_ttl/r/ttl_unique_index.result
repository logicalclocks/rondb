DROP TABLE IF EXISTS test.sz;
CREATE TABLE test.sz (
col_a INT,
col_b TIMESTAMP,
col_c INT,
PRIMARY KEY(col_a),
UNIQUE KEY(col_c)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE test.sz COMMENT="NDB_TABLE=TTL=5@col_b";
#
# Case 47: Unique index behavior with TTL and re-insert
#
DELETE FROM sz;
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
COMMIT;
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	100
SELECT COUNT(*) FROM sz;
COUNT(*)
0
BEGIN;
INSERT INTO sz VALUES(2, SYSDATE(), 100);
COMMIT;
SELECT col_a, col_c FROM sz WHERE col_a = 2;
col_a	col_c
2	100
BEGIN;
INSERT INTO sz VALUES(2, SYSDATE(), 100);
COMMIT;
SELECT COUNT(*) FROM sz;
COUNT(*)
1
SELECT col_a FROM sz WHERE col_a = 2;
col_a
2
SELECT COUNT(*) FROM sz;
COUNT(*)
1
SELECT col_a FROM sz WHERE col_a = 2;
col_a
2
SELECT COUNT(*) FROM sz;
COUNT(*)
0
DELETE FROM sz;
