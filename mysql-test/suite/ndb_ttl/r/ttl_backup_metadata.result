DROP DATABASE IF EXISTS ttl_backup;
CREATE DATABASE ttl_backup;
#
# Case 46c: TTL metadata preserved after backup/restore
#
CREATE TABLE ttl_backup.sz1 (
col_a INT,
col_b TIMESTAMP,
col_c INT,
PRIMARY KEY(col_a),
UNIQUE KEY(col_c)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE ttl_backup.sz1 COMMENT="NDB_TABLE=TTL=10@col_b";
INSERT INTO ttl_backup.sz1 VALUES(1, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 100);
SELECT col_a, col_c FROM ttl_backup.sz1;
col_a	col_c
1	100
DROP DATABASE ttl_backup;
CREATE DATABASE IF NOT EXISTS ttl_backup;
SELECT col_a, col_c FROM ttl_backup.sz1;
col_a	col_c
1	100
INSERT INTO ttl_backup.sz1 VALUES(11, SYSDATE(), 1100);
INSERT INTO ttl_backup.sz1 VALUES(12, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 1200);
SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;
col_a	col_c
1	100
12	1200
DROP DATABASE ttl_backup;
#
# Case 46d: NULL TTL column rows survive backup/restore
#
CREATE DATABASE ttl_backup;
CREATE TABLE ttl_backup.sz1 (
col_a INT,
col_b TIMESTAMP NULL,
col_c INT,
PRIMARY KEY(col_a)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE ttl_backup.sz1 COMMENT="NDB_TABLE=TTL=10@col_b";
INSERT INTO ttl_backup.sz1 VALUES(1, NULL, 100);
INSERT INTO ttl_backup.sz1 VALUES(2, NULL, 200);
INSERT INTO ttl_backup.sz1 VALUES(3, SYSDATE(), 300);
INSERT INTO ttl_backup.sz1 VALUES(4, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 400);
SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;
col_a	col_c
1	100
2	200
4	400
DROP DATABASE ttl_backup;
CREATE DATABASE IF NOT EXISTS ttl_backup;
SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;
col_a	col_c
1	100
2	200
4	400
SELECT col_a FROM ttl_backup.sz1 WHERE col_b IS NULL ORDER BY col_a;
col_a
1
2
DROP DATABASE ttl_backup;
