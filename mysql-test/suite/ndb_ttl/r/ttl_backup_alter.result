DROP DATABASE IF EXISTS ttl_backup;
CREATE DATABASE ttl_backup;
#
# Case 46f: ALTER TTL after backup/restore
#
CREATE TABLE ttl_backup.sz1 (
col_a INT,
col_b TIMESTAMP,
col_c INT,
PRIMARY KEY(col_a)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE ttl_backup.sz1 COMMENT="NDB_TABLE=TTL=10@col_b";
INSERT INTO ttl_backup.sz1 VALUES(1, SYSDATE(), 100);
INSERT INTO ttl_backup.sz1 VALUES(2, DATE_ADD(SYSDATE(), INTERVAL 1 DAY), 200);
SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;
col_a	col_c
1	100
2	200
DROP DATABASE ttl_backup;
CREATE DATABASE IF NOT EXISTS ttl_backup;
SELECT col_a, col_c FROM ttl_backup.sz1;
col_a	col_c
2	200
ALTER TABLE ttl_backup.sz1 COMMENT="NDB_TABLE=TTL=OFF";
SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;
col_a	col_c
1	100
2	200
ALTER TABLE ttl_backup.sz1 COMMENT="NDB_TABLE=TTL=10@col_b";
SELECT col_a, col_c FROM ttl_backup.sz1;
col_a	col_c
2	200
ALTER TABLE ttl_backup.sz1 COMMENT="NDB_TABLE=TTL=86400@col_b";
SELECT col_a, col_c FROM ttl_backup.sz1 ORDER BY col_a;
col_a	col_c
1	100
2	200
DROP DATABASE ttl_backup;
