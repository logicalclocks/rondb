SET time_zone = '+00:00';
DROP TABLE IF EXISTS test.tm;
CREATE TABLE test.tm (
id INT PRIMARY KEY,
a INT,
b INT,
ttl_col TIMESTAMP NULL DEFAULT NULL,
KEY idx_a (a),
KEY idx_b (b)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=2@ttl_col";
INSERT INTO test.tm VALUES
(1, 1, 0, NOW()), (2, 1, 0, NOW()), (3, 1, 0, NOW()), (4, 1, 0, NOW()),
(5, 0, 1, NOW()), (6, 0, 1, NOW()), (7, 0, 1, NOW()), (8, 0, 1, NOW());
#
# The plan must be an index_merge for this test to mean anything.
#
EXPLAIN DELETE /*+ INDEX_MERGE(tm idx_a, idx_b) */ FROM test.tm
WHERE a = 1 OR b = 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	DELETE	tm	p0,p1,p2,p3,p4,p5,p6,p7	index_merge	idx_a,idx_b	idx_a,idx_b	5,5	NULL	#	#	Using sort_union(idx_a,idx_b); Using where; Using pushed condition ((`test`.`tm`.`a` = 1) or (`test`.`tm`.`b` = 1))
Warnings:
Note	1003	delete /*+ INDEX_MERGE(`tm`@`select#1` `idx_a`, `idx_b`) */ from `test`.`tm` where ((`test`.`tm`.`a` = 1) or (`test`.`tm`.`b` = 1))
#
# With the variable ON the DELETE must see and remove all 8 expired
# rows, also through the cloned index_merge readers.
#
SET ttl_expired_rows_visible_in_delete = ON;
DELETE /*+ INDEX_MERGE(tm idx_a, idx_b) */ FROM test.tm
WHERE a = 1 OR b = 1;
SELECT ROW_COUNT() AS deleted_rows;
deleted_rows
8
SET ttl_expired_rows_visible_in_delete = OFF;
DROP TABLE test.tm;
