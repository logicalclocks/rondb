DROP TABLE IF EXISTS test.sz;
CREATE TABLE test.sz (
col_a INT,
col_b TIMESTAMP,
col_c INT,
PRIMARY KEY(col_a),
UNIQUE KEY(col_c)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE test.sz COMMENT="NDB_TABLE=TTL=5@col_b";
#
# Case 30: REPLACE before TTL
#
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
REPLACE INTO sz VALUES(1, SYSDATE(), 200);
COMMIT;
COMMIT;
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	200
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	200
SELECT COUNT(*) FROM sz WHERE col_a = 1;
COUNT(*)
0
DELETE FROM sz;
#
# Case 31: REPLACE when expired
#
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
REPLACE INTO sz VALUES(1, SYSDATE(), 200);
COMMIT;
COMMIT;
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	200
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	200
SELECT COUNT(*) FROM sz WHERE col_a = 1;
COUNT(*)
0
DELETE FROM sz;
#
# Case 32: REPLACE both expire
#
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
REPLACE INTO sz VALUES(1, SYSDATE(), 200);
COMMIT;
COMMIT;
SELECT COUNT(*) FROM sz WHERE col_a = 1;
COUNT(*)
0
SELECT COUNT(*) FROM sz WHERE col_a = 1;
COUNT(*)
0
DELETE FROM sz;
#
# Case 33: ROLLBACK before TTL, REPLACE
#
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
REPLACE INTO sz VALUES(1, SYSDATE(), 200);
ROLLBACK;
COMMIT;
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	200
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	200
SELECT COUNT(*) FROM sz WHERE col_a = 1;
COUNT(*)
0
DELETE FROM sz;
#
# Case 34: ROLLBACK after TTL, REPLACE
#
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
REPLACE INTO sz VALUES(1, SYSDATE(), 200);
ROLLBACK;
COMMIT;
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	200
SELECT col_a, col_c FROM sz WHERE col_a = 1;
col_a	col_c
1	200
SELECT COUNT(*) FROM sz WHERE col_a = 1;
COUNT(*)
0
DELETE FROM sz;
#
# Case 35: ROLLBACK after TTL, both expire
#
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
REPLACE INTO sz VALUES(1, SYSDATE(), 200);
ROLLBACK;
COMMIT;
SELECT COUNT(*) FROM sz WHERE col_a = 1;
COUNT(*)
0
SELECT COUNT(*) FROM sz WHERE col_a = 1;
COUNT(*)
0
DELETE FROM sz;
DROP TABLE test.sz;
