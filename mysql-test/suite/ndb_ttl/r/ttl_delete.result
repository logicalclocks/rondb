DROP TABLE IF EXISTS test.sz;
CREATE TABLE test.sz (
col_a INT,
col_b TIMESTAMP,
col_c INT,
PRIMARY KEY(col_a),
UNIQUE KEY(col_c)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=66@col_b";
ALTER TABLE test.sz COMMENT="NDB_TABLE=TTL=5@col_b";
# -------------------------------------------------------
# Case 19: DELETE succeeds when row not expired
# -------------------------------------------------------
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
DELETE FROM sz WHERE col_a = 1;
COMMIT;
SELECT ROW_COUNT();
ROW_COUNT()
1
COMMIT;
SELECT COUNT(*) FROM sz;
COUNT(*)
0
SELECT COUNT(*) FROM sz;
COUNT(*)
0
DELETE FROM sz;
# -------------------------------------------------------
# Case 20: DELETE finds no row (row expired)
# -------------------------------------------------------
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
DELETE FROM sz WHERE col_a = 1;
COMMIT;
SELECT ROW_COUNT();
ROW_COUNT()
0
COMMIT;
SELECT COUNT(*) FROM sz;
COUNT(*)
0
DELETE FROM sz;
# -------------------------------------------------------
# Case 21: ROLLBACK before TTL, DELETE finds no row
# -------------------------------------------------------
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
DELETE FROM sz WHERE col_a = 1;
ROLLBACK;
SELECT ROW_COUNT();
ROW_COUNT()
0
COMMIT;
SELECT COUNT(*) FROM sz;
COUNT(*)
0
SELECT COUNT(*) FROM sz;
COUNT(*)
0
DELETE FROM sz;
# -------------------------------------------------------
# Case 22: ROLLBACK after TTL, DELETE finds no row
# -------------------------------------------------------
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 100);
BEGIN;
DELETE FROM sz WHERE col_a = 1;
ROLLBACK;
SELECT ROW_COUNT();
ROW_COUNT()
0
COMMIT;
SELECT COUNT(*) FROM sz;
COUNT(*)
0
SELECT COUNT(*) FROM sz;
COUNT(*)
0
DELETE FROM sz;
# -------------------------------------------------------
# Case 27: ttl_expired_rows_visible_in_delete
# -------------------------------------------------------
# Test 1: DELETE FROM sz (full table delete)
BEGIN;
INSERT INTO sz VALUES(1, SYSDATE(), 101);
INSERT INTO sz VALUES(2, SYSDATE(), 102);
INSERT INTO sz VALUES(3, SYSDATE(), 103);
INSERT INTO sz VALUES(4, SYSDATE(), 104);
INSERT INTO sz VALUES(5, SYSDATE(), 105);
COMMIT;
SELECT COUNT(*) FROM sz;
COUNT(*)
5
BEGIN;
DELETE FROM sz;
SELECT ROW_COUNT();
ROW_COUNT()
0
SET ttl_expired_rows_visible_in_delete = ON;
DELETE FROM sz;
SELECT ROW_COUNT();
ROW_COUNT()
5
COMMIT;
SET ttl_expired_rows_visible_in_delete = OFF;
DELETE FROM sz;
# Test 2: DELETE FROM sz WHERE col_a > 1
INSERT INTO sz VALUES(1, SYSDATE(), 101);
INSERT INTO sz VALUES(2, SYSDATE(), 102);
INSERT INTO sz VALUES(3, SYSDATE(), 103);
INSERT INTO sz VALUES(4, SYSDATE(), 104);
INSERT INTO sz VALUES(5, SYSDATE(), 105);
COMMIT;
SELECT COUNT(*) FROM sz;
COUNT(*)
5
BEGIN;
DELETE FROM sz WHERE col_a > 1;
SELECT ROW_COUNT();
ROW_COUNT()
0
SET ttl_expired_rows_visible_in_delete = ON;
DELETE FROM sz WHERE col_a > 1;
SELECT ROW_COUNT();
ROW_COUNT()
4
COMMIT;
SET ttl_expired_rows_visible_in_delete = ON;
DELETE FROM sz;
SET ttl_expired_rows_visible_in_delete = OFF;
