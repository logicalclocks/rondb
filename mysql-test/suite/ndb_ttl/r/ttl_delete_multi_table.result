SET time_zone = '+00:00';
CREATE TABLE t1 (
id INT PRIMARY KEY,
a INT,
ttl_col TIMESTAMP NULL DEFAULT NULL
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=2@ttl_col";
CREATE TABLE t2 (
id INT PRIMARY KEY,
a INT
) ENGINE=NDB;
INSERT INTO t1 VALUES (1, 1, NOW()), (2, 1, NOW()), (3, 2, NOW()),
(4, 2, NOW());
INSERT INTO t2 VALUES (1, 1), (2, 1), (3, 2), (4, 2);
#
# With the variable OFF the expired rows are invisible.
#
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id WHERE t2.a = 1;
SELECT ROW_COUNT() AS deleted_rows;
deleted_rows
0
#
# With the variable ON the multi-table DELETE removes them.
#
SET ttl_expired_rows_visible_in_delete = ON;
DELETE t1 FROM t1 JOIN t2 ON t1.id = t2.id WHERE t2.a = 1;
SELECT ROW_COUNT() AS deleted_rows;
deleted_rows
2
#
# Also when the deleted table is looked up by a constant key.
#
DELETE FROM t1 USING t1, t2 WHERE t1.id = 3 AND t2.id = t1.id;
SELECT ROW_COUNT() AS deleted_rows;
deleted_rows
1
#
# A TTL table that is only read still hides its expired rows.
#
DELETE t2 FROM t2 JOIN t1 ON t1.id = t2.id;
SELECT ROW_COUNT() AS deleted_rows;
deleted_rows
0
SELECT COUNT(*) FROM t2;
COUNT(*)
4
#
# Only row 4 of t1 is left.
#
DELETE FROM t1;
SELECT ROW_COUNT() AS deleted_rows;
deleted_rows
1
SET ttl_expired_rows_visible_in_delete = OFF;
DROP TABLE t1, t2;
