# Per-test config for ttl_rpl_ring_buffer_purge.test.
#
# The ndb_ttl_rpl suite my.cnf plus one REST server (rdrs2, which runs the
# TTL purge) on the source cluster and one on the replica cluster, with free
# API node slots for them, and the UTC time zone for NOW().
!include include/default_mysqld.cnf
!include include/default_ndbd.cnf

[cluster_config]
TimeBetweenEpochsTimeout = 30000

[cluster_config.1]
NoOfReplicas=                  2
ndbd=,
ndb_mgmd=
mysqld=,
ndbapi=,,,,,,,,,,,,
DefaultOperationRedoProblemAction=queue
TransactionDeadlockDetectionTimeout=30000

[cluster_config.slave]
NoOfReplicas=                  1
ndbd=
ndb_mgmd=
mysqld=
ndbapi=,,,,,,,,
DefaultOperationRedoProblemAction=queue
TransactionDeadlockDetectionTimeout=30000

[mysqld]
# Make all mysqlds use cluster
ndbcluster
ndb-wait-connected=30
ndb-wait-setup=120
ndb-cluster-connection-pool=3
replica-allow-batching
ndb-log-bin=1
# Use smaller than default cache size to save resources
ndb-log-cache-size=32768

# Enable load data local functionality
local-infile=true

# Turn on bin logging
log-bin=                       master-bin
# for performance reasons
ndb-table-temporary=1

ndb-extra-logging=99

# Cluster only supports row format
binlog-format=                 row

[cluster_config.mysqld.1.1]
NodeId=49
Dedicated=1

[cluster_config.mysqld.2.1]
NodeId=16
Dedicated=1

[cluster_config.ndbapi.1.1]
NodeId=32
Dedicated=1

[cluster_config.ndbapi.2.1]
NodeId=48
Dedicated=1

[cluster_config.ndbapi.3.1]
NodeId=63
Dedicated=1

[cluster_config.ndbapi.4.1]
NodeId=127
Dedicated=1

[cluster_config.mysqld.1.slave]
NodeId=49
Dedicated=1

[cluster_config.ndbapi.1.slave]
NodeId=32
Dedicated=1

[cluster_config.ndbapi.2.slave]
NodeId=48
Dedicated=1

[cluster_config.ndbapi.3.slave]
NodeId=63
Dedicated=1

[cluster_config.ndbapi.4.slave]
NodeId=127
Dedicated=1

[mysqld.1.1]
ndb-cluster-connection-pool-nodeids=49,32,63
# Tests are written with the assumption that this mysqld does not
# log updates from the slave
skip-log-replica-updates

[mysqld.1.slave]
ndb-cluster-connection-pool-nodeids=49,32,63

# Append <testname>-slave.opt file to the list of argument used when
# starting the mysqld
#!use-slave-opt

log-bin=                      slave-bin
relay-log=                    slave-relay-bin
# Cluster only supports row format
binlog-format=                 row

log-replica-updates

# Values reported by slave when it connect to master
# and shows up in SHOW REPLICA STATUS;
report-host=                  127.0.0.1
report-port=                  @mysqld.1.slave.port
report-user=                  root

skip-replica-start

# Directory where slaves find the dumps generated by "load data"
# on the server. The path need to have constant length otherwise
# test results will vary, thus a relative path is used.
replica-load-tmpdir=            ../../../tmp

[mysqld.2.1]
ndb-cluster-connection-pool-nodeids=16,48,127

[mysqld]
default-time-zone ="+00:00"

# TTL purge REST servers: source and replica cluster
[rdrs.1.1]
config-json-template=suite/ndb_ttl_rpl/rdrs_config_template_source.json
UseHopsworksAPIKeys=false
InsecureAllowAll=true

[rdrs.1.slave]
config-json-template=suite/ndb_ttl_rpl/rdrs_config_template_replica.json
UseHopsworksAPIKeys=false
InsecureAllowAll=true

[ENV]
RDRS_HOST=                    @rdrs.1.1.#host
RDRS_PORT=                    @rdrs.1.1.port
RDRS_REPLICA_HOST=            @rdrs.1.slave.#host
RDRS_REPLICA_PORT=            @rdrs.1.slave.port
NDB_CONNECTSTRING=            @mysql_cluster.1.ndb_connectstring
MASTER_MYPORT=                @mysqld.1.1.port
MASTER_ERRFILE=               @mysqld.1.1.#log-error
MASTER_MYPORT1=               @mysqld.2.1.port
MASTER_ERRFILE1=              @mysqld.2.1.#log-error

NDB_CONNECTSTRING_SLAVE=      @mysql_cluster.slave.ndb_connectstring
SLAVE_MYPORT=                 @mysqld.1.slave.port
SLAVE_MYSOCK=                 @mysqld.1.slave.socket
SLAVE_ERRFILE=                @mysqld.1.slave.#log-error

NDB_BACKUP_DIR=               @cluster_config.ndbd.1.1.BackupDataDir
