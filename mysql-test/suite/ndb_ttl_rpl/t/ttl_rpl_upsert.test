# suite/ndb_ttl_rpl/t/ttl_rpl_upsert.test
#
# TTL binlog replication tests: Cases 39, 40
# Migrated from ttl_test_suite.py (TestCase39BinlogUpsertMultiple,
# TestCase40BinlogFullyReplicatedUpsert)
#
# Topology: master (2 ndbd) -> slave (1 ndbd), binlog row format
#
# TTL = 30 seconds on col_b. A longer TTL than the suite default (10s) is
# used deliberately: Stage 3 relies on the Stage-2 row still being LIVE after
# a replication round-trip (wait_for_ndb_committed_to_binlog + sync_slave),
# and under --parallel=N the sync jitter can exceed a 10s window and expire
# the row early, making the ON DUP KEY UPDATE miss (a false failure). 30s
# leaves a comfortable liveness margin; the Stage-1 in-txn expiry sleeps are
# bumped to stay past the larger TTL (well under TransactionInactiveTimeout).

--source include/have_ndb.inc
--source include/have_binlog_format_row.inc
--source suite/ndb_rpl/ndb_rpl_init_source_replica.inc

--connection master
--let $ttl_rpl_ttl = 30
--source suite/ndb_ttl_rpl/include/ttl_rpl_create_table.inc
--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

###############################################################################
# Case 39: INSERT ON DUPLICATE KEY UPDATE with multiple updates
#
# Stage 1: Two INS ON DUP KEY in one TX -> sleep past TTL -> COMMIT (expired)
# Stage 2: INS ON DUP KEY(col_c=300) -> COMMIT -> sync -> slave sees col_c=300
# Stage 3: INS ON DUP KEY(col_c=400 -> updates to 401) -> sync
#          -> slave sees col_c=401
# Final:   Wait for expiry on both
###############################################################################

--echo #
--echo # Case 39: INSERT ON DUPLICATE KEY UPDATE with replication
--echo #

# Stage 1: Two upserts in one TX, sleep past TTL, COMMIT
--connection master
BEGIN;
INSERT INTO test.sz VALUES(1, SYSDATE(), 100)
  ON DUPLICATE KEY UPDATE col_c = 101;
sleep 3;
INSERT INTO test.sz VALUES(1, SYSDATE(), 200)
  ON DUPLICATE KEY UPDATE col_c = 201;

# Sleep past the 30s TTL so the row expires before COMMIT (margin over TTL).
sleep 35;

# Row visible within transaction
SELECT col_a, col_c FROM test.sz;

COMMIT;

# Row expired after commit
SELECT col_a, col_c FROM test.sz;

--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

# Slave: row expired
--connection slave
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.sz
--source suite/ndb_ttl_rpl/include/ttl_wait_expired.inc

SELECT col_a, col_c FROM test.sz;

# Stage 2: Fresh insert(col_c=300), COMMIT, verify on slave
--connection master
sleep 2;
BEGIN;
INSERT INTO test.sz VALUES(1, SYSDATE(), 300)
  ON DUPLICATE KEY UPDATE col_c = 301;
COMMIT;

SELECT col_a, col_c FROM test.sz;

--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

--connection slave
SELECT col_a, col_c FROM test.sz;

# Stage 3: Upsert that triggers ON DUP KEY UPDATE (col_c=400 -> 401).
# Keep the pre-insert delay small so the Stage-2 row is still live (< TTL).
--connection master
sleep 1;
BEGIN;
INSERT INTO test.sz VALUES(1, SYSDATE(), 400)
  ON DUPLICATE KEY UPDATE col_c = 401;
COMMIT;

SELECT col_a, col_c FROM test.sz;

--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

--connection slave
SELECT col_a, col_c FROM test.sz;

# Final: Wait for expiry on both. Bound the poll to TTL(30s) + ~10s slack so a
# real late-expiry regression still trips --die instead of passing on eventual
# invisibility (do NOT rely on the shared 20s default, which is < TTL here).
--connection master
--let $ttl_wait_timeout = 40
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.sz
--source suite/ndb_ttl_rpl/include/ttl_wait_expired.inc

SELECT col_a, col_c FROM test.sz;

--connection slave
--let $ttl_wait_timeout = 40
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.sz
--source suite/ndb_ttl_rpl/include/ttl_wait_expired.inc

SELECT col_a, col_c FROM test.sz;

# Clean up for next case
--connection master
--disable_warnings
DELETE FROM test.sz;
--enable_warnings
COMMIT;
--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

###############################################################################
# Case 40: FULLY_REPLICATED table with INSERT ON DUPLICATE KEY UPDATE
#
# Uses sz1 table with FULLY_REPLICATED=1 (no PK, no UNIQUE KEY).
# Same operation flow as Case 39 but with FULLY_REPLICATED row counts.
# Note: master with 2 ndbd may show 2 rows; slave with 1 ndbd shows 1 row.
###############################################################################

--echo #
--echo # Case 40: FULLY_REPLICATED table with INSERT ON DUPLICATE KEY UPDATE
--echo #

--connection master
--disable_warnings
DROP TABLE IF EXISTS test.sz1;
--enable_warnings

CREATE TABLE test.sz1 (
    col_a INT,
    col_b TIMESTAMP,
    col_c INT
) ENGINE = NDB,
  COMMENT="NDB_TABLE=FULLY_REPLICATED=1,NOLOGGING=0,TTL=66@col_b";

sleep 3;
ALTER TABLE test.sz1 COMMENT="NDB_TABLE=FULLY_REPLICATED=1,NOLOGGING=0,TTL=30@col_b";
sleep 3;

--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

# Stage 1: Two upserts in one TX, sleep past TTL, COMMIT
--connection master
BEGIN;
INSERT INTO test.sz1 VALUES(1, SYSDATE(), 100)
  ON DUPLICATE KEY UPDATE col_c = 101;
sleep 3;
INSERT INTO test.sz1 VALUES(1, SYSDATE(), 200)
  ON DUPLICATE KEY UPDATE col_c = 201;

# Sleep past the 30s TTL so both rows expire before COMMIT (margin over TTL).
sleep 35;

# Rows visible within transaction (FULLY_REPLICATED: 2 rows on master with 2 ndbd)
SELECT col_a, col_c FROM test.sz1 ORDER BY col_c;

COMMIT;

# Rows expired after commit
SELECT col_a, col_c FROM test.sz1;

--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

# Slave: rows expired
--connection slave
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.sz1
--source suite/ndb_ttl_rpl/include/ttl_wait_expired.inc

SELECT col_a, col_c FROM test.sz1;

# Stage 2: Fresh insert(col_c=300)
--connection master
sleep 2;
BEGIN;
INSERT INTO test.sz1 VALUES(1, SYSDATE(), 300)
  ON DUPLICATE KEY UPDATE col_c = 301;
COMMIT;

SELECT col_a, col_c FROM test.sz1;

--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

--connection slave
SELECT col_a, col_c FROM test.sz1;

# Stage 3: Upsert that may trigger ON DUP KEY UPDATE.
# Keep the pre-insert delay small so the Stage-2 row is still live (< TTL).
--connection master
sleep 1;
BEGIN;
INSERT INTO test.sz1 VALUES(1, SYSDATE(), 400)
  ON DUPLICATE KEY UPDATE col_c = 401;
COMMIT;

SELECT col_a, col_c FROM test.sz1 ORDER BY col_c;

--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

--connection slave
SELECT col_a, col_c FROM test.sz1 ORDER BY col_c;

# Final: Wait for expiry on both. Bound the poll to TTL(30s) + ~10s slack so a
# real late-expiry regression still trips --die instead of passing on eventual
# invisibility (do NOT rely on the shared 20s default, which is < TTL here).
--connection master
--let $ttl_wait_timeout = 40
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.sz1
--source suite/ndb_ttl_rpl/include/ttl_wait_expired.inc

SELECT col_a, col_c FROM test.sz1;

--connection slave
--let $ttl_wait_timeout = 40
--let $ttl_wait_condition = SELECT COUNT(*) = 0 FROM test.sz1
--source suite/ndb_ttl_rpl/include/ttl_wait_expired.inc

SELECT col_a, col_c FROM test.sz1;

###############################################################################
# Cleanup
###############################################################################

--connection master
DROP TABLE test.sz1;
DROP TABLE test.sz;
--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master
--source include/rpl/deinit.inc
