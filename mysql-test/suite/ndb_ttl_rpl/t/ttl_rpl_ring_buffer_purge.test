--source include/have_ndb.inc
--source include/have_binlog_format_row.inc
--source suite/ndb_rpl/ndb_rpl_init_source_replica.inc

# suite/ndb_ttl_rpl/t/ttl_rpl_ring_buffer_purge.test
#
# Replication of the TTL purge, for a ring buffer table with TTL
# (MAX_ROWS_PER_PK + TTL) and a plain TTL table. The other ndb_ttl_rpl tests
# run without a purger; this test's .cnf starts one REST server (rdrs2, the
# purger) on the source cluster and one on the replica cluster.
#   1. Both purges off; seed expired and live rows; the replica has the
#      same physical rows.
#   2. The source purge reclaims the expired rows; its deletes replicate
#      and remove the same rows on the replica (expired there as well), so
#      the replica has the same physical rows; replication keeps running.
#   3. The source rings wrap into their purged slots; the write row events
#      re-create the slots on the replica with the same meta rows.
#   4. The replica's own purge finds nothing left to reclaim.

--source suite/ndb_ttl_purge/include/ttl_purge_setup.inc
--let $source_purge_base = $ttl_purge_base
--let $replica_purge_base = http://$RDRS_REPLICA_HOST:$RDRS_REPLICA_PORT/0.1.0/ttl-purge
--let $replica_put_config = curl -s -X PUT -H "Content-Type: application/json" $replica_purge_base/config -d
--let $replica_get_metrics = curl -s $replica_purge_base/metrics

--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--exec $replica_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2

--connection master
CREATE DATABASE ttl_rrb;
CREATE TABLE ttl_rrb.rb (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col DATETIME,
    data VARCHAR(100),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=5@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rrb.rb (ttl_col);
CREATE TABLE ttl_rrb.t (
    id INT NOT NULL PRIMARY KEY,
    ttl_col DATETIME,
    data VARCHAR(100)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col";
CREATE INDEX ttl_index ON ttl_rrb.t (ttl_col);
--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master
--connection master

# Both purges know the tables
--let $wait_db = ttl_rrb
--let $wait_table = rb
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
--let $wait_table = t
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
--let $ttl_purge_base = $replica_purge_base
--let $wait_table = rb
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
--let $wait_table = t
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
--let $ttl_purge_base = $source_purge_base

--let $phys_rb = SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rrb/def/rb' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rrb/def/rb'
--let $phys_t = SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rrb/def/t' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rrb/def/t'

--echo #
--echo # 1. Seed with both purges off
--echo #

# Ring prefix 1: 3 expired + 2 live (full, next_pos 1); prefix 2: 5 expired
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_exp_1');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_exp_2');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_exp_3');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_live_4');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_live_5');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_1');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_2');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_3');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_4');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_5');
# Plain TTL table: rows 1-3 expired, 4-5 live
INSERT INTO ttl_rrb.t VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 't_exp_1');
INSERT INTO ttl_rrb.t VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 't_exp_2');
INSERT INTO ttl_rrb.t VALUES (3, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 't_exp_3');
INSERT INTO ttl_rrb.t VALUES (4, DATE_ADD(NOW(), INTERVAL 1 HOUR), 't_live_4');
INSERT INTO ttl_rrb.t VALUES (5, DATE_ADD(NOW(), INTERVAL 1 HOUR), 't_live_5');
--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

--connection slave
SELECT client_id, ring_idx, data FROM ttl_rrb.rb ORDER BY client_id, ring_idx;
SELECT id, data FROM ttl_rrb.t ORDER BY id;
--let $rows = `$phys_rb`
--let $assert_text = replica: 12 physical ring rows (2 meta + 10 data)
--let $assert_cond = $rows = 12
--source include/assert.inc
--let $rows = `$phys_t`
--let $assert_text = replica: 5 physical rows in the plain TTL table
--let $assert_cond = $rows = 5
--source include/assert.inc

--echo #
--echo # 2. The source purge reclaims the expired rows; its deletes replicate
--echo #

--connection master
--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rrb_src.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rrb_src.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $base_purged = $json_value
--exec $ttl_purge_put_config '{"enabled":true,"min_batch_size":5,"max_batch_size":50,"sleep_interval_ms":1500}' > /dev/null 2>&1
--let $expected_purge_total = `SELECT $base_purged + 11`
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc
--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2
--let $rows = `$phys_rb`
--let $assert_text = source: 4 physical ring rows after the purge (2 meta + 2 live)
--let $assert_cond = $rows = 4
--source include/assert.inc
--let $rows = `$phys_t`
--let $assert_text = source: 2 physical rows in the plain TTL table after the purge
--let $assert_cond = $rows = 2
--source include/assert.inc
--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

--connection slave
SELECT client_id, ring_idx, data FROM ttl_rrb.rb ORDER BY client_id, ring_idx;
SELECT id, data FROM ttl_rrb.t ORDER BY id;
--let $rows = `$phys_rb`
--let $assert_text = replica: 4 physical ring rows after the replicated purge deletes
--let $assert_cond = $rows = 4
--source include/assert.inc
--let $rows = `$phys_t`
--let $assert_text = replica: 2 physical rows in the plain TTL table after the replicated purge deletes
--let $assert_cond = $rows = 2
--source include/assert.inc
SELECT MAX(LAST_ERROR_NUMBER) AS applier_error FROM performance_schema.replication_applier_status_by_worker;

--echo #
--echo # 3. The source rings wrap into their purged slots
--echo #

--connection master
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_wrap_6');
INSERT INTO ttl_rrb.rb (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p2_wrap_6');
INSERT INTO ttl_rrb.t VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 't_again_1');
SELECT client_id, ring_idx, data FROM ttl_rrb.rb ORDER BY client_id, ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rrb.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;
--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master

--connection slave
SELECT client_id, ring_idx, data FROM ttl_rrb.rb ORDER BY client_id, ring_idx;
SELECT id, data FROM ttl_rrb.t ORDER BY id;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rrb.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;
SELECT MAX(LAST_ERROR_NUMBER) AS applier_error FROM performance_schema.replication_applier_status_by_worker;

--echo #
--echo # 4. The replica's own purge finds nothing left to reclaim
--echo #

--exec $replica_get_metrics > $MYSQL_TMP_DIR/rrb_rep.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rrb_rep.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $base_purged = $json_value
--exec $replica_put_config '{"enabled":true,"min_batch_size":5,"max_batch_size":50,"sleep_interval_ms":1500}' > /dev/null 2>&1
--sleep 10
--exec $replica_get_metrics > $MYSQL_TMP_DIR/rrb_rep2.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rrb_rep2.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $assert_text = replica: its purge reclaimed nothing
--let $assert_cond = $json_value = $base_purged
--source include/assert.inc
--let $rows = `$phys_rb`
--let $assert_text = replica: 6 physical ring rows (2 meta + 4 live), as on the source
--let $assert_cond = $rows = 6
--source include/assert.inc
--let $rows = `$phys_t`
--let $assert_text = replica: 3 physical rows in the plain TTL table, as on the source
--let $assert_cond = $rows = 3
--source include/assert.inc
SELECT client_id, ring_idx, data FROM ttl_rrb.rb ORDER BY client_id, ring_idx;
SELECT id, data FROM ttl_rrb.t ORDER BY id;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rrb.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;

--connection master
--let $rows = `$phys_rb`
--let $assert_text = source: 6 physical ring rows (2 meta + 4 live)
--let $assert_cond = $rows = 6
--source include/assert.inc
--let $rows = `$phys_t`
--let $assert_text = source: 3 physical rows in the plain TTL table
--let $assert_cond = $rows = 3
--source include/assert.inc

--echo #
--echo # Cleanup
--echo #

--connection master
DROP DATABASE ttl_rrb;
--source include/rpl/wait_for_ndb_committed_to_binlog.inc
--sync_slave_with_master
--connection master
--exec $ttl_purge_put_config '{"enabled":true,"min_batch_size":5,"max_batch_size":50,"sleep_interval_ms":1500}' > /dev/null 2>&1
--exec $replica_put_config '{"enabled":true,"min_batch_size":5,"max_batch_size":50,"sleep_interval_ms":1500}' > /dev/null 2>&1
--source suite/ndb_ttl_purge/include/ttl_purge_cleanup_tmp.inc
--source include/rpl/deinit.inc
