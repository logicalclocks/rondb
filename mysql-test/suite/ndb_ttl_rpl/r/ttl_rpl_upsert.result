include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
DROP TABLE IF EXISTS test.sz;
CREATE TABLE test.sz (
col_a INT,
col_b TIMESTAMP,
col_c INT,
PRIMARY KEY(col_a),
UNIQUE KEY(col_c)
) ENGINE = NDB,
COMMENT="NDB_TABLE=NOLOGGING=0,TTL=66@col_b";
ALTER TABLE test.sz COMMENT="NDB_TABLE=NOLOGGING=0,TTL=30@col_b";
#
# Case 39: INSERT ON DUPLICATE KEY UPDATE with replication
#
BEGIN;
INSERT INTO test.sz VALUES(1, SYSDATE(), 100)
ON DUPLICATE KEY UPDATE col_c = 101;
INSERT INTO test.sz VALUES(1, SYSDATE(), 200)
ON DUPLICATE KEY UPDATE col_c = 201;
SELECT col_a, col_c FROM test.sz;
col_a	col_c
1	201
COMMIT;
SELECT col_a, col_c FROM test.sz;
col_a	col_c
SELECT col_a, col_c FROM test.sz;
col_a	col_c
BEGIN;
INSERT INTO test.sz VALUES(1, SYSDATE(), 300)
ON DUPLICATE KEY UPDATE col_c = 301;
COMMIT;
SELECT col_a, col_c FROM test.sz;
col_a	col_c
1	300
SELECT col_a, col_c FROM test.sz;
col_a	col_c
1	300
BEGIN;
INSERT INTO test.sz VALUES(1, SYSDATE(), 400)
ON DUPLICATE KEY UPDATE col_c = 401;
COMMIT;
SELECT col_a, col_c FROM test.sz;
col_a	col_c
1	401
SELECT col_a, col_c FROM test.sz;
col_a	col_c
1	401
SELECT col_a, col_c FROM test.sz;
col_a	col_c
SELECT col_a, col_c FROM test.sz;
col_a	col_c
DELETE FROM test.sz;
COMMIT;
#
# Case 40: FULLY_REPLICATED table with INSERT ON DUPLICATE KEY UPDATE
#
DROP TABLE IF EXISTS test.sz1;
CREATE TABLE test.sz1 (
col_a INT,
col_b TIMESTAMP,
col_c INT
) ENGINE = NDB,
COMMENT="NDB_TABLE=FULLY_REPLICATED=1,NOLOGGING=0,TTL=66@col_b";
ALTER TABLE test.sz1 COMMENT="NDB_TABLE=FULLY_REPLICATED=1,NOLOGGING=0,TTL=30@col_b";
BEGIN;
INSERT INTO test.sz1 VALUES(1, SYSDATE(), 100)
ON DUPLICATE KEY UPDATE col_c = 101;
INSERT INTO test.sz1 VALUES(1, SYSDATE(), 200)
ON DUPLICATE KEY UPDATE col_c = 201;
SELECT col_a, col_c FROM test.sz1 ORDER BY col_c;
col_a	col_c
1	100
1	200
COMMIT;
SELECT col_a, col_c FROM test.sz1;
col_a	col_c
SELECT col_a, col_c FROM test.sz1;
col_a	col_c
BEGIN;
INSERT INTO test.sz1 VALUES(1, SYSDATE(), 300)
ON DUPLICATE KEY UPDATE col_c = 301;
COMMIT;
SELECT col_a, col_c FROM test.sz1;
col_a	col_c
1	300
SELECT col_a, col_c FROM test.sz1;
col_a	col_c
1	300
BEGIN;
INSERT INTO test.sz1 VALUES(1, SYSDATE(), 400)
ON DUPLICATE KEY UPDATE col_c = 401;
COMMIT;
SELECT col_a, col_c FROM test.sz1 ORDER BY col_c;
col_a	col_c
1	300
1	400
SELECT col_a, col_c FROM test.sz1 ORDER BY col_c;
col_a	col_c
1	300
1	400
SELECT col_a, col_c FROM test.sz1;
col_a	col_c
SELECT col_a, col_c FROM test.sz1;
col_a	col_c
DROP TABLE test.sz1;
DROP TABLE test.sz;
