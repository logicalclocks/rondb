# Topology mirror of suite ronsql_fs (RONDB-1121 E8): 4 node groups x 2 replicas (8 data nodes).
# Everything else — DataMemory, CompiledInterpreter=OFF (the interpreter
# arm), the two RDRS instances, node ids — comes from the included file;
# only the data-node count differs (NoOfReplicas stays 2).  Each mirror
# test asserts the topology (COUNT(*) FROM ndbinfo.nodes) before sourcing
# the original, so a mirror can never silently run on the base cluster.
!include suite/ronsql_fs/my.cnf

[cluster_config.1]
ndbd=,,,,,,,
NoOfReplicas=2
