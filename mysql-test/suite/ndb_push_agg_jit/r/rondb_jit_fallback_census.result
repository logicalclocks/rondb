############################################################
# RONDB-1056 JIT fallback census
############################################################
CREATE TABLE t1 (
pk   BIGINT NOT NULL,
a    BIGINT NOT NULL,
b    BIGINT NOT NULL,
u    BIGINT UNSIGNED NOT NULL,
d    DOUBLE NOT NULL,
f    FLOAT NOT NULL,
dec9 DECIMAL(9,2) NOT NULL,
s    VARCHAR(16) NOT NULL,
ch   CHAR(8) NOT NULL,
i    INT NOT NULL,
dt   DATE NOT NULL,
n    BIGINT,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t1 VALUES
(1, 10, 3, 100, 2.5, 0.5, 1.10, 'beta',  'beta',  1, '2026-01-15', NULL),
(2, 20, 4, 200, 3.5, 0.5, 2.20, 'alpha', 'alpha', 2, '2026-02-15', 5),
(3, 30, 5, 300, 4.0, 2.0, 3.30, 'gamma', 'gamma', 3, '2026-03-15', 7),
(4, 40, 6, 400, 6.0, 4.0, 4.40, 'delta', 'delta', 4, '2026-04-15', NULL);
SET ndb_pushdown_aggregate=ON;
#
# ---- Shapes expected to COMPILE (controls) ----
#
# sum_bigint: plain SUM (Phase 4).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a) FROM t1;
SUM(a)
100
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS sum_bigint_fell_back;
sum_bigint_fell_back
0
# case_int: integer CASE aggregation (Phase 5A).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(CASE WHEN a > 25 THEN a ELSE 0 END) FROM t1;
SUM(CASE WHEN a > 25 THEN a ELSE 0 END)
70
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS case_int_fell_back;
case_int_fell_back
0
# sum_double + double division (Phase 5C-2).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(d), SUM(d / f) FROM t1;
SUM(d)	SUM(d / f)
16	15.5
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS double_div_fell_back;
double_div_fell_back
0
# min_max_u64: unsigned MIN/MAX (Phase 5C-3).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT MIN(u), MAX(u) FROM t1;
MIN(u)	MAX(u)
100	400
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS min_max_u64_fell_back;
min_max_u64_fell_back
0
# nullable_sum: NULL rows on the JIT (Phase 5D).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(n), COUNT(n) FROM t1;
SUM(n)	COUNT(n)
12	2
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS nullable_sum_fell_back;
nullable_sum_fell_back
0
# mixed_arith: int + double operands in one expression (Phase
# 5I — the conversion cold call; includes the TPC-H Q9 shape
# of NNC-const arithmetic over scaled DECIMAL).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a + d), SUM(dec9 * (1 - f)) FROM t1;
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS mixed_arith_fell_back;
mixed_arith_fell_back
0
# case_nullable: CASE over a NULLABLE condition column (Phase
# 5D-3 — the planner's BRANCH_REG_EQ_NULL guard fuses with the
# READ_ATTR into a null-branching load; NULL rows stay on the
# JIT).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(CASE WHEN n > 5 THEN 1 ELSE 0 END) FROM t1;
SUM(CASE WHEN n > 5 THEN 1 ELSE 0 END)
1
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS case_nullable_fell_back;
case_nullable_fell_back
0
#
# ---- Shapes expected to FALL BACK (the census proper) ----
#
# int_div: integer division (lowered since Phase 5E-2; the SQL
# planner does not push DIV, so 0 here means never-pushed —
# rondb_jit_ronsql_canary exercises the lowering).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a DIV b) FROM t1;
SUM(a DIV b)
20
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS int_div_fell_back;
int_div_fell_back
0
# int_mod: modulo (lowered since Phase 5E-2, same not-pushed
# caveat; the NDBAPI fallback canary (testJoinAggJit Test 4)
# now uses a 33-aggregate over-capacity program).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a % b) FROM t1;
SUM(a % b)
5
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS int_mod_fell_back;
int_mod_fell_back
0
# generic_div_int: '/' over INTEGER operands (lowered since
# Phase 5E-3 — the conversion cold call; the SQL planner does
# not push '/', so 0 here means never-pushed —
# rondb_jit_ronsql_canary exercises the lowering).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(a / b) FROM t1;
SUM(a / b)
21.0000
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS generic_div_int_fell_back;
generic_div_int_fell_back
0
# string_min: MIN over VARCHAR (compiles since Phase 5F-1 — the
# fused string MIN/MAX cold call).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT MIN(s), MAX(s) FROM t1;
MIN(s)	MAX(s)
alpha	gamma
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS string_min_fell_back;
string_min_fell_back
0
# decimal_sum: SUM over DECIMAL (compiles since Phase 5G — the
# DECIMAL load + generic-aggregate lowering).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(dec9) FROM t1;
SUM(dec9)
11.00
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS decimal_sum_fell_back;
decimal_sum_fell_back
0
# date_min: MIN/MAX over DATE (lowered since Phase 5K on the u64
# track; the SQL planner does not push temporals — 0 here means
# never-pushed; rondb_jit_ronsql_canary Q16-Q18 exercise it).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT MIN(dt), MAX(dt) FROM t1;
MIN(dt)	MAX(dt)
2026-01-15	2026-04-15
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS date_min_fell_back;
date_min_fell_back
0
# unsigned_arith: arithmetic over BIGINT UNSIGNED (compiles since
# Phase 5C-4 — u64 checked arithmetic).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(u + 1) FROM t1;
SUM(u + 1)
1004
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS unsigned_arith_fell_back;
unsigned_arith_fell_back
0
# int_sum: SUM over a plain INT column (compiles since the
# narrow-int admission — signed widths ride the i64 track,
# unsigned widths the u64 track).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(i) FROM t1;
SUM(i)
10
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS int_sum_fell_back;
int_sum_fell_back
0
# case_string: STRING condition in a CASE aggregate (compiles
# since the aggregation-path BRANCH_ATTR_OP_ARG unblock —
# absolute instruction offsets + prog_buf at dispatch).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(CASE WHEN ch = 'beta' THEN 1 ELSE 0 END) FROM t1;
SUM(CASE WHEN ch = 'beta' THEN 1 ELSE 0 END)
1
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS case_string_fell_back;
case_string_fell_back
0
#
# ---- Phase 6-0: the JOIN-AGGREGATION compile path ----
#
# Every row above runs the STANDALONE scan-aggregation path
# (PushdownInterpreterFactory -> cached compile, counters
# visible). Joined aggregation compiles separately in
# DblqhProxy::execJOIN_AGG_SETUP_REQ: bridge/compile rejects DO
# bump programs_fallback, and since Phase 6-4 successful compiles
# go through the agg reuse cache (programs_compiled / reused move
# for join aggregation too) — these rows stay fallback-delta
# probes; must-JIT proof stays with the 4060 canaries.
CREATE TABLE tj_parent (
pk  BIGINT NOT NULL,
grp BIGINT NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
CREATE TABLE tj_c1 (
parent_id BIGINT NOT NULL,
amount    BIGINT NOT NULL,
PRIMARY KEY (parent_id)
) ENGINE=NDB;
CREATE TABLE tj_c2 (
parent_id BIGINT NOT NULL,
qty       BIGINT NOT NULL,
PRIMARY KEY (parent_id)
) ENGINE=NDB;
INSERT INTO tj_parent VALUES (1, 1), (2, 1), (3, 2);
INSERT INTO tj_c1 VALUES (1, 10), (2, 20);
INSERT INTO tj_c2 VALUES (1, 5), (2, 7);
SET ndb_join_pushdown_aggregate=ON;
SET ndb_join_pushdown_aggregate_outer_join=ON;
# join_sum: two-table inner-join SUM over a child column — the
# canonical JOIN_AGG_SETUP shape (compiles since Phase 4;
# must-JIT proof in testJoinAggJit Test 1).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(c.amount) FROM tj_parent p JOIN tj_c1 c ON c.parent_id = p.pk;
SUM(c.amount)
30
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS join_sum_fell_back;
join_sum_fell_back
0
# outer_join_sum: LEFT JOIN aggregation (pushed since
# RONDB-1035). The program compiles; NULL-EXTENDED rows for
# unmatched parents (pk=3 here) never dispatch to the JIT — a
# per-row exclusion invisible to this program-level counter by
# design (see the 6-2 exemption list).
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(c.amount), COUNT(*) FROM tj_parent p LEFT JOIN tj_c1 c ON c.parent_id = p.pk;
SUM(c.amount)	COUNT(*)
30	3
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS outer_join_sum_fell_back;
outer_join_sum_fell_back
0
# star_two_leaf: aggregates over TWO child tables in one query.
# Since Phase 6-3 every leaf of a multi-leaf setup compiles
# independently (the old compile-gate skip is gone); note the SQL
# planner itself never emits multi-leaf setups, so this row probes
# whatever single-leaf shape the planner produces. The definitive
# multi-leaf exercises are testJoinAggJit Test 7 (must-JIT under
# 4060) and the testStarJoinAgg* fleet.
SET @c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SELECT SUM(c1.amount), SUM(c2.qty)
FROM tj_parent p
JOIN tj_c1 c1 ON c1.parent_id = p.pk
JOIN tj_c2 c2 ON c2.parent_id = p.pk;
SUM(c1.amount)	SUM(c2.qty)
30	12
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) > @c0 AS star_two_leaf_fell_back;
star_two_leaf_fell_back
0
DROP TABLE tj_c2, tj_c1, tj_parent;
DROP TABLE t1;
