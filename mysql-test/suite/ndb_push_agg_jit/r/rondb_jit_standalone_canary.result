############################################################
# RONDB-1056 standalone aggregation JIT canary
############################################################
CREATE TABLE t1 (
pk BIGINT NOT NULL,
v  BIGINT NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t1 VALUES
(1, 10), (2, 20), (3, 30), (4, 40), (5, 50);
SET ndb_pushdown_aggregate=ON;
# Q1: SUM over one BIGINT NOT NULL column must JIT.
SELECT SUM(v) FROM t1;
SUM(v)
150
# Q2: SUM over simple bigint addition must JIT.
SELECT SUM(v + pk) FROM t1;
SUM(v + pk)
165
# Q3: SUM over plus, minus and mul must JIT.
SELECT SUM(v - pk + pk * 0) FROM t1;
SUM(v - pk + pk * 0)
135
# Q4: WHERE clause remains a fallback smoke query.
SELECT SUM(v) FROM t1 WHERE pk >= 3;
SUM(v)
120
DROP TABLE t1;
