############################################################
# Test 17: Combined HAVING + ORDER BY + LIMIT
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT t1.grp, SUM(t3.amount) AS total, COUNT(*) AS cnt
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp
HAVING cnt >= 3
ORDER BY total ASC
LIMIT 1;
grp	total	cnt
A	1000	4
SET ndb_join_pushdown_aggregate=ON;
SELECT t1.grp, SUM(t3.amount) AS total, COUNT(*) AS cnt
FROM t1 JOIN t2 ON t2.pk = t1.pk JOIN t3 ON t3.pk = t2.pk
GROUP BY t1.grp
HAVING cnt >= 3
ORDER BY total ASC
LIMIT 1;
grp	total	cnt
A	1000	4
