2	300
3	300
############################################################
# Test 45: Arithmetic in CASE THEN
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT tc1.grp,
SUM(CASE WHEN tc2.flag = 1 THEN tc2.val * 2 ELSE tc2.val END) AS wt
FROM tc1 JOIN tc2 ON tc2.pk = tc1.pk
GROUP BY tc1.grp;
grp	wt
1	100
2	200
3	220
SET ndb_join_pushdown_aggregate=ON;
SELECT tc1.grp,
SUM(CASE WHEN tc2.flag = 1 THEN tc2.val * 2 ELSE tc2.val END) AS wt
FROM tc1 JOIN tc2 ON tc2.pk = tc1.pk
GROUP BY tc1.grp;
grp	wt
1	100
2	200
3	220
# Cleanup CASE tables
DROP TABLE tc2, tc1;
############################################################
# AVG in Pushed Joins
############################################################
# Create tables for AVG tests
CREATE TABLE ta1 (
pk INT PRIMARY KEY,
grp INT
) ENGINE=NDB;
CREATE TABLE ta2 (
pk INT PRIMARY KEY,
val INT,
val_null INT
) ENGINE=NDB;
INSERT INTO ta1 VALUES (1,1),(2,1),(3,1),(4,2),(5,2),(6,2),(7,3),(8,3);
INSERT INTO ta2 VALUES
(1, 10, 10), (2, 20, NULL), (3, 30, 30),
(4, 40, NULL), (5, 50, 50), (6, 60, 60),
(7, 70, NULL), (8, 80, 80);
############################################################
# Test 46: AVG on leaf column (2-way join)
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT ta1.grp, AVG(ta2.val)
FROM ta1 JOIN ta2 ON ta2.pk = ta1.pk
GROUP BY ta1.grp;
grp	AVG(ta2.val)
1	20.0000
2	50.0000
3	75.0000
SET ndb_join_pushdown_aggregate=ON;
SELECT ta1.grp, AVG(ta2.val)
FROM ta1 JOIN ta2 ON ta2.pk = ta1.pk
GROUP BY ta1.grp;
grp	AVG(ta2.val)
1	20.0000
2	50.0000
3	75.0000
############################################################
# Test 47: AVG with NULLs on leaf column
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT ta1.grp, AVG(ta2.val_null)
FROM ta1 JOIN ta2 ON ta2.pk = ta1.pk
GROUP BY ta1.grp;
grp	AVG(ta2.val_null)
1	20.0000
2	55.0000
3	80.0000
SET ndb_join_pushdown_aggregate=ON;
SELECT ta1.grp, AVG(ta2.val_null)
FROM ta1 JOIN ta2 ON ta2.pk = ta1.pk
GROUP BY ta1.grp;
grp	AVG(ta2.val_null)
1	20.0000
2	55.0000
3	80.0000
############################################################
# Test 48: Implicit AVG (no GROUP BY)
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT AVG(ta2.val)
FROM ta1 JOIN ta2 ON ta2.pk = ta1.pk;
AVG(ta2.val)
45.0000
SET ndb_join_pushdown_aggregate=ON;
SELECT AVG(ta2.val)
FROM ta1 JOIN ta2 ON ta2.pk = ta1.pk;
AVG(ta2.val)
45.0000
############################################################
# Test 49: AVG mixed with SUM, COUNT
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT ta1.grp, AVG(ta2.val), SUM(ta2.val), COUNT(*)
FROM ta1 JOIN ta2 ON ta2.pk = ta1.pk
GROUP BY ta1.grp;
grp	AVG(ta2.val)	SUM(ta2.val)	COUNT(*)
1	20.0000	60	3
2	50.0000	150	3
3	75.0000	150	2
SET ndb_join_pushdown_aggregate=ON;
SELECT ta1.grp, AVG(ta2.val), SUM(ta2.val), COUNT(*)
FROM ta1 JOIN ta2 ON ta2.pk = ta1.pk
GROUP BY ta1.grp;
