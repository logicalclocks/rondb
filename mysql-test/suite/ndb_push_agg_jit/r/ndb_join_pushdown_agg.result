############################################################
# Phase 21: Outer Join Aggregation Pushdown
############################################################
# Create tables for outer join tests.
# oj1 (parent): pk 1-8, grp column for GROUP BY
# oj2 (child):  pk 1,2,3,5,7 — missing 4,6,8 to test unmatched parents
CREATE TABLE oj1 (
pk INT PRIMARY KEY,
grp INT
) ENGINE=NDB;
CREATE TABLE oj2 (
pk INT PRIMARY KEY,
val INT,
val_null INT
) ENGINE=NDB;
INSERT INTO oj1 VALUES (1,1),(2,1),(3,2),(4,2),(5,3),(6,3),(7,1),(8,2);
INSERT INTO oj2 VALUES
(1, 10, 10), (2, 20, NULL), (3, 30, 30),
(5, 50, 50), (7, 70, NULL);
