2	300
3	300
SET ndb_join_pushdown_aggregate=ON;
SELECT tc1.grp, SUM(tc2.val * 2) AS dbl
FROM tc1 JOIN tc2 ON tc2.pk = tc1.pk
GROUP BY tc1.grp;
grp	dbl
