# Test 44: Arithmetic directly in SUM
############################################################
SET ndb_join_pushdown_aggregate=OFF;
SELECT tc1.grp, SUM(tc2.val * 2) AS dbl
FROM tc1 JOIN tc2 ON tc2.pk = tc1.pk
GROUP BY tc1.grp;
grp	dbl
