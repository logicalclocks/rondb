############################################################
# RONDB-1056 Phase 5.0 embedded JIT canary
############################################################
# Tables: BIGINT columns including a nullable c1.
CREATE TABLE t (
pk BIGINT NOT NULL,
c1 BIGINT,
c2 BIGINT NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
CREATE TABLE p (
pk BIGINT NOT NULL,
cnt BIGINT NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
# Load test data — 6 rows; c1 NULL on rows 2 and 5 only.
INSERT INTO t VALUES
(1, 10,   100),
(2, NULL, 200),
(3, 30,   300),
(4, 40,   400),
(5, NULL, 500),
(6, 60,   600);
INSERT INTO p VALUES
(1, 1), (2, 1), (3, 1), (4, 1), (5, 1), (6, 1);
SET ndb_join_pushdown_aggregate=ON;
############################################################
# Q1: SUM(t.c2) over rows where t.c1 IS NULL.
#     Embedded block carries BRANCH_ATTR_NE_NULL (skip if
#     c1 not null) → JIT'd via op_branch_attr_ne_null.
#     Expected: t2.c2 for pk in {2, 5} = 200 + 500 = 700.
############################################################
SELECT SUM(t.c2)
FROM p JOIN t ON t.pk = p.pk
WHERE t.c1 IS NULL;
SUM(t.c2)
700
############################################################
# Q2: SUM(t.c2) over rows where t.c1 IS NOT NULL.
#     Embedded block carries BRANCH_ATTR_EQ_NULL (skip if
#     c1 is null) → JIT'd via op_branch_attr_eq_null.
#     Expected: t2.c2 for pk in {1, 3, 4, 6} = 100+300+400+600 = 1400.
############################################################
SELECT SUM(t.c2)
FROM p JOIN t ON t.pk = p.pk
WHERE t.c1 IS NOT NULL;
SUM(t.c2)
1400
############################################################
# Q3: COUNT(*) — common simple case for IS NULL.
#     Expected: 2 rows have t.c1 IS NULL (pk 2 and 5).
############################################################
SELECT COUNT(*)
FROM p JOIN t ON t.pk = p.pk
WHERE t.c1 IS NULL;
COUNT(*)
2
############################################################
# Cleanup
############################################################
DROP TABLE t;
DROP TABLE p;
