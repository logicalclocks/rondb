############################################################
# RONDB-1056 GROUP BY JIT canary
############################################################
CREATE TABLE t1 (
pk  BIGINT NOT NULL,
grp BIGINT NOT NULL,
v   BIGINT NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t1 VALUES
(1, 1, 10), (2, 1, 20), (3, 1, 30), (4, 1, 40),
(5, 2, 50), (6, 2, 60), (7, 2, 70),
(8, 3, 80), (9, 3, 90), (10, 3, 100), (11, 3, 110), (12, 3, 120);
SET ndb_pushdown_aggregate=ON;
# Q1: grouped SUM must JIT (the basic gate lift).
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT grp, SUM(v) FROM t1 GROUP BY grp;
grp	SUM(v)
1	100
2	180
3	500
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q1_jit_compiled;
q1_jit_compiled
1
# Q2: grouped COUNT + SUM must JIT (OP_COUNT_BIGINT — count results
#     are unsigned BIGINT via the value_unsigned writeback mask).
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT grp, COUNT(v), SUM(v) FROM t1 GROUP BY grp;
grp	COUNT(v)	SUM(v)
1	4	100
2	3	180
3	5	500
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q2_jit_compiled;
q2_jit_compiled
1
# Q3: grouped CASE aggregation must JIT (Phase 5A: the embedded
#     READ_ATTR / LOAD_CONST16/64 / BRANCH_*_REG_REG condition
#     family lowers, and multi-arm same-aggregate mask indexes are
#     fixed). Note the planner still only pushes CASE with a
#     pushable ELSE value — ELSE NULL is evaluated server-side.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT grp, SUM(CASE WHEN v > 115 THEN v ELSE 0 END) AS s FROM t1 GROUP BY grp;
grp	s
1	0
2	0
3	120
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q3_jit_compiled;
q3_jit_compiled
1
# Q4: high-cardinality differential — 2048 rows over 500 groups
#     (chunk-allocator growth under JIT dispatch). The outer derived
#     query folds the grouped result to one deterministic row.
CREATE TABLE t2 (
pk  BIGINT NOT NULL,
grp BIGINT NOT NULL,
v   BIGINT NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t2 VALUES (1, 0, 1);
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
SET @m = (SELECT MAX(pk) FROM t2);
INSERT INTO t2 SELECT pk + @m, 0, 1 FROM t2;
UPDATE t2 SET grp = pk % 500, v = pk % 7;
SELECT COUNT(*) FROM t2;
COUNT(*)
2048
SELECT SUM(s), SUM(c), COUNT(*)
FROM (SELECT grp, SUM(v) AS s, COUNT(v) AS c FROM t2 GROUP BY grp) x;
SUM(s)	SUM(c)	COUNT(*)
6142	2048	500
DROP TABLE t2;
# Q5: grouped join aggregation must JIT (single-leaf pushed join).
CREATE TABLE jt1 (
pk  BIGINT NOT NULL,
grp BIGINT NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
CREATE TABLE jt2 (
pk BIGINT NOT NULL,
c2 BIGINT NOT NULL,
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO jt1 VALUES (1, 1), (2, 1), (3, 2), (4, 2), (5, 2);
INSERT INTO jt2 VALUES (1, 100), (2, 200), (3, 300), (4, 400), (5, 500);
SET ndb_join_pushdown_aggregate=ON;
SELECT jt1.grp, SUM(jt2.c2) FROM jt1 JOIN jt2 ON jt2.pk = jt1.pk GROUP BY jt1.grp;
grp	SUM(jt2.c2)
1	300
2	1200
DROP TABLE jt1;
DROP TABLE jt2;
# Q6: FIVE aggregates in one grouped program. Was the negative
#     control for the old BC_MAX_ACCS=4 cap (bridge-rejected,
#     interpreter fallback); the ronsql_jit slice-2 raise to 32
#     makes it a must-JIT: compile activity must move.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT grp, SUM(v), SUM(pk), SUM(v+pk), SUM(v-pk), SUM(pk*2) FROM t1 GROUP BY grp;
grp	SUM(v)	SUM(pk)	SUM(v+pk)	SUM(v-pk)	SUM(pk*2)
1	100	10	110	90	20
2	180	18	198	162	36
3	500	50	550	450	100
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) > @c0 AS q6_jit_compiled;
q6_jit_compiled
1
# Q7: grouped MIN/MAX must JIT (Phase 5B). All v values are > 0, so
#     a broken first-row initialization (fresh accumulator's 0
#     winning the MIN) would show as MIN = 0.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT grp, MIN(v), MAX(v) FROM t1 GROUP BY grp;
grp	MIN(v)	MAX(v)
1	10	40
2	50	70
3	80	120
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q7_jit_compiled;
q7_jit_compiled
1
DROP TABLE t1;
