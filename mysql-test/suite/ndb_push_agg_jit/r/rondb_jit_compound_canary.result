############################################################
# RONDB-1056 compound scan-predicate JIT canary
############################################################
CREATE TABLE t1 (
pk BIGINT NOT NULL,
a  BIGINT,
b  VARCHAR(32),
PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t1 VALUES
(1, 2,    'apple'),
(2, 6,    'banana'),
(3, 8,    'cherry'),
(4, 10,   'zebra'),
(5, NULL, 'kiwi'),
(6, 7,    NULL),
(7, 42,   'mango');
# Q1: WHERE a > 5 AND b < 'x' (integer AND string) must JIT.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT pk FROM t1 WHERE a > 5 AND b < 'x';
pk
2
3
7
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q1_jit_compiled;
q1_jit_compiled
1
# Q2: WHERE a > 5 AND a < 10 (integer range, same column) must JIT.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT pk, a FROM t1 WHERE a > 5 AND a < 10;
pk	a
2	6
3	8
6	7
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q2_jit_compiled;
q2_jit_compiled
1
# Q3: WHERE a < 3 OR a > 9 (integer OR) must JIT.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT pk, a FROM t1 WHERE a < 3 OR a > 9;
pk	a
1	2
4	10
7	42
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q3_jit_compiled;
q3_jit_compiled
1
# Q4: WHERE a IS NULL OR a > 9 (NULL-branch OR comparison) must JIT.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT pk FROM t1 WHERE a IS NULL OR a > 9;
pk
4
5
7
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q4_jit_compiled;
q4_jit_compiled
1
# Q5: WHERE a > 5 AND a < 41 AND b > 'b' (3-way mixed AND) must JIT.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT pk FROM t1 WHERE a > 5 AND a < 41 AND b > 'b';
pk
2
3
4
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q5_jit_compiled;
q5_jit_compiled
1
# Q6: differential — Q1 without the error insert matches.
SELECT pk FROM t1 WHERE a > 5 AND b < 'x';
pk
2
3
7
# Q7: differential — Q3 without the error insert matches.
SELECT pk, a FROM t1 WHERE a < 3 OR a > 9;
pk	a
1	2
4	10
7	42
# Q8: negative control — LIKE is bridge-rejected (cond > GE), so it
#     must run on the interpreter and the compile counters must not
#     move. No 4060 here: deliberate fallback is exempt anyway.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SELECT pk FROM t1 WHERE b LIKE 'c%';
pk
3
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) = @c0 AS q8_like_stays_on_interpreter;
q8_like_stays_on_interpreter
1
DROP TABLE t1;
