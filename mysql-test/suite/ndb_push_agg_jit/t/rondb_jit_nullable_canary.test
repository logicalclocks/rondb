--source include/have_ndb.inc
--source have_ndb_error_insert.inc

# RONDB-1056 nullable-column aggregation canary.
#
# History: the JIT's load helper originally abort()ed on a NULL column
# value (SELECT SUM(nullable) with any NULL row crashed the node).
# Phase 5A replaced the abort with a PER-ROW interpreter fallback.
# Phase 5D-1 replaces the fallback with NULL-BRANCHING loads: the load
# helper returns "was NULL" and the stencil branches past the loaded
# register's whole consumer chain — the interpreter kernels' null-skip
# (no accumulator update, no writeback marks) at JIT speed. NULL rows
# now STAY on the JIT.
#
# That makes ERROR_INSERT 4060 the proof: the per-row fallback path
# falls through to the interpreter loop, where the 4060 guard aborts —
# so these queries surviving under 4060 proves every row, NULL rows
# included, ran the compiled program. (Pre-5D this test could not use
# 4060 at all.)

--echo ############################################################
--echo # RONDB-1056 nullable-column JIT canary (null-branching loads)
--echo ############################################################

CREATE TABLE tn (
  pk  BIGINT NOT NULL,
  grp BIGINT NOT NULL,
  v   BIGINT,
  PRIMARY KEY (pk)
) ENGINE=NDB;

INSERT INTO tn VALUES
  (1, 1, 10), (2, 1, NULL), (3, 1, 30),
  (4, 2, NULL), (5, 2, NULL), (6, 2, 60),
  (7, 3, NULL);

SET ndb_pushdown_aggregate=ON;

--echo # Q1: scalar SUM/COUNT over a nullable column must JIT — NULL rows
--echo #     take the null branch (no fallback; 4060 would abort on one).
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_nullable_canary_mgm.log
SELECT SUM(v), COUNT(v) FROM tn;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_nullable_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q1_jit_compiled;

--echo # Q2: grouped — including a group whose rows are ALL NULL (grp 3):
--echo #     SUM/MIN stay SQL NULL and COUNT is 0 for that group. Every
--echo #     row of that group takes the null branch, so even the
--echo #     all-NULL group is a pure JIT run under 4060.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_nullable_canary_mgm.log
--sorted_result
SELECT grp, SUM(v), COUNT(v), MIN(v) FROM tn GROUP BY grp;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_nullable_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q2_jit_compiled;

--echo # Q3: nullable expression — SUM(v + pk): a NULL v skips the whole
--echo #     arithmetic chain (no garbage arithmetic, no spurious
--echo #     overflow) and the row contributes nothing, matching the
--echo #     interpreter's null propagation.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_nullable_canary_mgm.log
SELECT SUM(v + pk) FROM tn;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_nullable_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q3_jit_compiled;

DROP TABLE tn;

--remove_file $MYSQL_TMP_DIR/rondb_jit_nullable_canary_mgm.log
