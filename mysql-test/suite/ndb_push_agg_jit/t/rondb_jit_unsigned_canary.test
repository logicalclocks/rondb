--source include/have_ndb.inc
--source have_ndb_error_insert.inc

# RONDB-1056 Phase 5C-3 — unsigned BIGINT canary.
#
# Aggregation over BIGINT UNSIGNED columns now JITs: declared
# BIGUNSIGNED loads go through the OP_LOAD_COL_NDB_U64 cold-call, and
# the optimizer's BIGINT-track aggregates lower to the UNSIGNED
# variants (u64 compares for MIN/MAX — a signed compare would order
# values >= 2^63 as negative — and a carry-checked u64 SUM). The
# writeback marks is_unsigned via the value_unsigned mask.
#
# Proof pattern (see rondb_jit_double_canary): ERROR_INSERT 4060 +
# an ndbinfo.jit programs_compiled + programs_reused delta >= 1.
#
# Requires regenerated stencils (regen-stencils) in the build.

--echo ############################################################
--echo # RONDB-1056 unsigned BIGINT JIT canary
--echo ############################################################

CREATE TABLE t1 (
  pk  BIGINT NOT NULL,
  grp BIGINT NOT NULL,
  u   BIGINT UNSIGNED NOT NULL,
  PRIMARY KEY (pk)
) ENGINE=NDB;

# Values straddle the signed boundary: 9223372036854775813 = 2^63 + 5
# and 18446744073709551615 = 2^64 - 1 are negative under a broken
# signed compare, so MIN/MAX answers detect signedness bugs directly.
INSERT INTO t1 VALUES
  (1, 1, 3),
  (2, 1, 9223372036854775813),
  (3, 1, 18446744073709551615),
  (4, 2, 100),
  (5, 2, 9223372036854775808),
  (6, 3, 42);

SET ndb_pushdown_aggregate=ON;

--echo # Q1: scalar MIN/MAX over BIGINT UNSIGNED must JIT with u64
--echo #     compares — a signed compare would report MIN = 2^63+5.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT MIN(u), MAX(u) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q1_jit_compiled;

--echo # Q2: grouped MIN/MAX/COUNT must JIT (per-group first-row init
--echo #     with unsigned compares).
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
--sorted_result
SELECT grp, MIN(u), MAX(u), COUNT(u) FROM t1 GROUP BY grp;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q2_jit_compiled;

--echo # Q3: SUM over values above the SIGNED boundary must JIT — the
--echo #     u64 carry-checked sum accumulates past 2^63 where a signed
--echo #     checked add would falsely overflow. 3 × (2^62 + 1) =
--echo #     13835058055282163715. End-to-end unsignedness (kernel u64
--echo #     sum -> value_unsigned writeback -> wire -> mysqld DECIMAL
--echo #     conversion) relies on the RONDB-733 set_pushed_value_uint
--echo #     fix — before it, this printed signed-wrapped.
CREATE TABLE t2 (
  pk BIGINT NOT NULL,
  u  BIGINT UNSIGNED NOT NULL,
  PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t2 VALUES
  (1, 4611686018427387905),
  (2, 4611686018427387905),
  (3, 4611686018427387905);
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT SUM(u) FROM t2;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q3_jit_compiled;
DROP TABLE t2;

--echo # Q4: AVG over BIGINT UNSIGNED must JIT (SUM + COUNT
--echo #     decomposition over the same u64 register).
CREATE TABLE t3 (
  pk BIGINT NOT NULL,
  u  BIGINT UNSIGNED NOT NULL,
  PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t3 VALUES (1, 10), (2, 20), (3, 30), (4, 60);
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT AVG(u) FROM t3;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q4_jit_compiled;

--echo # Q5 (Phase 5C-4): unsigned arithmetic must JIT — SUM(u + 1)
--echo #     lowers to the u64 checked add (the BIGINT constant 1 is a
--echo #     non-negative constant, u64-compatible).
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT SUM(u + 1) FROM t3;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q5_jit_compiled;
DROP TABLE t3;

--echo # Q6 (Phase 5D-2): nullable BIGINT UNSIGNED column must JIT under
--echo #     4060 — NULL rows take the u64 null-branching load's branch;
--echo #     the sum crosses 2^63 (unsigned end to end).
CREATE TABLE t4 (
  pk BIGINT NOT NULL,
  u  BIGINT UNSIGNED,
  PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO t4 VALUES
  (1, 3), (2, NULL), (3, 9223372036854775813), (4, NULL);
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT SUM(u), COUNT(u), MIN(u), MAX(u) FROM t4;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q6_jit_compiled;
DROP TABLE t4;

DROP TABLE t1;

--remove_file $MYSQL_TMP_DIR/rondb_jit_unsigned_canary_mgm.log
