--source include/have_ndb.inc
--source have_ndb_error_insert.inc

# RONDB-1056 narrow-int admission canary (census probe int_sum).
#
# Aggregates over TINYINT / SMALLINT / MEDIUMINT / INT columns —
# signed and unsigned — now compile: signed widths sign-extend into
# the i64 track, unsigned widths zero-extend into the u64 track (the
# interpreter's IsUnsigned(type) split, so unsigned accumulation and
# the is_unsigned result metadata match the kernels exactly).
#
# Values are chosen to be discriminating: signed minima prove sign
# extension (a byte-blind zero-extension would order -128 as 128),
# unsigned maxima prove zero extension and unsigned compare, and the
# INT UNSIGNED SUM crosses 2^32. Every query runs under ERROR_INSERT
# 4060 (abort on any JIT fallback) plus a compile-counter delta.
#
# Requires a build with generated stencils (regen-stencils).

--echo ############################################################
--echo # RONDB-1056 narrow-int JIT canary
--echo ############################################################

CREATE TABLE t1 (
  pk  INT PRIMARY KEY,
  grp INT NOT NULL,
  ti  TINYINT NOT NULL,
  si  SMALLINT NOT NULL,
  mi  MEDIUMINT NOT NULL,
  i   INT NOT NULL,
  tu  TINYINT UNSIGNED NOT NULL,
  su  SMALLINT UNSIGNED NOT NULL,
  mu  MEDIUMINT UNSIGNED NOT NULL,
  u   INT UNSIGNED NOT NULL,
  ni  INT,
  nu  INT UNSIGNED
) ENGINE=NDB;

INSERT INTO t1 VALUES
  (1, 1, -128, -32768, -8388608, -2147483648, 0,   0,     0,        0,          NULL, NULL),
  (2, 1,  127,  32767,  8388607,  2147483647, 255, 65535, 16777215, 4294967295, 5,    4294967295),
  (3, 2,  -1,   -1,     -1,       -1,         1,   1,     1,        1,          7,    NULL),
  (4, 2,  10,   100,    1000,     10000,      2,   3,     4,        4294967290, NULL, 10);

SET ndb_pushdown_aggregate=ON;

--echo # Q1: TINYINT — MIN must be -128 (sign extension), not 128.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
SELECT MIN(ti), MAX(ti), SUM(ti), COUNT(ti) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q1_jit_compiled;

--echo # Q2: SMALLINT boundaries.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
SELECT MIN(si), MAX(si), SUM(si) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q2_jit_compiled;

--echo # Q3: MEDIUMINT boundaries (3-byte sint3korr sign extension).
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
SELECT MIN(mi), MAX(mi), SUM(mi) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q3_jit_compiled;

--echo # Q4: INT boundaries + AVG (SUM+COUNT over one register).
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
SELECT MIN(i), MAX(i), AVG(i) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q4_jit_compiled;

--echo # Q5: three unsigned widths in ONE program (u64 track).
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
SELECT MIN(tu), MAX(su), SUM(mu) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q5_jit_compiled;

--echo # Q6: INT UNSIGNED — MAX at 4294967295, SUM crosses 2^32.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
SELECT MIN(u), MAX(u), SUM(u) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q6_jit_compiled;

--echo # Q7: grouped, both tracks in one program.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
--sorted_result
SELECT grp, SUM(i), SUM(u) FROM t1 GROUP BY grp;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q7_jit_compiled;

--echo # Q8: NULLABLE narrow columns — both null-branching load
--echo #     families (i64 and u64) under 4060.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
SELECT SUM(ni), COUNT(ni), MIN(nu), MAX(nu) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q8_jit_compiled;

--echo # Q9: narrow arithmetic — signed i64 chain and unsigned + const.
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $NDB_TOOLS_OUTPUT
SELECT SUM(i + si), SUM(u + 1) FROM t1;
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q9_jit_compiled;

DROP TABLE t1;

--remove_file $NDB_TOOLS_OUTPUT
