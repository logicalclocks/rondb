--source include/have_ndb.inc
--source have_ndb_error_insert.inc

# RONDB-1056 Phase 5F-2 — LINKED-column canary (join aggregation).
#
# Aggregates over PARENT-table columns in pushed joins ride linked
# loads (bit 15 of the col operand -> the JoinAggInterpreter's
# linked-buffer walk). The bridge now admits them for every type
# family — i64/u64/f64/DECIMAL/narrow ints, the null-branching
# variants, and the fused string MIN/MAX (whose type + CHARSET come
# from the linked CTE metadata words, so collation-discriminating
# values prove the full path). Each query runs with pushdown OFF
# (baseline) then ON under ERROR_INSERT 4060 with a compile-counter
# delta.
#
# Requires a build with generated stencils (regen-stencils).

--let $join_pushdown = `SELECT @@ndb_join_pushdown`
if (!$join_pushdown)
{
  --skip ndb_join_pushdown must be enabled
}

--echo ############################################################
--echo # RONDB-1056 linked-column JIT canary
--echo ############################################################

CREATE TABLE t1 (
  pk   INT PRIMARY KEY,
  grp  INT NOT NULL,
  pval BIGINT NOT NULL,
  pd   DOUBLE NOT NULL,
  ps   VARCHAR(16) NOT NULL,
  pn   BIGINT,
  pu   BIGINT UNSIGNED NOT NULL,
  pdec DECIMAL(9,2) NOT NULL,
  pi   INT NOT NULL
) ENGINE=NDB;

CREATE TABLE t3 (
  pk     INT PRIMARY KEY,
  amount BIGINT NOT NULL
) ENGINE=NDB;

INSERT INTO t1 VALUES
  (1, 1, 100, 1.5, 'Banana', NULL, 1000, 1.25, 7),
  (2, 1, 200, 2.5, 'apple',  5,    2000, 2.25, 8),
  (3, 2, 300, 4.0, 'Cherry', 7,    3000, 3.25, 9);
INSERT INTO t3 VALUES (1, 10), (2, 20), (3, 30);

--echo # Q1: linked BIGINT SUM/MIN/MAX.
SET ndb_join_pushdown_aggregate=OFF;
SELECT SUM(t1.pval), MIN(t1.pval), MAX(t1.pval)
FROM t1 JOIN t3 ON t3.pk = t1.pk;
SET ndb_join_pushdown_aggregate=ON;
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT SUM(t1.pval), MIN(t1.pval), MAX(t1.pval)
FROM t1 JOIN t3 ON t3.pk = t1.pk;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q1_jit_compiled;

--echo # Q2: linked DOUBLE and BIGINT UNSIGNED.
SET ndb_join_pushdown_aggregate=OFF;
SELECT SUM(t1.pd), SUM(t1.pu) FROM t1 JOIN t3 ON t3.pk = t1.pk;
SET ndb_join_pushdown_aggregate=ON;
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT SUM(t1.pd), SUM(t1.pu) FROM t1 JOIN t3 ON t3.pk = t1.pk;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q2_jit_compiled;

--echo # Q3: LINKED STRING MIN/MAX — collation order (ai_ci: apple <
--echo #     Banana < Cherry) differs from byte order, so the linked
--echo #     charset metadata is proven, not just the bytes.
SET ndb_join_pushdown_aggregate=OFF;
SELECT MIN(t1.ps), MAX(t1.ps) FROM t1 JOIN t3 ON t3.pk = t1.pk;
SET ndb_join_pushdown_aggregate=ON;
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT MIN(t1.ps), MAX(t1.ps) FROM t1 JOIN t3 ON t3.pk = t1.pk;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q3_jit_compiled;

--echo # Q4: NULLABLE linked column — the linked null-branching path.
SET ndb_join_pushdown_aggregate=OFF;
SELECT SUM(t1.pn), COUNT(t1.pn) FROM t1 JOIN t3 ON t3.pk = t1.pk;
SET ndb_join_pushdown_aggregate=ON;
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT SUM(t1.pn), COUNT(t1.pn) FROM t1 JOIN t3 ON t3.pk = t1.pk;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q4_jit_compiled;

--echo # Q5: linked DECIMAL and narrow INT.
SET ndb_join_pushdown_aggregate=OFF;
SELECT SUM(t1.pdec), SUM(t1.pi) FROM t1 JOIN t3 ON t3.pk = t1.pk;
SET ndb_join_pushdown_aggregate=ON;
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT SUM(t1.pdec), SUM(t1.pi) FROM t1 JOIN t3 ON t3.pk = t1.pk;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q5_jit_compiled;

--echo # Q6: local + linked in ONE program, and a grouped variant.
SET ndb_join_pushdown_aggregate=OFF;
SELECT SUM(t3.amount), SUM(t1.pval) FROM t1 JOIN t3 ON t3.pk = t1.pk;
--sorted_result
SELECT t1.grp, SUM(t1.pval), MIN(t1.ps)
FROM t1 JOIN t3 ON t3.pk = t1.pk GROUP BY t1.grp;
SET ndb_join_pushdown_aggregate=ON;
SET @c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
--exec $NDB_MGM -e "all error 4060" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT SUM(t3.amount), SUM(t1.pval) FROM t1 JOIN t3 ON t3.pk = t1.pk;
--sorted_result
SELECT t1.grp, SUM(t1.pval), MIN(t1.ps)
FROM t1 JOIN t3 ON t3.pk = t1.pk GROUP BY t1.grp;
--exec $NDB_MGM -e "all error 0" >> $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >= @c0 + 1 AS q6_jit_compiled;

DROP TABLE t3;
DROP TABLE t1;

--remove_file $MYSQL_TMP_DIR/rondb_jit_linked_canary_mgm.log
