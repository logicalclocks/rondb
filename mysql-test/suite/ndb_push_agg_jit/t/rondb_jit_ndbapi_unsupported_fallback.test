--source include/have_ndb.inc

# testJoinAggJit Test 4: an aggregation program that is a JIT candidate by
# shape but exceeds the JIT's accumulator capacity (33 SUM aggregates, one
# past BC_MAX_ACCS = 32; repointed from a dead kOpSetRegNull when ronsql_jit
# slice 2 lowered it, before that from kOpMod / kOpMaxBigint). The program
# is rejected at JOIN_AGG_SETUP_REQ and runs on the interpreter; this canary
# proves the fallback produces the correct result and never errors the query.
# No data-node error inserts are used, so it runs in every build type.

--echo Running rondb_jit_ndbapi_unsupported_fallback
--replace_regex /Connect string: .*/Connect string: #/ /MySQL port: .*/MySQL port: #/ /Connecting to management server at [^\n]*\n//
--exec $NDB_PUSH_AGG_DIR/testJoinAggJit -c "$NDB_CONNECTSTRING" -m $MASTER_MYPORT --only 4 2>&1
--echo PASSED

# Clean up database created by test program
DROP DATABASE IF EXISTS test_db;
