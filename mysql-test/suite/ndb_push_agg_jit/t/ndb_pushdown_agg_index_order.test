# Mirror of suite/ndb_push_agg/t/ndb_pushdown_agg_index_order.test with the
# JIT active (CompiledInterpreter=ON) — the JIT arm of the RONDB-1056
# differential. Test logic lives ONLY in the sourced original.
#
# The recorded fallback delta below is the Phase 6-2 coverage pin for
# this test: every JIT program reject it causes (join-agg, standalone
# aggregation, scan filter — one count per compile attempt) is
# counted. A change in EITHER direction is a coverage change:
# investigate, then re-record deliberately.
SET @jit_c0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
--source suite/ndb_push_agg/t/ndb_pushdown_agg_index_order.test
SELECT CAST((SELECT SUM(programs_fallback) FROM ndbinfo.jit) - @jit_c0 AS SIGNED)
       AS ndb_pushdown_agg_index_order_jit_fallback_delta;
