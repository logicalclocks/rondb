# RONDB-1056 — the JIT arm of the pushdown-aggregation differential.
#
# This suite runs the SAME tests as ndb_push_agg (one-line mirrors that
# --source the originals, so test logic can never diverge) but with the
# compiled interpreter ACTIVE, while ndb_push_agg pins
# CompiledInterpreter=OFF. Identical .result baselines passing under
# both suites is the always-JIT differential (phase_6_plan.md §6-0).
# The rondb_jit_* canaries live here natively — they assert JIT
# activity (ndbinfo.jit counters, ERROR_INSERT 4060 must-JIT) and are
# meaningless under OFF. bench* tests are deliberately not mirrored.
!include suite/ndb_push_agg/my.cnf

[cluster_config.1]
CompiledInterpreter=ON
