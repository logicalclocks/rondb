# ronsqlcrunch — benchmark cluster for the RonSQL vs MySQL vs
# compiled-interpreter comparison (RONDB-1056).
#
# Modelled on suite/ndbcrunch (2 data nodes, 2 MySQL servers,
# AutomaticThreadConfig, process CPU binding through
# --defaults-extra-file=.../cpubind.cnf) plus an RDRS server started by
# mtr: REST + RonSQL always, Rondis optionally (rondis.cnf).
#
# Start it and leave it running:
#
#   cd mysql-test
#   ./mtr --suite=ronsqlcrunch setup --start-and-exit \
#         --defaults-extra-file=suite/ronsqlcrunch/cpubind.cnf
#
# mtr prints the mysqld port/socket and "rdrs.1.1  RDRS port N, rondis
# port M". The generated RDRS config is var/rdrs.1.1_config.json.
#
# The driver storage/ndb/claude_files/compiled_interpreter/ronsql_bench_matrix.py
# starts and stops this cluster, loads TPC-H through rondb-cli and runs
# .bench_sql / .bench_ronsql across engine x compiler x threads.
#
# Like ndbcrunch this file is standalone (no default_ndbd.cnf: that one
# pins a fixed ThreadConfig, we want AutomaticThreadConfig).

[cluster_config.1]
ndbd=,
ndb_mgmd=
mysqld=,
# API slots: RDRS takes 2 (data + metadata), each mysqld takes 1 extra
# for its connection pool of 2, the rest are free for load_tpch /
# bench_* / ronsql_cli.
ndbapi=,,,,,,,
NoOfReplicas=2

# Benchmark-scale memory: TPC-H scale factor 1 loaded through rondb-cli
# .load_tpch (~8.7M rows) fits (mirrors
# suite/rdrs2-ronsqltpch/t/ronsql_bench_setup.cnf).
TotalMemoryConfig=10G
DataMemory=4G
DiskPageBufferMemory=400M
SchemaMemory=200M
TransactionMemory=200M
SharedGlobalMemory=450M
MaxNoOfTables=2000
MaxNoOfOrderedIndexes=2000
MaxNoOfUniqueHashIndexes=2000

# Auto configure NDB to use all CPUs assigned (bind the process with
# cpubind.cnf; NumCPUs should match the size of that CPU set).
AutomaticThreadConfig=1
NumCPUs=4

# REDO sized for the load step (as ndbcrunch).
RedoBuffer=256M
FragmentLogFileSize=1G
NoOfFragmentLogFiles=8
SendBufferMemory=8M
MaxBufferedEpochBytes=512M

BatchSize=990
BatchByteSize=1M
MaxScanBatchSize=4M
DefaultOperationRedoProblemAction=queue
TransactionDeadlockDetectionTimeout=3000
HeartbeatIntervalDbDb=30000
HeartbeatIntervalDbApi=30000
UseOnlyIPv4=1

# Compiled interpreter (JIT) mode: OFF | AUTO | ON, default AUTO (= on).
# The driver flips it at runtime with
#   ndb_mgm -e "ALL SET CompiledInterpreter OFF|ON"
# or pins it here through --defaults-extra-file.
#CompiledInterpreter=AUTO

[api]
UseOnlyIPv4=1

[mysqld]
ndbcluster
# Two NDB API connections per mysqld so multi-threaded benchmark
# clients do not serialize on one transporter.
ndb-cluster-connection-pool=2
ndb-wait-connected=30
ndb-wait-setup=120
# Aggregation pushdown ON so mysqld reaches the (compiled) interpreter.
# The driver still sets these globals explicitly per arm (its
# "mysqld_nopush" engine turns them off).
ndb-pushdown-aggregate=ON
ndb-join-pushdown-aggregate=ON
ndb-join-pushdown-aggregate-outer-join=ON
# Allow large number of connected clients
max-connections=1200
max_prepared_stmt_count=4194304
# No binlog, no query logs: benchmark
skip-log-bin
skip-log-replica-updates
general_log=OFF
slow_query_log=OFF
log-error-verbosity=2
default-time-zone="+00:00"
local-infile=true

[ndb_mgm]
verbose=0

# RDRS: REST + RonSQL, auth disabled, no TLS. Rondis is off here; add
# --defaults-extra-file=suite/ronsqlcrunch/rondis.cnf to enable it.
# For the [rdrs.N.M] option semantics see suite/rdrs2-golang/my.cnf.
[rdrs.1.1]
config-json-template=suite/ronsqlcrunch/rdrs_config_template.json
UseHopsworksAPIKeys=false
InsecureAllowAll=true
RESTNumThreads=64
enable-rondis=false

[ENV]
# Always use ndbmtd for the data nodes
MTR_NDBMTD=1
NDB_CONNECTSTRING=             @mysql_cluster.1.ndb_connectstring
NDB_MGMD_PORT=                 @cluster_config.ndb_mgmd.1.1.PortNumber
MASTER_MYSOCK=                 @mysqld.1.1.socket
MASTER_MYPORT=                 @mysqld.1.1.port
MASTER_MYPORT1=                @mysqld.2.1.port
RDRS_HOST=                     @rdrs.1.1.#host
RDRS_PORT=                     @rdrs.1.1.port
RONDIS_PORT=                   @rdrs.1.1.rondisport
