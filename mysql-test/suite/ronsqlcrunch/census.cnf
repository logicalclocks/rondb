# Memory for the RONDB-1121 M3.0 performance census
# (storage/ndb/claude_files/fs_ronsql/m3_plan.md): TPC-H sf 1 and the
# feature-store data set (fs_bench sf 1) loaded side by side in one
# cluster, so one ronsql_bench_matrix.py run covers every registry
# category (--queries all --load both).
#
# The driver takes it through --cpubind, which is a plain
# --defaults-extra-file for mtr (the driver appends its own
# CompiledInterpreter / RDRS settings the same way); on Linux add the
# cpubind= lines of cpubind.cnf below.
#
#   python3 storage/ndb/claude_files/compiled_interpreter/ronsql_bench_matrix.py \
#       --build prod_build --queries all --load both --sf 1 \
#       --cpubind mysql-test/suite/ronsqlcrunch/census.cnf ...

[cluster_config.1]
TotalMemoryConfig=12G
DataMemory=6G
# NumCPUs must equal the size of each data node's cpubind set: with the
# suite default (4) a node bound to 15 CPUs still runs the 4-CPU thread
# configuration (2 LDM threads) and leaves the rest idle — census run 4
# did exactly that.  Uncomment and set together with the cpubind lines.
#NumCPUs=15

# RDRS gets as many NDB data connections as each mysqld has
# (ndb-cluster-connection-pool=2 in my.cnf), so an engine comparison
# under concurrency does not pit one RDRS receive thread against two
# mysqld ones (census run 5, fs_hw_floor / fs_hw_snow1_point at T=8).
[rdrs.1.1]
RonDBConnectionPoolSize=2

# CPU binding for a benchmark computer (Linux, taskset); keep the sets
# disjoint: data nodes, mysqld, RDRS (the RonSQL client's server: it
# needs its own CPUs), and the rondb-cli client (--client-cpus).
#[cluster_config.ndbd.1.1]
#cpubind=0-14
#[cluster_config.ndbd.2.1]
#cpubind=16-30
#[mysqld.1.1]
#cpubind=15,31
#[mysqld.2.1]
#cpubind=15,31
#[rdrs.1.1]
#cpubind=32-35
