SET ndb_ring_buffer_show_meta = 0;
#
# Case 4: a ring buffer table renamed to a name with a conflict function
# replicates without it, and TRUNCATE keeps it
#
CREATE TABLE test.rb_later (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
X INT UNSIGNED NOT NULL,
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB, COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
RENAME TABLE test.rb_later TO test.rb_renamed;
INSERT INTO test.rb_renamed (client_id, X) VALUES (1, 1);
INSERT INTO test.rb_renamed (client_id, X) VALUES (1, 2);
INSERT INTO test.rb_renamed (client_id, X) VALUES (1, 3);
INSERT INTO test.rb_renamed (client_id, X) VALUES (1, 4);
INSERT INTO test.rb_renamed (client_id, X) VALUES (1, 5);
SET ndb_ring_buffer_show_meta = 1;
SELECT client_id, ring_idx, HEX(ring_meta), X FROM test.rb_renamed ORDER BY ring_idx;
client_id	ring_idx	HEX(ring_meta)	X
1	0	0100000003000000030000000000000005000000000000000000000000000000	0
1	1	NULL	4
1	2	NULL	5
1	3	NULL	3
SET ndb_ring_buffer_show_meta = 0;
# Same rows and meta row as on the source
SET ndb_ring_buffer_show_meta = 1;
SELECT client_id, ring_idx, HEX(ring_meta), X FROM test.rb_renamed ORDER BY ring_idx;
client_id	ring_idx	HEX(ring_meta)	X
1	0	0100000003000000030000000000000005000000000000000000000000000000	0
1	1	NULL	4
1	2	NULL	5
1	3	NULL	3
SET ndb_ring_buffer_show_meta = 0;
include/assert.inc [No conflicts counted on the renamed ring table]
