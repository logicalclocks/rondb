#
# Case 2: a plain table with the same conflict function is accepted
#
CREATE TABLE test.plain_max (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
X INT UNSIGNED NOT NULL,
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB;
SHOW WARNINGS;
Level	Code	Message
#
# Case 3: a ring buffer table without a conflict function replicates
#
CREATE TABLE test.rb_none (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
X INT UNSIGNED NOT NULL,
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB, COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_none (client_id, X) VALUES (1, 1);
INSERT INTO test.rb_none (client_id, X) VALUES (1, 2);
INSERT INTO test.rb_none (client_id, X) VALUES (1, 3);
INSERT INTO test.rb_none (client_id, X) VALUES (1, 4);
INSERT INTO test.rb_none (client_id, X) VALUES (1, 5);
SET ndb_ring_buffer_show_meta = 1;
