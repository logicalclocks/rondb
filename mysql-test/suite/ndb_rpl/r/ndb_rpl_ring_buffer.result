#
# Case 14: TTL ring buffer table - DDL, visibility and meta row replicate
#
SET time_zone = '+00:00';
CREATE TABLE test.rb_ttl (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ts TIMESTAMP NULL,
val VARCHAR(50),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_ttl (client_id, ts, val) VALUES (1, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'expired_1');
INSERT INTO test.rb_ttl (client_id, ts, val) VALUES (1, NOW(), 'live_2');
INSERT INTO test.rb_ttl (client_id, ts, val) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 DAY), 'future_3');
SELECT client_id, ring_idx, val FROM test.rb_ttl ORDER BY ring_idx;
client_id	ring_idx	val
1	2	live_2
1	3	future_3
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx, ts, HEX(ring_meta) FROM test.rb_ttl WHERE ring_idx = 0;
client_id	ring_idx	ts	HEX(ring_meta)
1	0	2038-01-19 03:14:07	0100000001000000030000000000000003000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
SET time_zone = '+00:00';
