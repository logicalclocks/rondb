) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=400@ring_idx@ring_meta";
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'Ring index column must have DEFAULT (e.g. 0)'
#
# Case 20: FOREIGN KEY on ring buffer table — blocked
#
CREATE TABLE test.fk_parent (
id INT NOT NULL PRIMARY KEY
) ENGINE = NDB;
CREATE TABLE test.rb_fk_child (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
parent_id INT NOT NULL,
PRIMARY KEY (id, ring_idx),
FOREIGN KEY (parent_id) REFERENCES test.fk_parent(id)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
ERROR HY000: Cannot add foreign key constraint
CREATE TABLE test.rb_fk_parent (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
code INT NOT NULL,
PRIMARY KEY (id, ring_idx),
UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
CREATE TABLE test.fk_child_of_rb (
id INT NOT NULL PRIMARY KEY,
code INT NOT NULL,
FOREIGN KEY (code) REFERENCES test.rb_fk_parent(code)
) ENGINE = NDB;
ERROR HY000: Cannot add foreign key constraint
DROP TABLE test.rb_fk_parent;
DROP TABLE test.fk_parent;
