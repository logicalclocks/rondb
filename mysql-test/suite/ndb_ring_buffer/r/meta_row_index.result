DROP TABLE test.rb_wrap_add_uniq;
#
# Case 15: Cross-prefix unique constraint with wrapping
#
CREATE TABLE test.rb_cross_uniq (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
code INT NOT NULL,
PRIMARY KEY (id, ring_idx),
UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=2@ring_idx@ring_meta";
INSERT INTO test.rb_cross_uniq (id, code) VALUES (1, 10);
INSERT INTO test.rb_cross_uniq (id, code) VALUES (1, 20);
INSERT INTO test.rb_cross_uniq (id, code) VALUES (2, 30);
INSERT INTO test.rb_cross_uniq (id, code) VALUES (2, 40);
INSERT INTO test.rb_cross_uniq (id, code) VALUES (1, 30);
ERROR 23000: Duplicate entry '30' for key 'rb_cross_uniq.idx_code'
INSERT INTO test.rb_cross_uniq (id, code) VALUES (1, 50);
INSERT INTO test.rb_cross_uniq (id, code) VALUES (2, 10);
SELECT id, ring_idx, code FROM test.rb_cross_uniq ORDER BY id, ring_idx;
id	ring_idx	code
1	1	50
1	2	20
2	1	10
2	2	40
DROP TABLE test.rb_cross_uniq;
