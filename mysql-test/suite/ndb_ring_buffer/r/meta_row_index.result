#
# Case 17: Multiple NOT NULL types — VARCHAR + INT with indexes
#
CREATE TABLE test.rb_nn_types (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
name VARCHAR(100) NOT NULL,
score INT NOT NULL,
PRIMARY KEY (id, ring_idx),
UNIQUE INDEX idx_name (name),
INDEX idx_score (score)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_nn_types (id, name, score) VALUES (1, 'Alice', 90);
INSERT INTO test.rb_nn_types (id, name, score) VALUES (2, 'Bob', 85);
INSERT INTO test.rb_nn_types (id, name, score) VALUES (3, 'Charlie', 95);
INSERT INTO test.rb_nn_types (id, name, score) VALUES (4, 'Alice', 70);
ERROR 23000: Duplicate entry 'Alice' for key 'rb_nn_types.idx_name'
INSERT INTO test.rb_nn_types (id, name, score) VALUES (4, '', 70);
SELECT id, ring_idx, name, score FROM test.rb_nn_types ORDER BY id, ring_idx;
id	ring_idx	name	score
1	1	Alice	90
2	1	Bob	85
3	1	Charlie	95
4	1		70
SELECT id, ring_idx, name, score FROM test.rb_nn_types
WHERE score = 0
ORDER BY id, ring_idx;
id	ring_idx	name	score
DROP TABLE test.rb_nn_types;
#
# Case 18: NOT NULL BLOB/TEXT columns — blocked at CREATE TABLE
#
CREATE TABLE test.rb_nn_text (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
content TEXT NOT NULL,
PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'Ring buffer tables cannot have NOT NULL BLOB/TEXT columns'
CREATE TABLE test.rb_nn_blob (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
payload BLOB NOT NULL,
PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'Ring buffer tables cannot have NOT NULL BLOB/TEXT columns'
CREATE TABLE test.rb_null_text (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
content TEXT,
PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_null_text (id, content) VALUES (1, 'Hello World');
INSERT INTO test.rb_null_text (id, content) VALUES (2, REPEAT('x', 1000));
SELECT id, ring_idx, LENGTH(content) FROM test.rb_null_text ORDER BY id, ring_idx;
id	ring_idx	LENGTH(content)
1	1	11
2	1	1000
DROP TABLE test.rb_null_text;
