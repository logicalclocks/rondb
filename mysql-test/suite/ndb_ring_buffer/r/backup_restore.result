#
# Case 10: restore with --promote-attributes (staging table move)
#
CREATE TABLE test.rb_promo (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
val INT,
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_promo (client_id, val) VALUES (1, 100);
INSERT INTO test.rb_promo (client_id, val) VALUES (1, 200);
INSERT INTO test.rb_promo (client_id, val) VALUES (1, 300);
INSERT INTO test.rb_promo (client_id, val) VALUES (1, 400);
INSERT INTO test.rb_promo (client_id, val) VALUES (2, 500);
SELECT client_id, ring_idx, val FROM test.rb_promo ORDER BY client_id, ring_idx;
client_id	ring_idx	val
1	1	400
1	2	200
1	3	300
2	1	500
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM test.rb_promo WHERE ring_idx = 0 ORDER BY client_id;
client_id	HEX(ring_meta)
1	0100000002000000030000000000000004000000000000000000000000000000
2	0100000002000000010000000000000001000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
DROP TABLE test.rb_promo;
