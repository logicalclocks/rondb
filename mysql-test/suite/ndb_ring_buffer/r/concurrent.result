#
# Setup
#
CREATE TABLE test.rb (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
event_data VARCHAR(100),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=8@ring_idx@ring_meta";
#
# Case 1: Two sessions inserting to different PK prefixes - no conflict
#
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'con1_A');
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'con1_B');
INSERT INTO test.rb (client_id, event_data) VALUES (2, 'con2_A');
INSERT INTO test.rb (client_id, event_data) VALUES (2, 'con2_B');
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'con1_C');
INSERT INTO test.rb (client_id, event_data) VALUES (2, 'con2_C');
SELECT client_id, ring_idx, event_data FROM test.rb
ORDER BY client_id, ring_idx;
client_id	ring_idx	event_data
1	1	con1_A
1	2	con1_B
1	3	con1_C
2	1	con2_A
2	2	con2_B
2	3	con2_C
#
# Case 2: Two sessions inserting to same PK prefix - sequential
#
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'con1_X');
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'con1_Y');
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'con2_Z');
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'con2_W');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 3
ORDER BY ring_idx;
client_id	ring_idx	event_data
3	1	con1_X
3	2	con1_Y
3	3	con2_Z
3	4	con2_W
#
# Case 3: Concurrent sessions fill and wrap the ring
#
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'fill_5');
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'fill_6');
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'fill_7');
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'fill_8');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 3
ORDER BY ring_idx;
client_id	ring_idx	event_data
3	1	con1_X
3	2	con1_Y
3	3	con2_Z
3	4	con2_W
3	5	fill_5
3	6	fill_6
3	7	fill_7
3	8	fill_8
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'wrap_9');
INSERT INTO test.rb (client_id, event_data) VALUES (3, 'wrap_10');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 3
ORDER BY ring_idx;
client_id	ring_idx	event_data
3	1	wrap_9
3	2	wrap_10
3	3	con2_Z
3	4	con2_W
3	5	fill_5
3	6	fill_6
3	7	fill_7
3	8	fill_8
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx, HEX(ring_meta) FROM test.rb
WHERE client_id = 3 AND ring_idx = 0;
client_id	ring_idx	HEX(ring_meta)
3	0	010000000300000008000000000000000A000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 4: One session inserts, another reads - meta rows never visible
#
INSERT INTO test.rb (client_id, event_data) VALUES (4, 'read_test_A');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 4
ORDER BY ring_idx;
client_id	ring_idx	event_data
4	1	read_test_A
SELECT COUNT(*) AS cnt FROM test.rb WHERE client_id = 4;
cnt
1
INSERT INTO test.rb (client_id, event_data) VALUES (4, 'read_test_B');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 4
ORDER BY ring_idx;
client_id	ring_idx	event_data
4	1	read_test_A
4	2	read_test_B
SELECT COUNT(*) AS cnt FROM test.rb WHERE client_id = 4;
cnt
2
#
# Case 5: Transaction isolation - committed data visible to other session
#
BEGIN;
INSERT INTO test.rb (client_id, event_data) VALUES (5, 'tx_A');
INSERT INTO test.rb (client_id, event_data) VALUES (5, 'tx_B');
COMMIT;
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 5
ORDER BY ring_idx;
client_id	ring_idx	event_data
5	1	tx_A
5	2	tx_B
#
# Case 6: Transaction isolation - rolled back data not visible
#
BEGIN;
INSERT INTO test.rb (client_id, event_data) VALUES (6, 'rollback_A');
INSERT INTO test.rb (client_id, event_data) VALUES (6, 'rollback_B');
ROLLBACK;
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 6
ORDER BY ring_idx;
client_id	ring_idx	event_data
INSERT INTO test.rb (client_id, event_data) VALUES (6, 'after_rb');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 6
ORDER BY ring_idx;
client_id	ring_idx	event_data
6	1	after_rb
#
# Case 7: DELETE in one session, re-INSERT in another
#
DELETE FROM test.rb WHERE client_id = 1;
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 1
ORDER BY ring_idx;
client_id	ring_idx	event_data
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'reborn_A');
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'reborn_B');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 1
ORDER BY ring_idx;
client_id	ring_idx	event_data
1	1	reborn_A
1	2	reborn_B
#
# Case 8: UPDATE from con1, INSERT from con2 on same prefix
#
UPDATE test.rb SET event_data = 'UPDATED' WHERE client_id = 1 AND ring_idx = 1;
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'after_update');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 1
ORDER BY ring_idx;
client_id	ring_idx	event_data
1	1	UPDATED
1	2	reborn_B
1	3	after_update
#
# Case 9: concurrent first-insert on a fresh prefix
#
BEGIN;
INSERT INTO test.rb (client_id, event_data) VALUES (9, 'racer1');
INSERT INTO test.rb (client_id, event_data) VALUES (9, 'racer2');
COMMIT;
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 9
ORDER BY ring_idx;
client_id	ring_idx	event_data
9	1	racer1
9	2	racer2
#
# Case 10: overlapping transactions on one prefix, meta byte-exact
#
BEGIN;
INSERT INTO test.rb (client_id, event_data) VALUES (20, 'txn1_a');
INSERT INTO test.rb (client_id, event_data) VALUES (20, 'txn2_x');
INSERT INTO test.rb (client_id, event_data) VALUES (20, 'txn1_b');
COMMIT;
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 20
ORDER BY ring_idx;
client_id	ring_idx	event_data
20	1	txn1_a
20	2	txn1_b
20	3	txn2_x
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb WHERE client_id = 20 AND ring_idx = 0;
HEX(ring_meta)
0100000004000000030000000000000003000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 11: whole-ring DELETE waits for an open INSERT on the prefix
#
CREATE TABLE test.rb_l1 (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
v INT,
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=20@ring_idx@ring_meta";
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 1);
BEGIN;
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 2);
DELETE FROM test.rb_l1 WHERE client_id = 1;
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 3);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 4);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 5);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 6);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 7);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 8);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 9);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 10);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 11);
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 12);
COMMIT;
# No row of prefix 1 may survive, data or meta
SET ndb_ring_buffer_show_meta = ON;
SELECT COUNT(*) FROM test.rb_l1 WHERE client_id = 1;
COUNT(*)
0
SET ndb_ring_buffer_show_meta = OFF;
# The next insert starts a fresh ring at slot 1
INSERT INTO test.rb_l1 (client_id, v) VALUES (1, 100);
SELECT ring_idx, v FROM test.rb_l1 WHERE client_id = 1 ORDER BY ring_idx;
ring_idx	v
1	100
# Same with a prepared DELETE: the prefix value is a parameter
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 1);
BEGIN;
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 2);
PREPARE del_prefix FROM 'DELETE FROM test.rb_l1 WHERE client_id = ?';
SET @prefix = 2;
EXECUTE del_prefix USING @prefix;
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 3);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 4);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 5);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 6);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 7);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 8);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 9);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 10);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 11);
INSERT INTO test.rb_l1 (client_id, v) VALUES (2, 12);
COMMIT;
DEALLOCATE PREPARE del_prefix;
SET ndb_ring_buffer_show_meta = ON;
SELECT COUNT(*) FROM test.rb_l1 WHERE client_id = 2;
COUNT(*)
0
SET ndb_ring_buffer_show_meta = OFF;
# Same with IN (): the DELETE locks the meta row of every listed prefix
INSERT INTO test.rb_l1 (client_id, v) VALUES (3, 1);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 1);
BEGIN;
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 2);
DELETE FROM test.rb_l1 WHERE client_id IN (3, 4, 5);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 3);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 4);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 5);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 6);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 7);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 8);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 9);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 10);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 11);
INSERT INTO test.rb_l1 (client_id, v) VALUES (4, 12);
COMMIT;
SET ndb_ring_buffer_show_meta = ON;
SELECT COUNT(*) FROM test.rb_l1 WHERE client_id IN (3, 4);
COUNT(*)
0
SET ndb_ring_buffer_show_meta = OFF;
DROP TABLE test.rb_l1;
#
# Cleanup
#
DROP TABLE test.rb;
# Done.
