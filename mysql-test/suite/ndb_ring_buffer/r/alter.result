) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='NDB_TABLE=TTL=7200@created_at,MAX_ROWS_PER_PK=3@ring_idx@ring_meta'
ALTER TABLE test.rb_ttl2 COMMENT="NDB_TABLE=TTL=OFF,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
