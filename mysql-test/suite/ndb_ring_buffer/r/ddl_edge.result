#
# Case 9: INFORMATION_SCHEMA.TABLES for ring-buffer table
#
CREATE TABLE test.rb_is (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
val VARCHAR(50),
PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_is (id, val) VALUES (1, 'x');
INSERT INTO test.rb_is (id, val) VALUES (1, 'y');
SELECT TABLE_NAME, ENGINE, TABLE_COMMENT
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'rb_is';
TABLE_NAME	ENGINE	TABLE_COMMENT
rb_is	ndbcluster	NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta
SELECT COLUMN_NAME, DATA_TYPE, IS_NULLABLE, COLUMN_DEFAULT
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'rb_is'
    ORDER BY ORDINAL_POSITION;
COLUMN_NAME	DATA_TYPE	IS_NULLABLE	COLUMN_DEFAULT
id	int	NO	NULL
ring_idx	int	NO	0
ring_meta	varbinary	YES	NULL
val	varchar	YES	NULL
DROP TABLE test.rb_is;
#
# Case 10: ALTER TABLE DROP ring_idx/ring_meta columns - blocked
#
CREATE TABLE test.rb_drop_col (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
val VARCHAR(50),
PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
ALTER TABLE test.rb_drop_col DROP COLUMN ring_idx;
