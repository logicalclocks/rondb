DROP TABLE test.rb_drop_col;
#
# Case 11: AFTER INSERT trigger on ring-buffer table
#
CREATE TABLE test.rb_trigger (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
val VARCHAR(50),
PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
CREATE TABLE test.trigger_log (
log_id INT AUTO_INCREMENT PRIMARY KEY,
logged_id INT,
logged_val VARCHAR(50)
) ENGINE = NDB;
CREATE TRIGGER test.rb_after_ins AFTER INSERT ON test.rb_trigger
FOR EACH ROW
BEGIN
INSERT INTO test.trigger_log (logged_id, logged_val)
VALUES (NEW.id, NEW.val);
END//
INSERT INTO test.rb_trigger (id, val) VALUES (1, 'trig_A');
INSERT INTO test.rb_trigger (id, val) VALUES (1, 'trig_B');
SELECT id, ring_idx, val FROM test.rb_trigger ORDER BY ring_idx;
id	ring_idx	val
1	1	trig_A
1	2	trig_B
SELECT log_id, logged_id, logged_val FROM test.trigger_log ORDER BY log_id;
log_id	logged_id	logged_val
1	1	trig_A
2	1	trig_B
INSERT INTO test.rb_trigger (id, val) VALUES (1, 'trig_C');
INSERT INTO test.rb_trigger (id, val) VALUES (1, 'trig_D');
SELECT id, ring_idx, val FROM test.rb_trigger ORDER BY ring_idx;
id	ring_idx	val
1	1	trig_D
1	2	trig_B
1	3	trig_C
SELECT log_id, logged_id, logged_val FROM test.trigger_log ORDER BY log_id;
log_id	logged_id	logged_val
1	1	trig_A
2	1	trig_B
3	1	trig_C
4	1	trig_D
DROP TRIGGER test.rb_after_ins;
DROP TABLE test.trigger_log;
DROP TABLE test.rb_trigger;
