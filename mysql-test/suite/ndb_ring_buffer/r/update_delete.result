#
# Case 37: DELETE on ring-buffer table with DELETE triggers - blocked
#
CREATE TABLE test.rb_trig (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
val VARCHAR(50),
PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_trig (id, val) VALUES (1, 'a');
INSERT INTO test.rb_trig (id, val) VALUES (1, 'b');
INSERT INTO test.rb_trig (id, val) VALUES (1, 'c');
CREATE TRIGGER test.rb_trig_ad AFTER DELETE ON test.rb_trig
FOR EACH ROW SET @del_cnt = IFNULL(@del_cnt, 0) + 1;
SET @del_cnt = 0;
DELETE FROM test.rb_trig WHERE id = 1;
