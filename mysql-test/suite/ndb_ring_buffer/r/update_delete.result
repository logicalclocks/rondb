#
# Setup: Create ring-buffer table with ring_size=4
#
CREATE TABLE test.rb (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
event_data VARCHAR(100),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'ev_A');
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'ev_B');
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'ev_C');
INSERT INTO test.rb (client_id, event_data) VALUES (2, 'ev_X');
INSERT INTO test.rb (client_id, event_data) VALUES (2, 'ev_Y');
SELECT client_id, ring_idx, event_data FROM test.rb
ORDER BY client_id, ring_idx;
client_id	ring_idx	event_data
1	1	ev_A
1	2	ev_B
1	3	ev_C
2	1	ev_X
2	2	ev_Y
#
# ===== UPDATE TESTS =====
#
#
# Case 1: UPDATE user column on data row - allowed
#
UPDATE test.rb SET event_data = 'updated_A'
    WHERE client_id = 1 AND ring_idx = 1;
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	event_data
1	1	updated_A
1	2	ev_B
1	3	ev_C
#
# Case 2: UPDATE user column via scan (no ring_idx in WHERE) - allowed
#
UPDATE test.rb SET event_data = 'scan_update'
    WHERE client_id = 1 AND event_data = 'ev_B';
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	event_data
1	1	updated_A
1	2	scan_update
1	3	ev_C
#
# Case 3: UPDATE ring_idx column - blocked
#
UPDATE test.rb SET ring_idx = 5 WHERE client_id = 1 AND ring_idx = 1;
ERROR HY000: Table storage engine for 'Cannot update ring_idx on ring-buffer table' doesn't have this option
#
# Case 4: UPDATE ring_meta column - blocked
#
UPDATE test.rb SET ring_meta = 'bad' WHERE client_id = 1 AND ring_idx = 1;
ERROR HY000: Table storage engine for 'Cannot update ring_meta on ring-buffer table' doesn't have this option
#
# Case 5: UPDATE meta row (ring_idx=0) - blocked
# Need show_meta=ON to make the scan see the meta row
#
SET ndb_ring_buffer_show_meta = ON;
UPDATE test.rb SET event_data = 'hack' WHERE client_id = 1 AND ring_idx = 0;
ERROR HY000: Table storage engine for 'Cannot update meta row on ring-buffer table' doesn't have this option
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 6: UPDATE all data rows for a PK prefix via scan
#
UPDATE test.rb SET event_data = CONCAT(event_data, '_v2')
WHERE client_id = 1;
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	event_data
1	1	updated_A_v2
1	2	scan_update_v2
1	3	ev_C_v2
#
# Case 7: UPDATE with expression in SET value
#
UPDATE test.rb SET event_data = UPPER(event_data)
WHERE client_id = 2 AND ring_idx = 1;
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 2 ORDER BY ring_idx;
client_id	ring_idx	event_data
2	1	EV_X
2	2	ev_Y
#
# Case 8: UPDATE non-existent row - 0 rows affected, no error
#
UPDATE test.rb SET event_data = 'ghost'
    WHERE client_id = 999 AND ring_idx = 1;
SELECT ROW_COUNT();
ROW_COUNT()
0
#
# Case 9: UPDATE ring_idx + user column together - blocked
# (ring_idx in write_set triggers block even if user col also present)
#
UPDATE test.rb SET ring_idx = 9, event_data = 'sneaky'
    WHERE client_id = 1 AND ring_idx = 1;
ERROR HY000: Table storage engine for 'Cannot update ring_idx on ring-buffer table' doesn't have this option
#
# ===== DELETE TESTS =====
#
#
# Case 10: DELETE with full PK prefix - allowed
# Deletes all data rows + meta row for client_id=2
#
DELETE FROM test.rb WHERE client_id = 2;
SELECT client_id, ring_idx, event_data FROM test.rb
ORDER BY client_id, ring_idx;
client_id	ring_idx	event_data
1	1	updated_A_v2
1	2	scan_update_v2
1	3	ev_C_v2
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx FROM test.rb
WHERE client_id = 2 AND ring_idx = 0;
client_id	ring_idx
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 11: Re-INSERT after delete creates fresh ring
#
INSERT INTO test.rb (client_id, event_data) VALUES (2, 'fresh_A');
INSERT INTO test.rb (client_id, event_data) VALUES (2, 'fresh_B');
SELECT client_id, ring_idx, event_data FROM test.rb
WHERE client_id = 2 ORDER BY ring_idx;
client_id	ring_idx	event_data
2	1	fresh_A
2	2	fresh_B
#
# Case 12: DELETE individual row (ring_idx in WHERE) - blocked
#
DELETE FROM test.rb WHERE client_id = 1 AND ring_idx = 1;
ERROR HY000: Table storage engine for 'DELETE WHERE on ring-buffer table may only reference PK-prefix columns (excluding ring_idx)' doesn't have this option
#
# Case 13: DELETE with non-PK column in WHERE - blocked
#
DELETE FROM test.rb WHERE client_id = 1 AND event_data = 'ev_C';
ERROR HY000: Table storage engine for 'DELETE WHERE on ring-buffer table may only reference PK-prefix columns (excluding ring_idx)' doesn't have this option
#
# Case 14: DELETE without WHERE (full table) - rejected
# It could not lock the rings it deletes; TRUNCATE clears all data
# rows + meta rows for all PK prefixes
#
DELETE FROM test.rb;
ERROR HY000: Table storage engine for 'DELETE on ring-buffer table must give every PK-prefix column with = or IN; use TRUNCATE TABLE to clear the table' doesn't have this option
TRUNCATE TABLE test.rb;
SELECT client_id, ring_idx, event_data FROM test.rb
ORDER BY client_id, ring_idx;
client_id	ring_idx	event_data
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx FROM test.rb WHERE ring_idx = 0;
client_id	ring_idx
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 15: Re-INSERT after bare DELETE creates fresh rings
#
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'after_clear_A');
INSERT INTO test.rb (client_id, event_data) VALUES (2, 'after_clear_B');
SELECT client_id, ring_idx, event_data FROM test.rb
ORDER BY client_id, ring_idx;
client_id	ring_idx	event_data
1	1	after_clear_A
2	1	after_clear_B
#
# Case 16: Multi-column PK prefix DELETE
#
DROP TABLE test.rb;
CREATE TABLE test.rb_multi (
region INT NOT NULL,
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
event_data VARCHAR(100),
PRIMARY KEY (region, client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (1, 100, 'a');
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (1, 100, 'b');
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (1, 200, 'c');
SELECT region, client_id, ring_idx, event_data FROM test.rb_multi
ORDER BY region, client_id, ring_idx;
region	client_id	ring_idx	event_data
1	100	1	a
1	100	2	b
1	200	1	c
DELETE FROM test.rb_multi WHERE region = 1 AND client_id = 100;
SELECT region, client_id, ring_idx, event_data FROM test.rb_multi
ORDER BY region, client_id, ring_idx;
region	client_id	ring_idx	event_data
1	200	1	c
#
# Case 17: Partial PK prefix - rejected; name the rings of the region
#
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (1, 200, 'r1c200');
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (2, 300, 'r2c300');
DELETE FROM test.rb_multi WHERE region = 1;
ERROR HY000: Table storage engine for 'DELETE on ring-buffer table must give every PK-prefix column with = or IN; use TRUNCATE TABLE to clear the table' doesn't have this option
DELETE FROM test.rb_multi WHERE region = 1 AND client_id IN (100, 200);
SELECT region, client_id, ring_idx, event_data FROM test.rb_multi
ORDER BY region, client_id, ring_idx;
region	client_id	ring_idx	event_data
2	300	1	r2c300
#
# Case 18: DELETE with IN() on PK column - allowed
#
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (2, 400, 'r2c400');
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (2, 500, 'r2c500');
DELETE FROM test.rb_multi WHERE region = 2 AND client_id IN (300, 400);
SELECT region, client_id, ring_idx, event_data FROM test.rb_multi
ORDER BY region, client_id, ring_idx;
region	client_id	ring_idx	event_data
2	500	1	r2c500
SET ndb_ring_buffer_show_meta = ON;
SELECT region, client_id, ring_idx FROM test.rb_multi
WHERE region = 2 AND client_id IN (300, 400) AND ring_idx = 0;
region	client_id	ring_idx
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 19: DELETE with range on PK column - rejected, IN () allowed
#
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (3, 100, 'r3c100');
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (3, 200, 'r3c200');
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (3, 300, 'r3c300');
DELETE FROM test.rb_multi WHERE region = 3 AND client_id > 100;
ERROR HY000: Table storage engine for 'DELETE on ring-buffer table must give every PK-prefix column with = or IN; use TRUNCATE TABLE to clear the table' doesn't have this option
DELETE FROM test.rb_multi WHERE region = 3 AND client_id IN (200, 300);
SELECT region, client_id, ring_idx, event_data FROM test.rb_multi
WHERE region = 3 ORDER BY client_id, ring_idx;
region	client_id	ring_idx	event_data
3	100	1	r3c100
#
# Case 20: DELETE with non-PK column in WHERE - blocked
#
DELETE FROM test.rb_multi WHERE region = 3 AND event_data = 'r3c100';
ERROR HY000: Table storage engine for 'DELETE WHERE on ring-buffer table may only reference PK-prefix columns (excluding ring_idx)' doesn't have this option
#
# Case 21: DELETE with ring_idx in WHERE - blocked
#
DELETE FROM test.rb_multi WHERE region = 3 AND client_id = 100 AND ring_idx = 1;
ERROR HY000: Table storage engine for 'DELETE WHERE on ring-buffer table may only reference PK-prefix columns (excluding ring_idx)' doesn't have this option
#
# Case 22: DELETE non-existent prefix - allowed (0 rows, no error)
#
DELETE FROM test.rb_multi WHERE region = 99 AND client_id = 99;
SELECT ROW_COUNT();
ROW_COUNT()
0
#
# Case 23: DELETE + re-INSERT + DELETE cycle
#
DELETE FROM test.rb_multi WHERE region = 3 AND client_id = 100;
INSERT INTO test.rb_multi (region, client_id, event_data) VALUES (3, 100, 'cycle2_a');
SELECT region, client_id, ring_idx, event_data FROM test.rb_multi
WHERE region = 3 AND client_id = 100 ORDER BY ring_idx;
region	client_id	ring_idx	event_data
3	100	1	cycle2_a
DROP TABLE test.rb_multi;
#
# Case 24: DELETE on ring_size=1 table
#
CREATE TABLE test.rb1 (
pk INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
val VARCHAR(50),
PRIMARY KEY (pk, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=1@ring_idx@ring_meta";
INSERT INTO test.rb1 (pk, val) VALUES (1, 'only_slot');
SELECT pk, ring_idx, val FROM test.rb1 ORDER BY pk, ring_idx;
pk	ring_idx	val
1	1	only_slot
DELETE FROM test.rb1 WHERE pk = 1;
SELECT pk, ring_idx, val FROM test.rb1 ORDER BY pk, ring_idx;
pk	ring_idx	val
SET ndb_ring_buffer_show_meta = ON;
SELECT pk, ring_idx FROM test.rb1 WHERE pk = 1 AND ring_idx = 0;
pk	ring_idx
SET ndb_ring_buffer_show_meta = OFF;
INSERT INTO test.rb1 (pk, val) VALUES (1, 'after_delete');
SELECT pk, ring_idx, val FROM test.rb1 ORDER BY pk, ring_idx;
pk	ring_idx	val
1	1	after_delete
DROP TABLE test.rb1;
