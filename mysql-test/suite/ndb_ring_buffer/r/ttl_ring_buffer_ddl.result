  `ts2` timestamp NULL DEFAULT NULL,
  `val` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`client_id`,`ring_idx`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='NDB_TABLE=READ_BACKUP=1,TTL=3600@ts2,MAX_ROWS_PER_PK=4@ring_idx@ring_meta'
#
# Case 7: a copying ALTER drops expired rows (the copy scan does not see them) and copies the meta row as is
#
UPDATE test.rb SET ts2 = DATE_SUB(NOW(), INTERVAL 5 HOUR) WHERE client_id = 1 AND ring_idx = 1;
SELECT client_id, ring_idx, val FROM test.rb ORDER BY ring_idx;
client_id	ring_idx	val
1	2	live_2
1	3	live_3
1	4	live_4
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb';
physical_rows
5
ALTER TABLE test.rb ALGORITHM=COPY, ADD COLUMN extra INT DEFAULT 0;
SHOW CREATE TABLE test.rb;
Table	Create Table
rb	CREATE TABLE `rb` (
  `client_id` int NOT NULL,
  `ring_idx` int NOT NULL DEFAULT '0',
  `ring_meta` varbinary(64) DEFAULT NULL,
  `ts2` timestamp NULL DEFAULT NULL,
  `val` varchar(50) DEFAULT NULL,
  `extra` int DEFAULT '0',
  PRIMARY KEY (`client_id`,`ring_idx`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='NDB_TABLE=READ_BACKUP=1,TTL=3600@ts2,MAX_ROWS_PER_PK=4@ring_idx@ring_meta'
SELECT client_id, ring_idx, val, extra FROM test.rb ORDER BY ring_idx;
client_id	ring_idx	val	extra
1	2	live_2	0
1	3	live_3	0
1	4	live_4	0
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb';
physical_rows
4
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx, ts2, HEX(ring_meta) FROM test.rb WHERE ring_idx = 0;
client_id	ring_idx	ts2	HEX(ring_meta)
1	0	2038-01-19 03:14:07	0100000002000000040000000000000005000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
INSERT INTO test.rb (client_id, ts2, val) VALUES (1, DATE_SUB(NOW(), INTERVAL 30 MINUTE), 'after_copy');
SELECT client_id, ring_idx, val, extra FROM test.rb ORDER BY ring_idx;
client_id	ring_idx	val	extra
1	2	after_copy	0
1	3	live_3	0
1	4	live_4	0
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb';
