#
# Case 8: an ordered index on a user column hides expired rows and meta rows
#
UPDATE test.rb SET ts2 = DATE_SUB(NOW(), INTERVAL 5 HOUR) WHERE client_id = 1 AND ring_idx = 3;
ALTER TABLE test.rb ADD INDEX idx_val (val);
SELECT client_id, ring_idx, val FROM test.rb FORCE INDEX (idx_val) WHERE val >= 'a' ORDER BY ring_idx;
client_id	ring_idx	val
1	2	after_copy
1	4	live_4
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx, val FROM test.rb FORCE INDEX (idx_val) WHERE val >= 'a' ORDER BY ring_idx;
client_id	ring_idx	val
1	2	after_copy
1	4	live_4
SET ndb_ring_buffer_show_meta = OFF;
ALTER TABLE test.rb DROP INDEX idx_val;
DROP TABLE test.rb;
#
# Case 9: a virtual generated column before the ring and TTL columns
#
CREATE TABLE test.rb_vcol (
client_id INT NOT NULL,
twice INT AS (client_id * 2) VIRTUAL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ts TIMESTAMP NULL,
val VARCHAR(50),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_vcol (client_id, ts, val) VALUES (1, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'exp_1');
INSERT INTO test.rb_vcol (client_id, ts, val) VALUES (1, NOW(), 'live_2');
INSERT INTO test.rb_vcol (client_id, ts, val) VALUES (1, NOW(), 'live_3'), (1, NOW(), 'wrap_4');
SELECT client_id, twice, ring_idx, val FROM test.rb_vcol ORDER BY ring_idx;
client_id	twice	ring_idx	val
1	2	1	wrap_4
1	2	2	live_2
1	2	3	live_3
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx, ts, HEX(ring_meta) FROM test.rb_vcol WHERE ring_idx = 0;
client_id	ring_idx	ts	HEX(ring_meta)
1	0	2038-01-19 03:14:07	0100000002000000030000000000000004000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
UPDATE test.rb_vcol SET val = 'live_2u' WHERE client_id = 1 AND ring_idx = 2;
DELETE FROM test.rb_vcol WHERE client_id = 1;
affected rows: 4
SELECT COUNT(*) FROM test.rb_vcol;
COUNT(*)
0
DROP TABLE test.rb_vcol;
#
# Case 10: the TTL column must not be a primary key column
#
CREATE TABLE test.rb_ttl_pk (
ts TIMESTAMP NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
v INT,
PRIMARY KEY (ts, ring_idx)
) ENGINE = NDB
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
