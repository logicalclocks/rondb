#
# Case 8: a rolled-back INSERT over an expired slot leaves the slot expired and the meta row unchanged
#
BEGIN;
INSERT INTO test.rb (client_id, ts, val) VALUES (1, NOW(), 'txn_9');
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	val
1	1	txn_9
1	2	wrap_6_u
1	3	over_7
1	4	over_8
ROLLBACK;
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	val
1	2	wrap_6_u
1	3	over_7
1	4	over_8
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb WHERE client_id = 1 AND ring_idx = 0;
HEX(ring_meta)
0100000001000000040000000000000008000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
BEGIN;
INSERT INTO test.rb (client_id, ts, val) VALUES (1, NOW(), 'txn_10');
COMMIT;
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	val
1	1	txn_10
1	2	wrap_6_u
1	3	over_7
1	4	over_8
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb WHERE client_id = 1 AND ring_idx = 0;
HEX(ring_meta)
0100000002000000040000000000000009000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 9: OPTIMIZE TABLE with expired rows present
#
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb';
physical_rows
13
OPTIMIZE TABLE test.rb;
Table	Op	Msg_type	Msg_text
test.rb	optimize	status	OK
SELECT client_id, COUNT(*) AS visible FROM test.rb GROUP BY client_id ORDER BY client_id;
client_id	visible
1	4
2	1
3	3
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb';
physical_rows
13
DROP TABLE test.rb;
#
# Case 10: an INSERT that omits columns writes their defaults into the slot it overwrites
#
CREATE TABLE test.rb_omit (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ts TIMESTAMP NULL,
val VARCHAR(50),
note VARCHAR(20) DEFAULT 'dflt',
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=2@ring_idx@ring_meta";
INSERT INTO test.rb_omit (client_id, ts, val, note) VALUES
(1, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'exp_1', 'old_note_1'),
(1, NOW(), 'live_2', 'old_note_2');
SELECT client_id, ring_idx, val, note FROM test.rb_omit ORDER BY ring_idx;
client_id	ring_idx	val	note
1	2	live_2	old_note_2
INSERT INTO test.rb_omit (client_id, val) VALUES (1, 'wrap_3');
SELECT client_id, ring_idx, val, note, ts IS NULL AS ts_null FROM test.rb_omit ORDER BY ring_idx;
client_id	ring_idx	val	note	ts_null
1	1	wrap_3	dflt	1
1	2	live_2	old_note_2	0
INSERT INTO test.rb_omit (client_id, ts, val) VALUES (1, NOW(), 'wrap_4'), (1, NOW(), 'wrap_5');
SELECT client_id, ring_idx, val, note FROM test.rb_omit ORDER BY ring_idx;
client_id	ring_idx	val	note
1	1	wrap_5	dflt
1	2	wrap_4	dflt
LOAD DATA LOCAL INFILE 'MYSQLTEST_VARDIR/tmp/rb_omit_load.csv'
    INTO TABLE test.rb_omit (client_id, val);
SELECT client_id, ring_idx, val, note, ts IS NULL AS ts_null FROM test.rb_omit ORDER BY ring_idx;
client_id	ring_idx	val	note	ts_null
1	1	wrap_5	dflt	0
1	2	load_6	dflt	1
DROP TABLE test.rb_omit;
#
# Case 11: the meta row's TTL column is the type maximum after multi-row INSERTs too
#
CREATE TABLE test.rb_batch (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ts TIMESTAMP NULL,
val VARCHAR(50),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
CREATE TABLE test.rb_batch_nn (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ts DATETIME NOT NULL DEFAULT '2000-01-01 00:00:00',
val VARCHAR(50),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
INSERT INTO test.rb_batch (client_id, ts, val) VALUES (1, NOW(), 'a'), (1, NOW(), 'b');
INSERT INTO test.rb_batch (client_id, ts, val) VALUES (2, NOW(), 'a');
INSERT INTO test.rb_batch (client_id, ts, val) VALUES (2, NOW(), 'b'), (2, NOW(), 'c');
INSERT INTO test.rb_batch_nn (client_id, ts, val) VALUES (1, NOW(), 'a'), (1, NOW(), 'b');
INSERT INTO test.rb_batch_nn (client_id, ts, val) VALUES (2, NOW(), 'a');
INSERT INTO test.rb_batch_nn (client_id, ts, val) VALUES (2, NOW(), 'b'), (2, NOW(), 'c');
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ts FROM test.rb_batch WHERE ring_idx = 0 ORDER BY client_id;
client_id	ts
1	2038-01-19 03:14:07
2	2038-01-19 03:14:07
SELECT client_id, ts FROM test.rb_batch_nn WHERE ring_idx = 0 ORDER BY client_id;
client_id	ts
1	9999-12-31 23:59:59
2	9999-12-31 23:59:59
SET ndb_ring_buffer_show_meta = OFF;
SELECT client_id, COUNT(*) AS visible FROM test.rb_batch GROUP BY client_id ORDER BY client_id;
client_id	visible
1	2
2	3
SELECT client_id, COUNT(*) AS visible FROM test.rb_batch_nn GROUP BY client_id ORDER BY client_id;
client_id	visible
1	2
2	3
DROP TABLE test.rb_batch;
DROP TABLE test.rb_batch_nn;
