SET time_zone = '+00:00';
#
# Case 1: multi-row INSERT fills and wraps over expired slots like live ones
#
CREATE TABLE test.rb (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ts TIMESTAMP NULL,
val VARCHAR(50),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
INSERT INTO test.rb (client_id, ts, val) VALUES
(1, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'exp_1'),
(1, NOW(), 'live_2'),
(1, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'exp_3'),
(1, NOW(), 'live_4');
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	val
1	2	live_2
1	4	live_4
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb WHERE client_id = 1 AND ring_idx = 0;
HEX(ring_meta)
0100000001000000040000000000000004000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
INSERT INTO test.rb (client_id, ts, val) VALUES (1, NOW(), 'wrap_5'), (1, NOW(), 'wrap_6');
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	val
1	1	wrap_5
1	2	wrap_6
1	4	live_4
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb WHERE client_id = 1 AND ring_idx = 0;
HEX(ring_meta)
0100000003000000040000000000000006000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb';
physical_rows
5
#
# Case 2: LOAD DATA - rows loaded with a past TTL value occupy their slots invisibly
#
LOAD DATA LOCAL INFILE 'MYSQLTEST_VARDIR/tmp/rb_ttl_load.csv'
    INTO TABLE test.rb (client_id, ts, val);
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 2 ORDER BY ring_idx;
client_id	ring_idx	val
2	2	load_live_2
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb WHERE client_id = 2 AND ring_idx = 0;
HEX(ring_meta)
0100000004000000030000000000000003000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 3: INSERT ... SELECT copies the visible rows only (no expired rows, no meta rows)
#
INSERT INTO test.rb (client_id, ts, val)
SELECT 3, ts, val FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 3 ORDER BY ring_idx;
client_id	ring_idx	val
3	1	wrap_5
3	2	wrap_6
3	3	live_4
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb WHERE client_id = 3 AND ring_idx = 0;
HEX(ring_meta)
0100000004000000030000000000000003000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 4: unique index - an expired row keeps its unique value until the ring overwrites the slot
#
CREATE TABLE test.rb_u (
id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ts TIMESTAMP NULL,
code INT NOT NULL,
PRIMARY KEY (id, ring_idx),
UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
INSERT INTO test.rb_u (id, ts, code) VALUES (1, DATE_SUB(NOW(), INTERVAL 2 HOUR), 100);
SELECT id, ring_idx, code FROM test.rb_u ORDER BY ring_idx;
id	ring_idx	code
INSERT INTO test.rb_u (id, ts, code) VALUES (1, NOW(), 100);
ERROR 23000: Duplicate entry '100' for key 'rb_u.idx_code'
INSERT INTO test.rb_u (id, ts, code) VALUES (1, NOW(), 200);
INSERT INTO test.rb_u (id, ts, code) VALUES (1, NOW(), 300);
INSERT INTO test.rb_u (id, ts, code) VALUES (1, NOW(), 100);
SELECT id, ring_idx, code FROM test.rb_u ORDER BY ring_idx;
id	ring_idx	code
1	1	100
1	2	200
1	3	300
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb_u WHERE id = 1 AND ring_idx = 0;
HEX(ring_meta)
0100000002000000030000000000000004000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
DROP TABLE test.rb_u;
#
# Case 5: scan UPDATE matches visible rows only; a NULL TTL value never expires
#
UPDATE test.rb SET val = CONCAT(val, '_u') WHERE client_id = 1;
affected rows: 3
info: Rows matched: 3  Changed: 3  Warnings: 0
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	val
1	1	wrap_5_u
1	2	wrap_6_u
1	4	live_4_u
UPDATE test.rb SET ts = NULL WHERE client_id = 1 AND ring_idx = 3;
affected rows: 0
info: Rows matched: 0  Changed: 0  Warnings: 0
UPDATE test.rb SET ts = NULL WHERE client_id = 1 AND ring_idx = 4;
UPDATE test.rb SET ts = DATE_SUB(NOW(), INTERVAL 5 HOUR) WHERE client_id = 1 AND ring_idx = 1;
SELECT client_id, ring_idx, val, ts IS NULL AS never_expires FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	val	never_expires
1	2	wrap_6_u	0
1	4	live_4_u	1
#
# Case 6: a NULL-TTL row is overwritten by the ring like any other slot
#
INSERT INTO test.rb (client_id, ts, val) VALUES (1, NOW(), 'over_7'), (1, NOW(), 'over_8');
SELECT client_id, ring_idx, val FROM test.rb WHERE client_id = 1 ORDER BY ring_idx;
client_id	ring_idx	val
1	2	wrap_6_u
1	3	over_7
1	4	over_8
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb WHERE client_id = 1 AND ring_idx = 0;
HEX(ring_meta)
0100000001000000040000000000000008000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 7: DELETE forms leave expired rows behind; ttl_expired_rows_visible_in_delete removes them
#
CREATE TABLE test.rb_del (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ts TIMESTAMP NULL,
val VARCHAR(50),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=TTL=3600@ts,MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
INSERT INTO test.rb_del (client_id, ts, val) VALUES
(5, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'p5_exp_1'),
(5, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'p5_exp_2'),
(5, NOW(), 'p5_live_3'),
(6, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'p6_exp_1'),
(6, DATE_SUB(NOW(), INTERVAL 2 HOUR), 'p6_exp_2');
SELECT client_id, ring_idx, val FROM test.rb_del ORDER BY client_id, ring_idx;
client_id	ring_idx	val
5	3	p5_live_3
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb_del' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb_del';
physical_rows
7
DELETE FROM test.rb_del WHERE client_id = 6;
affected rows: 1
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb_del' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb_del';
physical_rows
6
DELETE FROM test.rb_del WHERE client_id IN (5, 6);
affected rows: 2
SELECT COUNT(*) FROM test.rb_del;
COUNT(*)
0
SET ndb_ring_buffer_show_meta = ON;
SELECT COUNT(*) FROM test.rb_del;
COUNT(*)
0
SET ndb_ring_buffer_show_meta = OFF;
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb_del' AND fragment_num = 0) AS physical_rows FROM ndbinfo.memory_per_fragment WHERE fq_name = 'test/def/rb_del';
physical_rows
4
INSERT INTO test.rb_del (client_id, ts, val) VALUES (6, NOW(), 'p6_fresh_1');
SELECT client_id, ring_idx, val FROM test.rb_del ORDER BY client_id, ring_idx;
