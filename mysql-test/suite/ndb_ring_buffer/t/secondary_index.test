# ndb_ring_buffer_secondary_index.test
#
# Tests for ring-buffer tables with secondary indexes.
# Verifies that meta rows (ring_idx=0) are properly filtered when
# queries use a secondary index scan path, and that index operations
# work correctly after wrapping.

--source include/have_ndb.inc

###############################################################################
# Setup
###############################################################################

--echo #
--echo # Setup: ring-buffer table with secondary index on user column
--echo #

CREATE TABLE test.rb_idx (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    event_type VARCHAR(50),
    amount INT,
    PRIMARY KEY (client_id, ring_idx),
    INDEX idx_event_type (event_type),
    INDEX idx_amount (amount)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=4@ring_idx@ring_meta";

# Populate client_id=1 (4 rows - full ring)
INSERT INTO test.rb_idx (client_id, event_type, amount) VALUES (1, 'login', 10);
INSERT INTO test.rb_idx (client_id, event_type, amount) VALUES (1, 'purchase', 50);
INSERT INTO test.rb_idx (client_id, event_type, amount) VALUES (1, 'login', 20);
INSERT INTO test.rb_idx (client_id, event_type, amount) VALUES (1, 'refund', 30);

# Populate client_id=2 (2 rows)
INSERT INTO test.rb_idx (client_id, event_type, amount) VALUES (2, 'login', 5);
INSERT INTO test.rb_idx (client_id, event_type, amount) VALUES (2, 'purchase', 100);

###############################################################################
# Case 1: SELECT via secondary index hides meta rows
###############################################################################

--echo #
--echo # Case 1: SELECT via secondary index on VARCHAR - meta rows hidden
--echo #

SELECT client_id, ring_idx, event_type, amount FROM test.rb_idx
    WHERE event_type = 'login'
    ORDER BY client_id, ring_idx;

--echo #
--echo # Case 2: SELECT via secondary index on INT - meta rows hidden
--echo #

SELECT client_id, ring_idx, event_type, amount FROM test.rb_idx
    WHERE amount >= 20
    ORDER BY client_id, ring_idx;

###############################################################################
# Case 3: COUNT via secondary index excludes meta rows
###############################################################################

--echo #
--echo # Case 3: COUNT via secondary index - correct count (no meta rows)
--echo #

SELECT COUNT(*) AS cnt FROM test.rb_idx WHERE event_type = 'login';
SELECT COUNT(*) AS cnt FROM test.rb_idx WHERE amount > 0;

###############################################################################
# Case 4: Range scan via secondary index
###############################################################################

--echo #
--echo # Case 4: Range scan via secondary index - meta rows hidden
--echo #

SELECT client_id, ring_idx, event_type, amount FROM test.rb_idx
    WHERE amount BETWEEN 10 AND 50
    ORDER BY amount;

###############################################################################
# Case 5: After ring wraps, secondary index scan still correct
###############################################################################

--echo #
--echo # Case 5: After wrap - secondary index scan still filters meta rows
--echo #

# 5th and 6th inserts wrap the ring for client_id=1
INSERT INTO test.rb_idx (client_id, event_type, amount) VALUES (1, 'login', 60);
INSERT INTO test.rb_idx (client_id, event_type, amount) VALUES (1, 'purchase', 70);

# After wrap: slot 1 = 'login'/60, slot 2 = 'purchase'/70
# slot 3 = 'login'/20, slot 4 = 'refund'/30

SELECT client_id, ring_idx, event_type, amount FROM test.rb_idx
    WHERE event_type = 'login'
    ORDER BY client_id, ring_idx;

SELECT client_id, ring_idx, event_type, amount FROM test.rb_idx
    WHERE event_type = 'purchase'
    ORDER BY client_id, ring_idx;

###############################################################################
# Case 6: UPDATE via secondary index WHERE - allowed
###############################################################################

--echo #
--echo # Case 6: UPDATE via secondary index WHERE on user column - allowed
--echo #

UPDATE test.rb_idx SET amount = amount + 1000
    WHERE event_type = 'refund';

SELECT client_id, ring_idx, event_type, amount FROM test.rb_idx
    WHERE client_id = 1
    ORDER BY ring_idx;

###############################################################################
# Case 7: Aggregation via secondary index
###############################################################################

--echo #
--echo # Case 7: GROUP BY with secondary index - meta rows excluded
--echo #

SELECT event_type, COUNT(*) AS cnt, SUM(amount) AS total
    FROM test.rb_idx
    GROUP BY event_type
    ORDER BY event_type;

###############################################################################
# Case 8: show_meta with secondary index
###############################################################################

--echo #
--echo # Case 8: show_meta=ON - meta rows visible even via secondary index scan
--echo #

SET ndb_ring_buffer_show_meta = ON;

# Meta rows have NULL event_type/amount, so they won't match event_type='login'
# but they should be visible in a full scan
SELECT client_id, ring_idx, event_type, amount FROM test.rb_idx
    ORDER BY client_id, ring_idx;

SET ndb_ring_buffer_show_meta = OFF;

###############################################################################
# Case 9: Unique index on ring-buffer table
###############################################################################

--echo #
--echo # Case 9: Unique index on user column
--echo #

DROP TABLE test.rb_idx;

CREATE TABLE test.rb_uniq (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code VARCHAR(20),
    val INT,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_uniq (id, code, val) VALUES (1, 'AAA', 10);
INSERT INTO test.rb_uniq (id, code, val) VALUES (1, 'BBB', 20);
INSERT INTO test.rb_uniq (id, code, val) VALUES (1, 'CCC', 30);

# Lookup via unique index - should work, meta rows hidden
SELECT id, ring_idx, code, val FROM test.rb_uniq
    WHERE code = 'BBB';

# After wrap, old code 'AAA' is overwritten - unique constraint allows reuse
INSERT INTO test.rb_uniq (id, code, val) VALUES (1, 'DDD', 40);

SELECT id, ring_idx, code, val FROM test.rb_uniq
    ORDER BY ring_idx;

DROP TABLE test.rb_uniq;

###############################################################################
# Case 10: Add secondary index after table creation and data
###############################################################################

--echo #
--echo # Case 10: ALTER TABLE ADD INDEX on existing ring-buffer table
--echo #

CREATE TABLE test.rb_add_idx (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    category VARCHAR(30),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_add_idx (id, category) VALUES (1, 'alpha');
INSERT INTO test.rb_add_idx (id, category) VALUES (1, 'beta');
INSERT INTO test.rb_add_idx (id, category) VALUES (2, 'alpha');

# Add index after data exists
ALTER TABLE test.rb_add_idx ADD INDEX idx_cat (category);

# Query via new index - meta rows should be hidden
SELECT id, ring_idx, category FROM test.rb_add_idx
    WHERE category = 'alpha'
    ORDER BY id, ring_idx;

# Insert more, wrap, and verify index still correct
INSERT INTO test.rb_add_idx (id, category) VALUES (1, 'gamma');
INSERT INTO test.rb_add_idx (id, category) VALUES (1, 'delta');

SELECT id, ring_idx, category FROM test.rb_add_idx
    WHERE category = 'alpha'
    ORDER BY id, ring_idx;

SELECT id, ring_idx, category FROM test.rb_add_idx
    ORDER BY id, ring_idx;

DROP TABLE test.rb_add_idx;

###############################################################################
# Case 11: Duplicate unique value within same PK prefix - ER_DUP_ENTRY
#
# Two inserts for the same PK prefix that carry the same unique column value.
# The second insert must fail with ER_DUP_ENTRY because both data rows
# (ring_idx > 0) are active in the ring.
###############################################################################

--echo #
--echo # Case 11: Duplicate unique value in same PK prefix - ER_DUP_ENTRY
--echo #

CREATE TABLE test.rb_uniq_dup_same (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code VARCHAR(20),
    val INT,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_uniq_dup_same (id, code, val) VALUES (1, 'AAA', 10);
INSERT INTO test.rb_uniq_dup_same (id, code, val) VALUES (1, 'BBB', 20);

# Third insert duplicates 'AAA' which is still active in slot 1
--error ER_DUP_ENTRY
INSERT INTO test.rb_uniq_dup_same (id, code, val) VALUES (1, 'AAA', 30);

# Verify only the two successful rows exist
SELECT id, ring_idx, code, val FROM test.rb_uniq_dup_same
    ORDER BY ring_idx;

# Also test cross-prefix duplicate: different PK, same unique value
--error ER_DUP_ENTRY
INSERT INTO test.rb_uniq_dup_same (id, code, val) VALUES (2, 'BBB', 40);

DROP TABLE test.rb_uniq_dup_same;

###############################################################################
# Case 12: Wrap-time collision - new value matches active slot's unique value
#
# Fill the ring, wrap once successfully, then attempt a wrapping insert whose
# new unique value collides with a still-active slot.  The overwritten slot's
# old value is freed, but the new value must not duplicate another slot.
###############################################################################

--echo #
--echo # Case 12: Wrap-time collision with active slot - ER_DUP_ENTRY
--echo #

CREATE TABLE test.rb_uniq_wrap_dup (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code VARCHAR(20),
    val INT,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# Fill ring (size=3): slot 1=AAA, slot 2=BBB, slot 3=CCC
INSERT INTO test.rb_uniq_wrap_dup (id, code, val) VALUES (1, 'AAA', 10);
INSERT INTO test.rb_uniq_wrap_dup (id, code, val) VALUES (1, 'BBB', 20);
INSERT INTO test.rb_uniq_wrap_dup (id, code, val) VALUES (1, 'CCC', 30);

SELECT id, ring_idx, code, val FROM test.rb_uniq_wrap_dup ORDER BY ring_idx;

# 4th insert wraps to slot 1: AAA freed, DDD takes its place - OK
INSERT INTO test.rb_uniq_wrap_dup (id, code, val) VALUES (1, 'DDD', 40);

SELECT id, ring_idx, code, val FROM test.rb_uniq_wrap_dup ORDER BY ring_idx;

# 5th insert wraps to slot 2: BBB would be freed, but new value 'CCC'
# collides with active slot 3 - ER_DUP_ENTRY
--error ER_DUP_ENTRY
INSERT INTO test.rb_uniq_wrap_dup (id, code, val) VALUES (1, 'CCC', 50);

# Verify state unchanged after failed insert
SELECT id, ring_idx, code, val FROM test.rb_uniq_wrap_dup ORDER BY ring_idx;

# Retry with a non-duplicate value - should succeed at slot 2
INSERT INTO test.rb_uniq_wrap_dup (id, code, val) VALUES (1, 'EEE', 50);

SELECT id, ring_idx, code, val FROM test.rb_uniq_wrap_dup ORDER BY ring_idx;

DROP TABLE test.rb_uniq_wrap_dup;

###############################################################################
# Case 13: Reuse of freed unique value after wrap
#
# After wrapping overwrites a slot, the old slot's unique value becomes
# available again.  Verify that a subsequent insert can reuse it.
###############################################################################

--echo #
--echo # Case 13: Freed unique value reusable after wrap
--echo #

CREATE TABLE test.rb_uniq_reuse (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code VARCHAR(20),
    val INT,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# Fill ring: slot 1=AAA, slot 2=BBB, slot 3=CCC
INSERT INTO test.rb_uniq_reuse (id, code, val) VALUES (1, 'AAA', 10);
INSERT INTO test.rb_uniq_reuse (id, code, val) VALUES (1, 'BBB', 20);
INSERT INTO test.rb_uniq_reuse (id, code, val) VALUES (1, 'CCC', 30);

# Wrap: slot 1 overwritten, AAA freed
INSERT INTO test.rb_uniq_reuse (id, code, val) VALUES (1, 'DDD', 40);

# AAA was freed by wrap - a different PK prefix can now use it
INSERT INTO test.rb_uniq_reuse (id, code, val) VALUES (2, 'AAA', 50);

SELECT id, ring_idx, code, val FROM test.rb_uniq_reuse
    ORDER BY id, ring_idx;

# BBB is still active in id=1 slot 2 - cannot reuse
--error ER_DUP_ENTRY
INSERT INTO test.rb_uniq_reuse (id, code, val) VALUES (2, 'BBB', 60);

DROP TABLE test.rb_uniq_reuse;

--echo #
--echo # Done.
--echo #
