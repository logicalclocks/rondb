# meta_row_index.test
#
# Tests for ring buffer tables with NOT NULL user columns and secondary indexes.
#
# Verifies three fixes:
#   1. Meta rows can be inserted when table has NOT NULL user columns
#      (handler includes NOT NULL columns with zero-defaults in meta mask)
#   2. Meta rows are excluded from secondary index maintenance
#      (DBTUP skips SECONDARY_INDEX/FK triggers for ring_idx=0 rows)
#   3. ALTER TABLE ADD UNIQUE INDEX succeeds on ring buffer tables
#      (SUMA hides meta rows for SingleTableScan index build scans)

--source include/have_ndb.inc

###############################################################################
# Case 1: NOT NULL INT column — no secondary index
###############################################################################

--echo #
--echo # Case 1: NOT NULL INT column — basic ring buffer works
--echo #

CREATE TABLE test.rb_nn_bare (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    status INT NOT NULL,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_nn_bare (id, status) VALUES (1, 42);
INSERT INTO test.rb_nn_bare (id, status) VALUES (2, 99);

SELECT id, ring_idx, status FROM test.rb_nn_bare ORDER BY id, ring_idx;

DROP TABLE test.rb_nn_bare;

###############################################################################
# Case 2: NOT NULL VARCHAR column — no secondary index
###############################################################################

--echo #
--echo # Case 2: NOT NULL VARCHAR column — basic ring buffer works
--echo #

CREATE TABLE test.rb_nn_varchar (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    name VARCHAR(100) NOT NULL,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_nn_varchar (id, name) VALUES (1, 'Alice');
INSERT INTO test.rb_nn_varchar (id, name) VALUES (2, 'Bob');

SELECT id, ring_idx, name FROM test.rb_nn_varchar ORDER BY id, ring_idx;

DROP TABLE test.rb_nn_varchar;

###############################################################################
# Case 3: Multiple NOT NULL columns — no secondary index
###############################################################################

--echo #
--echo # Case 3: Multiple NOT NULL columns — all work
--echo #

CREATE TABLE test.rb_nn_multi (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    cat INT NOT NULL,
    sub INT NOT NULL,
    label VARCHAR(50) NOT NULL,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_nn_multi (id, cat, sub, label) VALUES (1, 10, 20, 'hello');
INSERT INTO test.rb_nn_multi (id, cat, sub, label) VALUES (2, 30, 40, 'world');

SELECT id, ring_idx, cat, sub, label FROM test.rb_nn_multi ORDER BY id, ring_idx;

DROP TABLE test.rb_nn_multi;

###############################################################################
# Case 4: UNIQUE index on NOT NULL INT — multiple PK prefixes
###############################################################################

--echo #
--echo # Case 4: UNIQUE index on NOT NULL INT — no collision between meta rows
--echo #

CREATE TABLE test.rb_uniq_int (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    status INT NOT NULL,
    PRIMARY KEY (client_id, ring_idx),
    UNIQUE INDEX idx_status (status)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_uniq_int (client_id, status) VALUES (1, 42);
INSERT INTO test.rb_uniq_int (client_id, status) VALUES (2, 99);
INSERT INTO test.rb_uniq_int (client_id, status) VALUES (3, 7);

SELECT client_id, ring_idx, status FROM test.rb_uniq_int ORDER BY client_id, ring_idx;

# Verify UNIQUE constraint still works for data rows
--error ER_DUP_ENTRY
INSERT INTO test.rb_uniq_int (client_id, status) VALUES (1, 99);

DROP TABLE test.rb_uniq_int;

###############################################################################
# Case 5: UNIQUE index on NOT NULL VARCHAR — multiple PK prefixes
###############################################################################

--echo #
--echo # Case 5: UNIQUE index on NOT NULL VARCHAR — no collision
--echo #

CREATE TABLE test.rb_uniq_vc (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    name VARCHAR(100) NOT NULL,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_name (name)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_uniq_vc (id, name) VALUES (1, 'Alice');
INSERT INTO test.rb_uniq_vc (id, name) VALUES (2, 'Bob');
INSERT INTO test.rb_uniq_vc (id, name) VALUES (3, 'Charlie');

SELECT id, ring_idx, name FROM test.rb_uniq_vc ORDER BY id, ring_idx;

DROP TABLE test.rb_uniq_vc;

###############################################################################
# Case 6: Composite UNIQUE index on NOT NULL columns
###############################################################################

--echo #
--echo # Case 6: Composite UNIQUE index on two NOT NULL columns
--echo #

CREATE TABLE test.rb_uniq_comp (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    cat INT NOT NULL,
    sub INT NOT NULL,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_cat_sub (cat, sub)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_uniq_comp (id, cat, sub) VALUES (1, 10, 20);
INSERT INTO test.rb_uniq_comp (id, cat, sub) VALUES (2, 30, 40);

SELECT id, ring_idx, cat, sub FROM test.rb_uniq_comp ORDER BY id, ring_idx;

DROP TABLE test.rb_uniq_comp;

###############################################################################
# Case 7: Non-unique index on NOT NULL column
###############################################################################

--echo #
--echo # Case 7: Non-unique index on NOT NULL column — meta rows not in index
--echo #

CREATE TABLE test.rb_nonuniq (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    priority INT NOT NULL,
    PRIMARY KEY (id, ring_idx),
    INDEX idx_priority (priority)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_nonuniq (id, priority) VALUES (1, 5);
INSERT INTO test.rb_nonuniq (id, priority) VALUES (1, 10);
INSERT INTO test.rb_nonuniq (id, priority) VALUES (2, 15);

# Meta rows have priority=0 in the tuple but should NOT be in the index
SELECT id, ring_idx, priority FROM test.rb_nonuniq
    WHERE priority = 0
    ORDER BY id, ring_idx;

SELECT id, ring_idx, priority FROM test.rb_nonuniq
    WHERE priority > 0
    ORDER BY id, ring_idx;

DROP TABLE test.rb_nonuniq;

###############################################################################
# Case 8: Ring wrap with UNIQUE index
###############################################################################

--echo #
--echo # Case 8: Ring wrap with UNIQUE index — old values freed, new indexed
--echo #

CREATE TABLE test.rb_wrap_uniq (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code INT NOT NULL,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# Fill ring (size=3)
INSERT INTO test.rb_wrap_uniq (id, code) VALUES (1, 100);
INSERT INTO test.rb_wrap_uniq (id, code) VALUES (1, 200);
INSERT INTO test.rb_wrap_uniq (id, code) VALUES (1, 300);

SELECT id, ring_idx, code FROM test.rb_wrap_uniq ORDER BY ring_idx;

# Wrap: slot 1 overwritten, code=100 freed, code=400 takes its place
INSERT INTO test.rb_wrap_uniq (id, code) VALUES (1, 400);

SELECT id, ring_idx, code FROM test.rb_wrap_uniq ORDER BY ring_idx;

# code=100 was freed by wrap, so we can reuse it
INSERT INTO test.rb_wrap_uniq (id, code) VALUES (1, 100);

SELECT id, ring_idx, code FROM test.rb_wrap_uniq ORDER BY ring_idx;

DROP TABLE test.rb_wrap_uniq;

###############################################################################
# Case 9: ALTER TABLE ADD UNIQUE INDEX on existing ring buffer data
#
# SUMA now hides meta rows for SingleTableScan subscriptions (index builds)
# while still showing them for TableEvent subscriptions (replication).
# This allows ALTER TABLE ADD UNIQUE INDEX to succeed on ring buffer tables.
###############################################################################

--echo #
--echo # Case 9: ALTER TABLE ADD UNIQUE INDEX — meta rows hidden in TRIX scan
--echo #

CREATE TABLE test.rb_alter_uniq (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code INT NOT NULL,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_alter_uniq (id, code) VALUES (1, 100);
INSERT INTO test.rb_alter_uniq (id, code) VALUES (2, 200);

# SUMA hides meta rows for index build scans — no duplicate key collision
ALTER TABLE test.rb_alter_uniq ADD UNIQUE INDEX idx_code (code);

# Verify unique constraint works after ALTER
--error ER_DUP_ENTRY
INSERT INTO test.rb_alter_uniq (id, code) VALUES (3, 100);

# Non-unique (ordered) index via ALTER TABLE also works
ALTER TABLE test.rb_alter_uniq ADD INDEX idx_code_ord (code);

SELECT id, ring_idx, code FROM test.rb_alter_uniq
    WHERE code > 0
    ORDER BY id, ring_idx;

DROP TABLE test.rb_alter_uniq;

###############################################################################
# Case 10: UNIQUE on NULLABLE column — still works (control case)
###############################################################################

--echo #
--echo # Case 10: UNIQUE on NULLABLE column — control case
--echo #

CREATE TABLE test.rb_uniq_null (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    tag VARCHAR(50),
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_tag (tag)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_uniq_null (id, tag) VALUES (1, 'first');
INSERT INTO test.rb_uniq_null (id, tag) VALUES (2, 'second');
INSERT INTO test.rb_uniq_null (id, tag) VALUES (3, 'third');

SELECT id, ring_idx, tag FROM test.rb_uniq_null ORDER BY id, ring_idx;

DROP TABLE test.rb_uniq_null;

###############################################################################
# Case 11: show_meta shows zero-defaults for NOT NULL columns
###############################################################################

--echo #
--echo # Case 11: show_meta — meta rows show zero-defaults for NOT NULL columns
--echo #

CREATE TABLE test.rb_show_meta (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    val INT NOT NULL,
    label VARCHAR(50) NOT NULL,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_show_meta (id, val, label) VALUES (1, 42, 'hello');

SET ndb_ring_buffer_show_meta = ON;
SELECT id, ring_idx, val, label FROM test.rb_show_meta ORDER BY id, ring_idx;
SET ndb_ring_buffer_show_meta = OFF;

DROP TABLE test.rb_show_meta;

###############################################################################
# Case 12: Bulk INSERT with NOT NULL + unique index
# Multi-row INSERT creates multiple meta rows (all code=0).
# Verify they don't collide in the unique index.
###############################################################################

--echo #
--echo # Case 12: Bulk INSERT with NOT NULL + unique index
--echo #

CREATE TABLE test.rb_bulk_nn_uniq (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code INT NOT NULL,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# Multi-row INSERT: each prefix gets a meta row with code=0, hidden from index
INSERT INTO test.rb_bulk_nn_uniq (id, code) VALUES (1, 100), (2, 200), (3, 300);

SELECT id, ring_idx, code FROM test.rb_bulk_nn_uniq ORDER BY id, ring_idx;

# Unique constraint enforced among data rows
--error ER_DUP_ENTRY
INSERT INTO test.rb_bulk_nn_uniq (id, code) VALUES (4, 100);

DROP TABLE test.rb_bulk_nn_uniq;

###############################################################################
# Case 13: NOT NULL DEFAULT non-zero + unique index
# Meta rows use zero-default (0 for INT), not the column DEFAULT (99).
# Data rows with value 0 are allowed since meta rows are not indexed.
###############################################################################

--echo #
--echo # Case 13: NOT NULL DEFAULT non-zero — meta rows use zero-default
--echo #

CREATE TABLE test.rb_nn_default (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code INT NOT NULL DEFAULT 99,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_nn_default (id, code) VALUES (1, 100);
INSERT INTO test.rb_nn_default (id, code) VALUES (2, 200);
# Omit code: gets column DEFAULT 99
INSERT INTO test.rb_nn_default (id) VALUES (3);

SELECT id, ring_idx, code FROM test.rb_nn_default ORDER BY id, ring_idx;

# Insert code=0: succeeds because meta rows (code=0) are not in the index
INSERT INTO test.rb_nn_default (id, code) VALUES (4, 0);

SELECT id, ring_idx, code FROM test.rb_nn_default ORDER BY id, ring_idx;

# A second code=0 data row fails (unique constraint among data rows)
--error ER_DUP_ENTRY
INSERT INTO test.rb_nn_default (id, code) VALUES (5, 0);

# Verify meta rows have zero-default (0) via show_meta
SET ndb_ring_buffer_show_meta = ON;
SELECT id, ring_idx, code FROM test.rb_nn_default ORDER BY id, ring_idx;
SET ndb_ring_buffer_show_meta = OFF;

DROP TABLE test.rb_nn_default;

###############################################################################
# Case 14: ALTER TABLE ADD UNIQUE INDEX after ring wrapping
# After wrapping, only current data rows exist. TRIX build must see them
# (not meta rows) when building the new index.
###############################################################################

--echo #
--echo # Case 14: ALTER TABLE ADD UNIQUE INDEX after ring wrapping
--echo #

CREATE TABLE test.rb_wrap_add_uniq (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code INT NOT NULL,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_wrap_add_uniq (id, code) VALUES (1, 100);
INSERT INTO test.rb_wrap_add_uniq (id, code) VALUES (1, 200);
INSERT INTO test.rb_wrap_add_uniq (id, code) VALUES (1, 300);
# Wrap: overwrites slot 1 (code=100 -> code=400)
INSERT INTO test.rb_wrap_add_uniq (id, code) VALUES (1, 400);

SELECT id, ring_idx, code FROM test.rb_wrap_add_uniq ORDER BY ring_idx;

# Add unique index on wrapped table — TRIX scan hides meta rows
ALTER TABLE test.rb_wrap_add_uniq ADD UNIQUE INDEX idx_code (code);

# Verify constraint: 200 is still active in slot 2
--error ER_DUP_ENTRY
INSERT INTO test.rb_wrap_add_uniq (id, code) VALUES (2, 200);

# Freed value 100 can be reused by a different prefix
INSERT INTO test.rb_wrap_add_uniq (id, code) VALUES (2, 100);

SELECT id, ring_idx, code FROM test.rb_wrap_add_uniq ORDER BY id, ring_idx;

DROP TABLE test.rb_wrap_add_uniq;

###############################################################################
# Case 15: Multiple PK prefixes + wrapping + unique index cross-prefix
# Unique constraint spans all PK prefixes. Wrapping frees values for reuse.
###############################################################################

--echo #
--echo # Case 15: Cross-prefix unique constraint with wrapping
--echo #

CREATE TABLE test.rb_cross_uniq (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code INT NOT NULL,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=2@ring_idx@ring_meta";

# Fill rings for two prefixes
INSERT INTO test.rb_cross_uniq (id, code) VALUES (1, 10);
INSERT INTO test.rb_cross_uniq (id, code) VALUES (1, 20);
INSERT INTO test.rb_cross_uniq (id, code) VALUES (2, 30);
INSERT INTO test.rb_cross_uniq (id, code) VALUES (2, 40);

# Cross-prefix duplicate blocked
--error ER_DUP_ENTRY
INSERT INTO test.rb_cross_uniq (id, code) VALUES (1, 30);

# Wrap id=1: slot 1 (code=10) freed, new value 50
INSERT INTO test.rb_cross_uniq (id, code) VALUES (1, 50);

# Freed value 10 can be reused by different prefix
INSERT INTO test.rb_cross_uniq (id, code) VALUES (2, 10);

SELECT id, ring_idx, code FROM test.rb_cross_uniq ORDER BY id, ring_idx;

DROP TABLE test.rb_cross_uniq;

###############################################################################
# Case 16: ALTER TABLE grow preserves NOT NULL + unique index
###############################################################################

--echo #
--echo # Case 16: ALTER TABLE grow with NOT NULL + unique index
--echo #

CREATE TABLE test.rb_grow_nn (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    code INT NOT NULL,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_grow_nn (id, code) VALUES (1, 100);
INSERT INTO test.rb_grow_nn (id, code) VALUES (1, 200);
INSERT INTO test.rb_grow_nn (id, code) VALUES (1, 300);

# Grow ring from 3 to 5
ALTER TABLE test.rb_grow_nn COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=5@ring_idx@ring_meta";

# Insert into expanded slots
INSERT INTO test.rb_grow_nn (id, code) VALUES (1, 400);
INSERT INTO test.rb_grow_nn (id, code) VALUES (1, 500);

SELECT id, ring_idx, code FROM test.rb_grow_nn ORDER BY ring_idx;

# Unique constraint still works after grow
--error ER_DUP_ENTRY
INSERT INTO test.rb_grow_nn (id, code) VALUES (1, 200);

# Wrap into expanded ring
INSERT INTO test.rb_grow_nn (id, code) VALUES (1, 600);

SELECT id, ring_idx, code FROM test.rb_grow_nn ORDER BY ring_idx;

DROP TABLE test.rb_grow_nn;

###############################################################################
# Case 17: Multiple NOT NULL types + unique + ordered index
# Tests zero-defaults for VARCHAR (empty string) and INT (0) simultaneously.
###############################################################################

--echo #
--echo # Case 17: Multiple NOT NULL types — VARCHAR + INT with indexes
--echo #

CREATE TABLE test.rb_nn_types (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    name VARCHAR(100) NOT NULL,
    score INT NOT NULL,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_name (name),
    INDEX idx_score (score)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_nn_types (id, name, score) VALUES (1, 'Alice', 90);
INSERT INTO test.rb_nn_types (id, name, score) VALUES (2, 'Bob', 85);
INSERT INTO test.rb_nn_types (id, name, score) VALUES (3, 'Charlie', 95);

# Unique on name enforced
--error ER_DUP_ENTRY
INSERT INTO test.rb_nn_types (id, name, score) VALUES (4, 'Alice', 70);

# Empty string is VARCHAR zero-default in meta rows — insertable as data value
INSERT INTO test.rb_nn_types (id, name, score) VALUES (4, '', 70);

SELECT id, ring_idx, name, score FROM test.rb_nn_types ORDER BY id, ring_idx;

# score=0 is meta row zero-default; not in ordered index
SELECT id, ring_idx, name, score FROM test.rb_nn_types
    WHERE score = 0
    ORDER BY id, ring_idx;

DROP TABLE test.rb_nn_types;

###############################################################################
# Case 18: NOT NULL BLOB/TEXT columns — blocked at DDL time
# Meta rows cannot set zero-defaults for BLOB types, so NOT NULL BLOB/TEXT
# columns are rejected at CREATE TABLE time.
###############################################################################

--echo #
--echo # Case 18: NOT NULL BLOB/TEXT columns — blocked at CREATE TABLE
--echo #

# TEXT NOT NULL → rejected
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE test.rb_nn_text (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    content TEXT NOT NULL,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# BLOB NOT NULL → rejected
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE test.rb_nn_blob (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    payload BLOB NOT NULL,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# Nullable TEXT works fine (control case)
CREATE TABLE test.rb_null_text (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    content TEXT,
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_null_text (id, content) VALUES (1, 'Hello World');
INSERT INTO test.rb_null_text (id, content) VALUES (2, REPEAT('x', 1000));

SELECT id, ring_idx, LENGTH(content) FROM test.rb_null_text ORDER BY id, ring_idx;

DROP TABLE test.rb_null_text;

--echo #
--echo # Done.
--echo #
