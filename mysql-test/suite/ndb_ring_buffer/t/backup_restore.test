# ndb_ring_buffer_backup_restore.test
#
# Tests for backup and restore of ring-buffer tables.
# Verifies data survival, metadata preservation, BLOB/TEXT support,
# multi-PK-prefix handling, and continued ring operation after restore.

--source include/have_multi_ndb.inc
--source suite/ndb/include/backup_restore_setup.inc

###############################################################################
# Case 1: Basic backup/restore — data rows preserved
###############################################################################

--echo #
--echo # Case 1: Basic backup/restore — data rows preserved
--echo #

CREATE TABLE test.rb (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    event_data VARCHAR(100),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=RING_BUFFER=4@ring_idx@ring_meta";

INSERT INTO test.rb (client_id, event_data) VALUES (1, 'ev_A');
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'ev_B');
INSERT INTO test.rb (client_id, event_data) VALUES (1, 'ev_C');

# Verify pre-backup state
SELECT client_id, ring_idx, event_data FROM test.rb
    WHERE client_id = 1 ORDER BY ring_idx;

--source include/ndb_backup.inc

DROP TABLE test.rb;

--source common/rpl/ndb_restore_source.inc

# Wait for metadata sync on both servers
--let $max_wait = 60
SET GLOBAL ndb_metadata_sync = true;
--let $metadata_sync_value = `SELECT @@ndb_metadata_sync`
while ($metadata_sync_value != 0)
{
  --sleep 0.5
  --dec $max_wait
  if ($max_wait == 0)
  {
    --die Timed out waiting for metadata changes to be synced
  }
  --let $metadata_sync_value = `SELECT @@ndb_metadata_sync`
}

--connection server2
--let $max_wait = 60
SET GLOBAL ndb_metadata_sync = true;
--let $metadata_sync_value = `SELECT @@ndb_metadata_sync`
while ($metadata_sync_value != 0)
{
  --sleep 0.5
  --dec $max_wait
  if ($max_wait == 0)
  {
    --die Timed out waiting for metadata changes to be synced
  }
  --let $metadata_sync_value = `SELECT @@ndb_metadata_sync`
}
--connection server1

# Verify restored data matches pre-backup state
SELECT client_id, ring_idx, event_data FROM test.rb
    WHERE client_id = 1 ORDER BY ring_idx;

DROP TABLE test.rb;

###############################################################################
# Case 2: Wrapped ring backup/restore — wrapped state preserved
###############################################################################

--echo #
--echo # Case 2: Wrapped ring backup/restore — wrapped state preserved
--echo #

CREATE TABLE test.rb_wrap (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(100),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=RING_BUFFER=3@ring_idx@ring_meta";

# Insert 5 rows into ring of size 3: wraps around
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'a');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'b');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'c');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'd');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'e');

# Pre-backup: slots 1,2,3 should have d/e/c or similar wrapped pattern
SELECT id, ring_idx, data FROM test.rb_wrap WHERE id = 1 ORDER BY ring_idx;

--source include/ndb_backup.inc

DROP TABLE test.rb_wrap;

--source common/rpl/ndb_restore_source.inc

