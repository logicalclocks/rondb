# ndb_ring_buffer_alter.test
#
# Tests for ALTER TABLE on ring-buffer tables:
# grow (allowed), shrink (blocked), disable (blocked).

--source include/have_ndb.inc

--echo #
--echo # Setup: Create ring-buffer table with ring_size=3
--echo #

CREATE TABLE test.rb_alter (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(100),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_alter (id, data) VALUES (1, 'a');
INSERT INTO test.rb_alter (id, data) VALUES (1, 'b');
INSERT INTO test.rb_alter (id, data) VALUES (1, 'c');

SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

--echo #
--echo # Case 1: Grow ring_size 3 -> 6 - allowed
--echo #

ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=6@ring_idx@ring_meta";

# Verify existing data is preserved
SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

--echo #
--echo # Case 2: After grow, inserts fill empty slots first (no overwrite)
--echo #

INSERT INTO test.rb_alter (id, data) VALUES (1, 'd');

SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

# Fill remaining slots
INSERT INTO test.rb_alter (id, data) VALUES (1, 'e');
INSERT INTO test.rb_alter (id, data) VALUES (1, 'f');

SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

--echo #
--echo # Case 3: Ring wraps at new size (7th insert overwrites slot 1)
--echo #

INSERT INTO test.rb_alter (id, data) VALUES (1, 'g');

SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

--echo #
--echo # Case 4: Shrink blocked - 6 -> 3
--echo #

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

--echo #
--echo # Case 5: Shrink blocked - 6 -> 1
--echo #

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=1@ring_idx@ring_meta";

--echo #
--echo # Case 6: Disable blocked - MAX_ROWS_PER_PK=off
--echo #

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=off";

--echo #
--echo # Case 7: Same size - no-op, no error
--echo #

ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=6@ring_idx@ring_meta";

# Verify data unchanged
SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

--echo #
--echo # Case 8: Grow further - 6 -> 10
--echo #

ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=10@ring_idx@ring_meta";

INSERT INTO test.rb_alter (id, data) VALUES (1, 'h');

SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

DROP TABLE test.rb_alter;

--echo #
--echo # Case 9: Preserve ring buffer on unrelated ALTER (ADD COLUMN)
--echo #

CREATE TABLE test.rb_preserve (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    val VARCHAR(50),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=4@ring_idx@ring_meta";

INSERT INTO test.rb_preserve (id, val) VALUES (1, 'before_alter');
INSERT INTO test.rb_preserve (id, val) VALUES (1, 'before_alter2');

ALTER TABLE test.rb_preserve ADD COLUMN extra INT DEFAULT 0;

# Ring buffer still works after ADD COLUMN
INSERT INTO test.rb_preserve (id, val) VALUES (1, 'after_alter');

SELECT id, ring_idx, val, extra FROM test.rb_preserve
    WHERE id = 1 ORDER BY ring_idx;

DROP TABLE test.rb_preserve;

--echo #
--echo # Case 10: Multiple PK prefixes - grow preserves all rings
--echo #

CREATE TABLE test.rb_multi (
    region INT NOT NULL,
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(50),
    PRIMARY KEY (region, client_id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=2@ring_idx@ring_meta";

INSERT INTO test.rb_multi (region, client_id, data) VALUES (1, 100, 'r1c100_a');
INSERT INTO test.rb_multi (region, client_id, data) VALUES (1, 100, 'r1c100_b');
INSERT INTO test.rb_multi (region, client_id, data) VALUES (2, 200, 'r2c200_a');

# Grow 2 -> 5
ALTER TABLE test.rb_multi COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=5@ring_idx@ring_meta";

# Both rings preserved
SELECT region, client_id, ring_idx, data FROM test.rb_multi
    ORDER BY region, client_id, ring_idx;

# Insert expands into new slots (not wrapping)
INSERT INTO test.rb_multi (region, client_id, data) VALUES (1, 100, 'r1c100_c');

SELECT region, client_id, ring_idx, data FROM test.rb_multi
    WHERE region = 1 AND client_id = 100 ORDER BY ring_idx;

DROP TABLE test.rb_multi;

--echo #
--echo # Case 11: Grow on not-full ring (perfect - no caveat)
--echo #

CREATE TABLE test.rb_notfull (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(50),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=4@ring_idx@ring_meta";

# Only 2 inserts in a size-4 ring (not full)
INSERT INTO test.rb_notfull (id, data) VALUES (1, 'x');
INSERT INTO test.rb_notfull (id, data) VALUES (1, 'y');

# Grow 4 -> 8
ALTER TABLE test.rb_notfull COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=8@ring_idx@ring_meta";

# Next insert goes to slot 3 (sequential, no adjustment needed)
INSERT INTO test.rb_notfull (id, data) VALUES (1, 'z');

SELECT id, ring_idx, data FROM test.rb_notfull ORDER BY ring_idx;

DROP TABLE test.rb_notfull;

--echo #
--echo # Case 12: Grow on heavily wrapped ring (next_pos in middle)
--echo # ring_size=3, 8 inserts -> wraps multiple times
--echo # After 8 inserts: slots hold values 7(1), 8(2), 6(3)
--echo # Meta: next_pos=3, count=3 (oldest is slot 3 = value 6)
--echo #

CREATE TABLE test.rb_wrap (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(50),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v1');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v2');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v3');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v4');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v5');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v6');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v7');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v8');

SELECT id, ring_idx, data FROM test.rb_wrap ORDER BY ring_idx;

# Grow 3 -> 6
ALTER TABLE test.rb_wrap COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=6@ring_idx@ring_meta";

# Next insert should go to slot 4 (first empty), not overwrite any slot
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v9');

SELECT id, ring_idx, data FROM test.rb_wrap ORDER BY ring_idx;

# Fill slot 5 and 6
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v10');
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v11');

SELECT id, ring_idx, data FROM test.rb_wrap ORDER BY ring_idx;

# Ring now full at size 6. Next insert overwrites (wrapping resumes)
INSERT INTO test.rb_wrap (id, data) VALUES (1, 'v12');

SELECT id, ring_idx, data FROM test.rb_wrap ORDER BY ring_idx;

DROP TABLE test.rb_wrap;

--echo #
--echo # Case 13: Sequential grows - 2 -> 4 -> 8
--echo #

CREATE TABLE test.rb_seq (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(50),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=2@ring_idx@ring_meta";

INSERT INTO test.rb_seq (id, data) VALUES (1, 'a');
INSERT INTO test.rb_seq (id, data) VALUES (1, 'b');

# Ring full at size 2: a(1), b(2), next_pos=1
SELECT id, ring_idx, data FROM test.rb_seq ORDER BY ring_idx;

# First grow: 2 -> 4
ALTER TABLE test.rb_seq COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=4@ring_idx@ring_meta";

INSERT INTO test.rb_seq (id, data) VALUES (1, 'c');
INSERT INTO test.rb_seq (id, data) VALUES (1, 'd');

# Slots 3,4 filled. Ring full at size 4.
SELECT id, ring_idx, data FROM test.rb_seq ORDER BY ring_idx;

# Second grow: 4 -> 8
ALTER TABLE test.rb_seq COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=8@ring_idx@ring_meta";

INSERT INTO test.rb_seq (id, data) VALUES (1, 'e');
INSERT INTO test.rb_seq (id, data) VALUES (1, 'f');
INSERT INTO test.rb_seq (id, data) VALUES (1, 'g');
INSERT INTO test.rb_seq (id, data) VALUES (1, 'h');

# Slots 5-8 filled. Ring full at size 8.
SELECT id, ring_idx, data FROM test.rb_seq ORDER BY ring_idx;

# Verify wrapping works at new size
INSERT INTO test.rb_seq (id, data) VALUES (1, 'i');

SELECT id, ring_idx, data FROM test.rb_seq ORDER BY ring_idx;

DROP TABLE test.rb_seq;

--echo #
--echo # Case 14: Grow on ring_size=1 (edge case)
--echo #

CREATE TABLE test.rb_one (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(50),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=1@ring_idx@ring_meta";

INSERT INTO test.rb_one (id, data) VALUES (1, 'only');

SELECT id, ring_idx, data FROM test.rb_one ORDER BY ring_idx;

# Grow 1 -> 3
ALTER TABLE test.rb_one COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# Next insert should go to slot 2 (empty), not overwrite slot 1
INSERT INTO test.rb_one (id, data) VALUES (1, 'second');

SELECT id, ring_idx, data FROM test.rb_one ORDER BY ring_idx;

INSERT INTO test.rb_one (id, data) VALUES (1, 'third');

SELECT id, ring_idx, data FROM test.rb_one ORDER BY ring_idx;

# Ring full, 4th insert wraps
INSERT INTO test.rb_one (id, data) VALUES (1, 'fourth');

SELECT id, ring_idx, data FROM test.rb_one ORDER BY ring_idx;

DROP TABLE test.rb_one;

--echo #
--echo # Case 15: Bulk insert after grow - batch path uses empty slots
--echo #

CREATE TABLE test.rb_bulk (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(50),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_bulk (id, data) VALUES (1, 'x'), (1, 'y'), (1, 'z');

SELECT id, ring_idx, data FROM test.rb_bulk ORDER BY ring_idx;

# Grow 3 -> 6
ALTER TABLE test.rb_bulk COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=6@ring_idx@ring_meta";

# Bulk insert 3 rows - should fill slots 4, 5, 6
INSERT INTO test.rb_bulk (id, data) VALUES (1, 'b1'), (1, 'b2'), (1, 'b3');

SELECT id, ring_idx, data FROM test.rb_bulk ORDER BY ring_idx;

DROP TABLE test.rb_bulk;
