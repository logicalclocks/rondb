# ndb_ring_buffer_alter.test
#
# Tests for ALTER TABLE on ring-buffer tables:
# size changes (blocked), disable (blocked), unrelated ALTERs preserved.
# Online ring-buffer resize is disabled; resize requires DROP+CREATE.

--source include/have_ndb.inc

--echo #
--echo # Setup: Create ring-buffer table with ring_size=3
--echo #

CREATE TABLE test.rb_alter (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    data VARCHAR(100),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_alter (id, data) VALUES (1, 'a');
INSERT INTO test.rb_alter (id, data) VALUES (1, 'b');
INSERT INTO test.rb_alter (id, data) VALUES (1, 'c');

SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

--echo #
--echo # Case 1: Grow blocked - 3 -> 6
--echo #

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=6@ring_idx@ring_meta";

--echo #
--echo # Case 2: Shrink blocked - 3 -> 1
--echo #

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=1@ring_idx@ring_meta";

--echo #
--echo # Case 3: Disable blocked - MAX_ROWS_PER_PK=off
--echo #

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=off";

--echo #
--echo # Case 4: Same size - no-op, no error
--echo #

ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# Verify data unchanged
SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

--echo #
--echo # Case 4b: Adding FULLY_REPLICATED to a ring-buffer table is rejected
--echo #

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_alter COMMENT="NDB_TABLE=FULLY_REPLICATED=1,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

--echo #
--echo # Case 4c: INSERT after the rejected ALTERs - ring intact at size 3
--echo #

# The wrap to slot 1 proves the original ring size survived every
# rejected ALTER above.
INSERT INTO test.rb_alter (id, data) VALUES (1, 'd');
SELECT id, ring_idx, data FROM test.rb_alter ORDER BY ring_idx;

DROP TABLE test.rb_alter;

--echo #
--echo # Case 5: Preserve ring buffer on unrelated ALTER (ADD COLUMN)
--echo #

CREATE TABLE test.rb_preserve (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    val VARCHAR(50),
    PRIMARY KEY (id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=4@ring_idx@ring_meta";

INSERT INTO test.rb_preserve (id, val) VALUES (1, 'before_alter');
INSERT INTO test.rb_preserve (id, val) VALUES (1, 'before_alter2');

ALTER TABLE test.rb_preserve ADD COLUMN extra INT DEFAULT 0;

# Ring buffer still works after ADD COLUMN
INSERT INTO test.rb_preserve (id, val) VALUES (1, 'after_alter');

SELECT id, ring_idx, val, extra FROM test.rb_preserve
    WHERE id = 1 ORDER BY ring_idx;

DROP TABLE test.rb_preserve;

--echo #
--echo # Case 6: REORGANIZE PARTITION / ADD PARTITION - blocked
--echo #

# The kernel reorg copy machinery carries no ring-buffer flag, so real
# data movement aborts mid-schema-transaction with error 940, and the
# reorg copy scan would drop hidden meta rows. Reject at DDL instead.

CREATE TABLE test.rb_reorg (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    val VARCHAR(50),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta"
  PARTITION BY KEY(client_id);

INSERT INTO test.rb_reorg (client_id, val) VALUES (1, 'a');
INSERT INTO test.rb_reorg (client_id, val) VALUES (1, 'b');
INSERT INTO test.rb_reorg (client_id, val) VALUES (1, 'c');
INSERT INTO test.rb_reorg (client_id, val) VALUES (2, 'x');

--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE test.rb_reorg ALGORITHM=INPLACE, ADD PARTITION PARTITIONS 2;

--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE test.rb_reorg ALGORITHM=INPLACE, REORGANIZE PARTITION;

# Contents unchanged by the rejected statements
SELECT client_id, ring_idx, val FROM test.rb_reorg ORDER BY client_id, ring_idx;

# Without ALGORITHM the server falls back to COPY - a full rebuild that
# copies data AND meta rows verbatim. That path is safe and stays allowed.
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb_reorg WHERE client_id = 1 AND ring_idx = 0;
SET ndb_ring_buffer_show_meta = OFF;

ALTER TABLE test.rb_reorg ADD PARTITION PARTITIONS 2;

# Meta rows survived the copy byte-for-byte
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb_reorg WHERE client_id = 1 AND ring_idx = 0;
SET ndb_ring_buffer_show_meta = OFF;
SELECT client_id, ring_idx, val FROM test.rb_reorg ORDER BY client_id, ring_idx;

# Ring state continues (4th insert wraps to slot 1, count stays 3)
INSERT INTO test.rb_reorg (client_id, val) VALUES (1, 'wrap_d');
SELECT client_id, ring_idx, val FROM test.rb_reorg
    WHERE client_id = 1 ORDER BY ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb_reorg WHERE client_id = 1 AND ring_idx = 0;
SET ndb_ring_buffer_show_meta = OFF;

# Inplace partition management still rejected on the repartitioned table
# (bare REORGANIZE now stops at the SQL layer: the partition count became
# explicit after ADD PARTITION, so probe with ADD PARTITION instead)
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE test.rb_reorg ALGORITHM=INPLACE, ADD PARTITION PARTITIONS 1;

DROP TABLE test.rb_reorg;

# Bare REORGANIZE PARTITION on an implicitly partitioned ring table is
# rejected the same way (today a no-op, but after add-node scale-out it
# would move data through the unflagged copy path)

CREATE TABLE test.rb_reorg_i (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    val VARCHAR(50),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_reorg_i (client_id, val) VALUES (1, 'a');

--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE test.rb_reorg_i ALGORITHM=INPLACE, REORGANIZE PARTITION;

INSERT INTO test.rb_reorg_i (client_id, val) VALUES (1, 'b');
SELECT client_id, ring_idx, val FROM test.rb_reorg_i ORDER BY ring_idx;

DROP TABLE test.rb_reorg_i;

--echo #
--echo # Case 7: TTL on a ring buffer table is a creation-time property
--echo #

# Enabling TTL on an existing ring buffer table is rejected (meta rows
# written so far carry a zero TTL column); the message goes through
# ER_ILLEGAL_HA_CREATE_OPTION on the copy path.
CREATE TABLE test.rb_ttl (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    val VARCHAR(50),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_ttl (client_id, val) VALUES (1, 'a');

# TTL added alongside the ring comment
--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_ttl COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta,TTL=3600@created_at";

# TTL replacing the ring comment (comment re-injection keeps the ring
# modifier alive, so this still enables TTL on a ring table)
--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_ttl COMMENT="NDB_TABLE=TTL=3600@created_at";

# The inplace path rejects it with its own reason
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE test.rb_ttl ALGORITHM=INPLACE, COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta,TTL=3600@created_at";

# Comment unchanged, table still writable
SHOW CREATE TABLE test.rb_ttl;
INSERT INTO test.rb_ttl (client_id, val) VALUES (1, 'b');
SELECT client_id, ring_idx, val FROM test.rb_ttl ORDER BY ring_idx;

DROP TABLE test.rb_ttl;

# On a TTL ring buffer table the TTL seconds may change, TTL cannot be
# disabled (deleteOldest would become legal on a ring with purged holes).
CREATE TABLE test.rb_ttl2 (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    created_at TIMESTAMP NULL,
    val VARCHAR(50),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=TTL=3600@created_at,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_ttl2 (client_id, created_at, val) VALUES (1, NOW(), 'a');

# TTL seconds change: allowed
ALTER TABLE test.rb_ttl2 COMMENT="NDB_TABLE=TTL=7200@created_at,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
SHOW CREATE TABLE test.rb_ttl2;

# TTL=OFF: rejected on both paths
--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_ttl2 COMMENT="NDB_TABLE=TTL=OFF,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE test.rb_ttl2 ALGORITHM=INPLACE, COMMENT="NDB_TABLE=TTL=OFF,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# A comment without the TTL modifier keeps it (re-injection): no change
ALTER TABLE test.rb_ttl2 COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
SHOW CREATE TABLE test.rb_ttl2;

# Data untouched, ring continues
INSERT INTO test.rb_ttl2 (client_id, created_at, val) VALUES (1, NOW(), 'b');
SELECT client_id, ring_idx, val FROM test.rb_ttl2 ORDER BY ring_idx;

DROP TABLE test.rb_ttl2;

--echo #
--echo # Case 8: repartition via ALTER ... PARTITION BY
--echo #

# Repartitioning to a user-defined scheme is rejected (the COPY alter
# re-enters CREATE, where non-KEY partitioning on a ring buffer table is
# refused - without the guard the copy succeeded but the table became
# write-dead: every INSERT failed with NDB 4544). Repartitioning to KEY
# is allowed and preserves ring state through the copy.

CREATE TABLE test.rb_repart (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    val VARCHAR(50),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
  COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

INSERT INTO test.rb_repart (client_id, val) VALUES (1, 'a');
INSERT INTO test.rb_repart (client_id, val) VALUES (1, 'b');
INSERT INTO test.rb_repart (client_id, val) VALUES (1, 'c');
INSERT INTO test.rb_repart (client_id, val) VALUES (1, 'd');

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_repart PARTITION BY RANGE (client_id) (
    PARTITION p0 VALUES LESS THAN (100),
    PARTITION p1 VALUES LESS THAN MAXVALUE
  );

# Table unchanged and still writable after the rejected repartition
SELECT client_id, ring_idx, val FROM test.rb_repart ORDER BY ring_idx;
INSERT INTO test.rb_repart (client_id, val) VALUES (1, 'e');
SELECT client_id, ring_idx, val FROM test.rb_repart ORDER BY ring_idx;

# Repartition to KEY: allowed, ring state preserved through the copy
ALTER TABLE test.rb_repart PARTITION BY KEY(client_id) PARTITIONS 2;
SELECT client_id, ring_idx, val FROM test.rb_repart ORDER BY ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) FROM test.rb_repart WHERE client_id = 1 AND ring_idx = 0;
SET ndb_ring_buffer_show_meta = OFF;
INSERT INTO test.rb_repart (client_id, val) VALUES (1, 'f');
SELECT client_id, ring_idx, val FROM test.rb_repart ORDER BY ring_idx;

DROP TABLE test.rb_repart;


--echo #
--echo # Case 9: enabling MAX_ROWS_PER_PK on an ordinary or non-NDB table via ALTER - blocked
--echo #
# The copy would keep every row as it is: no meta rows, slots outside
# 1..size, a ring_idx = 0 row taken for a meta row. DROP+CREATE instead.
CREATE TABLE test.rb_plain (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    val VARCHAR(20),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB;
INSERT INTO test.rb_plain VALUES (1, 0, NULL, 'a'), (1, 7, NULL, 'b'),
                                 (1, 50, NULL, 'c'), (2, 3, NULL, 'd');

--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_plain COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_plain ALGORITHM=COPY, COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE test.rb_plain ALGORITHM=INPLACE, COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";

# The table is unchanged: still an ordinary table with the same rows
SHOW CREATE TABLE test.rb_plain;
SELECT client_id, ring_idx, val FROM test.rb_plain ORDER BY client_id, ring_idx;
INSERT INTO test.rb_plain (client_id, val) VALUES (3, 'e');
SELECT client_id, ring_idx, val FROM test.rb_plain WHERE client_id = 3;

DROP TABLE test.rb_plain;

# The same from a table of another engine (no NDB table to compare with)
CREATE TABLE test.rb_innodb (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    val VARCHAR(20),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE = InnoDB;
INSERT INTO test.rb_innodb VALUES (1, 0, NULL, 'a'), (1, 7, NULL, 'b');
--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE test.rb_innodb ENGINE = NDB,
    COMMENT="NDB_TABLE=MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
SHOW CREATE TABLE test.rb_innodb;
DROP TABLE test.rb_innodb;
