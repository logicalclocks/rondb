#
# Run only the ClusterJ RingBufferTest from MTR
#

--source include/have_ndb.inc
--source include/full_result_diff.inc
--source suite/ndb/include/have_connectorj.inc

--let SEP=:
if (`select @@version_compile_os IN ("Win32","Win64","Windows")`)
{
--let SEP=;
}

--let JAVA_MIN_REQUIRED_VERSION=1.8
--source suite/ndb/include/have_java.inc
--source suite/ndb/include/have_clusterj.inc

--let CLUSTERJ_JAVA_WARNING_ARGS=
if (`SELECT SUBSTRING_INDEX('$MTR_JAVA_VERSION', '.', 1) + 0 >= 24`)
{
  --let CLUSTERJ_JAVA_WARNING_ARGS= --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow
}

--replace_regex /Java .*/Java VERSION/ /Running named tests in '.*clusterj-test-[^']*\.jar'/Running named tests in 'CLUSTERJ_TEST_JAR'/ /Finished running tests in '.*clusterj-test-[^']*\.jar'/Finished running tests in 'CLUSTERJ_TEST_JAR'/
--error 0,1
exec
  $MTR_JAVA -ea $CLUSTERJ_JAVA_WARNING_ARGS
  -Dclusterj.properties=$MYSQLTEST_VARDIR/tmp/clusterj.properties
  -Djava.library.path=$NDBCLIENT_LIB_DIR
  -Duser.timezone=$TZ
  -Djava.io.tmpdir=$MYSQLTEST_VARDIR/tmp
  -Dmysqld2.port=$MASTER_MYPORT1
  -classpath $CLUSTERJ_TEST_JAR$SEP$CLUSTERJ_JAR$SEP$MTR_CLASSPATH
  testsuite.clusterj.AllTests
  $CLUSTERJ_TEST_JAR -n RingBufferTest
  ;

--remove_file $MYSQLTEST_VARDIR/tmp/clusterj.properties

# DIAG: Full table scan with show_meta (no WHERE filter)
--echo # DIAG: Full table scan with show_meta
SET ndb_ring_buffer_show_meta = ON;
SELECT sensor_id, ring_idx, HEX(ring_meta) FROM ring_buffer_sensor
  ORDER BY sensor_id, ring_idx;
--echo # DIAG: Filtered scan for sensor_id=3100 with show_meta
SELECT sensor_id, ring_idx, HEX(ring_meta) FROM ring_buffer_sensor
  WHERE sensor_id = 3100 ORDER BY ring_idx;
--echo # DIAG: PK lookup for meta row (3100, 0) with show_meta
SELECT sensor_id, ring_idx, HEX(ring_meta) FROM ring_buffer_sensor
  WHERE sensor_id = 3100 AND ring_idx = 0;
SET ndb_ring_buffer_show_meta = OFF;

