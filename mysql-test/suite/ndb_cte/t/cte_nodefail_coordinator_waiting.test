# RONDB-1121 NF-13: the transaction coordinator fails while every DBSPJ
# worker of a CTE query waits for its next SCAN_NEXTREQ.
# Run with: ./mtr --suite=ndb_cte cte_nodefail_coordinator_waiting
#
# Runs the CteCoordinatorDiesWaitingScan case from the testNodeRestart NDBT
# program (storage/ndb/test/ndbapi/testNodeRestart.cpp, plan
# storage/ndb/claude_files/pushdown_join_aggregation/node_failure_test_plan.md).
#
# The API holds the query after its first row; with a 64-row main scan
# batch every DBSPJ worker has sent a non-final SCAN_FRAGCONF and waits
# (RS_WAITING). The case kills the coordinator, which can no longer send
# a SCAN_NEXTREQ, and requires a survivor's SPJ_ORPHANED_SCANS line for
# the coordinator, the coordinator to rejoin, the leak-check DUMPs (2650
# above all: no DBSPJ request may survive as an RS_ABORTED tombstone;
# 2361, 2362, 2363, 2560; each crashes a node on a leak) and the query to
# return every row afterwards. Three iterations. Needs 2 data nodes with
# 2 replicas, which this suite's cluster provides.
#
# No error insert: runs on release binaries too, where 2361-2363 are not
# checked. The testNodeRestart binary is only present in WITH_NDB_TEST
# builds.
#
# On failure the program's output is in $NDB_TOOLS_OUTPUT (var/tmp) of the
# saved test directory.

--source include/have_ndb.inc

# Locate the testNodeRestart binary next to ndb_mgm, skip if this
# build does not include the NDBT test programs.
--perl
use strict;
use File::Basename;
my $mgm = $ENV{'NDB_MGM'} or die "NDB_MGM not set";
my ($mgm_bin) = split(/\s+/, $mgm);
my $tnr = dirname($mgm_bin) . "/testNodeRestart";
my $vardir = $ENV{'MYSQLTEST_VARDIR'} or die "MYSQLTEST_VARDIR not set";
open(my $f, '>', "$vardir/tmp/tnr_location.inc") or die "$!";
if (-x $tnr) {
  print $f "let \$TEST_NODE_RESTART= $tnr;\n";
} else {
  print $f "--skip Needs testNodeRestart binary (WITH_NDB_TEST build)\n";
}
close($f);
EOF
--source $MYSQLTEST_VARDIR/tmp/tnr_location.inc
--remove_file $MYSQLTEST_VARDIR/tmp/tnr_location.inc

# The NDBT program creates its tables (TEST_DB.T1 and the CTE fixtures
# TEST_DB.cte_nf_src / cte_nf_virtual) directly via the NDB API. Tables
# created outside of the MySQL Server crash the MySQL Server, so both
# MySQL Servers are shut down while the NDBT case runs and started again
# after the NDBT tables have been dropped.
--connect(s1,127.0.0.1,root,,test,$MASTER_MYPORT,)
--connect(s2,127.0.0.1,root,,test,$MASTER_MYPORT1,)

--connection s1
--echo "[shutting down mysqld 1]"
--let $mysqld_name=mysqld.1.1
--source include/shutdown_mysqld.inc
--let $expect_mysqld1_file_name= $_expect_file_name

--connection s2
--echo "[shutting down mysqld 2]"
--let $mysqld_name=mysqld.2.1
--source include/shutdown_mysqld.inc
--let $expect_mysqld2_file_name= $_expect_file_name

--connection default

--echo # NF-13: kill the coordinator while every DBSPJ worker waits for SCAN_NEXTREQ
--exec $TEST_NODE_RESTART -n CteCoordinatorDiesWaitingScan T1 >> $NDB_TOOLS_OUTPUT 2>&1

# The NDBT framework drops T1 and the case's finalizer drops the CTE
# fixtures when the case completes cleanly; a missing table is not an
# error here.
--echo "[dropping NDBT test tables]"
--exec $NDB_DROP_TABLE -d TEST_DB T1 >> $NDB_TOOLS_OUTPUT 2>&1 || true
--exec $NDB_DROP_TABLE -d TEST_DB cte_nf_src >> $NDB_TOOLS_OUTPUT 2>&1 || true
--exec $NDB_DROP_TABLE -d TEST_DB cte_nf_virtual >> $NDB_TOOLS_OUTPUT 2>&1 || true

--echo "[starting mysqld 1]"
--let $_expect_file_name= $expect_mysqld1_file_name
--let $mysqld_name=mysqld.1.1
--source include/start_mysqld.inc

--echo "[starting mysqld 2]"
--let $_expect_file_name= $expect_mysqld2_file_name
--let $mysqld_name=mysqld.2.1
--source include/start_mysqld.inc

--remove_file $NDB_TOOLS_OUTPUT

--echo # CteCoordinatorDiesWaitingScan passed
