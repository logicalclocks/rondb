# RONDB-1124 bug 8, PK-8b: the transaction coordinator fails while the
# replay of SCAN_FRAGREQ feeds that parked before a successful SETUP is
# held on a peer; the scan feed's coordinator guard must refuse the replay
# on the host record's ZNODE_DOWN even while m_connected still says the
# coordinator is connected.
# Run with: ./mtr --suite=ndb_cte cte_nodefail_coordinator_scan_replay
#
# Runs the CteCoordinatorDiesParkedScanReplay case from the testNodeRestart
# NDBT program (storage/ndb/test/ndbapi/testNodeRestart.cpp). It is the
# scan counterpart of cte_nodefail_coordinator_replay (PK-8).
#
# The query is a main aggregation whose aggregate leaf is an index scan
# of the source table's PRIMARY ordered index (CteQueryUtil ScanAggMain),
# so its feeds are SCAN_FRAGREQs. Error insert 5161 on the peer holds its
# SETUP_REQ until one SCAN_FRAGREQ has parked on the SETUP's identity,
# lets the SETUP succeed, and then holds the replay of the parked
# consumers on every LDM / query instance until that instance processes
# NODE_FAILREP, which queues the replays ahead of the instance's own
# node-failure handling, so they run before the proxy can release the
# state. The case kills the coordinator once a held SCAN_FRAGREQ was
# reported (CTE_PK8_REPLAY_HELD). The coordinator guard ignores
# m_connected for that replay, as if DISCONNECT_REP lagged the
# node-failure protocol, so JOIN_AGG_SCAN_FRAGREQ_REJECTED (SCAN_FRAGREF
# 286) must name the failed coordinator and the same iteration, instance
# and park record: the host record alone refused it. The case also
# requires the query to fail with a node-failure error, the coordinator
# to rejoin, the join-agg leak-check DUMPs (2361, 2362, 2363, 2560, 2650)
# to stay clean and the query to return the full aggregate afterwards.
# Three iterations; the peer's insert is cleared after each. Needs 2 data
# nodes with 2 replicas, which this suite's cluster provides.
#
# The error insert needs error-insert capable ndbmtd binaries, and the
# testNodeRestart binary is only present in WITH_NDB_TEST builds.
#
# On failure the program's output is in $NDB_TOOLS_OUTPUT (var/tmp) of the
# saved test directory.

--source include/have_ndb.inc
--source include/have_ndb_debug.inc

# Locate the testNodeRestart binary next to ndb_mgm, skip if this
# build does not include the NDBT test programs.
--perl
use strict;
use File::Basename;
my $mgm = $ENV{'NDB_MGM'} or die "NDB_MGM not set";
my ($mgm_bin) = split(/\s+/, $mgm);
my $tnr = dirname($mgm_bin) . "/testNodeRestart";
my $vardir = $ENV{'MYSQLTEST_VARDIR'} or die "MYSQLTEST_VARDIR not set";
open(my $f, '>', "$vardir/tmp/tnr_location.inc") or die "$!";
if (-x $tnr) {
  print $f "let \$TEST_NODE_RESTART= $tnr;\n";
} else {
  print $f "--skip Needs testNodeRestart binary (WITH_NDB_TEST build)\n";
}
close($f);
EOF
--source $MYSQLTEST_VARDIR/tmp/tnr_location.inc
--remove_file $MYSQLTEST_VARDIR/tmp/tnr_location.inc

# The NDBT program creates its tables (TEST_DB.T1 and the CTE fixtures
# TEST_DB.cte_nf_src, with its PRIMARY ordered index, and cte_nf_virtual)
# directly via the NDB API. Tables created outside of the MySQL Server
# crash the MySQL Server, so both MySQL Servers are shut down while the
# NDBT case runs and started again after the NDBT tables have been
# dropped.
--connect(s1,127.0.0.1,root,,test,$MASTER_MYPORT,)
--connect(s2,127.0.0.1,root,,test,$MASTER_MYPORT1,)

--connection s1
--echo "[shutting down mysqld 1]"
--let $mysqld_name=mysqld.1.1
--source include/shutdown_mysqld.inc
--let $expect_mysqld1_file_name= $_expect_file_name

--connection s2
--echo "[shutting down mysqld 2]"
--let $mysqld_name=mysqld.2.1
--source include/shutdown_mysqld.inc
--let $expect_mysqld2_file_name= $_expect_file_name

--connection default

--echo # PK-8b: kill the coordinator while parked SCAN_FRAGREQ replays are held on a peer (error insert 5161)
--exec $TEST_NODE_RESTART -n CteCoordinatorDiesParkedScanReplay T1 >> $NDB_TOOLS_OUTPUT 2>&1

# The NDBT framework drops T1 and the case's finalizer drops the CTE
# fixtures when the case completes cleanly; a missing table is not an
# error here.
--echo "[dropping NDBT test tables]"
--exec $NDB_DROP_TABLE -d TEST_DB T1 >> $NDB_TOOLS_OUTPUT 2>&1 || true
--exec $NDB_DROP_TABLE -d TEST_DB cte_nf_src >> $NDB_TOOLS_OUTPUT 2>&1 || true
--exec $NDB_DROP_TABLE -d TEST_DB cte_nf_virtual >> $NDB_TOOLS_OUTPUT 2>&1 || true

--echo "[starting mysqld 1]"
--let $_expect_file_name= $expect_mysqld1_file_name
--let $mysqld_name=mysqld.1.1
--source include/start_mysqld.inc

--echo "[starting mysqld 2]"
--let $_expect_file_name= $expect_mysqld2_file_name
--let $mysqld_name=mysqld.2.1
--source include/start_mysqld.inc

--remove_file $NDB_TOOLS_OUTPUT

--echo # CteCoordinatorDiesParkedScanReplay passed
