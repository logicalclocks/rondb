=== filter-29: main WHERE > on CTE aggregate output (SUM) ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_shippriority) AS t
FROM orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM customer AS c
JOIN sums ON sums.k = c.c_custkey
WHERE sums.t > 60000
GROUP BY sums.k;

