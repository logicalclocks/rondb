==========



== Expected result ==
WITH clk AS (
SELECT o_custkey AS k, COUNT(*) AS n, MAX(o_clerk) AS mc
FROM orders GROUP BY o_custkey)
SELECT clk.k, SUM(clk.n)
FROM customer AS c
JOIN clk ON clk.k = c.c_custkey
WHERE clk.mc IS NULL
GROUP BY clk.k|
