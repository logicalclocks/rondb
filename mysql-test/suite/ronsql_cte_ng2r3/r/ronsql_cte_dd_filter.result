SELECT o_custkey AS k, SUM(o_shippriority) AS t, COUNT(*) AS n
FROM orders WHERE o_totalprice > 10000 GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t), SUM(sums.n)
FROM customer AS c
JOIN sums ON sums.k = c.c_custkey
GROUP BY sums.k;

