=== fpw-7: scanCte main root (pinned to 1), FRAGS_PER_WORKER = 4 ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_shippriority) AS t
FROM orders WHERE o_custkey >= 100 AND o_custkey < 200
GROUP BY o_custkey)
SELECT MAX(sums.t), COUNT(*)
FROM sums;
