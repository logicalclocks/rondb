=== Q1 (form B): high-cardinality CTE GROUP BY (20000 groups), scalar
===     reduce over CTE_SCAN root — multi-batch + cross-NG redistribution ===
== Query ==
WITH per_cust AS (
SELECT lg_cust AS k, SUM(lg_amount) AS s, COUNT(*) AS c
FROM lg_orders GROUP BY lg_cust)
SELECT SUM(s) AS total_amount, SUM(c) AS total_rows, COUNT(*) AS group_count
FROM per_cust;

