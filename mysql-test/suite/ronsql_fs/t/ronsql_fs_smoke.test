--echo
--echo === EDGE: stored bytes of the UTF-8 keys (utf8mb4 round trip through mysqltest) ===
SELECT `n`, HEX(`s_key`) AS `key_hex`, CHAR_LENGTH(`s_key`) AS `chars`, LENGTH(`s_key`) AS `bytes` FROM `edge_str_1` WHERE `n` IN (10, 13) ORDER BY `n`|
SELECT `n`, HEX(`s_val`) AS `val_hex` FROM `edge_str_1` WHERE `n` IN (9, 11, 14, 15, 16) ORDER BY `n`|

--echo
--echo === PROBE EDGE-STR-A: apostrophe key, IN list with empty / literal-NULL / multibyte keys ===
--let QUERY_FILE=$MYSQL_TMP_DIR/q_edge_str_a.sql
--write_file $QUERY_FILE
