--echo
--echo === PROBE EDGE-COMP-A: composite child-PK hop with two conditions (parent 2 -> child B) ===
let $QUERY=
WITH `b` AS (SELECT `ck1`, `ck2`, COUNT(*) AS `hw_cnt` FROM `edge_parent_1` WHERE `parent_id` = 2 GROUP BY `ck1`, `ck2`) SELECT `j2`.`label` AS `c_label`, `j2`.`weight` AS `c_weight` FROM `b` JOIN `edge_child_1` AS `j2` ON `j2`.`ck1` = `b`.`ck1` AND `j2`.`ck2` = `b`.`ck2`;|
--source suite/ronsql/include/ronsql_compare.inc
