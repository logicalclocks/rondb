# ronsql_fs_fuzz_spec — RONDB-1121 E6: spec-level random generator.
# Drives the rondb-cli binary: 200 seeded feature-view specifications
# (seed 1) sampled inside the Hopsworks gates, checked against the ported
# emitter (gate / template count), every RonSQL template run on MySQL and
# RonSQL (RDRS) and compared typed (random_generator.md §3).  Only the
# SUMMARY line, any SIGNATURE lines and failing CASE lines are printed
# (--quiet); a failing case makes the command exit non-zero.
# Findings: suite/ronsql_fs/findings/spec_fuzz.md.

--source include/have_ndb.inc

if (!$RONDB_CLI) {
  --skip rondb-cli binary not found
}

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--echo === Create and load the feature-store data set ===
--source suite/ronsql_fs/include/fs_schema.inc
--source suite/ronsql_fs/include/fs_data.inc

--let $FS=$RONDB_CLI --host=127.0.0.1 --mysql-port=$MASTER_MYPORT --rdrs-host=$RDRS_NOKEY_HOST --rdrs-port=$RDRS_NOKEY_PORT --no-rondis --quiet

--echo
--echo === Spec-level fuzz: seed 1, 200 cases, L1 on both engines ===
--exec $FS -e ".fs_fuzz spec --seed 1 --count 200 --db test --sf 0.01 --threads 4 --dump-dir $MYSQLTEST_VARDIR/log/fs_fuzz_spec --quiet"

--echo
--echo === Cleanup ===
--source suite/ronsql_fs/include/fs_drop.inc
