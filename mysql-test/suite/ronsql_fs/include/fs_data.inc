# --- transactions_str_1: 100 entities, ~36 rows each, 111 entities per statement ---
INSERT INTO `test`.`transactions_str_1` (`customer_key`, `event_time`, `amount`, `fee`, `merchant_id`, `category`, `score`, `amount_dec`, `flag`)
SELECT CONCAT(IF(MOD(c.n,10)=0,'CUST-','cust-'), LPAD(c.n, 8, '0')),
       DATE_SUB('2026-06-01 00:00:00', INTERVAL (i.n * sp.s + off.o) SECOND),
       100 + MOD(c.n*31 + i.n*17, 900),
       MOD(c.n + i.n, 50) - 10,
       CASE WHEN MOD(c.n + i.n, 11)=0 THEN NULL WHEN MOD(c.n + i.n, 23)=0 THEN 100 + 1 + MOD(i.n,3) ELSE MOD(c.n*7 + i.n, 100) + 1 END,
       ELT(MOD(c.n + i.n, 6)+1, 'grocery','Grocery','fuel','travel','Travel','online'),
       MOD(c.n, 97) + i.n * 0.25,
       MOD(c.n*31 + i.n*17, 90000) / 100,
       MOD(c.n + i.n, 2)
FROM _seq AS c
JOIN _ntx ON _ntx.k = MOD(c.n, 16)
JOIN _seq300 AS i ON i.n <= _ntx.n
JOIN _spacing AS sp ON sp.k = MOD(c.n DIV 16, 4)
JOIN _offset AS off ON off.k = MOD(c.n, 3)
WHERE c.n BETWEEN 1 AND 100;

