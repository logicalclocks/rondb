--source include/have_ndb.inc

# suite/ndb_ttl_purge/t/ttl_purge_ring_buffer.test
#
# TTL purge on ring buffer tables (MAX_ROWS_PER_PK + TTL). The purge
# physically reclaims expired data rows in scan order, never touches the
# ring meta row (DBTUP never expires it; its TTL column holds the type
# maximum), and the ring continues past the reclaimed slots. Cases:
#   - test_reclaim_with_ttl_index    (index-scan purge)
#   - test_reclaim_without_ttl_index (table-scan purge)
#   - test_precision_columns         (TIMESTAMP(3), DATETIME(6) TTL columns)
#   - test_null_ttl_rows             (NULL TTL values are never purged)
#   - test_unique_value_reuse_after_purge
#   - test_blob_column               (blob parts of purged rows released)
# Writers racing the purge: ttl_purge_ring_buffer_concurrent; recovery
# with purged holes: ttl_purge_ring_buffer_restart.
#
# Expired rows are invisible to SQL before and after the purge, so the
# reclaim is observed through the purge metrics and the physical row count
# in ndbinfo.memory_per_fragment (all replicas summed, divided by the
# replica count of fragment 0; meta rows included).

--source suite/ndb_ttl_purge/include/ttl_purge_setup.inc
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc

SET time_zone = '+00:00';
CREATE DATABASE ttl_rb;

--echo #
--echo # Test: test_reclaim_with_ttl_index
--echo # Ring of 5 per prefix, TTL 5 s, ttl_index; 3 prefixes with expired and future rows
--echo #

CREATE TABLE ttl_rb.rb (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col DATETIME,
    data VARCHAR(100),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=5@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rb.rb (ttl_col);

--let $wait_db = ttl_rb
--let $wait_table = rb
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
# Purge off while seeding, so that the pre-purge probes are deterministic
--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2

# Baseline of the purge counter
--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rb_initial.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rb_initial.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $initial_purged = $json_value

# Prefix 1: 3 expired + 2 future (ring full, next_pos wrapped to 1)
# Prefix 2: 5 expired (ring full)
# Prefix 3: 2 future
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_expired_1');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_expired_2');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_expired_3');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_future_4');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_future_5');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_expired_1');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_expired_2');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_expired_3');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_expired_4');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_expired_5');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (3, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p3_future_1');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (3, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p3_future_2');

# Visible rows before the purge
SELECT client_id, ring_idx, data FROM ttl_rb.rb ORDER BY client_id, ring_idx;
--let $physical_before = `SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb'`
--let $assert_text = 15 physical rows before the purge (3 meta + 12 data)
--let $assert_cond = $physical_before = 15
--source include/assert.inc

# Purge on again (default configuration)
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc
# Wait until the 8 expired rows are reclaimed
--let $expected_purge_total = `SELECT $initial_purged + 8`
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc

# Visible rows unchanged, physical rows reduced to meta rows + live rows
SELECT client_id, ring_idx, data FROM ttl_rb.rb ORDER BY client_id, ring_idx;
--let $physical_after = `SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb'`
--let $assert_text = 7 physical rows after the purge (3 meta + 4 live)
--let $assert_cond = $physical_after = 7
--source include/assert.inc

# Meta rows untouched: TTL column at the DATETIME maximum, count = span
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx, ttl_col, HEX(ring_meta) FROM ttl_rb.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;

# The ring continues past the reclaimed slots (next_pos 1 on prefixes 1, 2)
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_new_6');
INSERT INTO ttl_rb.rb (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p2_new_6');
SELECT client_id, ring_idx, data FROM ttl_rb.rb ORDER BY client_id, ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rb.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;
--let $physical_final = `SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb'`
--let $assert_text = 9 physical rows after the inserts (3 meta + 6 live)
--let $assert_cond = $physical_final = 9
--source include/assert.inc

DROP TABLE ttl_rb.rb;

--echo #
--echo # Test: test_reclaim_without_ttl_index
--echo # Same table without ttl_index: the purge scans the table
--echo #

CREATE TABLE ttl_rb.rb_noidx (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col DATETIME,
    data VARCHAR(100),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=5@ring_idx@ring_meta";

--let $wait_db = ttl_rb
--let $wait_table = rb_noidx
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
# Purge off while seeding, so that the pre-purge probes are deterministic
--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2

# Baseline of the purge counter
--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rb_noidx_initial.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rb_noidx_initial.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $initial_purged = $json_value

# Prefix 1: 3 expired + 1 future; prefix 2: 2 expired
INSERT INTO ttl_rb.rb_noidx (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_expired_1');
INSERT INTO ttl_rb.rb_noidx (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_expired_2');
INSERT INTO ttl_rb.rb_noidx (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_expired_3');
INSERT INTO ttl_rb.rb_noidx (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_future_4');
INSERT INTO ttl_rb.rb_noidx (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_expired_1');
INSERT INTO ttl_rb.rb_noidx (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_expired_2');

SELECT client_id, ring_idx, data FROM ttl_rb.rb_noidx ORDER BY client_id, ring_idx;
--let $physical_before = `SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_noidx' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_noidx'`
--let $assert_text = 8 physical rows before the purge (2 meta + 6 data)
--let $assert_cond = $physical_before = 8
--source include/assert.inc

# Purge on again (default configuration)
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc
--let $expected_purge_total = `SELECT $initial_purged + 5`
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc

SELECT client_id, ring_idx, data FROM ttl_rb.rb_noidx ORDER BY client_id, ring_idx;
--let $physical_after = `SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_noidx' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_noidx'`
--let $assert_text = 3 physical rows after the purge (2 meta + 1 live)
--let $assert_cond = $physical_after = 3
--source include/assert.inc

SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx, ttl_col, HEX(ring_meta) FROM ttl_rb.rb_noidx WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;

# Prefix 2 (all rows reclaimed) continues from its meta row
INSERT INTO ttl_rb.rb_noidx (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p2_new_3');
SELECT client_id, ring_idx, data FROM ttl_rb.rb_noidx ORDER BY client_id, ring_idx;

DROP TABLE ttl_rb.rb_noidx;

--echo #
--echo # Test: test_precision_columns
--echo # TIMESTAMP(3) and DATETIME(6) TTL columns: the purge reclaims, the meta rows carry the maximum with fraction digits
--echo #

CREATE TABLE ttl_rb.rb_ts3 (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col TIMESTAMP(3) NULL,
    data VARCHAR(100),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rb.rb_ts3 (ttl_col);
CREATE TABLE ttl_rb.rb_dt6 (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col DATETIME(6),
    data VARCHAR(100),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rb.rb_dt6 (ttl_col);

--let $wait_db = ttl_rb
--let $wait_table = rb_ts3
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
--let $wait_table = rb_dt6
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
# Purge off while seeding, so that the pre-purge probes are deterministic
--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2

--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rb_prec_initial.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rb_prec_initial.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $initial_purged = $json_value

# Each table: slots 1 and 2 expired, slot 3 live (ring full, next_pos 1)
INSERT INTO ttl_rb.rb_ts3 (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(3), INTERVAL 5 MINUTE), 'ts3_exp_1');
INSERT INTO ttl_rb.rb_ts3 (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(3), INTERVAL 5 MINUTE), 'ts3_exp_2');
INSERT INTO ttl_rb.rb_ts3 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(3), INTERVAL 1 HOUR), 'ts3_live_3');
INSERT INTO ttl_rb.rb_dt6 (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(6), INTERVAL 5 MINUTE), 'dt6_exp_1');
INSERT INTO ttl_rb.rb_dt6 (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(6), INTERVAL 5 MINUTE), 'dt6_exp_2');
INSERT INTO ttl_rb.rb_dt6 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(6), INTERVAL 1 HOUR), 'dt6_live_3');
SELECT client_id, ring_idx, data FROM ttl_rb.rb_ts3 ORDER BY ring_idx;
SELECT client_id, ring_idx, data FROM ttl_rb.rb_dt6 ORDER BY ring_idx;

# Purge on again (default configuration)
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc
--let $expected_purge_total = `SELECT $initial_purged + 4`
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc

SELECT client_id, ring_idx, data FROM ttl_rb.rb_ts3 ORDER BY ring_idx;
SELECT client_id, ring_idx, data FROM ttl_rb.rb_dt6 ORDER BY ring_idx;
--let $physical_ts3 = `SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_ts3' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_ts3'`
--let $assert_text = rb_ts3: 2 physical rows after the purge (meta + live)
--let $assert_cond = $physical_ts3 = 2
--source include/assert.inc
--let $physical_dt6 = `SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_dt6' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_dt6'`
--let $assert_text = rb_dt6: 2 physical rows after the purge (meta + live)
--let $assert_cond = $physical_dt6 = 2
--source include/assert.inc

# Meta rows: the type maximum with the column's fraction digits, untouched by the purge
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, ring_idx, ttl_col, HEX(ring_meta) FROM ttl_rb.rb_ts3 WHERE ring_idx = 0;
SELECT client_id, ring_idx, ttl_col, HEX(ring_meta) FROM ttl_rb.rb_dt6 WHERE ring_idx = 0;
SET ndb_ring_buffer_show_meta = OFF;

# The rings continue into the reclaimed slot 1
INSERT INTO ttl_rb.rb_ts3 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(3), INTERVAL 1 HOUR), 'ts3_new_4');
INSERT INTO ttl_rb.rb_dt6 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(6), INTERVAL 1 HOUR), 'dt6_new_4');
SELECT client_id, ring_idx, data FROM ttl_rb.rb_ts3 ORDER BY ring_idx;
SELECT client_id, ring_idx, data FROM ttl_rb.rb_dt6 ORDER BY ring_idx;

DROP TABLE ttl_rb.rb_ts3;
DROP TABLE ttl_rb.rb_dt6;

--echo #
--echo # Test: test_null_ttl_rows
--echo # Rows with a NULL TTL column never expire and are not purged; the ring overwrites them like any slot
--echo #

CREATE TABLE ttl_rb.rb_null (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col DATETIME,
    data VARCHAR(100),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=5@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rb.rb_null (ttl_col);

--let $wait_db = ttl_rb
--let $wait_table = rb_null
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
# Purge off while seeding, so that the pre-purge probes are deterministic
--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2

--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rb_null_initial.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rb_null_initial.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $initial_purged = $json_value

# Slots: NULL, expired, NULL, expired (next_pos 5)
INSERT INTO ttl_rb.rb_null (client_id, ttl_col, data) VALUES (1, NULL, 'null_1');
INSERT INTO ttl_rb.rb_null (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'exp_2');
INSERT INTO ttl_rb.rb_null (client_id, ttl_col, data) VALUES (1, NULL, 'null_3');
INSERT INTO ttl_rb.rb_null (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'exp_4');
SELECT client_id, ring_idx, data FROM ttl_rb.rb_null ORDER BY ring_idx;

# Purge on again (default configuration)
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc
--let $expected_purge_total = `SELECT $initial_purged + 2`
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc

SELECT client_id, ring_idx, data FROM ttl_rb.rb_null ORDER BY ring_idx;
--let $physical_null = `SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_null' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_null'`
--let $assert_text = rb_null: 3 physical rows after the purge (meta + 2 NULL rows)
--let $assert_cond = $physical_null = 3
--source include/assert.inc

# Slot 5, then the wrap overwrites slot 1 (a NULL row); next_pos 2,
# count 5, total_inserts 6
INSERT INTO ttl_rb.rb_null (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'live_5');
INSERT INTO ttl_rb.rb_null (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'wrap_6');
SELECT client_id, ring_idx, data FROM ttl_rb.rb_null ORDER BY ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rb.rb_null WHERE ring_idx = 0;
SET ndb_ring_buffer_show_meta = OFF;

DROP TABLE ttl_rb.rb_null;

--echo #
--echo # Test: test_unique_value_reuse_after_purge
--echo # A unique value owned by an expired row is free once the purge has reclaimed the row
--echo #

CREATE TABLE ttl_rb.rb_u (
    id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col DATETIME,
    code INT NOT NULL,
    PRIMARY KEY (id, ring_idx),
    UNIQUE INDEX idx_code (code)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rb.rb_u (ttl_col);

--let $wait_db = ttl_rb
--let $wait_table = rb_u
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
# Purge off while seeding, so that the pre-purge probes are deterministic
--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2

--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rb_u_initial.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rb_u_initial.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $initial_purged = $json_value

INSERT INTO ttl_rb.rb_u (id, ttl_col, code) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 100);
# Another prefix cannot take code 100 while its expired owner is physically present
--error ER_DUP_ENTRY
INSERT INTO ttl_rb.rb_u (id, ttl_col, code) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 100);

# Purge on again (default configuration)
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc
--let $expected_purge_total = `SELECT $initial_purged + 1`
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc

INSERT INTO ttl_rb.rb_u (id, ttl_col, code) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 100);
# Prefix 1 continues at slot 2; the reclaimed slot 1 waits for the wrap
INSERT INTO ttl_rb.rb_u (id, ttl_col, code) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 200);
SELECT id, ring_idx, code FROM ttl_rb.rb_u ORDER BY id, ring_idx;
# Prefix 1: next_pos 3, count 2, total_inserts 2; prefix 2: next_pos 2, count 1, total_inserts 1
SET ndb_ring_buffer_show_meta = ON;
SELECT id, HEX(ring_meta) FROM ttl_rb.rb_u WHERE ring_idx = 0 ORDER BY id;
SET ndb_ring_buffer_show_meta = OFF;

DROP TABLE ttl_rb.rb_u;

--echo #
--echo # Test: test_blob_column
--echo # TEXT column: the purge frees the blob parts of the expired rows, the live row keeps its parts
--echo #

CREATE TABLE ttl_rb.rb_blob (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col DATETIME,
    data TEXT,
    PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rb.rb_blob (ttl_col);

--let $wait_db = ttl_rb
--let $wait_table = rb_blob
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
# Purge off while seeding, so that the pre-purge probes are deterministic
--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2

--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rb_blob_initial.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rb_blob_initial.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $initial_purged = $json_value

# Blob part rows: exact fixed-element count of the NDB$BLOB table whose
# parent is rb_blob (parent_fq_name alone would also match the ordered
# indexes), one replica. Plain statements: mysqltest would expand the $ of
# NDB$BLOB inside a --let.
--let $physical_blob = SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_blob' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rb/def/rb_blob'

# Slot 1 live first: its blob parts are the reference count for one row
--let $blob_text = `SELECT REPEAT('X', 3000)`
--disable_query_log
--eval INSERT INTO ttl_rb.rb_blob (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), '$blob_text')
--enable_query_log
--disable_query_log
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE parent_fq_name = 'ttl_rb/def/rb_blob' AND fq_name LIKE '%NDB$BLOB%' AND fragment_num = 0) INTO @blob_parts FROM ndbinfo.memory_per_fragment WHERE parent_fq_name = 'ttl_rb/def/rb_blob' AND fq_name LIKE '%NDB$BLOB%';
--enable_query_log
--let $bp_one = `SELECT @blob_parts`
--let $assert_text = the live row has blob parts
--let $assert_cond = $bp_one > 0
--source include/assert.inc

# Slots 2-4 expired (ring full, next_pos 1)
--disable_query_log
--eval INSERT INTO ttl_rb.rb_blob (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), '$blob_text')
--eval INSERT INTO ttl_rb.rb_blob (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), '$blob_text')
--eval INSERT INTO ttl_rb.rb_blob (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), '$blob_text')
--enable_query_log
SELECT client_id, ring_idx, LENGTH(data) AS len FROM ttl_rb.rb_blob ORDER BY ring_idx;
--disable_query_log
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE parent_fq_name = 'ttl_rb/def/rb_blob' AND fq_name LIKE '%NDB$BLOB%' AND fragment_num = 0) INTO @blob_parts FROM ndbinfo.memory_per_fragment WHERE parent_fq_name = 'ttl_rb/def/rb_blob' AND fq_name LIKE '%NDB$BLOB%';
--enable_query_log
--let $bp_four = `SELECT @blob_parts`
--let $assert_text = four rows hold four times the blob parts of one row
--let $assert_cond = $bp_four = 4 * $bp_one
--source include/assert.inc

# Purge on again (default configuration)
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc
--let $expected_purge_total = `SELECT $initial_purged + 3`
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc

--let $rows = `$physical_blob`
--let $assert_text = rb_blob: 2 physical rows after the purge (meta + live)
--let $assert_cond = $rows = 2
--source include/assert.inc

# The blob parts of the three expired rows are released with them
--disable_query_log
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE parent_fq_name = 'ttl_rb/def/rb_blob' AND fq_name LIKE '%NDB$BLOB%' AND fragment_num = 0) INTO @blob_parts FROM ndbinfo.memory_per_fragment WHERE parent_fq_name = 'ttl_rb/def/rb_blob' AND fq_name LIKE '%NDB$BLOB%';
--enable_query_log
--let $bp_after = `SELECT @blob_parts`
--let $assert_text = only the live row's blob parts remain after the purge
--let $assert_cond = $bp_after = $bp_one
--source include/assert.inc

# The wrap overwrites slot 1 (the live row) and replaces its blob
--disable_query_log
--eval INSERT INTO ttl_rb.rb_blob (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), REPEAT('Y', 3000))
--enable_query_log
SELECT client_id, ring_idx, LENGTH(data) AS len, LEFT(data, 3) AS head FROM ttl_rb.rb_blob ORDER BY ring_idx;
--disable_query_log
SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE parent_fq_name = 'ttl_rb/def/rb_blob' AND fq_name LIKE '%NDB$BLOB%' AND fragment_num = 0) INTO @blob_parts FROM ndbinfo.memory_per_fragment WHERE parent_fq_name = 'ttl_rb/def/rb_blob' AND fq_name LIKE '%NDB$BLOB%';
--enable_query_log
--let $bp_final = `SELECT @blob_parts`
--let $assert_text = one row's blob parts after the wrap
--let $assert_cond = $bp_final = $bp_one
--source include/assert.inc

DROP TABLE ttl_rb.rb_blob;
DROP DATABASE ttl_rb;
--sleep 3

--source suite/ndb_ttl_purge/include/ttl_purge_cleanup_tmp.inc
