--source include/have_ndb.inc
# Defines the server1 / server2 connections used after the system restart
--source include/have_multi_ndb.inc

# suite/ndb_ttl_purge/t/ttl_purge_ring_buffer_restart.test
#
# Recovery of a ring buffer table with TTL (MAX_ROWS_PER_PK + TTL) after
# the TTL purge has reclaimed expired slots, so that the rings have
# physical holes below next_pos (the tests in ndb_ring_buffer only restart
# with logical holes, expired rows still present):
#   Case 1: node restart (node 2, from its own LCP + REDO with the purge
#           deletes)
#   Case 2: initial node restart (node 2 copies the fragments with holes
#           from node 1)
#   Case 3: system restart (all nodes)
# After each restart the visible set, the ring meta rows and the physical
# row count on both replicas must be unchanged. Afterwards the rings refill
# over the holes and the purge keeps reclaiming (the REST server
# reconnected).

--source suite/ndb_ttl_purge/include/ttl_purge_setup.inc
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc

SET time_zone = '+00:00';
CREATE DATABASE ttl_rbr;

CREATE TABLE ttl_rbr.rb (
    client_id INT NOT NULL,
    ring_idx INT NOT NULL DEFAULT 0,
    ring_meta VARBINARY(64),
    ttl_col DATETIME,
    data VARCHAR(100),
    PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=5@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rbr.rb (ttl_col);

--let $wait_db = ttl_rbr
--let $wait_table = rb
--source suite/ndb_ttl_purge/include/ttl_purge_wait_table_detected.inc
# Purge off while seeding, so that the pre-purge probes are deterministic
--exec $ttl_purge_put_config '{"enabled":false}' > /dev/null 2>&1
--sleep 2

--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rbr_initial.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rbr_initial.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $initial_purged = $json_value

# Prefix 1: 3 expired + 2 live (full, next_pos 1)
# Prefix 2: 5 expired (full, next_pos 1)
# Prefix 3: 2 live (next_pos 3)
# Prefix 4: live, expired, live, expired (next_pos 5)
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_exp_1');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_exp_2');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p1_exp_3');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_live_4');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_live_5');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_1');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_2');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_3');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_4');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p2_exp_5');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (3, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p3_live_1');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (3, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p3_live_2');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (4, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p4_live_1');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (4, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p4_exp_2');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (4, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p4_live_3');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (4, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p4_exp_4');

--let $physical = SELECT SUM(fixed_elem_count) DIV (SELECT COUNT(*) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rbr/def/rb' AND fragment_num = 0) FROM ndbinfo.memory_per_fragment WHERE fq_name = 'ttl_rbr/def/rb'
--let $rows = `$physical`
--let $assert_text = 20 physical rows before the purge (4 meta + 16 data)
--let $assert_cond = $rows = 20
--source include/assert.inc

# Purge on again (default configuration)
--source suite/ndb_ttl_purge/include/ttl_purge_reset_config.inc
# The purge reclaims the 10 expired rows: holes at 1.1-1.3, 2.1-2.5, 4.2, 4.4
--let $expected_purge_total = `SELECT $initial_purged + 10`
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc
--let $rows = `$physical`
--let $assert_text = 10 physical rows after the purge (4 meta + 6 live)
--let $assert_cond = $rows = 10
--source include/assert.inc

--echo # State before the restarts
SELECT client_id, ring_idx, data FROM ttl_rbr.rb ORDER BY client_id, ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbr.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;
SELECT node_id, SUM(fixed_elem_count) AS physical_rows FROM ndbinfo.memory_per_fragment
    WHERE fq_name = 'ttl_rbr/def/rb' GROUP BY node_id ORDER BY node_id;

--echo #
--echo # Case 1: node restart of node 2 - holes, live rows and meta rows unchanged
--echo #

--exec $NDB_MGM -e "2 RESTART -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --nowait-nodes=1 --not-started >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "2 START" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT

SELECT client_id, ring_idx, data FROM ttl_rbr.rb ORDER BY client_id, ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbr.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;
SELECT node_id, SUM(fixed_elem_count) AS physical_rows FROM ndbinfo.memory_per_fragment
    WHERE fq_name = 'ttl_rbr/def/rb' GROUP BY node_id ORDER BY node_id;

--echo #
--echo # Case 2: initial node restart of node 2 - the copied fragments carry the holes
--echo #

--exec $NDB_MGM -e "2 RESTART -n -i" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --nowait-nodes=1 --not-started >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "2 START" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT

SELECT client_id, ring_idx, data FROM ttl_rbr.rb ORDER BY client_id, ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbr.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;
SELECT node_id, SUM(fixed_elem_count) AS physical_rows FROM ndbinfo.memory_per_fragment
    WHERE fq_name = 'ttl_rbr/def/rb' GROUP BY node_id ORDER BY node_id;

--echo #
--echo # Case 3: system restart - holes, live rows and meta rows unchanged
--echo #

--exec $NDB_MGM -e "ALL RESTART -N" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --not-started >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "ALL START" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT

# Wait for the mysqlds to reconnect
--source include/ndb_not_readonly.inc
--connection server2
--source include/ndb_not_readonly.inc
--connection server1

SET time_zone = '+00:00';
SELECT client_id, ring_idx, data FROM ttl_rbr.rb ORDER BY client_id, ring_idx;
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbr.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;
SELECT node_id, SUM(fixed_elem_count) AS physical_rows FROM ndbinfo.memory_per_fragment
    WHERE fq_name = 'ttl_rbr/def/rb' GROUP BY node_id ORDER BY node_id;

--echo #
--echo # After the restarts: the rings refill over the holes and the purge keeps working
--echo #

# Prefix 1 takes slots 1-3 (holes), prefix 2 slots 1-2 (holes), prefix 4
# slot 5 (never filled)
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_new_6');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_new_7');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p1_new_8');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p2_new_6');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p2_new_7');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (4, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'p4_new_5');
SELECT client_id, ring_idx, data FROM ttl_rbr.rb ORDER BY client_id, ring_idx;
# Prefix 1: next_pos 4, count 5, total_inserts 8; prefix 2: next_pos 3,
# count 5, total_inserts 7; prefix 3 unchanged; prefix 4: next_pos 1,
# count 5, total_inserts 5
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbr.rb WHERE ring_idx = 0 ORDER BY client_id;
SET ndb_ring_buffer_show_meta = OFF;
--let $rows = `$physical`
--let $assert_text = 16 physical rows after the refill (4 meta + 12 live)
--let $assert_cond = $rows = 16
--source include/assert.inc

# New expired rows on prefix 3 (slots 3, 4) are reclaimed: the purge
# reconnected after the system restart
--exec $ttl_purge_get_metrics > $MYSQL_TMP_DIR/rbr_after_sr.json 2>/dev/null
--let $json_file = $MYSQL_TMP_DIR/rbr_after_sr.json
--let $json_field = rows_purged_total
--source suite/ndb_ttl_purge/include/ttl_purge_json_parse.inc
--let $after_sr_purged = $json_value
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (3, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p3_exp_3');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (3, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p3_exp_4');
--let $expected_purge_total = `SELECT $after_sr_purged + 2`
--let $purge_wait_timeout = 60
--source suite/ndb_ttl_purge/include/ttl_purge_wait_rows_purged.inc
--let $rows = `$physical`
--let $assert_text = 16 physical rows after the purge of the two new expired rows
--let $assert_cond = $rows = 16
--source include/assert.inc
SELECT client_id, ring_idx, data FROM ttl_rbr.rb WHERE client_id = 3 ORDER BY ring_idx;

DROP TABLE ttl_rbr.rb;
DROP DATABASE ttl_rbr;
--sleep 3

# The ndb_mgm / ndb_waiter output file is not covered by the purge suite's
# tmp cleanup (MTR check-testcase fails on leftover files)
--remove_file $NDB_TOOLS_OUTPUT
--source suite/ndb_ttl_purge/include/ttl_purge_cleanup_tmp.inc
