SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbr.rb WHERE ring_idx = 0 ORDER BY client_id;
client_id	HEX(ring_meta)
1	0100000004000000050000000000000008000000000000000000000000000000
2	0100000003000000050000000000000007000000000000000000000000000000
3	0100000003000000020000000000000002000000000000000000000000000000
4	0100000001000000050000000000000005000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
include/assert.inc [16 physical rows after the refill (4 meta + 12 live)]
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (3, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p3_exp_3');
INSERT INTO ttl_rbr.rb (client_id, ttl_col, data) VALUES (3, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'p3_exp_4');
include/assert.inc [16 physical rows after the purge of the two new expired rows]
SELECT client_id, ring_idx, data FROM ttl_rbr.rb WHERE client_id = 3 ORDER BY ring_idx;
client_id	ring_idx	data
3	1	p3_live_1
3	2	p3_live_2
DROP TABLE ttl_rbr.rb;
DROP DATABASE ttl_rbr;
