#
# Test: test_rows_purged_total_accumulates
# Insert 10 expired, wait, check total; insert 15 more, check total again
#
CREATE DATABASE IF NOT EXISTS ttl_metrics;
DROP TABLE IF EXISTS ttl_metrics.accumulate;
CREATE TABLE ttl_metrics.accumulate (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_metrics.accumulate(ttl_col);
ALTER TABLE ttl_metrics.accumulate COMMENT="NDB_TABLE=TTL=5@ttl_col";
INSERT INTO ttl_metrics.accumulate (id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_1');
INSERT INTO ttl_metrics.accumulate (id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_2');
