#
# Test: test_rounds_completed_increments
# Wait, check rounds_completed increases
#
CREATE DATABASE IF NOT EXISTS ttl_metrics;
DROP TABLE IF EXISTS ttl_metrics.rounds_test;
CREATE TABLE ttl_metrics.rounds_test (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_metrics.rounds_test(ttl_col);
ALTER TABLE ttl_metrics.rounds_test COMMENT="NDB_TABLE=TTL=60@ttl_col";
include/assert.inc [rounds_completed should increment over 15s]
DROP DATABASE ttl_metrics;
