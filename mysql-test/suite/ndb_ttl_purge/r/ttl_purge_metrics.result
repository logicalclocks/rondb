#
# Test: test_metrics_cleanup_on_ttl_disable
# Create TTL table, verify detected, disable TTL, verify removed
#
CREATE DATABASE IF NOT EXISTS ttl_metrics;
DROP TABLE IF EXISTS ttl_metrics.cleanup_test;
CREATE TABLE ttl_metrics.cleanup_test (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_metrics.cleanup_test(ttl_col);
ALTER TABLE ttl_metrics.cleanup_test COMMENT="NDB_TABLE=TTL=60@ttl_col";
INSERT INTO ttl_metrics.cleanup_test (id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_1');
INSERT INTO ttl_metrics.cleanup_test (id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_2');
INSERT INTO ttl_metrics.cleanup_test (id, ttl_col, data) VALUES (3, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_3');
INSERT INTO ttl_metrics.cleanup_test (id, ttl_col, data) VALUES (4, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_4');
INSERT INTO ttl_metrics.cleanup_test (id, ttl_col, data) VALUES (5, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_5');
ALTER TABLE ttl_metrics.cleanup_test COMMENT="NDB_TABLE=TTL=off";
Table metrics cleaned up after TTL disabled
DROP DATABASE ttl_metrics;
#
# Test: test_tables_count_accuracy
