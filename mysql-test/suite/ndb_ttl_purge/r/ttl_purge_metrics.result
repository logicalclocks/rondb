INSERT INTO ttl_metrics.accumulate (id, ttl_col, data) VALUES (7, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_7');
INSERT INTO ttl_metrics.accumulate (id, ttl_col, data) VALUES (8, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_8');
INSERT INTO ttl_metrics.accumulate (id, ttl_col, data) VALUES (9, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_9');
INSERT INTO ttl_metrics.accumulate (id, ttl_col, data) VALUES (10, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_10');
include/assert.inc [rows_purged_total should increase by at least 10]
