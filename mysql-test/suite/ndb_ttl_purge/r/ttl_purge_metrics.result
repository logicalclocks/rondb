CREATE INDEX ttl_index ON ttl_metrics.count_0(ttl_col);
ALTER TABLE ttl_metrics.count_0 COMMENT="NDB_TABLE=TTL=60@ttl_col";
CREATE DATABASE IF NOT EXISTS ttl_metrics;
