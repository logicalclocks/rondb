include/assert.inc [Rows expired for less than the lag must not be purged]
#
# Phase 2: lag lowered to 60s => the rows become purgeable
#
UPDATE mysql.ttl_purge_ctrl SET value = 60 WHERE ctrl_id = 1;
#
# Phase 3: negative lag is treated as 0, purging continues
#
UPDATE mysql.ttl_purge_ctrl SET value = -5 WHERE ctrl_id = 1;
