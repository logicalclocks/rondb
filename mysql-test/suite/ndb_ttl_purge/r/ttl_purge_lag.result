SET time_zone = '+00:00';
#
# Phase 1: lag 3600s retains rows that expired ~5 minutes ago
#
CREATE TABLE mysql.ttl_purge_ctrl (ctrl_id INT PRIMARY KEY, value INT) ENGINE=NDB;
INSERT INTO mysql.ttl_purge_ctrl VALUES (1, 3600);
CREATE DATABASE IF NOT EXISTS ttl_lag;
DROP TABLE IF EXISTS ttl_lag.t1;
CREATE TABLE ttl_lag.t1 (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_lag.t1(ttl_col);
ALTER TABLE ttl_lag.t1 COMMENT="NDB_TABLE=TTL=5@ttl_col";
INSERT INTO ttl_lag.t1 (id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_1');
