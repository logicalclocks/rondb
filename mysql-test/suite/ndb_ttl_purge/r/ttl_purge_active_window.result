#
# Phase 6: wrap-around window covering now => purging continues
#
SET @now_min = HOUR(UTC_TIME()) * 60 + MINUTE(UTC_TIME());
SET @gap_min = IF((@now_min + 720) % 1440 = 1439, 1438, (@now_min + 720) % 1440);
UPDATE mysql.ttl_purge_ctrl SET value = @gap_min + 1 WHERE ctrl_id = 2;
UPDATE mysql.ttl_purge_ctrl SET value = @gap_min WHERE ctrl_id = 3;
