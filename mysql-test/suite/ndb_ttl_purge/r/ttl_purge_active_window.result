SET time_zone = '+00:00';
#
# Phase 1: window far from now => expired rows are not purged
#
CREATE TABLE mysql.ttl_purge_ctrl (ctrl_id INT PRIMARY KEY, value INT) ENGINE=NDB;
SET @now_min = HOUR(UTC_TIME()) * 60 + MINUTE(UTC_TIME());
INSERT INTO mysql.ttl_purge_ctrl VALUES (2, (@now_min + 240) % 1440), (3, (@now_min + 360) % 1440);
include/assert.inc [Status must report the window source as ttl_purge_ctrl]
CREATE DATABASE IF NOT EXISTS ttl_aw;
DROP TABLE IF EXISTS ttl_aw.t1;
CREATE TABLE ttl_aw.t1 (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_aw.t1(ttl_col);
ALTER TABLE ttl_aw.t1 COMMENT="NDB_TABLE=TTL=5@ttl_col";
