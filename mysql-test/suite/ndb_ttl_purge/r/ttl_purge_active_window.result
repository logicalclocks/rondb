#
# Phase 2: window moved over now => purging resumes
#
SET @now_min = HOUR(UTC_TIME()) * 60 + MINUTE(UTC_TIME());
UPDATE mysql.ttl_purge_ctrl SET value = (@now_min + 1380) % 1440 WHERE ctrl_id = 2;
UPDATE mysql.ttl_purge_ctrl SET value = (@now_min + 60) % 1440 WHERE ctrl_id = 3;
#
# Phase 3: wrap-around window (start > end) not covering now => idle
#
SET @now_min = HOUR(UTC_TIME()) * 60 + MINUTE(UTC_TIME());
UPDATE mysql.ttl_purge_ctrl SET value = (@now_min + 60) % 1440 WHERE ctrl_id = 2;
UPDATE mysql.ttl_purge_ctrl SET value = (@now_min + 1380) % 1440 WHERE ctrl_id = 3;
