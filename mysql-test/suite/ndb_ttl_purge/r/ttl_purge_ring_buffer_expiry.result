INSERT INTO ttl_rbx.rb_dt6 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(6), INTERVAL 10 SECOND), 'dt6_early');
INSERT INTO ttl_rbx.rb_dt6 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(6), INTERVAL 1 HOUR), 'dt6_live');
INSERT INTO ttl_rbx.rb_dt6 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(6), INTERVAL 30 SECOND), 'dt6_late');
SELECT ring_idx, data FROM ttl_rbx.rb_ts3 ORDER BY ring_idx;
ring_idx	data
1	ts3_early
2	ts3_live
3	ts3_late
SELECT ring_idx, data FROM ttl_rbx.rb_dt6 ORDER BY ring_idx;
ring_idx	data
1	dt6_early
2	dt6_live
3	dt6_late
