SET time_zone = '+00:00';
SET time_zone = '+00:00';
CREATE DATABASE ttl_rbx;
CREATE TABLE ttl_rbx.rb_c1 (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ttl_col DATETIME,
data VARCHAR(100),
PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rbx.rb_c1 (ttl_col);
CREATE TABLE ttl_rbx.rb_c2 LIKE ttl_rbx.rb_c1;
CREATE TABLE ttl_rbx.rb_c3 LIKE ttl_rbx.rb_c1;
#
# Cases 1-3, seed: crossing rows (expire 15 s after the INSERT) and live rows
#
INSERT INTO ttl_rbx.rb_c1 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c1_cross');
INSERT INTO ttl_rbx.rb_c1 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'c1_live');
INSERT INTO ttl_rbx.rb_c2 (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c2_cross_1');
INSERT INTO ttl_rbx.rb_c2 (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c2_cross_2');
INSERT INTO ttl_rbx.rb_c2 (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c2_cross_3');
INSERT INTO ttl_rbx.rb_c3 (client_id, ttl_col, data) VALUES (3, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c3_locked');
INSERT INTO ttl_rbx.rb_c3 (client_id, ttl_col, data) VALUES (3, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c3_unlocked');
INSERT INTO ttl_rbx.rb_c3 (client_id, ttl_col, data) VALUES (4, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c4_locked_1');
INSERT INTO ttl_rbx.rb_c3 (client_id, ttl_col, data) VALUES (4, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c4_locked_2');
INSERT INTO ttl_rbx.rb_c3 (client_id, ttl_col, data) VALUES (5, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c5_nolock_1');
INSERT INTO ttl_rbx.rb_c3 (client_id, ttl_col, data) VALUES (5, DATE_ADD(NOW(), INTERVAL 10 SECOND), 'c5_nolock_2');
#
# Case 1, before the expiry: every read path shows the crossing row
#
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c1 ORDER BY client_id, ring_idx;
client_id	ring_idx	data
1	1	c1_cross
1	2	c1_live
SELECT ring_idx, data FROM ttl_rbx.rb_c1 WHERE client_id = 1 ORDER BY ring_idx;
ring_idx	data
1	c1_cross
2	c1_live
SELECT ring_idx, data FROM ttl_rbx.rb_c1 WHERE client_id = 1 AND ring_idx = 1;
ring_idx	data
1	c1_cross
SELECT ring_idx, data FROM ttl_rbx.rb_c1 FORCE INDEX (ttl_index) WHERE ttl_col >= '2000-01-01' ORDER BY ttl_col;
ring_idx	data
1	c1_cross
2	c1_live
SELECT COUNT(*) FROM ttl_rbx.rb_c1;
COUNT(*)
2
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c1 ORDER BY client_id, ring_idx;
client_id	ring_idx	data
1	1	c1_cross
1	2	c1_live
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbx.rb_c1 WHERE ring_idx = 0;
client_id	HEX(ring_meta)
1	0100000003000000020000000000000002000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
#
# Case 2, before the expiry: a transaction overwrites slot 1 (a live crossing row)
#
SET time_zone = '+00:00';
BEGIN;
INSERT INTO ttl_rbx.rb_c2 (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'c2_new_1');
SELECT ring_idx, data FROM ttl_rbx.rb_c2 WHERE client_id = 2 ORDER BY ring_idx;
ring_idx	data
1	c2_new_1
2	c2_cross_2
3	c2_cross_3
#
# Case 3, before the expiry: a transaction locks prefix 3 slot 1 and all of prefix 4
#
SET time_zone = '+00:00';
BEGIN;
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c3 WHERE client_id = 3 AND ring_idx = 1 FOR UPDATE;
client_id	ring_idx	data
3	1	c3_locked
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c3 WHERE client_id = 4 ORDER BY ring_idx FOR UPDATE;
client_id	ring_idx	data
4	1	c4_locked_1
4	2	c4_locked_2
#
# Wait until the crossing rows have expired (committed reads)
#
#
# Case 1, after the expiry: every read path hides the row, the meta row and the physical row are unchanged
#
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c1 ORDER BY client_id, ring_idx;
client_id	ring_idx	data
1	2	c1_live
SELECT ring_idx, data FROM ttl_rbx.rb_c1 WHERE client_id = 1 ORDER BY ring_idx;
ring_idx	data
2	c1_live
SELECT ring_idx, data FROM ttl_rbx.rb_c1 WHERE client_id = 1 AND ring_idx = 1;
ring_idx	data
SELECT ring_idx, data FROM ttl_rbx.rb_c1 FORCE INDEX (ttl_index) WHERE ttl_col >= '2000-01-01' ORDER BY ttl_col;
ring_idx	data
2	c1_live
SELECT COUNT(*) FROM ttl_rbx.rb_c1;
COUNT(*)
1
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c1 ORDER BY client_id, ring_idx;
client_id	ring_idx	data
1	2	c1_live
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbx.rb_c1 WHERE ring_idx = 0;
client_id	HEX(ring_meta)
1	0100000003000000020000000000000002000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
include/assert.inc [rb_c1: 3 physical rows after the expiry (meta + expired + live)]
INSERT INTO ttl_rbx.rb_c1 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'c1_next');
SELECT ring_idx, data FROM ttl_rbx.rb_c1 WHERE client_id = 1 ORDER BY ring_idx;
ring_idx	data
2	c1_live
3	c1_next
INSERT INTO ttl_rbx.rb_c1 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'c1_wrap');
SELECT ring_idx, data FROM ttl_rbx.rb_c1 WHERE client_id = 1 ORDER BY ring_idx;
ring_idx	data
1	c1_wrap
2	c1_live
3	c1_next
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbx.rb_c1 WHERE ring_idx = 0;
client_id	HEX(ring_meta)
1	0100000002000000030000000000000004000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
include/assert.inc [rb_c1: 4 physical rows after the wrap (meta + 3 slots)]
#
# Case 2, after the expiry: the same transaction overwrites slot 2, which expired meanwhile
#
INSERT INTO ttl_rbx.rb_c2 (client_id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'c2_new_2');
SELECT ring_idx, data FROM ttl_rbx.rb_c2 WHERE client_id = 2 ORDER BY ring_idx;
ring_idx	data
1	c2_new_1
2	c2_new_2
COMMIT;
SELECT ring_idx, data FROM ttl_rbx.rb_c2 WHERE client_id = 2 ORDER BY ring_idx;
ring_idx	data
1	c2_new_1
2	c2_new_2
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbx.rb_c2 WHERE ring_idx = 0;
client_id	HEX(ring_meta)
2	0100000003000000030000000000000005000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
include/assert.inc [rb_c2: 4 physical rows (meta + 2 new rows + expired slot 3)]
#
# Case 3, after the expiry: the transaction still sees, updates and deletes the rows it locked
#
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c3 WHERE client_id = 3 ORDER BY ring_idx;
client_id	ring_idx	data
3	1	c3_locked
affected rows: 1
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c3 WHERE client_id = 4 ORDER BY ring_idx;
client_id	ring_idx	data
4	1	c4_locked_1
4	2	c4_locked_2
affected rows: 2
UPDATE ttl_rbx.rb_c3 SET data = CONCAT(data, '_upd') WHERE client_id = 3;
affected rows: 1
info: Rows matched: 1  Changed: 1  Warnings: 0
UPDATE ttl_rbx.rb_c3 SET ttl_col = DATE_ADD(NOW(), INTERVAL 1 HOUR) WHERE client_id = 3 AND ring_idx = 1;
affected rows: 1
info: Rows matched: 1  Changed: 1  Warnings: 0
DELETE FROM ttl_rbx.rb_c3 WHERE client_id = 4;
affected rows: 3
COMMIT;
DELETE FROM ttl_rbx.rb_c3 WHERE client_id = 5;
affected rows: 1
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c3 ORDER BY client_id, ring_idx;
client_id	ring_idx	data
3	1	c3_locked_upd
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbx.rb_c3 WHERE ring_idx = 0 ORDER BY client_id;
client_id	HEX(ring_meta)
3	0100000003000000020000000000000002000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
include/assert.inc [rb_c3: 5 physical rows (prefix 3 meta + 2 rows, prefix 5 two expired leftovers)]
INSERT INTO ttl_rbx.rb_c3 (client_id, ttl_col, data) VALUES (4, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'c4_again');
INSERT INTO ttl_rbx.rb_c3 (client_id, ttl_col, data) VALUES (5, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'c5_again');
SELECT client_id, ring_idx, data FROM ttl_rbx.rb_c3 ORDER BY client_id, ring_idx;
client_id	ring_idx	data
3	1	c3_locked_upd
4	1	c4_again
5	1	c5_again
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbx.rb_c3 WHERE ring_idx = 0 ORDER BY client_id;
client_id	HEX(ring_meta)
3	0100000003000000020000000000000002000000000000000000000000000000
4	0100000002000000010000000000000001000000000000000000000000000000
5	0100000002000000010000000000000001000000000000000000000000000000
SET ndb_ring_buffer_show_meta = OFF;
include/assert.inc [rb_c3: 8 physical rows (3 meta, 3 live, prefix 3 slot 2 and prefix 5 slot 2 expired)]
DROP TABLE ttl_rbx.rb_c1;
DROP TABLE ttl_rbx.rb_c2;
DROP TABLE ttl_rbx.rb_c3;
#
# Case 4: the purge and ring writers reach just-expired slots at the same time
#
CREATE TABLE ttl_rbx.rb_c4 (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ttl_col DATETIME,
data VARCHAR(100),
PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=3@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rbx.rb_c4 (ttl_col);
CREATE PROCEDURE ttl_rbx.ins_all(IN cross_row INT, IN tag VARCHAR(20))
BEGIN
DECLARE p INT DEFAULT 1;
WHILE p <= 20 DO
IF cross_row = 1 THEN
INSERT INTO ttl_rbx.rb_c4 (client_id, ttl_col, data)
VALUES (p, DATE_ADD(NOW(), INTERVAL 10 SECOND), CONCAT(tag, '_', p));
ELSE
INSERT INTO ttl_rbx.rb_c4 (client_id, ttl_col, data)
VALUES (p, DATE_ADD(NOW(), INTERVAL 1 HOUR), CONCAT(tag, '_', p));
END IF;
SET p = p + 1;
END WHILE;
END|
CALL ttl_rbx.ins_all(1, 'cross_a');
CALL ttl_rbx.ins_all(1, 'cross_b');
CALL ttl_rbx.ins_all(1, 'cross_c');
SELECT COUNT(*) AS visible FROM ttl_rbx.rb_c4;
visible
60
CALL ttl_rbx.ins_all(0, 'r1');
CALL ttl_rbx.ins_all(0, 'r2');
include/assert.inc [rb_c4: 60 physical rows once the purge has settled (20 meta + 40 live)]
SELECT COUNT(*) AS visible FROM ttl_rbx.rb_c4;
visible
40
SELECT ring_idx, LEFT(data, 2) AS round, COUNT(*) AS prefixes FROM ttl_rbx.rb_c4
GROUP BY ring_idx, round ORDER BY ring_idx;
ring_idx	round	prefixes
1	r1	20
2	r2	20
SET ndb_ring_buffer_show_meta = ON;
SELECT HEX(ring_meta) AS meta, COUNT(*) AS prefixes FROM ttl_rbx.rb_c4 WHERE ring_idx = 0
GROUP BY meta ORDER BY meta;
meta	prefixes
0100000003000000030000000000000005000000000000000000000000000000	20
SET ndb_ring_buffer_show_meta = OFF;
DROP PROCEDURE ttl_rbx.ins_all;
DROP TABLE ttl_rbx.rb_c4;
#
# Case 5: TIMESTAMP(3) and DATETIME(6) rows cross the boundary; the SQL layer and the purge agree
#
CREATE TABLE ttl_rbx.rb_ts3 (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ttl_col TIMESTAMP(3) NULL,
data VARCHAR(100),
PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rbx.rb_ts3 (ttl_col);
CREATE TABLE ttl_rbx.rb_dt6 (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
ttl_col DATETIME(6),
data VARCHAR(100),
PRIMARY KEY (client_id, ring_idx)
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col,MAX_ROWS_PER_PK=4@ring_idx@ring_meta";
CREATE INDEX ttl_index ON ttl_rbx.rb_dt6 (ttl_col);
INSERT INTO ttl_rbx.rb_ts3 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(3), INTERVAL 10 SECOND), 'ts3_early');
INSERT INTO ttl_rbx.rb_ts3 (client_id, ttl_col, data) VALUES (1, DATE_ADD(NOW(3), INTERVAL 1 HOUR), 'ts3_live');
