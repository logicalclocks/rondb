ring_idx	data
2	ts3_live
3	ts3_late
SELECT ring_idx, data FROM ttl_rbx.rb_ts3 FORCE INDEX (ttl_index) WHERE ttl_col >= '2000-01-01' ORDER BY ttl_col;
ring_idx	data
3	ts3_late
2	ts3_live
SELECT ring_idx, data FROM ttl_rbx.rb_dt6 ORDER BY ring_idx;
ring_idx	data
2	dt6_live
3	dt6_late
SELECT ring_idx, data FROM ttl_rbx.rb_dt6 FORCE INDEX (ttl_index) WHERE ttl_col >= '2000-01-01' ORDER BY ttl_col;
ring_idx	data
3	dt6_late
2	dt6_live
include/assert.inc [rb_ts3: 3 physical rows after the first purge (meta + live + late)]
include/assert.inc [rb_dt6: 3 physical rows after the first purge (meta + live + late)]
SELECT ring_idx, data FROM ttl_rbx.rb_ts3 ORDER BY ring_idx;
ring_idx	data
2	ts3_live
3	ts3_late
SELECT ring_idx, data FROM ttl_rbx.rb_dt6 ORDER BY ring_idx;
ring_idx	data
2	dt6_live
3	dt6_late
include/assert.inc [rb_ts3: 2 physical rows after the second purge (meta + live)]
include/assert.inc [rb_dt6: 2 physical rows after the second purge (meta + live)]
SELECT ring_idx, data FROM ttl_rbx.rb_ts3 ORDER BY ring_idx;
ring_idx	data
2	ts3_live
SELECT ring_idx, data FROM ttl_rbx.rb_dt6 ORDER BY ring_idx;
ring_idx	data
2	dt6_live
SET ndb_ring_buffer_show_meta = ON;
SELECT client_id, HEX(ring_meta) FROM ttl_rbx.rb_ts3 WHERE ring_idx = 0;
client_id	HEX(ring_meta)
