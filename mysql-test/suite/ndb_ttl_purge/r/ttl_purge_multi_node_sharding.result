INSERT INTO ttl_ms.t1 (id, ttl_col, data) VALUES (600, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_600');
#
# Both nodes participated and together purged all 600 rows
#
Both purge nodes purged rows and all 600 rows are purged
#
# Per-node window: the out-of-window node ages out and ownership
# redistributes to the in-window node
#
INSERT INTO ttl_ms.t1 (id, ttl_col, data) WITH RECURSIVE seq (n) AS (SELECT 5000 UNION ALL SELECT n + 1 FROM seq WHERE n < 5199) SELECT n, DATE_SUB(NOW(), INTERVAL 5 MINUTE), CONCAT('expired_', n) FROM seq;
Node 1 purged the whole batch alone; node 2 purged none
#
# Cleanup
#
DROP TABLE mysql.ttl_purge_nodes;
DROP DATABASE ttl_ms;
