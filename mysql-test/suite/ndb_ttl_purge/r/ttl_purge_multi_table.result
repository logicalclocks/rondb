#
# Test: test_different_ttl_durations
# 3 tables (TTL=5, 30, 3600); only short and medium purged
#
CREATE DATABASE IF NOT EXISTS ttl_mt_1;
DROP TABLE IF EXISTS ttl_mt_1.short_ttl;
CREATE TABLE ttl_mt_1.short_ttl (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_mt_1.short_ttl(ttl_col);
ALTER TABLE ttl_mt_1.short_ttl COMMENT="NDB_TABLE=TTL=5@ttl_col";
CREATE DATABASE IF NOT EXISTS ttl_mt_2;
DROP TABLE IF EXISTS ttl_mt_2.medium_ttl;
CREATE TABLE ttl_mt_2.medium_ttl (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_mt_2.medium_ttl(ttl_col);
ALTER TABLE ttl_mt_2.medium_ttl COMMENT="NDB_TABLE=TTL=30@ttl_col";
CREATE DATABASE IF NOT EXISTS ttl_mt_3;
DROP TABLE IF EXISTS ttl_mt_3.long_ttl;
CREATE TABLE ttl_mt_3.long_ttl (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_mt_3.long_ttl(ttl_col);
ALTER TABLE ttl_mt_3.long_ttl COMMENT="NDB_TABLE=TTL=3600@ttl_col";
