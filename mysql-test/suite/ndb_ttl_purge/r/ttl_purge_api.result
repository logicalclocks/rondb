DROP TABLE IF EXISTS ttl_api.page_4;
CREATE TABLE ttl_api.page_4 (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_api.page_4(ttl_col);
