#
# Test: test_pagination
# Create 5 tables, test GET /tables with offset/limit
#
CREATE DATABASE IF NOT EXISTS ttl_api;
DROP TABLE IF EXISTS ttl_api.page_0;
CREATE TABLE ttl_api.page_0 (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_api.page_0(ttl_col);
ALTER TABLE ttl_api.page_0 COMMENT="NDB_TABLE=TTL=60@ttl_col";
CREATE DATABASE IF NOT EXISTS ttl_api;
Warnings:
Note	1007	Can't create database 'ttl_api'; database exists
DROP TABLE IF EXISTS ttl_api.page_1;
CREATE TABLE ttl_api.page_1 (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_api.page_1(ttl_col);
ALTER TABLE ttl_api.page_1 COMMENT="NDB_TABLE=TTL=60@ttl_col";
CREATE DATABASE IF NOT EXISTS ttl_api;
Warnings:
Note	1007	Can't create database 'ttl_api'; database exists
