#
# Test: test_blob_purge_with_index
# TEXT column + ttl_index, verify rows and blob parts cleaned
#
CREATE DATABASE IF NOT EXISTS ttl_blob;
DROP TABLE IF EXISTS ttl_blob.blob_idx;
CREATE TABLE ttl_blob.blob_idx (
id INT PRIMARY KEY,
ttl_col DATETIME,
data TEXT
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_blob.blob_idx(ttl_col);
ALTER TABLE ttl_blob.blob_idx COMMENT="NDB_TABLE=TTL=5@ttl_col";
INSERT INTO ttl_blob.blob_idx (id, ttl_col, data) VALUES (0, NOW(), '');
INSERT INTO ttl_blob.blob_idx (id, ttl_col, data) VALUES (1, NOW(), '');
INSERT INTO ttl_blob.blob_idx (id, ttl_col, data) VALUES (2, NOW(), '');
INSERT INTO ttl_blob.blob_idx (id, ttl_col, data) VALUES (3, NOW(), '');
INSERT INTO ttl_blob.blob_idx (id, ttl_col, data) VALUES (4, NOW(), '');
include/assert.inc [5 blob rows should be inserted]
SELECT IFNULL(SUM(frag.rows), 0) INTO @blob_parts_before
FROM ndbinfo.ndb$frag_mem_use AS frag
JOIN ndbinfo.ndb$dict_obj_info AS obj ON obj.id = frag.table_id AND obj.type <= 6
LEFT JOIN ndbinfo.ndb$dict_obj_info AS parent
ON obj.parent_obj_id = parent.id AND obj.parent_obj_type = parent.type
WHERE obj.fq_name LIKE '%NDB$BLOB%' AND parent.fq_name LIKE '%ttl_blob/def/blob_idx%';
include/assert.inc [Blob parts should exist before purge]
Blob parts after purge: 0
DROP TABLE ttl_blob.blob_idx;
#
# Test: test_blob_purge_table_scan
# TEXT column, NO index, verify blob parts cleaned via table scan
#
DROP TABLE IF EXISTS ttl_blob.blob_noscan;
CREATE TABLE ttl_blob.blob_noscan (
id INT PRIMARY KEY,
ttl_col DATETIME,
data TEXT
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
ALTER TABLE ttl_blob.blob_noscan COMMENT="NDB_TABLE=TTL=5@ttl_col";
INSERT INTO ttl_blob.blob_noscan (id, ttl_col, data) VALUES (0, NOW(), '');
INSERT INTO ttl_blob.blob_noscan (id, ttl_col, data) VALUES (1, NOW(), '');
INSERT INTO ttl_blob.blob_noscan (id, ttl_col, data) VALUES (2, NOW(), '');
INSERT INTO ttl_blob.blob_noscan (id, ttl_col, data) VALUES (3, NOW(), '');
INSERT INTO ttl_blob.blob_noscan (id, ttl_col, data) VALUES (4, NOW(), '');
include/assert.inc [5 blob rows should be inserted (no index)]
SELECT IFNULL(SUM(frag.rows), 0) INTO @blob_parts_noscan
FROM ndbinfo.ndb$frag_mem_use AS frag
JOIN ndbinfo.ndb$dict_obj_info AS obj ON obj.id = frag.table_id AND obj.type <= 6
LEFT JOIN ndbinfo.ndb$dict_obj_info AS parent
ON obj.parent_obj_id = parent.id AND obj.parent_obj_type = parent.type
WHERE obj.fq_name LIKE '%NDB$BLOB%' AND parent.fq_name LIKE '%ttl_blob/def/blob_noscan%';
include/assert.inc [Blob parts should exist before purge (table scan)]
Blob parts after table scan purge: 0
DROP TABLE ttl_blob.blob_noscan;
#
# Test: test_blob_purge_multiple_blob_columns
# TEXT + BLOB columns, verify all blob parts cleaned
#
DROP TABLE IF EXISTS ttl_blob.multi_blob;
CREATE TABLE ttl_blob.multi_blob (
id INT PRIMARY KEY,
ttl_col DATETIME,
text_data TEXT,
blob_data BLOB
) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_blob.multi_blob(ttl_col);
ALTER TABLE ttl_blob.multi_blob COMMENT="NDB_TABLE=TTL=5@ttl_col";
INSERT INTO ttl_blob.multi_blob (id, ttl_col, text_data, blob_data) VALUES (0, NOW(), '', '');
INSERT INTO ttl_blob.multi_blob (id, ttl_col, text_data, blob_data) VALUES (1, NOW(), '', '');
INSERT INTO ttl_blob.multi_blob (id, ttl_col, text_data, blob_data) VALUES (2, NOW(), '', '');
INSERT INTO ttl_blob.multi_blob (id, ttl_col, text_data, blob_data) VALUES (3, NOW(), '', '');
INSERT INTO ttl_blob.multi_blob (id, ttl_col, text_data, blob_data) VALUES (4, NOW(), '', '');
include/assert.inc [5 multi-blob rows should be inserted]
SELECT IFNULL(SUM(frag.rows), 0) INTO @blob_parts_multi
FROM ndbinfo.ndb$frag_mem_use AS frag
JOIN ndbinfo.ndb$dict_obj_info AS obj ON obj.id = frag.table_id AND obj.type <= 6
LEFT JOIN ndbinfo.ndb$dict_obj_info AS parent
ON obj.parent_obj_id = parent.id AND obj.parent_obj_type = parent.type
WHERE obj.fq_name LIKE '%NDB$BLOB%' AND parent.fq_name LIKE '%ttl_blob/def/multi_blob%';
include/assert.inc [Blob parts should exist before purge (multi-blob)]
Multi-blob parts after purge: 0
DROP DATABASE ttl_blob;
# All blob purge tests passed
