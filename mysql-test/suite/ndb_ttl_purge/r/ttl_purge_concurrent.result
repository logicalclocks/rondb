DROP DATABASE ttl_concurrent;
#
# Test: test_update_expired_row
# UPDATE an expired row should affect 0 rows
#
CREATE DATABASE IF NOT EXISTS ttl_concurrent;
DROP TABLE IF EXISTS ttl_concurrent.update_test;
CREATE TABLE ttl_concurrent.update_test (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_concurrent.update_test(ttl_col);
ALTER TABLE ttl_concurrent.update_test COMMENT="NDB_TABLE=TTL=5@ttl_col";
INSERT INTO ttl_concurrent.update_test (id, ttl_col, data)
VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired');
UPDATE ttl_concurrent.update_test SET data = 'updated' WHERE id = 1;
SELECT ROW_COUNT() INTO @update_rc;
include/assert.inc [UPDATE on expired row should affect 0 rows]
include/assert.inc [Table should appear empty after expired insert]
DROP DATABASE ttl_concurrent;
#
# Test: test_delete_expired_row
# DELETE an expired row should affect 0 rows
#
CREATE DATABASE IF NOT EXISTS ttl_concurrent;
DROP TABLE IF EXISTS ttl_concurrent.delete_test;
CREATE TABLE ttl_concurrent.delete_test (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_concurrent.delete_test(ttl_col);
ALTER TABLE ttl_concurrent.delete_test COMMENT="NDB_TABLE=TTL=5@ttl_col";
INSERT INTO ttl_concurrent.delete_test (id, ttl_col, data)
VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired');
DELETE FROM ttl_concurrent.delete_test WHERE id = 1;
SELECT ROW_COUNT() INTO @delete_rc;
include/assert.inc [DELETE on expired row should affect 0 rows]
include/assert.inc [Table should appear empty]
DROP DATABASE ttl_concurrent;
