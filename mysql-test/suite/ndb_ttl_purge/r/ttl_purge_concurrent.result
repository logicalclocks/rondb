#
# Test: test_read_expired_rows
# Insert already-expired rows, SELECT should return 0
#
CREATE DATABASE IF NOT EXISTS ttl_concurrent;
DROP TABLE IF EXISTS ttl_concurrent.read_expired;
CREATE TABLE ttl_concurrent.read_expired (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_concurrent.read_expired(ttl_col);
ALTER TABLE ttl_concurrent.read_expired COMMENT="NDB_TABLE=TTL=5@ttl_col";
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_1');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (2, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_2');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (3, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_3');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (4, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_4');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (5, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_5');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (6, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_6');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (7, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_7');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (8, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_8');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (9, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_9');
INSERT INTO ttl_concurrent.read_expired (id, ttl_col, data) VALUES (10, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_10');
include/assert.inc [Expired rows should not be visible via SELECT]
DROP DATABASE ttl_concurrent;
