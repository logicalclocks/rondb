SET time_zone = '+00:00';
#
# Phase 1: sharded mode, one active node owns all partitions
#
CREATE TABLE mysql.ttl_purge_nodes (node_id INT PRIMARY KEY, last_active DATETIME) ENGINE=NDB;
INSERT INTO mysql.ttl_purge_nodes WITH RECURSIVE seq (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 255) SELECT n, NULL FROM seq;
CREATE DATABASE IF NOT EXISTS ttl_shard;
DROP TABLE IF EXISTS ttl_shard.t1;
CREATE TABLE ttl_shard.t1 (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col" PARTITION BY KEY(id) PARTITIONS 8;
CREATE INDEX ttl_index ON ttl_shard.t1(ttl_col);
INSERT INTO ttl_shard.t1 (id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_1');
