DROP DATABASE ttl_config;
#
# Test: test_disable_during_active_purge
# Insert 200 expired, disable purge, check disabled, re-enable, wait
#
CREATE DATABASE IF NOT EXISTS ttl_config;
DROP TABLE IF EXISTS ttl_config.disable_test;
CREATE TABLE ttl_config.disable_test (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_config.disable_test(ttl_col);
ALTER TABLE ttl_config.disable_test COMMENT="NDB_TABLE=TTL=5@ttl_col";
