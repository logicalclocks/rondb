#
# Test: test_change_batch_size_during_purge
# Insert 100 expired, change max_batch=100, wait, all purged
#
CREATE DATABASE IF NOT EXISTS ttl_config;
DROP TABLE IF EXISTS ttl_config.batch_size;
CREATE TABLE ttl_config.batch_size (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_config.batch_size(ttl_col);
ALTER TABLE ttl_config.batch_size COMMENT="NDB_TABLE=TTL=5@ttl_col";
