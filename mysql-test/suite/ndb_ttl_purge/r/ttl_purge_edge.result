#
# Test: test_empty_table
# Create empty TTL table, verify detected by API, no error state
#
CREATE DATABASE IF NOT EXISTS ttl_edge;
DROP TABLE IF EXISTS ttl_edge.empty_tbl;
CREATE TABLE ttl_edge.empty_tbl (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_edge.empty_tbl(ttl_col);
ALTER TABLE ttl_edge.empty_tbl COMMENT="NDB_TABLE=TTL=10@ttl_col";
include/assert.inc [Purge state should not be error]
Purge state after empty table: OK
DROP DATABASE ttl_edge;
#
# Test: test_boundary_time
# Insert row with NOW(), wait for TTL expiry + purge
#
CREATE DATABASE IF NOT EXISTS ttl_edge;
DROP TABLE IF EXISTS ttl_edge.boundary;
CREATE TABLE ttl_edge.boundary (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_edge.boundary(ttl_col);
ALTER TABLE ttl_edge.boundary COMMENT="NDB_TABLE=TTL=10@ttl_col";
INSERT INTO ttl_edge.boundary (id, ttl_col, data) VALUES (1, NOW(), 'boundary_row');
include/assert.inc [Row should be visible immediately after insert]
include/assert.inc [Row should be purged after TTL expiry]
DROP DATABASE ttl_edge;
#
# Test: test_multi_partition
# PARTITION BY KEY(id) PARTITIONS 4, 40 expired rows, all purged
#
CREATE DATABASE IF NOT EXISTS ttl_edge;
DROP TABLE IF EXISTS ttl_edge.multi_part;
CREATE TABLE ttl_edge.multi_part (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=5@ttl_col" PARTITION BY KEY(id) PARTITIONS 4;
CREATE INDEX ttl_index ON ttl_edge.multi_part(ttl_col);
INSERT INTO ttl_edge.multi_part (id, ttl_col, data) VALUES (1, DATE_SUB(NOW(), INTERVAL 5 MINUTE), 'expired_row_1');
