#
# Test: test_very_short_ttl
# TTL=1s, insert with NOW(), wait for purge
#
CREATE DATABASE IF NOT EXISTS ttl_edge;
DROP TABLE IF EXISTS ttl_edge.short_ttl;
CREATE TABLE ttl_edge.short_ttl (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_edge.short_ttl(ttl_col);
ALTER TABLE ttl_edge.short_ttl COMMENT="NDB_TABLE=TTL=1@ttl_col";
INSERT INTO ttl_edge.short_ttl (id, ttl_col, data) VALUES (1, NOW(), 'short_lived');
include/assert.inc [Very short TTL row should be purged]
DROP DATABASE ttl_edge;
# All edge case tests passed
