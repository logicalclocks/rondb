#
# Test: test_no_expired_rows
# TTL=3600s, insert valid rows, verify none purged
#
CREATE DATABASE IF NOT EXISTS ttl_edge;
DROP TABLE IF EXISTS ttl_edge.no_expired;
CREATE TABLE ttl_edge.no_expired (id INT PRIMARY KEY, ttl_col DATETIME, data VARCHAR(100)) ENGINE=NDB COMMENT="NDB_TABLE=TTL=3600@ttl_col";
CREATE INDEX ttl_index ON ttl_edge.no_expired(ttl_col);
ALTER TABLE ttl_edge.no_expired COMMENT="NDB_TABLE=TTL=3600@ttl_col";
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (1, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_1');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (2, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_2');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (3, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_3');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (4, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_4');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (5, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_5');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (6, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_6');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (7, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_7');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (8, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_8');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (9, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_9');
INSERT INTO ttl_edge.no_expired (id, ttl_col, data) VALUES (10, DATE_ADD(NOW(), INTERVAL 1 HOUR), 'valid_row_10');
SELECT COUNT(*) FROM ttl_edge.no_expired;
COUNT(*)
10
include/assert.inc [No rows should be purged with TTL=3600]
DROP DATABASE ttl_edge;
