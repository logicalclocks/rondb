--source include/have_ndb.inc

# P-48 (see test_spj_malformed_p48) with the JIT on
# (CompiledInterpreter=ON, test_spj_malformed_p48_jit.cnf). The leaf
# program of its compare compiles, so the rows that are found run on
# the JIT: READ_LINKED_COLUMN_TO_REG is ndb_jit_h_load_linked_col, which
# decoded 8 bytes from the 4-byte entry, 4 of them from past the linked
# buffer, and the row was counted (SCAN_TABCONF). It now takes the
# per-row fallback, where the interpreter reads NULL and fails the row
# (SCAN_TABREF), as for a NULL entry, while the rows of an 8-byte entry
# are counted on the JIT. The outer join's NULL-extended rows never run
# on the JIT.
# A per-row fallback does not show in ndbinfo.jit, so the counters show
# that no program fell back to the interpreter, that the programs were
# compiled (or reused), and that rows ran on the JIT.

SET @jit_f0 = (SELECT SUM(programs_fallback) FROM ndbinfo.jit);
SET @jit_c0 = (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit);
SET @jit_r0 = (SELECT SUM(rows_executed) FROM ndbinfo.jit);
--let $spj_case = P48
--let $spj_case_title = P-48: join aggregation linked attribute entry shorter than its type, JIT on
--source suite/ndb_spj/include/spj_malformed_case.inc
SELECT (SELECT SUM(programs_fallback) FROM ndbinfo.jit) = @jit_f0
       AS p48_not_refused_by_jit;
SELECT (SELECT SUM(programs_compiled + programs_reused) FROM ndbinfo.jit) >
       @jit_c0 AS p48_compiled_by_jit;
SELECT (SELECT SUM(rows_executed) FROM ndbinfo.jit) > @jit_r0
       AS p48_rows_on_jit;
