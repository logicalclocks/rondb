--source include/have_ndb.inc
# The block unit tests send JOIN_AGG_FINAL_REP from an API node, so a
# debug data node still takes it (NDB_SCOPE_REMOTE_EXCEPT_DEBUG in
# SignalScopes.hpp) and this one stops it. Only a release data node drops
# it and disconnects the API node before DBLQH sees it.
--source include/check_ndb_debug.inc
if ($have_ndb_debug)
{
  --skip Test requires release compiled NDB
}

