#
# DBSPJ robustness R-4b: more child fragments started after the request
# was aborted in the first batch of a child scan.
#
# As in ndb_spj_robust_first_batch_abort, error insert 17535 makes the
# first batch of a child scan fail (OutOfSectionMemory) after one
# SCAN_FRAGREQ was sent, while the tree node is still TN_INACTIVE, so
# scanFrag_abort() does not close it. Here every child fragment holds only
# two matching rows, so the started fragment completes at once:
#
#  - scanFrag_execSCAN_FRAGCONF() sees RS_ABORTING and
#    m_fragCount == m_frags_complete + m_frags_not_started, decrements
#    m_cnt_active and sets the node TN_INACTIVE;
#  - the same call then finds all started fragments completed with
#    fragments not started, and, as nothing checks RS_ABORTING there,
#    calls scanFrag_send() for the remaining fragments of the aborted
#    request;
#  - when the last of them completes, m_frags_complete == m_fragCount and
#    the node is "completed" a second time: ndbrequire(m_cnt_active)
#    stops the data node (or, if fewer fragments were started, they may
#    stay open in DBLQH).
#
# The query must fail with NDB error 20006, no data node may stop, and
# nothing may be left open or registered.
#
--source include/have_ndb.inc
--source suite/ndb/t/have_ndb_error_insert.inc

# The ndb_mgm and ndb_waiter output goes to a file of this test, removed
# at the end. Appending to the shared $NDB_TOOLS_OUTPUT fails MTR's
# check-testcase for the first test that creates it.
--let $spj_mgm_log = $MYSQLTEST_VARDIR/tmp/ndb_spj_robust_first_batch_abort_small_mgm.log

--disable_query_log
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
call mtr.add_suppression("Node failure caused abort of transaction");
call mtr.add_suppression("Got NDB error");
--enable_query_log

CREATE TABLE t1 (a INT NOT NULL PRIMARY KEY, b INT NOT NULL, c INT NOT NULL)
  ENGINE=NDB PARTITION BY KEY(a) PARTITIONS 8;
CREATE TABLE t2 (a INT NOT NULL PRIMARY KEY, b INT NOT NULL, c INT NOT NULL,
                 KEY ib (b))
  ENGINE=NDB PARTITION BY KEY(a) PARTITIONS 8;
INSERT INTO t1 VALUES (1, 1, 1);
INSERT INTO t2 VALUES (1,1,1),(2,1,2),(3,1,3),(4,1,4),(5,1,5),(6,1,6),
                      (7,1,7),(8,1,8),(9,1,9),(10,1,10),(11,1,11),(12,1,12),
                      (13,1,13),(14,1,14),(15,1,15),(16,1,16);

CREATE VIEW spj_robust_dih_scans AS
  SELECT d.node_id, d.table_id,
         d.current_scan_count + d.scan_count_wait AS scans
  FROM ndbinfo.ndb$table_distribution_status_all AS d
  JOIN ndbinfo.dict_obj_info AS o ON o.id = d.table_id AND o.type <= 6
  LEFT JOIN ndbinfo.dict_obj_info AS p
    ON p.id = o.parent_obj_id AND p.type = o.parent_obj_type
  WHERE o.fq_name LIKE 'test/def/%' OR p.fq_name LIKE 'test/def/%';
CREATE VIEW spj_robust_frag_scans AS
  SELECT node_id, block_instance, fq_name, fragment_num, conc_frag_scans
  FROM ndbinfo.operations_per_fragment
  WHERE fq_name LIKE 'test/def/%' OR parent_fq_name LIKE 'test/def/%';

--let $spj_q = SELECT STRAIGHT_JOIN COUNT(*) AS cnt, SUM(t2.c) AS chk FROM t1 JOIN t2 FORCE INDEX (ib) ON t2.b = t1.b

--echo #
--echo # Reference run: the query is pushed
--echo #
--let $spj_pq0 = query_get_value(SHOW GLOBAL STATUS LIKE 'Ndb_pushed_queries_executed', Value, 1)
--source suite/ndb_spj/include/spj_run_query.inc
--let $spj_ref = $spj_res
--let $spj_pq1 = query_get_value(SHOW GLOBAL STATUS LIKE 'Ndb_pushed_queries_executed', Value, 1)
if ($spj_errno)
{
  --echo ERROR $spj_errno: $spj_w
  --die Test setup: the query failed without an error insert
}
if (`SELECT $spj_pq1 <= $spj_pq0`)
{
  --die Test setup: the query was not executed as a pushed join
}
--echo Reference query was pushed
--let $spj_nodes = `SELECT COUNT(*) FROM ndbinfo.nodes WHERE status = 'STARTED'`

--echo #
--echo # 17535 with small child fragments
--echo #
--exec $NDB_MGM -e "all error 17535" >> $spj_mgm_log
--source suite/ndb_spj/include/spj_run_query.inc

# The count is read with SELECT ... INTO, an ndbinfo scan that fails must
# not stop the test (see spj_run_query.inc).
--sleep 2
--disable_query_log
--disable_result_log
--disable_abort_on_error
SET @spj_nodes_after = NULL;
SELECT COUNT(*) INTO @spj_nodes_after FROM ndbinfo.nodes WHERE status = 'STARTED';
--enable_abort_on_error
--enable_result_log
--let $spj_nodes_after = `SELECT IFNULL(@spj_nodes_after, '')`
--enable_query_log
if (`SELECT LENGTH("$spj_nodes_after") = 0 OR "$spj_nodes_after" < $spj_nodes`)
{
  --echo Query result: $spj_res, error $spj_errno, warning: $spj_w
  --die R-4b: a data node stopped: child fragments were started for the aborted request (scanFrag_execSCAN_FRAGCONF does not check RS_ABORTING) and the tree node was completed twice (ndbrequire(m_cnt_active))
}
--exec $NDB_MGM -e "all error 0" >> $spj_mgm_log

if (!$spj_errno)
{
  --die Test setup: error insert 17535 did not fire (first child batch started fewer than 2 fragments), the query succeeded
}
--let $spj_err = `SELECT IF(LOCATE('error ', "$spj_w") > 0, SUBSTRING_INDEX(SUBSTRING("$spj_w", LOCATE('error ', "$spj_w") + 6), ' ', 1), 'none')`
if (`SELECT '$spj_err' <> '20006'`)
{
  --echo Query failed with: $spj_w
  --die 17535: the query did not fail with NDB error 20006 (OutOfSectionMemory)
}
--echo The query failed with NDB error 20006, all data nodes are still started

--let $spj_i = 0
--let $spj_open = `SELECT IFNULL(SUM(conc_frag_scans), 0) FROM spj_robust_frag_scans`
while ($spj_open)
{
  if (`SELECT $spj_i >= 150`)
  {
    SELECT * FROM spj_robust_frag_scans WHERE conc_frag_scans > 0;
    --die R-4b: child fragment scans started for the aborted request are still open 30 s later
  }
  --sleep 0.2
  --inc $spj_i
  --let $spj_open = `SELECT IFNULL(SUM(conc_frag_scans), 0) FROM spj_robust_frag_scans`
}
--echo No fragment scan is left open

--let $spj_i = 0
--let $spj_scans = `SELECT IFNULL(SUM(scans), 0) FROM spj_robust_dih_scans`
while ($spj_scans)
{
  if (`SELECT $spj_i >= 100`)
  {
    SELECT node_id, table_id, scans FROM spj_robust_dih_scans WHERE scans > 0;
    --die R-5: a DIH scan leaked after the aborted first child batch
  }
  --sleep 0.2
  --inc $spj_i
  --let $spj_scans = `SELECT IFNULL(SUM(scans), 0) FROM spj_robust_dih_scans`
}
--echo No DIH scan is left registered

--source suite/ronsql_large/include/mem_leak_dumps.inc

--source suite/ndb_spj/include/spj_run_query.inc
if (`SELECT $spj_errno <> 0 OR "$spj_res" <> "$spj_ref"`)
{
  --echo Got: $spj_res (error $spj_errno: $spj_w), expected: $spj_ref
  --die The query returned a wrong result after the error insert was cleared
}
--echo The query returns the reference result

DROP VIEW spj_robust_dih_scans, spj_robust_frag_scans;
DROP TABLE t1, t2;
--remove_file $spj_mgm_log
