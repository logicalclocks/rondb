#
# DBSPJ robustness S-2: DIH_SCAN_TAB_REF for a child scan.
#
# scanFrag_prepare() starts a DIH scan for each child scan and counts it in
# Request::m_outstanding; the answer comes back as DIH_SCAN_TAB_CONF or
# DIH_SCAN_TAB_REF. execDIH_SCAN_TAB_REF() decrements m_outstanding and
# calls abort(), but neither checkPrepareComplete() nor
# checkBatchComplete(): when this was the last outstanding prepare, the
# aborted request is never completed. It waits until DBTC times out the
# scan fragment (TransactionDeadlockDetectionTimeout) and closes it; the
# API gets DBTC's time-out error 274 instead of the failure of the query.
#
# Error insert 17541 makes DBDIH refuse the DIH scan of the child (as for a
# table that is not active, nothing registered in DBDIH). The query must
# fail promptly, not with a time-out error, and leave nothing behind.
#
--source include/have_ndb.inc
--source suite/ndb/t/have_ndb_error_insert.inc

# The ndb_mgm and ndb_waiter output goes to a file of this test, removed
# at the end. Appending to the shared $NDB_TOOLS_OUTPUT fails MTR's
# check-testcase for the first test that creates it.
--let $spj_mgm_log = $MYSQLTEST_VARDIR/tmp/ndb_spj_robust_dih_scan_ref_mgm.log

--disable_query_log
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_query_log

CREATE TABLE t1 (a INT NOT NULL PRIMARY KEY, b INT NOT NULL, c INT NOT NULL)
  ENGINE=NDB PARTITION BY KEY(a) PARTITIONS 8;
CREATE TABLE t2 (a INT NOT NULL PRIMARY KEY, b INT NOT NULL, c INT NOT NULL,
                 KEY ib (b))
  ENGINE=NDB PARTITION BY KEY(a) PARTITIONS 8;
INSERT INTO t1 VALUES (1,1,10),(2,2,20),(3,3,30),(4,4,40),
                      (5,5,50),(6,6,60),(7,7,70),(8,8,80);
INSERT INTO t2 SELECT a, b, c + 1 FROM t1;
INSERT INTO t2 SELECT a + 100, b, c + 2 FROM t1;

CREATE VIEW spj_robust_dih_scans AS
  SELECT d.node_id, d.table_id,
         d.current_scan_count + d.scan_count_wait AS scans
  FROM ndbinfo.ndb$table_distribution_status_all AS d
  JOIN ndbinfo.dict_obj_info AS o ON o.id = d.table_id AND o.type <= 6
  LEFT JOIN ndbinfo.dict_obj_info AS p
    ON p.id = o.parent_obj_id AND p.type = o.parent_obj_type
  WHERE o.fq_name LIKE 'test/def/%' OR p.fq_name LIKE 'test/def/%';

--let $spj_q = SELECT STRAIGHT_JOIN COUNT(*) AS cnt, SUM(t1.c * 1000 + t2.c) AS chk FROM t1 JOIN t2 FORCE INDEX (ib) ON t2.b = t1.a

--let $spj_pq0 = query_get_value(SHOW GLOBAL STATUS LIKE 'Ndb_pushed_queries_executed', Value, 1)
--let $spj_ref = `$spj_q`
--let $spj_pq1 = query_get_value(SHOW GLOBAL STATUS LIKE 'Ndb_pushed_queries_executed', Value, 1)
if (`SELECT $spj_pq1 <= $spj_pq0`)
{
  --die Test setup: the query was not executed as a pushed join
}
--echo Reference query was pushed

connect (con1,localhost,root,,test);
--let $spj_con1_id = `SELECT CONNECTION_ID()`
connection default;

--echo #
--echo # 17541: DBDIH refuses the DIH scan of the child scan
--echo #
--exec $NDB_MGM -e "all error 17541" >> $spj_mgm_log
connection con1;
--send_eval $spj_q
connection default;
--sleep 0.5
--let $spj_i = 0
--let $spj_busy = `SELECT COUNT(*) FROM performance_schema.threads WHERE PROCESSLIST_ID = $spj_con1_id AND PROCESSLIST_COMMAND = 'Query'`
while ($spj_busy)
{
  if (`SELECT $spj_i >= 300`)
  {
    --exec $NDB_MGM -e "all error 0" >> $spj_mgm_log
    --die S-2: the query hung for 30 s after DIH_SCAN_TAB_REF
  }
  --sleep 0.1
  --inc $spj_i
  --let $spj_busy = `SELECT COUNT(*) FROM performance_schema.threads WHERE PROCESSLIST_ID = $spj_con1_id AND PROCESSLIST_COMMAND = 'Query'`
}
--let $spj_polls = $spj_i
--exec $NDB_MGM -e "all error 0" >> $spj_mgm_log
connection con1;
--disable_result_log
--disable_abort_on_error
--reap
--let $spj_errno = $mysql_errno
--let $spj_w = query_get_value(SHOW WARNINGS, Message, 1)
--enable_abort_on_error
--enable_result_log
connection default;
if (!$spj_errno)
{
  --die Test setup: error insert 17541 did not fire, the query succeeded
}
--let $spj_err = `SELECT IF(LOCATE('error ', "$spj_w") > 0, SUBSTRING_INDEX(SUBSTRING("$spj_w", LOCATE('error ', "$spj_w") + 6), ' ', 1), 'none')`
if (`SELECT '$spj_err' IN ('274', '296', '297', '4008', '4012')`)
{
  --echo Query failed with: $spj_w
  --die S-2: the query failed with a time-out error: the aborted request was only completed when DBTC timed out the scan fragment (execDIH_SCAN_TAB_REF does not call checkBatchComplete)
}
# 0.5 s + 20 polls of 0.1 s: well below the 3 s scan fragment time-out
if (`SELECT $spj_polls >= 20`)
{
  --echo Query failed with: $spj_w
  --die S-2: the query took more than 2.5 s to fail after DIH_SCAN_TAB_REF
}
--echo The query failed promptly with an error that is not a time-out

--let $spj_i = 0
--let $spj_scans = `SELECT IFNULL(SUM(scans), 0) FROM spj_robust_dih_scans`
while ($spj_scans)
{
  if (`SELECT $spj_i >= 100`)
  {
    SELECT node_id, table_id, scans FROM spj_robust_dih_scans WHERE scans > 0;
    --die DIH scans are still registered 20 s after the failed query
  }
  --sleep 0.2
  --inc $spj_i
  --let $spj_scans = `SELECT IFNULL(SUM(scans), 0) FROM spj_robust_dih_scans`
}
--echo No DIH scan is registered

--source suite/ronsql_large/include/mem_leak_dumps.inc

--let $spj_res = `$spj_q`
if (`SELECT "$spj_res" <> "$spj_ref"`)
{
  --echo Got: $spj_res, expected: $spj_ref
  --die The query returned a wrong result after the error insert was cleared
}
--echo The query returns the reference result

disconnect con1;
DROP VIEW spj_robust_dih_scans;
DROP TABLE t1, t2;
--remove_file $spj_mgm_log
