--source include/have_ndb.inc

# P-30: join aggregation leaf 0 with a bad magic word in its header (K-1).
# JoinAggInterpreter::Init asserted the header of leaf 0, so a debug
# data node stopped; checkProgram now rejects it at JOIN_AGG_SETUP_REQ.
# The case runs a well-formed join aggregation first, then the malformed
# one, which must get SCAN_TABREF with every data node still started.
# One testSpjMalformed case per MTR test, see
# suite/ndb_spj/include/spj_malformed_case.inc.

--let $spj_case = P30
--let $spj_case_title = P-30: join aggregation leaf 0 with a bad magic word
--source suite/ndb_spj/include/spj_malformed_case.inc
