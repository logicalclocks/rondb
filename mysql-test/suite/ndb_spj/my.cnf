# DBSPJ robustness tests (RONDB-1124): error, abort, node-failure and
# malformed-request paths of pushed joins.  Same cluster as the ndb suite.
!include suite/ndb/my.cnf

[mysqld]
# testSpjMalformed creates the database TEST_DB through the NDB API.
# With lower_case_table_names=2 (macOS) the metadata change monitor stops
# mysqld on a dictionary assertion (MDL_checker::is_read_locked) when it
# finds that database, which failed test_spj_malformed_p24: its dropped
# request waits 10 s for a reply that never comes, long enough for a
# check to run.
ndb_metadata_check = false
