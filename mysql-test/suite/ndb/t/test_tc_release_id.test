--source include/have_ndb.inc

# TCSEIZEREQ and TCRELEASEREQ carry a release id from an API node of
# 26.10.0 or later.  Runs the NDB API test program testTcReleaseId, which
# seizes TC connect records with raw signals on every data node and checks
# that DBTC releases one only with the release id it was seized with:
# another id, or none, is ignored, a release of a record released already
# is refused with TCRELEASEREF, and a record seized without an id is
# released as before.
# The program creates no tables.

let NDBAPITEST_NAME=testTcReleaseId;
let NDBAPITEST_ARGS=--stop-on-error;
--source suite/ndb/include/run_ndbapitest.inc
