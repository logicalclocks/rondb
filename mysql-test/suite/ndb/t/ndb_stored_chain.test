--source include/have_ndb.inc
--disable_query_log

# Read Backup: a committed read uses the replica in the node of the
# transaction coordinator, so the row can be read from each replica below.
CREATE TABLE t1 (a INT PRIMARY KEY, b INT NOT NULL)
  ENGINE=NDB COMMENT="NDB_TABLE=READ_BACKUP=1"
  PARTITION BY KEY(a) PARTITIONS 1;
INSERT INTO t1 VALUES (1, 0);

# Observe the fragment on both possible transaction coordinators.
CREATE VIEW surviving_chains AS
  SELECT * FROM ndbinfo.ndb$table_fragments_all WHERE node_id IN (1, 2);
SELECT id INTO @tab FROM ndbinfo.dict_obj_info WHERE fq_name = 'test/def/t1';

--exec $NDB_MGM -e "3 RESTART -n -i" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --wait-nodes=3 --not-started >> $NDB_TOOLS_OUTPUT
let $wait_condition =
  SELECT COUNT(*) = 2 AND MIN(current_primary) = MAX(current_primary)
  FROM surviving_chains WHERE table_id = @tab AND no_of_replicas = 2;
--source include/wait_condition.inc
if (!$success)
{
  --die The surviving nodes did not agree on the two-replica chain
}
SELECT MIN(current_primary) INTO @p FROM surviving_chains WHERE table_id = @tab;

connect (writer, localhost, root,, test);
BEGIN;
UPDATE t1 SET b = b + 1 WHERE a = 1;

connection default;
--exec $NDB_MGM -e "3 START" >> $NDB_TOOLS_OUTPUT
# STORED has inserted node 3 right after the primary. The copy needs the
# writer's row lock, so COMMIT_STORED cannot run yet.
let $wait_timeout = 240;
let $wait_condition =
  SELECT COUNT(*) = 2 FROM surviving_chains
  WHERE table_id = @tab AND current_primary = @p AND current_first_backup = 3
    AND no_of_replicas = 3 AND num_alive_replicas = 2;
--source include/wait_condition.inc
if (!$success)
{
  --die The surviving nodes did not see node 3 inserted as first backup
}

# The first update went primary -> backup and has completed on both. The
# second one goes primary -> node 3 -> backup: the backup gets a new
# predecessor, which is safe since nothing of the row is in flight.
connection writer;
UPDATE t1 SET b = b + 1 WHERE a = 1;
COMMIT;
disconnect writer;

connection default;
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT
# Every replica has both updates: read the row with each data node as
# transaction coordinator, and check that the scan ran in that node.
let $node = 1;
while ($node <= 3)
{
  eval SET GLOBAL ndb_data_node_neighbour = $node;
  CREATE TEMPORARY TABLE scans_before ENGINE=InnoDB AS
    SELECT node_id, fragment_num, tot_frag_scans
    FROM ndbinfo.operations_per_fragment WHERE fq_name = 'test/def/t1';
  eval SELECT $node AS neighbour, a, b FROM t1;
  SELECT DISTINCT o.node_id AS scanned_in
    FROM ndbinfo.operations_per_fragment o JOIN scans_before s
    ON o.node_id = s.node_id AND o.fragment_num = s.fragment_num
    WHERE o.fq_name = 'test/def/t1' AND o.tot_frag_scans > s.tot_frag_scans;
  DROP TEMPORARY TABLE scans_before;
  inc $node;
}
SET GLOBAL ndb_data_node_neighbour = 0;
DROP VIEW surviving_chains;
DROP TABLE t1;
--remove_file $NDB_TOOLS_OUTPUT
--enable_query_log
