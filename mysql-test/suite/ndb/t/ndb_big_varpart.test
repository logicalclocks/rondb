--source include/have_ndb.inc

CREATE LOGFILE GROUP lg1
ADD UNDOFILE 'undofile.dat'
INITIAL_SIZE 32M
UNDO_BUFFER_SIZE = 16M
ENGINE = NDB;

CREATE TABLESPACE ts1
ADD DATAFILE 'datafile.dat'
USE LOGFILE GROUP lg1
INITIAL_SIZE 32M
ENGINE = NDB;

--echo #
--echo # VARCHAR(32614) is the largest in-memory VARCHAR, its var part is
--echo # MAX_VAR_SIZE_IN_WORDS (8158 words), it fills an empty var page and
--echo # no DBTUP var page free list guarantees that much free space.
--echo # VARCHAR(32610) is the largest on-disk VARCHAR, its disk part is
--echo # MAX_DISK_VAR_SIZE_IN_WORDS (8158 words), it fills an empty disk
--echo # page. Both are in the same table.
--echo #

CREATE TABLE t1 (
  pk INT NOT NULL PRIMARY KEY,
  v VARCHAR(32614) CHARACTER SET latin1 NOT NULL,
  d VARCHAR(32610) CHARACTER SET latin1 NOT NULL STORAGE DISK
) TABLESPACE ts1 ENGINE = NDB;

--echo # Insert full rows
INSERT INTO t1 VALUES (1, REPEAT('a', 32614), REPEAT('A', 32610)),
                      (2, REPEAT('b', 32614), REPEAT('B', 32610)),
                      (3, REPEAT('c', 32614), REPEAT('C', 32610));

--echo # Grow a small row to full size
INSERT INTO t1 VALUES (4, 'd', 'D');
UPDATE t1 SET v = REPEAT('d', 32614), d = REPEAT('D', 32610) WHERE pk = 4;

--echo # Shrink a full row and grow it again
UPDATE t1 SET v = 'e', d = 'E' WHERE pk = 1;
UPDATE t1 SET v = REPEAT('e', 32614), d = REPEAT('E', 32610) WHERE pk = 1;

--echo # Delete full rows and insert new ones in the freed space
DELETE FROM t1 WHERE pk IN (2, 3);
INSERT INTO t1 VALUES (5, REPEAT('f', 32614), REPEAT('F', 32610)),
                      (6, REPEAT('g', 32614), REPEAT('G', 32610));

--echo # Move var parts
OPTIMIZE TABLE t1;

SELECT pk, LENGTH(v), LEFT(v, 3), RIGHT(v, 3),
       LENGTH(d), LEFT(d, 3), RIGHT(d, 3)
  FROM t1 ORDER BY pk;

DROP TABLE t1;

--echo # One byte more in memory exceeds the var part limit
--error ER_CANT_CREATE_TABLE
CREATE TABLE t2 (
  pk INT NOT NULL PRIMARY KEY,
  v VARCHAR(32615) CHARACTER SET latin1 NOT NULL
) ENGINE = NDB;
SHOW WARNINGS;

--echo # One byte more on disk exceeds the disk part limit
--error ER_CANT_CREATE_TABLE
CREATE TABLE t2 (
  pk INT NOT NULL PRIMARY KEY,
  d VARCHAR(32611) CHARACTER SET latin1 NOT NULL STORAGE DISK
) TABLESPACE ts1 ENGINE = NDB;
SHOW WARNINGS;

--echo #
--echo # A row of MAX_TUPLE_SIZE_IN_WORDS (18000 words, 72000 bytes).
--echo # MySQL limits a record to 65535 bytes not counting BLOBs, so the
--echo # in-memory var part is a BLOB with a 32600 byte inline part
--echo # (8154 words). The disk part is a VARCHAR(32610) (8153 words) and
--echo # the fixed part is the INT primary key, 26 BINARY(255) and one
--echo # BINARY(112) (1693 words).
--echo #

let $fixcols = ;
let $fixvals = ;
let $fixupd = ;
let $fixconcat = ;
let $n = 1;
let $count = 26;
while ($count)
{
  let $fixcols = $fixcols, c$n BINARY(255) NOT NULL;
  let $fixvals = $fixvals, REPEAT(CHAR(64 + $n), 255);
  let $fixupd = $fixupd, c$n = REPEAT(CHAR(65 + $n), 255);
  let $fixconcat = $fixconcat, c$n;
  inc $n;
  dec $count;
}

--disable_query_log
eval CREATE TABLE t3 (
  pk INT NOT NULL PRIMARY KEY,
  b BLOB NOT NULL COMMENT "NDB_COLUMN=BLOB_INLINE_SIZE=32600",
  d VARCHAR(32610) CHARACTER SET latin1 NOT NULL STORAGE DISK
  $fixcols,
  c27 BINARY(112) NOT NULL
) TABLESPACE ts1 ENGINE = NDB;
--enable_query_log

--echo # Insert full rows
--disable_query_log
eval INSERT INTO t3 VALUES
  (1, REPEAT('b', 32600), REPEAT('D', 32610)$fixvals, REPEAT(CHAR(99), 112)),
  (2, REPEAT('b', 32600), REPEAT('D', 32610)$fixvals, REPEAT(CHAR(99), 112));
--enable_query_log

--echo # Update all columns of a full row
--disable_query_log
eval UPDATE t3 SET b = REPEAT('u', 32600), d = REPEAT('U', 32610)$fixupd,
                   c27 = REPEAT(CHAR(100), 112)
  WHERE pk = 2;
--enable_query_log

--disable_query_log
eval SELECT pk, LENGTH(b) AS b_len, LENGTH(d) AS d_len,
            LENGTH(CONCAT(''$fixconcat, c27)) AS fixed_len,
            MD5(CONCAT(b, d$fixconcat, c27)) AS row_md5
  FROM t3 ORDER BY pk;
--enable_query_log

DELETE FROM t3 WHERE pk = 1;
SELECT COUNT(*) FROM t3;

DROP TABLE t3;

--echo # One byte more in the last fixed column makes the row 18001 words
--disable_query_log
--error ER_CANT_CREATE_TABLE
eval CREATE TABLE t4 (
  pk INT NOT NULL PRIMARY KEY,
  b BLOB NOT NULL COMMENT "NDB_COLUMN=BLOB_INLINE_SIZE=32600",
  d VARCHAR(32610) CHARACTER SET latin1 NOT NULL STORAGE DISK
  $fixcols,
  c27 BINARY(113) NOT NULL
) TABLESPACE ts1 ENGINE = NDB;
--enable_query_log
SHOW WARNINGS;

ALTER TABLESPACE ts1
DROP DATAFILE 'datafile.dat';
DROP TABLESPACE ts1;
DROP LOGFILE GROUP lg1 ENGINE = NDB;
