--source include/have_ndb.inc

--echo # RONDB-1062: scan vs key-op deadlock discovery (lock takeover).
--echo # A locking range scan (FOR UPDATE takes its row locks over to commit on
--echo # a buddy key-op connection) deadlocked with a key operation must be
--echo # resolved proactively - exactly one transaction aborted (the victim is
--echo # the smaller transaction-id hash, either side), promptly, with
--echo # TransactionDeadlockDetectionTimeout set to 60s (see .cnf).

--disable_query_log
--disable_result_log

connect (c1,localhost,root,,test);
connect (c2,localhost,root,,test);

connection default;
CREATE TABLE t1 (a INT NOT NULL PRIMARY KEY, b INT) ENGINE=NDB;
INSERT INTO t1 VALUES (1,10),(2,20);

# c2 (key op) holds the exclusive lock on row a=2.
connection c2;
BEGIN;
UPDATE t1 SET b = b + 1 WHERE a = 2;

# c1 runs an ascending locking range scan: it locks a=1 (free), then blocks
# trying to lock a=2 (held by c2).  At this point c1's scan holds a=1.
connection c1;
BEGIN;
--send SELECT * FROM t1 WHERE a BETWEEN 1 AND 2 ORDER BY a FOR UPDATE

connection default;
# Wait until the scan is blocked on a=2 (so it already holds a=1).
let $wait_condition=
  SELECT COUNT(*) >= 1 FROM ndbinfo.cluster_locks WHERE state = 'W';
--source include/wait_condition.inc

# c2 now wants row a=1 (held by c1's scan) -> closes the cycle:
#   scan(c1) waits-for keyop(c2) on a=2, keyop(c2) waits-for scan(c1) on a=1.
connection c2;
--send UPDATE t1 SET b = b + 1 WHERE a = 1

connection default;
SET @t0 = NOW(6);
# Either transaction may be the victim (collector = smaller transaction-id
# hash); exactly one is aborted with a deadlock error, the other proceeds.
connection c2;
--error 0,1205,1213
--reap
--let $c2_err = $mysql_errno
connection c1;
--error 0,1205,1213
--reap
--let $c1_err = $mysql_errno
connection default;
SET @t1 = NOW(6);
if (`SELECT ($c1_err <> 0) + ($c2_err <> 0) <> 1`)
{
  --die scan<->key-op: expected exactly one deadlock victim
}
if (`SELECT TIMESTAMPDIFF(SECOND, @t0, @t1) >= 20`)
{
  --die scan<->key-op deadlock not resolved promptly (proactive regressed?)
}

connection c1;
rollback;
connection c2;
rollback;

connection default;
DROP TABLE t1;
disconnect c1;
disconnect c2;
--enable_result_log
--enable_query_log

--echo # ndb_deadlock_scan: scan vs key-op (takeover) deadlock resolved
--echo # proactively - exactly one transaction aborted.
