--source include/have_ndb.inc
--source include/have_ndb_debug.inc

#
# Primary replicas after a node restart
# (storage/ndb/claude_files/replica_chain_switch/design.md).
#
# The end of a fragment copy to a restarting node keeps the replica chain
# of the fragment, so that no running transaction sees the chain change.
# The restarted node gets its primary replicas back in start phase 120,
# after the restart barrier: its DBDIH asks the master DBDIH, which makes
# every DBDIH recompute the primary replicas of all tables.
#
# DUMP 7037 1 makes the restarting node skip its phase-120 request in
# error insert builds.
#
# The checks read ndbinfo.ndb$table_fragments_all, where each data node
# reports the current primary of each fragment as it sees it
# (ndbinfo.table_fragments has the rows of the master only). They print
# booleans only, so the result does not depend on the number of fragments.
# The view t1_fragments hides the base table name: wait_condition.inc
# substitutes variables a second time, so ndb$... would become ndb.
#

CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=NDB;
--disable_query_log
let $i = 1;
while ($i <= 100)
{
  eval INSERT INTO t1 VALUES ($i, $i);
  inc $i;
}
--enable_query_log

CREATE VIEW t1_fragments AS
SELECT tf.node_id, tf.fragment_id, tf.current_primary
FROM ndbinfo.ndb$table_fragments_all AS tf
JOIN ndbinfo.dict_obj_info AS doi ON tf.table_id = doi.id
WHERE doi.fq_name = 'test/def/t1';

--echo #
--echo # Both data nodes see the same primary replicas, balanced over the
--echo # two nodes.
--echo #
SELECT COUNT(*) AS fragments_seen_differently FROM (
SELECT fragment_id FROM t1_fragments
GROUP BY fragment_id HAVING COUNT(DISTINCT current_primary) > 1) AS d;
SELECT node_id AS seen_by_node,
SUM(current_primary = 2) = 0 AS node_2_primary_for_none,
SUM(current_primary = 1) = SUM(current_primary = 2) AS balanced
FROM t1_fragments GROUP BY node_id ORDER BY node_id;

--echo #
--echo # Test 1: Node 2 restarts without the rebalance of start phase 120
--echo #   (DUMP 7037 1 while it waits in no-start). The fragment copies
--echo #   keep the replica chains, so it comes back primary for no fragment.
--echo #
--exec $NDB_MGM -e "2 restart -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --nowait-nodes=1 --not-started > $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "2 dump 7037 1" >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "2 start" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER > $NDB_TOOLS_OUTPUT
# The MySQL Server must see both data nodes, or ndbinfo has the rows of
# node 1 only
let $wait_condition=
  SELECT COUNT(*) = 2 FROM ndbinfo.nodes WHERE node_id IN (1,2);
--source include/wait_condition.inc
--source include/ndb_not_readonly.inc

SELECT COUNT(*) AS fragments_seen_differently FROM (
SELECT fragment_id FROM t1_fragments
GROUP BY fragment_id HAVING COUNT(DISTINCT current_primary) > 1) AS d;
SELECT node_id AS seen_by_node,
SUM(current_primary = 2) = 0 AS node_2_primary_for_none,
SUM(current_primary = 1) = SUM(current_primary = 2) AS balanced
FROM t1_fragments GROUP BY node_id ORDER BY node_id;
SELECT COUNT(*), SUM(b) FROM t1;

--echo #
--echo # Test 2: Node 2 restarts normally. Start phase 120 rebalances the
--echo #   primary replicas before the restart completes, so they are
--echo #   balanced as soon as the node has started, without any DUMP.
--echo #
--exec $NDB_MGM -e "2 restart -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --nowait-nodes=1 --not-started > $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "2 start" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER > $NDB_TOOLS_OUTPUT
let $wait_condition=
  SELECT COUNT(*) = 2 FROM ndbinfo.nodes WHERE node_id IN (1,2);
--source include/wait_condition.inc
--source include/ndb_not_readonly.inc

SELECT COUNT(*) AS fragments_seen_differently FROM (
SELECT fragment_id FROM t1_fragments
GROUP BY fragment_id HAVING COUNT(DISTINCT current_primary) > 1) AS d;
SELECT node_id AS seen_by_node,
SUM(current_primary = 2) = 0 AS node_2_primary_for_none,
SUM(current_primary = 1) = SUM(current_primary = 2) AS balanced
FROM t1_fragments GROUP BY node_id ORDER BY node_id;
UPDATE t1 SET b = b + 1;
SELECT COUNT(*), SUM(b) FROM t1;

DROP VIEW t1_fragments;
DROP TABLE t1;
--remove_file $NDB_TOOLS_OUTPUT
