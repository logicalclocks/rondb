--source include/have_ndb.inc
--source have_ndb_error_insert.inc

--echo #
--echo # UNDO log records of the largest size are applied at restart
--echo #
--echo # A disk part of MAX_DISK_VAR_SIZE_IN_WORDS (8158 words, a
--echo # VARCHAR(32610)) fills an empty disk page, the UNDO record of an
--echo # update or delete of such a row holds the full disk part. At restart
--echo # DBTUP queues the UNDO records of a page until the page is read, each
--echo # queued record is a copy in an RWPool record that must fit in one
--echo # 32 kB page. Node 1 restarts from an LCP that is older than these
--echo # UNDO records, so it applies all of them.
--echo #

CREATE LOGFILE GROUP lg1
ADD UNDOFILE 'undofile.dat'
INITIAL_SIZE 32M
UNDO_BUFFER_SIZE = 16M
ENGINE = NDB;

CREATE TABLESPACE ts1
ADD DATAFILE 'datafile.dat'
USE LOGFILE GROUP lg1
INITIAL_SIZE 64M
ENGINE = NDB;

CREATE TABLE t1 (
  pk INT NOT NULL PRIMARY KEY,
  d VARCHAR(32610) CHARACTER SET latin1 NOT NULL STORAGE DISK
) TABLESPACE ts1 ENGINE = NDB;

--echo # Full rows, each fills a disk page, and small rows
INSERT INTO t1 VALUES (1, REPEAT('A', 32610)), (2, REPEAT('B', 32610)),
                      (3, REPEAT('C', 32610)), (4, REPEAT('D', 32610));
INSERT INTO t1 VALUES (5, REPEAT('E', 32610)), (6, REPEAT('F', 32610));
INSERT INTO t1 VALUES (11, 'k'), (12, 'l'), (13, 'm'), (14, 'n');

--echo # LCP 1, node 1 restarts from it
--exec $NDB_MGM -e "all dump 7099" >> $NDB_TOOLS_OUTPUT
--sleep 10

--echo # Update the full rows twice, each of their disk pages gets two UNDO
--echo # records with a full disk part. The small updates in between move
--echo # the full records within the UNDO pages, LGMAN splits a record over
--echo # two UNDO pages when it does not fit in the rest of a page.
UPDATE t1 SET d = REPEAT('a', 32610) WHERE pk = 1;
UPDATE t1 SET d = 'x' WHERE pk = 11;
UPDATE t1 SET d = REPEAT('b', 32610) WHERE pk = 2;
UPDATE t1 SET d = REPEAT('c', 32610) WHERE pk = 3;
UPDATE t1 SET d = 'y' WHERE pk = 12;
UPDATE t1 SET d = REPEAT('d', 32610) WHERE pk = 4;
UPDATE t1 SET d = REPEAT('g', 32610) WHERE pk = 1;
UPDATE t1 SET d = REPEAT('h', 32610) WHERE pk = 2;
UPDATE t1 SET d = 'z' WHERE pk = 13;
UPDATE t1 SET d = REPEAT('i', 32610) WHERE pk = 3;
UPDATE t1 SET d = REPEAT('j', 32610) WHERE pk = 4;

--echo # Shrink a full row and grow it again
UPDATE t1 SET d = 'e' WHERE pk = 5;
UPDATE t1 SET d = REPEAT('e', 32610) WHERE pk = 5;

--echo # Delete a full row and insert new full rows
DELETE FROM t1 WHERE pk = 6;
INSERT INTO t1 VALUES (7, REPEAT('G', 32610)), (8, REPEAT('H', 32610));

--echo # LCP 2 writes the changed disk pages, and before them the UNDO log
--exec $NDB_MGM -e "all dump 7099" >> $NDB_TOOLS_OUTPUT
--sleep 10

SELECT pk, LENGTH(d) AS d_len, LEFT(d, 1) AS d_char,
       MD5(d) = MD5(REPEAT(LEFT(d, 1), LENGTH(d))) AS d_ok
  FROM t1 ORDER BY pk;

--echo # Restart node 1 from LCP 1, error 7248 skips the most recent LCP
--exec $NDB_MGM -e "1 RESTART -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --not-started --wait-nodes=1 >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "1 ERROR 7248" >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "1 START" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT
--exec $NDB_MGM -e "ALL ERROR 0" >> $NDB_TOOLS_OUTPUT
--source include/ndb_not_readonly.inc

--echo # Stop node 2, node 1 alone reads the rows
--exec $NDB_MGM -e "2 RESTART -n" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER --not-started --wait-nodes=2 >> $NDB_TOOLS_OUTPUT

--disable_query_log
--disable_result_log
--disable_warnings
let $read_ok = 0;
let $retries = 100;
while (!$read_ok)
{
  --error 0, ER_GET_TEMPORARY_ERRMSG, ER_GET_ERRMSG, ER_LOCK_WAIT_TIMEOUT
  SELECT COUNT(*) FROM t1;
  if (!$mysql_errno)
  {
    let $read_ok = 1;
  }
  if ($mysql_errno)
  {
    dec $retries;
    if (!$retries)
    {
      --die Reading t1 with node 2 stopped fails after 100 retries
    }
    --sleep 0.1
  }
}
--enable_warnings
--enable_result_log
--enable_query_log

SELECT pk, LENGTH(d) AS d_len, LEFT(d, 1) AS d_char,
       MD5(d) = MD5(REPEAT(LEFT(d, 1), LENGTH(d))) AS d_ok
  FROM t1 ORDER BY pk;

--echo # Change the disk pages on node 1 alone
UPDATE t1 SET d = REPEAT('k', 32610) WHERE pk = 11;
UPDATE t1 SET d = 'f' WHERE pk = 7;
DELETE FROM t1 WHERE pk = 8;
INSERT INTO t1 VALUES (6, REPEAT('F', 32610));

--exec $NDB_MGM -e "2 START" >> $NDB_TOOLS_OUTPUT
--exec $NDB_WAITER >> $NDB_TOOLS_OUTPUT
--source include/ndb_not_readonly.inc

SELECT pk, LENGTH(d) AS d_len, LEFT(d, 1) AS d_char,
       MD5(d) = MD5(REPEAT(LEFT(d, 1), LENGTH(d))) AS d_ok
  FROM t1 ORDER BY pk;

DROP TABLE t1;
ALTER TABLESPACE ts1
DROP DATAFILE 'datafile.dat';
DROP TABLESPACE ts1;
DROP LOGFILE GROUP lg1 ENGINE = NDB;

--remove_file $NDB_TOOLS_OUTPUT
