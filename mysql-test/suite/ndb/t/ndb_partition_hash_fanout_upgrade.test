-- source include/have_ndb.inc
-- source include/have_ndbmtd_v2.inc
-- source ndb_mgm.inc
-- source ndb_waiter.inc

# RONDB-1074: PARTITION_HASH fanout during rolling upgrade.
#
# The cluster starts with all data nodes running ndbmtd_v2 (the old
# binary). Requires an ndbmtd_v2 that predates partition hash fanout
# support (before 25.10.15): old DICT silently ignores unknown table
# properties, so creates must be refused while any old data node is
# connected. Run with MTR_RONDB_V2=1 and an ndbmtd_v2 binary in the
# bin directory.
#
# Verifies:
# - create with PARTITION_HASH rejected on an all-old cluster
# - still rejected while the cluster runs mixed versions
# - plain tables work throughout the rolling upgrade
# - create succeeds once all data nodes are upgraded, with working
#   interval pruning and physical placement

# Ignore the warning generated by ndbcluster's binlog thread
# when cluster is restarted
--disable_query_log ONCE
call mtr.add_suppression("cluster disconnect An incident event has been written");

connect(mysqld2,127.0.0.1,root,,test,$MASTER_MYPORT1);
connection mysqld2;
--disable_query_log ONCE
call mtr.add_suppression("cluster disconnect An incident event has been written");
connection default;

--echo -- All data nodes run the old version
--echo -- Create with PARTITION_HASH is rejected
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE t_fan (
  entity_id INT NOT NULL,
  ts INT NOT NULL,
  PRIMARY KEY (entity_id, ts)
) ENGINE=NDB COMMENT="NDB_TABLE=PARTITION_HASH=1:1:4"
PARTITION BY KEY () PARTITIONS 8;

--echo -- Plain tables work on the old version
CREATE TABLE t_plain (
  a INT NOT NULL,
  b INT NOT NULL,
  PRIMARY KEY (a,b)
) ENGINE=NDB;
CREATE TABLE nums (n INT PRIMARY KEY) ENGINE=NDB;
--disable_query_log
let $i=0;
while ($i < 25)
{
  eval INSERT INTO nums VALUES ($i);
  inc $i;
}
--enable_query_log
INSERT INTO t_plain SELECT a.n, b.n FROM nums a, nums b;
SELECT COUNT(*) FROM t_plain;

--echo -- Rolling upgrade of node 1 to the current version
--exec ln -sf $NDBMTD_EXE $NDBMTD_LINK
--exec $_mgm_cmd -e "1 RESTART -n" >> $NDB_TOOLS_OUTPUT
--echo --- Wait for node to stop
--exec $_waiter_cmd --not-started -w1 >> $NDB_TOOLS_OUTPUT
--echo --- Start node again
--exec $_mgm_cmd -e "ALL START" >> $NDB_TOOLS_OUTPUT
--echo --- Wait for node to recover
--exec $_waiter_cmd >> $NDB_TOOLS_OUTPUT

--echo -- Mixed version cluster: create with PARTITION_HASH still rejected
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE t_fan (
  entity_id INT NOT NULL,
  ts INT NOT NULL,
  PRIMARY KEY (entity_id, ts)
) ENGINE=NDB COMMENT="NDB_TABLE=PARTITION_HASH=1:1:4"
PARTITION BY KEY () PARTITIONS 8;

--echo -- Plain tables keep working on the mixed cluster
INSERT INTO t_plain SELECT a.n + 100, b.n FROM nums a, nums b WHERE a.n < 5;
SELECT COUNT(*) FROM t_plain;

--echo -- Rolling upgrade of node 2 to the current version
--exec $_mgm_cmd -e "2 RESTART -n" >> $NDB_TOOLS_OUTPUT
--echo --- Wait for node to stop
--exec $_waiter_cmd --not-started -w2 >> $NDB_TOOLS_OUTPUT
--echo --- Start node again
--exec $_mgm_cmd -e "ALL START" >> $NDB_TOOLS_OUTPUT
--echo --- Wait for node to recover
--exec $_waiter_cmd >> $NDB_TOOLS_OUTPUT

--echo -- All data nodes upgraded: create with PARTITION_HASH succeeds
CREATE TABLE t_fan (
  entity_id INT NOT NULL,
  ts INT NOT NULL,
  PRIMARY KEY (entity_id, ts)
) ENGINE=NDB COMMENT="NDB_TABLE=PARTITION_HASH=1:1:4"
PARTITION BY KEY () PARTITIONS 8;
SHOW CREATE TABLE t_fan;

# Single base key: interval routing and pruning work after the upgrade
INSERT INTO t_fan SELECT 1, a.n*25+b.n FROM nums a, nums b WHERE a.n < 4;
SELECT COUNT(*) FROM t_fan;

--source suite/ndb/include/ndb_init_scan_counts.inc
--sorted_result
SELECT * FROM t_fan FORCE INDEX (PRIMARY) WHERE entity_id = 1 AND ts < 5;
--source suite/ndb/include/ndb_scan_counts.inc

SELECT COUNT(DISTINCT fragment_num) AS fragments_with_rows
FROM ndbinfo.memory_per_fragment
WHERE fq_name = 'test/def/t_fan' AND fixed_elem_count > 0;

DROP TABLE t_fan, t_plain, nums;
--remove_file $NDB_TOOLS_OUTPUT
