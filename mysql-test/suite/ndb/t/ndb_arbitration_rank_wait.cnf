!include include/default_mysqld.cnf
!include include/default_ndbd.cnf

[cluster_config.1]
ndbd=,
ndb_mgmd=
mysqld=,
ndbapi=,,,,
# Short wait so the test runs quickly:
ArbitrationRankWait=5000

[cluster_config.ndbd.1.1]
NodeId=1

[cluster_config.ndbd.2.1]
NodeId=2

[cluster_config.ndb_mgmd.1.1]
NodeId=3

[cluster_config.mysqld.1.1]
NodeId=49
Dedicated=1
# Make mysqld-1 a rank-2 arbitrator candidate so that the rank-2
# fallback path is exercised when the rank-1 mgmd is unavailable.
ArbitrationRank=2

[cluster_config.mysqld.2.1]
NodeId=16
Dedicated=1

[cluster_config.ndbapi.1.1]
NodeId=32
Dedicated=1

[cluster_config.ndbapi.2.1]
NodeId=48
Dedicated=1

[cluster_config.ndbapi.3.1]
NodeId=56
Dedicated=1

[cluster_config.ndbapi.4.1]
NodeId=171
Dedicated=1

[mysqld]
ndbcluster
ndb-wait-connected=30
ndb-wait-setup=120
ndb-cluster-connection-pool=3
ndb-extra-logging=99
local-infile=true

[mysqld.1.1]
ndb-cluster-connection-pool-nodeids=49,56,171
skip-log-bin
skip-log-replica-updates

[mysqld.2.1]
ndb-cluster-connection-pool-nodeids=16,32,48
skip-log-bin
skip-log-replica-updates

[ENV]
NDB_CONNECTSTRING=             @mysql_cluster.1.ndb_connectstring
NDB_MGMD_PORT=                 @cluster_config.ndb_mgmd.1.1.PortNumber
NDB_MGMD_NODEID=               @cluster_config.ndb_mgmd.1.1.NodeId
NDB_MYSQLD_RANK2_NODEID=       @cluster_config.mysqld.1.1.NodeId
MASTER_MYSOCK=                 @mysqld.1.1.socket
MASTER_MYPORT=                 @mysqld.1.1.port
MASTER_MYPORT1=                @mysqld.2.1.port
NDB_BACKUP_DIR=                @cluster_config.ndbd.1.1.BackupDataDir
