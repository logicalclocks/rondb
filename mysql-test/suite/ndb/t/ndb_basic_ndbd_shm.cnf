!include suite/ndb/my.cnf
!include suite/ndb/shm.cnf
[cluster_config]
PartitionsPerNode=1
NumCPUs=1
[ENV]
MTR_NDBMTD=1

# ShmKey is only generated for node ids below 256, so keep all API
# nodes in this test below 256 instead of the ids from suite/ndb/my.cnf.

[cluster_config.mysqld.1.1]
NodeId=49

[cluster_config.mysqld.2.1]
NodeId=16

[cluster_config.ndbapi.1.1]
NodeId=32

[cluster_config.ndbapi.2.1]
NodeId=48

[cluster_config.ndbapi.3.1]
NodeId=63

[cluster_config.ndbapi.4.1]
NodeId=127

[mysqld.1.1]
ndb-cluster-connection-pool-nodeids=49,63,127

[mysqld.2.1]
ndb-cluster-connection-pool-nodeids=16,32,48
