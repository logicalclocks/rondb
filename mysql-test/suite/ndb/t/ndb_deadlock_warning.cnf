!include suite/ndb/my.cnf

[cluster_config.1]
# RONDB-1062 deadlock error enrichment test.
# A high transaction deadlock detection timeout so that a deadlock resolved
# quickly proves PROACTIVE detection fired (DBACC -> DBTC wait-for edges) - the
# only path that also sends the GSN_TC_DEADLOCK_REP detail this test checks for.
TransactionDeadlockDetectionTimeout = 60000
EnableProactiveDeadlockDetection = 1
