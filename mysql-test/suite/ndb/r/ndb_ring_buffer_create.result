#
# Case 1: Basic CREATE TABLE with RING_BUFFER — success
#
CREATE TABLE test.t1 (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
data VARCHAR(100),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=RING_BUFFER=400@ring_idx@ring_meta";
SHOW CREATE TABLE test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `client_id` int NOT NULL,
  `ring_idx` int NOT NULL DEFAULT '0',
  `ring_meta` varbinary(64) DEFAULT NULL,
  `data` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`client_id`,`ring_idx`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='NDB_TABLE=RING_BUFFER=400@ring_idx@ring_meta'
DROP TABLE test.t1;
