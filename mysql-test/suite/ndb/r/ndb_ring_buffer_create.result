) ENGINE = NDB,
COMMENT="NDB_TABLE=RING_BUFFER=400@ring_idx@ring_meta";
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'Ring meta column must be nullable'
#
# Case 12: Error — size = 0 (below minimum)
