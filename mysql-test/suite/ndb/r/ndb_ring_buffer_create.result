#
# Case 5: RING_BUFFER = OFF — success (no ring buffer set)
#
CREATE TABLE test.t5 (
pk INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(16),
PRIMARY KEY (pk, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=RING_BUFFER=off";
SHOW CREATE TABLE test.t5;
Table	Create Table
t5	CREATE TABLE `t5` (
  `pk` int NOT NULL,
  `ring_idx` int NOT NULL DEFAULT '0',
  `ring_meta` varbinary(16) DEFAULT NULL,
  PRIMARY KEY (`pk`,`ring_idx`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='NDB_TABLE=RING_BUFFER=off'
DROP TABLE test.t5;
#
# Case 6: Combined COMMENT with PARTITION_BALANCE — success
#
CREATE TABLE test.t6 (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
data VARCHAR(100),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=PARTITION_BALANCE=FOR_RP_BY_LDM,RING_BUFFER=200@ring_idx@ring_meta";
SHOW CREATE TABLE test.t6;
Table	Create Table
t6	CREATE TABLE `t6` (
  `client_id` int NOT NULL,
  `ring_idx` int NOT NULL DEFAULT '0',
  `ring_meta` varbinary(64) DEFAULT NULL,
  `data` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`client_id`,`ring_idx`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='NDB_TABLE=PARTITION_BALANCE=FOR_RP_BY_LDM,RING_BUFFER=200@ring_idx@ring_meta'
DROP TABLE test.t6;
#
# Case 7: Error — ring_idx column is not INT type (BIGINT)
#
CREATE TABLE test.t7 (
client_id INT NOT NULL,
ring_idx BIGINT NOT NULL DEFAULT 0,
ring_meta VARBINARY(64),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=RING_BUFFER=400@ring_idx@ring_meta";
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'Ring index column must be INT type'
#
# Case 8: Error — ring_idx column is not the last PK column
#
CREATE TABLE test.t8 (
ring_idx INT NOT NULL DEFAULT 0,
client_id INT NOT NULL,
ring_meta VARBINARY(64),
PRIMARY KEY (ring_idx, client_id)
) ENGINE = NDB,
COMMENT="NDB_TABLE=RING_BUFFER=400@ring_idx@ring_meta";
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'Ring index column must be the last column of the PRIMARY KEY'
#
# Case 9: Error — ring_meta column is not VARBINARY (VARCHAR used)
#
CREATE TABLE test.t9 (
client_id INT NOT NULL,
ring_idx INT NOT NULL DEFAULT 0,
ring_meta VARCHAR(64),
PRIMARY KEY (client_id, ring_idx)
) ENGINE = NDB,
COMMENT="NDB_TABLE=RING_BUFFER=400@ring_idx@ring_meta";
ERROR HY000: Table storage engine 'ndbcluster' does not support the create option 'Ring meta column must be VARBINARY type'
#
# Case 10: Error — ring_meta column VARBINARY too small (< 16)
#
