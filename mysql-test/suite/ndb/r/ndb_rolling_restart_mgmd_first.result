# Initial cluster state
CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=NDB;
INSERT INTO t1 VALUES (1, 10), (2, 20), (3, 30);
SELECT COUNT(*) AS initial_count FROM t1;
initial_count
3

# ------------------------------------------------------------------
# Step 1/5: restart ndb_mgmd
# ------------------------------------------------------------------
SELECT COUNT(*) AS after_mgmd_restart FROM t1;
after_mgmd_restart
3

# ------------------------------------------------------------------
# Step 2/5: restart ndbd node 1
# ------------------------------------------------------------------
# Restarting node 1, timeouts: start: 120 seconds, stop: 60 seconds:
SELECT COUNT(*) AS after_ndbd1_restart FROM t1;
after_ndbd1_restart
3

# ------------------------------------------------------------------
# Step 3/5: restart ndbd node 2
# ------------------------------------------------------------------
# Restarting node 2, timeouts: start: 120 seconds, stop: 60 seconds:
SELECT COUNT(*) AS after_ndbd2_restart FROM t1;
after_ndbd2_restart
3

# ------------------------------------------------------------------
# Step 4/5: restart mysqld #1
# ------------------------------------------------------------------
# restart
SELECT COUNT(*) AS after_mysqld1_restart FROM t1;
after_mysqld1_restart
3

# ------------------------------------------------------------------
# Step 5/5: restart mysqld #2
# ------------------------------------------------------------------
# restart
SELECT COUNT(*) AS after_mysqld2_restart FROM t1;
after_mysqld2_restart
3

# ------------------------------------------------------------------
# All five nodes have been restarted; verify cluster is healthy
# ------------------------------------------------------------------
INSERT INTO t1 VALUES (4, 40);
SELECT COUNT(*) AS final_count FROM t1;
final_count
4
DROP TABLE t1;

# Verify the mgmd's startup gate ran (info log line from
# wait_until_arbitrator).  Either the success or timeout-fallback
# path is acceptable; both prove the warm-restart gate executed.
include/assert_grep.inc [mgmd startup gate ran during restart]
