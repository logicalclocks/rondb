--source include/have_ndb.inc
--source include/have_ndb_debug.inc
# RONDB-1124: a transaction keeps its reference to the database whose rate
# queue it uses while one of its requests waits in that queue or has been
# re-sent from it. Before, a dirty read that completed the transaction's
# outstanding operations released it while the next operation waited in
# the queue, and the re-sent operation was taken to its own table's
# database: a data node crash when that database has no rate limit, and
# the wrong database's count of re-sent requests when it has one. The NDB
# API test reads the test table (TEST_DB, with a rate limit) and then a
# table of another database in one batch; error insert 8319 queues the
# second read and re-sends it after 1 s, after the first one completed.
CREATE DATABASE TEST_DB;
CREATE DATABASE rl_noquota;
CREATE DATABASE rl_quota2;
CREATE TABLE rl_noquota.t (pk INT PRIMARY KEY, v INT) ENGINE=NDBCLUSTER;
CREATE TABLE rl_quota2.t (pk INT PRIMARY KEY, v INT) ENGINE=NDBCLUSTER;
INSERT INTO rl_noquota.t VALUES (1, 10);
INSERT INTO rl_quota2.t VALUES (1, 10);
--exec $NDB_MGM -e "DATABASE QUOTA SET TEST_DB --rate-per-sec=1000000" > /dev/null
--exec $NDB_MGM -e "DATABASE QUOTA SET rl_quota2 --rate-per-sec=1000000" > /dev/null
let NDBAPITEST_NAME=testNdbApi;
let NDBAPITEST_ARGS=-n RateQueueDirtyReadOtherDatabase T1;
--source suite/ndb/include/run_ndbapitest.inc
--exec $NDB_MGM -e "DATABASE QUOTA DROP rl_quota2" > /dev/null
--exec $NDB_MGM -e "DATABASE QUOTA DROP TEST_DB" > /dev/null
DROP DATABASE rl_quota2;
DROP DATABASE rl_noquota;
DROP DATABASE TEST_DB;
