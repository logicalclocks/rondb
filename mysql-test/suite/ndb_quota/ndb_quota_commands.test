--disable_warnings
DROP TABLE IF EXISTS t1, t2;
--enable_warnings

CREATE TABLE t1 (
  pk1 INT NOT NULL PRIMARY KEY,
  b1 CHAR(255),
  b2 CHAR(255),
  b3 CHAR(255),
  b4 CHAR(255),
  b5 CHAR(255) NULL,
  b6 CHAR(255) NULL,
  b7 CHAR(255) NULL,
  b8 CHAR(255) NULL,
  b9 CHAR(255) NULL,
  b10 CHAR(255) NULL,
  b11 CHAR(255) NULL,
  b12 CHAR(255) NULL,
  b13 CHAR(255) NULL,
  b14 CHAR(255) NULL,
  b15 CHAR(255) NULL,
  b16 CHAR(255) NULL,
  b17 CHAR(255) NULL,
  b18 CHAR(255) NULL,
  b19 CHAR(255) NULL,
  b20 CHAR(255) NULL,
  b21 CHAR(255) NULL,
  b22 CHAR(255) NULL,
  b23 CHAR(255) NULL,
  b24 CHAR(255) NULL,
  b25 CHAR(255) NULL,
  b26 CHAR(255) NULL,
  b27 CHAR(255) NULL,
  b28 VARCHAR(20000) NULL
) engine ndb character set latin1;

CREATE TABLE t2 (a int not null primary key, b int) engine ndb;
