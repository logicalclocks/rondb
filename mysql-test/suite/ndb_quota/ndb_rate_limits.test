connection mysqld6;
let $count = 100;
while ($count)
{
--error 0,1297
  SELECT * from test1.t1;
  UPDATE test1.t1 SET b = 1 WHERE a = 5;
  dec $count;
}

connection default;
sleep 10;
SELECT * from test1.t1;
--exec $NDB_MGM -e "DATABASE QUOTA DROP test1"
DROP DATABASE test1;
