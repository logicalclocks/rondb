=== Test 7: regression — v1 two-arg GREATEST(col, const) ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(GREATEST(sums.k, 150)) AS gmax
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(GREATEST(sums.k, 150)) AS gmax
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id|
c_id	gmax
100	150
200	200
300	300


