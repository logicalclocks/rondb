=== Create tables for n-ary GREATEST / LEAST tests ===



=== Test 1: SUM(GREATEST(a, b, c)) — three distinct columns ===
== Query ==
SELECT c.c_id, SUM(GREATEST(c.c_region, c.c_floor, c.c_ceil)) AS gmax
FROM cte_customer AS c
JOIN cte_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT c.c_id, SUM(GREATEST(c.c_region, c.c_floor, c.c_ceil)) AS gmax
FROM cte_customer AS c
JOIN cte_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id|
c_id	gmax
100	400
200	300
300	400


