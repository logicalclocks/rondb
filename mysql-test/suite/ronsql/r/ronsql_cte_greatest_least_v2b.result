=== Test 9: CTE-scope — chained CTE with n-ary GREATEST in body ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, MAX(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(GREATEST(sums.t, 60, 80)) AS gmax
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH sums AS (
SELECT o_custkey AS k, MAX(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(GREATEST(sums.t, 60, 80)) AS gmax
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id|
c_id	gmax
100	80
200	80
300	90


