=== Test 5: 3-table join, GROUP BY on root, SUM on leaf ===
== Query ==
SELECT c.c_region, SUM(l.l_quantity)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY c.c_region;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
SELECT c.c_region, SUM(l.l_quantity)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY c.c_region|
c_region	SUM(l.l_quantity)
1	125
2	75


