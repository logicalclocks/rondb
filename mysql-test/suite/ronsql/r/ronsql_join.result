SELECT o.o_status, SUM(l.l_quantity), COUNT(l.l_id)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_status|
o_status	SUM(l.l_quantity)	COUNT(l.l_id)
