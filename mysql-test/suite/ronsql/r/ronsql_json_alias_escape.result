call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");

=== oe-1: a plain alias (control) ===
== Query ==
SELECT id, v AS plain FROM jalias WHERE id = 1;
== ronsql_cli JSON ==
[{"id":1,"plain":10}]
[{"id":1,"plain":10}]
== RDRS JSON ==
{"data":
[{"id":1,"plain":10}]
}
{"data":[{"id":1,"plain":10}]}

=== oe-2: a quote ===
== Query ==
SELECT id, v AS `x"y` FROM jalias WHERE id = 1;
== ronsql_cli JSON ==
[{"id":1,"x\"y":10}]
[{"id":1,"x\"y":10}]
== RDRS JSON ==
{"data":
[{"id":1,"x\"y":10}]
}
{"data":[{"id":1,"x\"y":10}]}

=== oe-3: a backslash ===
== Query ==
SELECT id, v AS `a\b` FROM jalias WHERE id = 1;
== ronsql_cli JSON ==
[{"id":1,"a\\b":10}]
[{"a\\b":10,"id":1}]
== RDRS JSON ==
{"data":
[{"id":1,"a\\b":10}]
}
{"data":[{"a\\b":10,"id":1}]}

=== oe-4: a quote and a backslash, several rows, ORDER BY ===
== Query ==
SELECT id, v AS `q"\z`, grp AS `\"` FROM jalias ORDER BY id;
== ronsql_cli JSON ==
[{"id":1,"q\"\\z":10,"\\\"":1},{"id":2,"q\"\\z":20,"\\\"":1},{"id":3,"q\"\\z":30,"\\\"":2}]
[{"\\\"":1,"id":1,"q\"\\z":10},{"\\\"":1,"id":2,"q\"\\z":20},{"\\\"":2,"id":3,"q\"\\z":30}]
== RDRS JSON ==
{"data":
[{"id":1,"q\"\\z":10,"\\\"":1},{"id":2,"q\"\\z":20,"\\\"":1},{"id":3,"q\"\\z":30,"\\\"":2}]
}
{"data":[{"\\\"":1,"id":1,"q\"\\z":10},{"\\\"":1,"id":2,"q\"\\z":20},{"\\\"":2,"id":3,"q\"\\z":30}]}

=== oe-5: a tab ===
== Query ==
SELECT id, v AS `t<TAB>b` FROM jalias WHERE id = 1;
== ronsql_cli JSON ==
[{"id":1,"t\tb":10}]
[{"id":1,"t\tb":10}]
== RDRS JSON ==
{"data":
[{"id":1,"t\tb":10}]
}
{"data":[{"id":1,"t\tb":10}]}

=== oe-6: aggregate rows with the same aliases (control) ===
== Query ==
SELECT grp, SUM(v) AS `s"um`, COUNT(*) AS `a\b`, MAX(v) AS `q"\z` FROM jalias GROUP BY grp ORDER BY grp;
== ronsql_cli JSON ==
[{"grp":1,"s\"um":30,"a\\b":2,"q\"\\z":20}
,{"grp":2,"s\"um":30,"a\\b":1,"q\"\\z":30}
]
[{"a\\b":2,"grp":1,"q\"\\z":20,"s\"um":30},{"a\\b":1,"grp":2,"q\"\\z":30,"s\"um":30}]
== RDRS JSON ==
{"data":
[{"grp":1,"s\"um":30,"a\\b":2,"q\"\\z":20}
,{"grp":2,"s\"um":30,"a\\b":1,"q\"\\z":30}
]
}
{"data":[{"a\\b":2,"grp":1,"q\"\\z":20,"s\"um":30},{"a\\b":1,"grp":2,"q\"\\z":30,"s\"um":30}]}

=== oe-7: the COUNT(*) shortcut (control) ===
== Query ==
SELECT COUNT(*) AS `n"\` FROM jalias;
== ronsql_cli JSON ==
[{"n\"\\":3}
]
[{"n\"\\":3}]
== RDRS JSON ==
{"data":
[{"n\"\\":3}
]
}
{"data":[{"n\"\\":3}]}

=== oe-8: a non-ASCII alias under JSON (control) ===
== Query ==
SELECT id, v AS `café` FROM jalias WHERE id = 1;
== ronsql_cli JSON ==
[{"id":1,"café":10}]
[{"café":10,"id":1}]
== RDRS JSON ==
{"data":
[{"id":1,"café":10}]
}
{"data":[{"café":10,"id":1}]}

=== oe-9: the same under JSON_ASCII ===
== Query ==
SELECT id, v AS `café` FROM jalias WHERE id = 1;
== ronsql_cli JSON_ASCII ==
[{"id":1,"caf\u00e9":10}]
[{"café":10,"id":1}]
== RDRS JSON_ASCII ==
{"data":
[{"id":1,"caf\u00e9":10}]
}
{"data":[{"café":10,"id":1}]}
