=== cm-4: ORDER BY the MIN of VARCHAR arms ===
== Query ==
SELECT g, MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn
FROM cms GROUP BY g ORDER BY mn;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT g, MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn
FROM cms GROUP BY g ORDER BY mn|
g	mn
1	apple
3	grape
2	Lime

=== cm-5: VARCHAR arms over a join ===
== Query ==
SELECT x.g,
MIN(CASE WHEN t.k > 5 THEN t.a ELSE t.b END) AS mn,
MAX(CASE WHEN t.k > 5 THEN t.a ELSE t.b END) AS mx
FROM cms_drv AS x
JOIN cms AS t ON t.g = x.g AND t.id = x.id
GROUP BY x.g;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT x.g,
MIN(CASE WHEN t.k > 5 THEN t.a ELSE t.b END) AS mn,
MAX(CASE WHEN t.k > 5 THEN t.a ELSE t.b END) AS mx
FROM cms_drv AS x
JOIN cms AS t ON t.g = x.g AND t.id = x.id
GROUP BY x.g|
g	mn	mx
1	apple	Zoo
2	Lime	Mango
3	grape	Olive

