=== cm-1: VARCHAR arms, GROUP BY ===
== Query ==
SELECT g,
MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn,
MAX(CASE WHEN k > 5 THEN a ELSE b END) AS mx
FROM cms GROUP BY g;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT g,
MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn,
MAX(CASE WHEN k > 5 THEN a ELSE b END) AS mx
FROM cms GROUP BY g|
g	mn	mx
1	apple	Zoo
2	Lime	Mango
3	grape	Olive

=== cm-2: CHAR arms, GROUP BY ===
== Query ==
SELECT g,
MIN(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mn,
MAX(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mx
FROM cms GROUP BY g;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT g,
MIN(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mn,
MAX(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mx
FROM cms GROUP BY g|
g	mn	mx
1	aa	Kk
2	ll	Mm
3	gg	Oo

