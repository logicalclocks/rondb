=== Test 4: WHERE filter on MIN/MAX DECIMAL output — inline-type pushdown ===
== Query ==
WITH stats AS (SELECT o_grp AS k,
MAX(o_amt0) AS hi
FROM dec_orders GROUP BY o_grp)
SELECT k, hi FROM stats WHERE hi > 600;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH stats AS (SELECT o_grp AS k,
MAX(o_amt0) AS hi
FROM dec_orders GROUP BY o_grp)
SELECT k, hi FROM stats WHERE hi > 600|
k	hi
100	1000
200	800


=== Test 5: chained CTE with MIN(MAX(decimal_col)) ===
== Query ==
WITH a AS (SELECT o_grp AS k, MAX(o_amt0) AS hi
FROM dec_orders GROUP BY o_grp),
b AS (SELECT MIN(a.hi) AS overall_min
FROM a)
SELECT overall_min FROM b;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH a AS (SELECT o_grp AS k, MAX(o_amt0) AS hi
FROM dec_orders GROUP BY o_grp),
b AS (SELECT MIN(a.hi) AS overall_min
FROM a)
SELECT overall_min FROM b|
overall_min
400
