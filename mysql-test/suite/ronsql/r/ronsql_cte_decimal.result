=== Test 1: MIN/MAX DECIMAL(10,0) — widens to BIGINT ===
== Query ==
WITH stats AS (SELECT o_grp AS k,
MIN(o_amt0) AS lo,
MAX(o_amt0) AS hi
FROM dec_orders GROUP BY o_grp)
SELECT k, lo, hi FROM stats;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH stats AS (SELECT o_grp AS k,
MIN(o_amt0) AS lo,
MAX(o_amt0) AS hi
FROM dec_orders GROUP BY o_grp)
SELECT k, lo, hi FROM stats|
k	lo	hi
100	500	1000
200	300	800
300	400	400


