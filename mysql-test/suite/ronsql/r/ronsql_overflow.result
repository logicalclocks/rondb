     , sum(sint8
           DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024
     ) as intdiv_overflow
FROM tbl
GROUP BY sint8;

