=== Create tables for CTE CASE tests ===



=== Test 1: CASE with parent-table condition + CTE THEN arm (baseline) ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN c.c_region = 1 THEN sums.t ELSE 0 END)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN c.c_region = 1 THEN sums.t ELSE 0 END)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id|
c_id	SUM(CASE WHEN c.c_region = 1 THEN sums.t ELSE 0 END)
100	125
200	100
300	0


