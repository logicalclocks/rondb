=== Test 3: CASE with multi-atom OR over CTE column ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k = 100 OR sums.k = 200
THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k = 100 OR sums.k = 200
THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id|
c_id	case_sum
100	125
200	100
300	0


=== Test 4: CASE with multi-atom AND over CTE column ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k != 100 AND sums.k != 200
THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

