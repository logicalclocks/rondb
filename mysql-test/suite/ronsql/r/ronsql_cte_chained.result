=== Test 3 (D3): Skewed CTE — single-group result, empty on other nodes ===
== Query ==
WITH skew AS (
SELECT grp AS k, SUM(val) AS s
FROM cte_big WHERE grp = 100 GROUP BY grp)
SELECT p.id, SUM(skew.s)
FROM cte_parent AS p JOIN skew ON skew.k = p.grp
GROUP BY p.id;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH skew AS (
SELECT grp AS k, SUM(val) AS s
FROM cte_big WHERE grp = 100 GROUP BY grp)
SELECT p.id, SUM(skew.s)
FROM cte_parent AS p JOIN skew ON skew.k = p.grp
GROUP BY p.id|
id	SUM(skew.s)
100	500


=== Test 4 (D4): Empty-intermediate chain ===
== Query ==
WITH a AS (
SELECT grp AS k, SUM(val) AS s
FROM cte_big WHERE val < 0 GROUP BY grp),
b AS (
SELECT k, MAX(s) AS m
FROM a GROUP BY k)
SELECT k, SUM(m) FROM b GROUP BY k;

Number of output lines, including header: 0

== Diff ==
==========



== Expected result ==
WITH a AS (
SELECT grp AS k, SUM(val) AS s
FROM cte_big WHERE val < 0 GROUP BY grp),
b AS (
SELECT k, MAX(s) AS m
FROM a GROUP BY k)
SELECT k, SUM(m) FROM b GROUP BY k|
k	SUM(m)

=== Cleanup ===
DROP TABLE cte_parent;
DROP TABLE cte_big;
