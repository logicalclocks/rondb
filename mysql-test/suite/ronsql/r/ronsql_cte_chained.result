=== Test 2 (D2): Sibling CTEs in the same phase ===
== Query ==
WITH sums AS (
SELECT grp AS k, SUM(val) AS s
FROM cte_big GROUP BY grp),
cnts AS (
SELECT grp AS k, COUNT(*) AS n
FROM cte_big GROUP BY grp)
SELECT p.id, SUM(sums.s), SUM(cnts.n)
FROM cte_parent AS p
JOIN sums ON sums.k = p.grp
JOIN cnts ON cnts.k = p.grp
GROUP BY p.id;

Number of output lines, including header: 301

== Diff ==
==========



== Expected result ==
WITH sums AS (
SELECT grp AS k, SUM(val) AS s
FROM cte_big GROUP BY grp),
cnts AS (
SELECT grp AS k, COUNT(*) AS n
FROM cte_big GROUP BY grp)
SELECT p.id, SUM(sums.s), SUM(cnts.n)
FROM cte_parent AS p
JOIN sums ON sums.k = p.grp
JOIN cnts ON cnts.k = p.grp
GROUP BY p.id|
