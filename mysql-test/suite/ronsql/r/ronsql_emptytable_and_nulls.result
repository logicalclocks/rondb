Create test table with no rows
CREATE TABLE tbl1 (
pk INT NOT NULL AUTO_INCREMENT,
idx INT NULL,
flt INT NULL,
gr INT NULL,
dat INT NULL,
PRIMARY KEY USING HASH (pk),
INDEX index_idx (idx)
) ENGINE=NDB CHARSET=latin1;
====== Queries on an empty table ======
Table scan
== Query ==
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
;

Number of output lines, including header: 2

== Diff ==
==========



