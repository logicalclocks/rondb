===== GROUP BY: a group with NULLs and an all-NULL group =====
== Query ==
SELECT grp, COUNT(*) AS cnt, MIN(d) AS d_min, MAX(dt) AS dt_max, MIN(ts3) AS ts3_min, MAX(ts6) AS ts6_max FROM tj GROUP BY grp ORDER BY grp;
