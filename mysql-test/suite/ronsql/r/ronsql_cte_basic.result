=== Create tables for CTE basic tests ===



=== Test 1: CTE as main aggregation leaf (A0 shape) ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY sums.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY sums.k|
k	SUM(sums.t)
100	125
200	100
300	90


=== Test 2: Multi-table CTE body, main agg on CTE leaf (A0) ===
== Query ==
WITH revenue AS (
SELECT o.o_custkey AS k, SUM(l.l_price) AS r
FROM cte_orders AS o JOIN cte_lineitem AS l ON l.l_custkey = o.o_custkey
GROUP BY o.o_custkey)
SELECT revenue.k, SUM(revenue.r)
FROM cte_customer AS c
JOIN revenue ON revenue.k = c.c_id
GROUP BY revenue.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH revenue AS (
SELECT o.o_custkey AS k, SUM(l.l_price) AS r
FROM cte_orders AS o JOIN cte_lineitem AS l ON l.l_custkey = o.o_custkey
GROUP BY o.o_custkey)
SELECT revenue.k, SUM(revenue.r)
FROM cte_customer AS c
JOIN revenue ON revenue.k = c.c_id
GROUP BY revenue.k|
k	SUM(revenue.r)
100	60
200	140
300	110


=== Test 3: CTE with MIN + MAX aggregates ===
== Query ==
WITH bounds AS (
SELECT o_custkey AS k, MIN(o_amt) AS mn, MAX(o_amt) AS mx
FROM cte_orders GROUP BY o_custkey)
SELECT bounds.k, SUM(bounds.mn), SUM(bounds.mx)
FROM cte_customer AS c
JOIN bounds ON bounds.k = c.c_id
GROUP BY bounds.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH bounds AS (
SELECT o_custkey AS k, MIN(o_amt) AS mn, MAX(o_amt) AS mx
FROM cte_orders GROUP BY o_custkey)
SELECT bounds.k, SUM(bounds.mn), SUM(bounds.mx)
FROM cte_customer AS c
JOIN bounds ON bounds.k = c.c_id
GROUP BY bounds.k|
k	SUM(bounds.mn)	SUM(bounds.mx)
100	50	75
200	40	60
300	90	90


=== Test 4: CTE with COUNT aggregate ===
== Query ==
WITH cnt AS (
SELECT o_custkey AS k, COUNT(*) AS n
FROM cte_orders GROUP BY o_custkey)
SELECT cnt.k, SUM(cnt.n)
FROM cte_customer AS c
JOIN cnt ON cnt.k = c.c_id
GROUP BY cnt.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH cnt AS (
SELECT o_custkey AS k, COUNT(*) AS n
FROM cte_orders GROUP BY o_custkey)
SELECT cnt.k, SUM(cnt.n)
FROM cte_customer AS c
JOIN cnt ON cnt.k = c.c_id
GROUP BY cnt.k|
k	SUM(cnt.n)
100	2
200	2
300	1


=== Test 5 (B.2a): Two independent CTEs in one query ===
== Query ==
WITH
sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey),
cnt  AS (SELECT o_custkey AS k, COUNT(*) AS n
FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t), SUM(cnt.n)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
JOIN cnt  ON cnt.k  = c.c_id
GROUP BY sums.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH
sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey),
cnt  AS (SELECT o_custkey AS k, COUNT(*) AS n
FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t), SUM(cnt.n)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
JOIN cnt  ON cnt.k  = c.c_id
GROUP BY sums.k|
k	SUM(sums.t)	SUM(cnt.n)
100	125	2
200	100	2
300	90	1


=== Test 6 (B.2b): WHERE inside CTE body (pre-GROUP BY filter) ===
== Query ==
WITH big_orders AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders
WHERE o_amt > 50
GROUP BY o_custkey)
SELECT big_orders.k, SUM(big_orders.t)
FROM cte_customer AS c
JOIN big_orders ON big_orders.k = c.c_id
GROUP BY big_orders.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH big_orders AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders
WHERE o_amt > 50
GROUP BY o_custkey)
SELECT big_orders.k, SUM(big_orders.t)
FROM cte_customer AS c
JOIN big_orders ON big_orders.k = c.c_id
GROUP BY big_orders.k|
k	SUM(big_orders.t)
100	75
200	60
300	90


=== Test 7 (B.2c): VARCHAR GROUP BY column in CTE body ===
== Query ==
WITH by_code AS (
SELECT r_code AS rcode, COUNT(*) AS n
FROM cte_regions GROUP BY r_code)
SELECT by_code.rcode, SUM(by_code.n)
FROM cte_regions AS r
JOIN by_code ON by_code.rcode = r.r_code
GROUP BY by_code.rcode;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH by_code AS (
SELECT r_code AS rcode, COUNT(*) AS n
FROM cte_regions GROUP BY r_code)
SELECT by_code.rcode, SUM(by_code.n)
FROM cte_regions AS r
JOIN by_code ON by_code.rcode = r.r_code
GROUP BY by_code.rcode|
rcode	SUM(by_code.n)
UK	4
US	4


