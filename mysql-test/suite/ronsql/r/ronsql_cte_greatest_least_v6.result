=== Test 4: GREATEST against a CTE aggregate output and a CTE column ===
== Query ==
WITH pairs AS (
SELECT o_custkey AS k, o_amt AS amt, COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey, o_amt)
SELECT pairs.k AS c_id, SUM(GREATEST(pairs.amt, pairs.cnt)) AS g
FROM pairs
JOIN cte_customer AS c ON c.c_id = pairs.k
GROUP BY pairs.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH pairs AS (
SELECT o_custkey AS k, o_amt AS amt, COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey, o_amt)
SELECT pairs.k AS c_id, SUM(GREATEST(pairs.amt, pairs.cnt)) AS g
FROM pairs
JOIN cte_customer AS c ON c.c_id = pairs.k
GROUP BY pairs.k|
