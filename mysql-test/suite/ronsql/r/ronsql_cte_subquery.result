=== Create tables for subquery x CTE tests ===


=== Test 1: Scalar subquery (INT) in the main WHERE of a WITH query ===
== Query ==
WITH li_stats AS (
SELECT l_ord AS k, SUM(l_qty) AS q, COUNT(*) AS n
FROM sq_li GROUP BY l_ord)
SELECT COUNT(*), SUM(li_stats.q), SUM(li_stats.n)
FROM sq_ord AS o JOIN li_stats ON li_stats.k = o.o_id
WHERE o.o_total > (SELECT MIN(l_price) FROM sq_li);

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH li_stats AS (
SELECT l_ord AS k, SUM(l_qty) AS q, COUNT(*) AS n
FROM sq_li GROUP BY l_ord)
SELECT COUNT(*), SUM(li_stats.q), SUM(li_stats.n)
FROM sq_ord AS o JOIN li_stats ON li_stats.k = o.o_id
WHERE o.o_total > (SELECT MIN(l_price) FROM sq_li)|
COUNT(*)	SUM(li_stats.q)	SUM(li_stats.n)
5	200	10


=== Test 2: Scalar subquery with inner WHERE + CTE join, GROUP BY main ===
== Query ==
WITH li_stats AS (
SELECT l_ord AS k, SUM(l_qty) AS q
FROM sq_li GROUP BY l_ord)
SELECT o.o_cust, COUNT(*), SUM(li_stats.q)
FROM sq_ord AS o JOIN li_stats ON li_stats.k = o.o_id
WHERE o.o_total >= (SELECT MAX(l_price) FROM sq_li WHERE l_qty < 20)
GROUP BY o.o_cust;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH li_stats AS (
SELECT l_ord AS k, SUM(l_qty) AS q
FROM sq_li GROUP BY l_ord)
SELECT o.o_cust, COUNT(*), SUM(li_stats.q)
FROM sq_ord AS o JOIN li_stats ON li_stats.k = o.o_id
WHERE o.o_total >= (SELECT MAX(l_price) FROM sq_li WHERE l_qty < 20)
GROUP BY o.o_cust|
o_cust	COUNT(*)	SUM(li_stats.q)
100	2	50
200	2	75
300	1	75


=== Test 3: EXISTS (correlated) in the main WHERE + CTE join ===
== Query ==
WITH li_stats AS (
SELECT l_ord AS k, COUNT(*) AS n
FROM sq_li GROUP BY l_ord)
SELECT COUNT(*), SUM(li_stats.n)
FROM sq_ord AS o JOIN li_stats ON li_stats.k = o.o_id
WHERE EXISTS (SELECT l_id FROM sq_li WHERE l_ord = o.o_id AND l_qty > 30);

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH li_stats AS (
SELECT l_ord AS k, COUNT(*) AS n
FROM sq_li GROUP BY l_ord)
SELECT COUNT(*), SUM(li_stats.n)
FROM sq_ord AS o JOIN li_stats ON li_stats.k = o.o_id
WHERE EXISTS (SELECT l_id FROM sq_li WHERE l_ord = o.o_id AND l_qty > 30)|
COUNT(*)	SUM(li_stats.n)
1	2


=== Test 4: NOT EXISTS in the main WHERE + CTE join ===
== Query ==
WITH cust_stats AS (
SELECT o_cust AS k, COUNT(*) AS n
FROM sq_ord GROUP BY o_cust)
SELECT COUNT(*), SUM(cust_stats.n)
FROM sq_ord AS o JOIN cust_stats ON cust_stats.k = o.o_cust
WHERE NOT EXISTS (SELECT l_id FROM sq_li WHERE l_ord = o.o_id);

