=== Test 4b: literal NOT(OR-chain) on the pushed join root ===
== Query ==
WITH cust_stats AS (
SELECT o_cust AS k, COUNT(*) AS n
FROM sq_ord GROUP BY o_cust)
SELECT COUNT(*), SUM(cust_stats.n)
FROM sq_ord AS o JOIN cust_stats ON cust_stats.k = o.o_cust
WHERE NOT (o.o_id = 1 OR o.o_id = 2 OR o.o_id = 3 OR o.o_id = 4 OR o.o_id = 5);

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH cust_stats AS (
SELECT o_cust AS k, COUNT(*) AS n
FROM sq_ord GROUP BY o_cust)
SELECT COUNT(*), SUM(cust_stats.n)
FROM sq_ord AS o JOIN cust_stats ON cust_stats.k = o.o_cust
WHERE NOT (o.o_id = 1 OR o.o_id = 2 OR o.o_id = 3 OR o.o_id = 4 OR o.o_id = 5)|
COUNT(*)	SUM(cust_stats.n)
1	2


=== Test 5: explicit IN-subquery in the main WHERE of a CTE join ===
== Query ==
