=== Test 6: GREATEST(c.c_smallint, o.o_threshold) — pair-op path regression ===
== Query ==
SELECT c.c_id, SUM(GREATEST(c.c_smallint, o.o_threshold)) AS g
FROM v5_customer AS c
JOIN v5_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT c.c_id, SUM(GREATEST(c.c_smallint, o.o_threshold)) AS g
FROM v5_customer AS c
JOIN v5_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id|
c_id	g
100	35
200	500
300	20000


=== Test 7: explicit CASE col-vs-col SMALLINT linked vs BIGINT leaf (v2a path) ===
== Query ==
SELECT c.c_id,
SUM(CASE WHEN c.c_smallint >= o.o_threshold THEN o.o_amt
ELSE 0 END) AS g
FROM v5_customer AS c
JOIN v5_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT c.c_id,
SUM(CASE WHEN c.c_smallint >= o.o_threshold THEN o.o_amt
ELSE 0 END) AS g
FROM v5_customer AS c
JOIN v5_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id|
c_id	g
100	0
200	90
300	70
