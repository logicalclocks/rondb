call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");

=== Create tables for typed linked register-load tests ===



=== Test 1: TINYINT signed linked vs BIGINT leaf — negative linked values ===
== Query ==
SELECT c.c_id,
SUM(CASE WHEN c.c_tinyint > o.o_threshold THEN 1 ELSE 0 END) AS s
FROM v5_customer AS c
JOIN v5_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT c.c_id,
SUM(CASE WHEN c.c_tinyint > o.o_threshold THEN 1 ELSE 0 END) AS s
FROM v5_customer AS c
JOIN v5_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id|
c_id	s
100	0
200	0
300	1


=== Test 2: SMALLINT signed linked vs BIGINT leaf — negative linked values ===
== Query ==
SELECT c.c_id,
SUM(CASE WHEN c.c_smallint <= o.o_threshold THEN 1 ELSE 0 END) AS s
FROM v5_customer AS c
JOIN v5_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

