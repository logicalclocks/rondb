=== Test 1: CTE body with equality bound on indexed column ===
== Query ==
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
FROM ix_orders WHERE o_grp = 200 GROUP BY o_grp)
SELECT k, total FROM stats;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
FROM ix_orders WHERE o_grp = 200 GROUP BY o_grp)
SELECT k, total FROM stats|
k	total
200	100


=== Test 2: CTE body with double-bounded range on indexed column ===
== Query ==
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
FROM ix_orders
WHERE o_grp >= 200 AND o_grp <= 300
GROUP BY o_grp)
SELECT k, total FROM stats;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
FROM ix_orders
WHERE o_grp >= 200 AND o_grp <= 300
GROUP BY o_grp)
SELECT k, total FROM stats|
k	total
200	100
300	130


