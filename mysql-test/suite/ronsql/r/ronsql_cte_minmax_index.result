=== Test 4: grouped MAX is not an I.10 scalar body ===
== Query ==
WITH mx AS (SELECT grp AS g, MAX(val) AS m
FROM ix_minmax GROUP BY grp)
SELECT g, m FROM mx;

Number of output lines, including header: 5

== Diff ==
==========



== Expected result ==
WITH mx AS (SELECT grp AS g, MAX(val) AS m
FROM ix_minmax GROUP BY grp)
SELECT g, m FROM mx|
g	m
100	60
200	70
300	90
400	80


=== Test 5: two scalar MIN/MAX CTEs compose through cross join ===
== Query ==
WITH mx AS (SELECT MAX(val) AS max_v FROM ix_minmax),
mn AS (SELECT MIN(val) AS min_v FROM ix_minmax)
SELECT SUM(max_v) AS max_v, SUM(min_v) AS min_v FROM mx, mn;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH mx AS (SELECT MAX(val) AS max_v FROM ix_minmax),
mn AS (SELECT MIN(val) AS min_v FROM ix_minmax)
SELECT SUM(max_v) AS max_v, SUM(min_v) AS min_v FROM mx, mn|
max_v	min_v
90	10


