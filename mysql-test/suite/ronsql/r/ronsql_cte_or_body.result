=== Test 1: pure body OR on one column (TABLE_SCAN + residual OR) ===
== Query ==
WITH s AS (SELECT g AS k, SUM(v) AS tot
FROM orb WHERE g = 10 OR g = 30 GROUP BY g)
SELECT k, tot FROM s;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH s AS (SELECT g AS k, SUM(v) AS tot
FROM orb WHERE g = 10 OR g = 30 GROUP BY g)
SELECT k, tot FROM s|
k	tot
10	45
30	150


=== Test 2: AND + parenthesised OR (g bounds idx_g, OR residual) ===
== Query ==
WITH s AS (SELECT h AS k, SUM(v) AS tot
FROM orb WHERE g = 10 AND (h = 1 OR h = 2) GROUP BY h)
SELECT k, tot FROM s;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH s AS (SELECT h AS k, SUM(v) AS tot
FROM orb WHERE g = 10 AND (h = 1 OR h = 2) GROUP BY h)
SELECT k, tot FROM s|
k	tot
1	5
2	15


