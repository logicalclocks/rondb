SUM(CASE WHEN a.k > 5 THEN a.d ELSE 0 END) AS sum0,
SUM(CASE WHEN a.k > 5 THEN a.d ELSE 1 END) AS sum1,
MIN(CASE WHEN a.k > 5 THEN a.d ELSE 7 END) AS min7,
MAX(CASE WHEN a.k > 5 THEN a.d ELSE -100 END) AS maxm
FROM cat_drv AS x
JOIN cat AS a ON a.g = x.g AND a.id = x.id
GROUP BY x.g|
