=== ca-5: SUM of GREATEST / LEAST over a DOUBLE CTE output ===
== Query ==
WITH s AS (SELECT g, id, MAX(d) AS m FROM cat GROUP BY g, id)
SELECT g,
SUM(GREATEST(m, 5)) AS g_m5,
SUM(GREATEST(5, m)) AS g_5m,
SUM(LEAST(m, 5)) AS l_m5,
SUM(LEAST(5, m)) AS l_5m
FROM s GROUP BY g;

Number of output lines, including header: 5

== Diff ==
==========



== Expected result ==
WITH s AS (SELECT g, id, MAX(d) AS m FROM cat GROUP BY g, id)
SELECT g,
SUM(GREATEST(m, 5)) AS g_m5,
SUM(GREATEST(5, m)) AS g_5m,
SUM(LEAST(m, 5)) AS l_m5,
SUM(LEAST(5, m)) AS l_5m
FROM s GROUP BY g|
g	g_m5	g_5m	l_m5	l_5m
