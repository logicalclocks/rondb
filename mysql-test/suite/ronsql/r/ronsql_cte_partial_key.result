=== Test 1: partial CTE key (1 of 2), inner join — auto-rewritten to CTE_SCAN root ===
== Query ==
WITH pairs AS (SELECT o_custkey AS k, o_amt AS amt, COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey, o_amt)
SELECT c.c_id, SUM(pairs.cnt) AS s
FROM cte_customer AS c
JOIN pairs ON pairs.k = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH pairs AS (SELECT o_custkey AS k, o_amt AS amt, COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey, o_amt)
SELECT c.c_id, SUM(pairs.cnt) AS s
FROM cte_customer AS c
JOIN pairs ON pairs.k = c.c_id
GROUP BY c.c_id|
c_id	s
100	2
200	2
300	1


=== Test 2: partial CTE key, LEFT JOIN on the CTE itself — still I.16a rejects ===
Error handling: RPE
ronsql_cli caught exception: Partial CTE lookup key not supported.  The virtual CTE primary key matches the CTE body's GROUP BY column list and the join must bind every key column.  Workaround: place the multi-key CTE on the joined root and join the smaller table to it.


=== Test 3: 3-table inner chain with multikey CTE in the middle ===
== Query ==
WITH pairs AS (SELECT o_custkey AS k, o_amt AS amt, COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey, o_amt)
SELECT c.c_id, r.r_name, SUM(pairs.cnt) AS s
FROM cte_customer AS c
JOIN pairs ON pairs.k = c.c_id
JOIN cte_region AS r ON r.r_id = c.c_region
GROUP BY c.c_id, r.r_name;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH pairs AS (SELECT o_custkey AS k, o_amt AS amt, COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey, o_amt)
SELECT c.c_id, r.r_name, SUM(pairs.cnt) AS s
FROM cte_customer AS c
JOIN pairs ON pairs.k = c.c_id
JOIN cte_region AS r ON r.r_id = c.c_region
GROUP BY c.c_id, r.r_name|
c_id	r_name	s
100	North	2
200	North	2
300	South	1


=== Test 4: rewrite coexists with LEFT JOIN elsewhere in the chain ===
== Query ==
WITH pairs AS (SELECT o_custkey AS k, o_amt AS amt, COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey, o_amt)
SELECT c.c_id, r.r_name, SUM(pairs.cnt) AS s
FROM cte_customer AS c
JOIN pairs ON pairs.k = c.c_id
LEFT JOIN cte_region AS r ON r.r_id = c.c_region
GROUP BY c.c_id, r.r_name;

