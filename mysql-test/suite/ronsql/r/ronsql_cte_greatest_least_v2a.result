call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");

=== Create tables for col-vs-col CASE / GREATEST tests ===



=== Test 1: GREATEST over two distinct parent-table columns ===
== Query ==
SELECT c.c_id, SUM(GREATEST(c.c_region, c.c_floor)) AS gmax
FROM cte_customer AS c
JOIN cte_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT c.c_id, SUM(GREATEST(c.c_region, c.c_floor)) AS gmax
FROM cte_customer AS c
JOIN cte_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id|
c_id	gmax
100	100
200	120
300	100


