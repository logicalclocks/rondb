=== Create tables for subquery aggregation tests ===


=== Test 1: Single subquery SUM per entity ===
== Query ==
SELECT e.id,
(SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val
FROM sq_entity AS e;

Number of output lines, including header: 5

== Diff ==
==========



== Expected result ==
SELECT e.id,
(SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val
FROM sq_entity AS e|
id	sum_val
1	60
2	150
3	240
4	330


=== Test 2: Two subqueries SUM + COUNT per entity ===
== Query ==
SELECT e.id,
(SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
(SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e;

Number of output lines, including header: 5

== Diff ==
==========



== Expected result ==
SELECT e.id,
(SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
(SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e|
id	sum_val	cnt_evt
1	60	2
2	150	2
3	240	2
4	330	2


=== Test 3: Three subqueries SUM + COUNT + MAX per entity ===
== Query ==
SELECT e.id,
(SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
(SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt,
(SELECT MAX(ev2.event_type) FROM sq_events AS ev2 WHERE ev2.entity_id = e.id) AS max_evt
FROM sq_entity AS e;

Number of output lines, including header: 5

== Diff ==
==========



== Expected result ==
SELECT e.id,
(SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
(SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt,
(SELECT MAX(ev2.event_type) FROM sq_events AS ev2 WHERE ev2.entity_id = e.id) AS max_evt
FROM sq_entity AS e|
id	sum_val	cnt_evt	max_evt
