=== Test 23: NOT EXISTS with outer filter ===
custkey = 200 AND no high-qty lineitems: only order 4
== Query ==
SELECT o_id, SUM(o_total)
FROM orders
WHERE o_custkey = 200
AND NOT EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 20)
GROUP BY o_id;

