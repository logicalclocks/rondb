=== Test 3: grouped CTE direct projection over string MIN/MAX ===
== Query ==
WITH s AS (
SELECT grp, MIN(v) AS min_v, MAX(v) AS max_v,
MIN(c) AS min_c, MAX(c) AS max_c,
MIN(lv) AS min_lv, MAX(lv) AS max_lv
FROM str_minmax
GROUP BY grp)
SELECT grp, min_v, max_v, min_c, max_c, min_lv, max_lv
FROM s;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH s AS (
SELECT grp, MIN(v) AS min_v, MAX(v) AS max_v,
MIN(c) AS min_c, MAX(c) AS max_c,
MIN(lv) AS min_lv, MAX(lv) AS max_lv
FROM str_minmax
GROUP BY grp)
SELECT grp, min_v, max_v, min_c, max_c, min_lv, max_lv
FROM s|
grp	min_v	max_v	min_c	max_c	min_lv	max_lv
10	alpha	delta	aa	dd	long-alpha	long-delta
20		echo	bb	ee		long-echo
30	NULL	NULL	NULL	NULL	NULL	NULL


=== Test 4: re-aggregate string CTE output through linked attrs ===
== Query ==
WITH s AS (
SELECT grp, MIN(v) AS min_v, MAX(v) AS max_v
FROM str_minmax
GROUP BY grp)
SELECT MIN(s.min_v) AS min_v, MAX(s.max_v) AS max_v
FROM s
JOIN str_groups AS g ON g.grp = s.grp;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH s AS (
SELECT grp, MIN(v) AS min_v, MAX(v) AS max_v
FROM str_minmax
GROUP BY grp)
SELECT MIN(s.min_v) AS min_v, MAX(s.max_v) AS max_v
FROM s
JOIN str_groups AS g ON g.grp = s.grp|
min_v	max_v
	echo


=== Test 5: filter on string CTE output ===
== Query ==
WITH s AS (
SELECT grp, MIN(v) AS min_v, MAX(v) AS max_v
FROM str_minmax
GROUP BY grp)
SELECT grp, min_v, max_v
FROM s
WHERE min_v < 'beta';

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH s AS (
SELECT grp, MIN(v) AS min_v, MAX(v) AS max_v
FROM str_minmax
GROUP BY grp)
SELECT grp, min_v, max_v
FROM s
WHERE min_v < 'beta'|
grp	min_v	max_v
10	alpha	delta
20		echo

=== Cleanup ===
DROP TABLE str_minmax;
DROP TABLE str_groups;
