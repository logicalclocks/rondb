=== Create tables for string MIN/MAX printer tests ===



=== Test 1: scalar MIN/MAX over VARCHAR, CHAR and Longvarchar ===
== Query ==
SELECT MIN(v) AS min_v, MAX(v) AS max_v,
MIN(c) AS min_c, MAX(c) AS max_c,
MIN(lv) AS min_lv, MAX(lv) AS max_lv
FROM str_minmax;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
SELECT MIN(v) AS min_v, MAX(v) AS max_v,
MIN(c) AS min_c, MAX(c) AS max_c,
MIN(lv) AS min_lv, MAX(lv) AS max_lv
FROM str_minmax|
min_v	max_v	min_c	max_c	min_lv	max_lv
	echo	aa	ee		long-echo


=== Test 2: grouped MIN/MAX over VARCHAR, CHAR and Longvarchar ===
== Query ==
SELECT grp, MIN(v) AS min_v, MAX(v) AS max_v,
MIN(c) AS min_c, MAX(c) AS max_c,
MIN(lv) AS min_lv, MAX(lv) AS max_lv
FROM str_minmax
GROUP BY grp;

