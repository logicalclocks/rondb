=== Test 4: scalar CTE with MIN + MAX + SUM + COUNT ===
== Query ==
WITH s AS (SELECT MIN(v) AS lo, MAX(v) AS hi,
SUM(v) AS total, COUNT(*) AS n
FROM scalar_t)
SELECT lo, hi, total, n FROM s;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH s AS (SELECT MIN(v) AS lo, MAX(v) AS hi,
SUM(v) AS total, COUNT(*) AS n
FROM scalar_t)
SELECT lo, hi, total, n FROM s|
lo	hi	total	n
10	100	210	5


