============================================================
= Chained LEFT JOIN aggregation tests for RonSQL
= These mirror the NDB API tests in testMultiOuterJoinAggNdbApi
============================================================



=== Test 1: 3-way LEFT JOIN with COUNT and SUM ===
== Query ==
SELECT d.dname, COUNT(*), SUM(t.hours)
FROM dept3 AS d
LEFT JOIN emp3 AS e ON e.dept_id = d.id
LEFT JOIN task3 AS t ON t.emp_id = e.dept_id
GROUP BY d.dname;

Number of output lines, including header: 6

== Diff ==
==========



== Expected result ==
SELECT d.dname, COUNT(*), SUM(t.hours)
FROM dept3 AS d
LEFT JOIN emp3 AS e ON e.dept_id = d.id
LEFT JOIN task3 AS t ON t.emp_id = e.dept_id
GROUP BY d.dname|
dname	COUNT(*)	SUM(t.hours)
10	1	8
20	1	12
30	1	NULL
40	1	NULL
50	1	NULL


