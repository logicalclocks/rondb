=== Test 4: 4-way mixed LEFT+INNER+LEFT join ===
== Query ==
SELECT r.area, COUNT(*), SUM(v.rating)
FROM region4 AS r
LEFT JOIN store4 AS s ON s.region_id = r.id
JOIN product4 AS p ON p.store_id = s.region_id
LEFT JOIN review4 AS v ON v.product_id = p.store_id
GROUP BY r.area;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT r.area, COUNT(*), SUM(v.rating)
FROM region4 AS r
LEFT JOIN store4 AS s ON s.region_id = r.id
JOIN product4 AS p ON p.store_id = s.region_id
LEFT JOIN review4 AS v ON v.product_id = p.store_id
GROUP BY r.area|
area	COUNT(*)	SUM(v.rating)
100	1	5
200	1	3
300	1	NULL


=== Test 5: 5-way deep LEFT JOIN chain ===
== Query ==
SELECT r.grp, COUNT(*), SUM(d.hours)
FROM root5 AS r
LEFT JOIN a5 AS a ON a.root_id = r.id
LEFT JOIN b5 AS b ON b.a_id = a.root_id
LEFT JOIN c5 AS c ON c.b_id = b.a_id
LEFT JOIN d5 AS d ON d.c_id = c.b_id
GROUP BY r.grp;

Number of output lines, including header: 7

== Diff ==
==========



== Expected result ==
SELECT r.grp, COUNT(*), SUM(d.hours)
FROM root5 AS r
LEFT JOIN a5 AS a ON a.root_id = r.id
LEFT JOIN b5 AS b ON b.a_id = a.root_id
LEFT JOIN c5 AS c ON c.b_id = b.a_id
LEFT JOIN d5 AS d ON d.c_id = c.b_id
GROUP BY r.grp|
grp	COUNT(*)	SUM(d.hours)
10	1	100
20	1	NULL
30	1	NULL
40	1	NULL
50	1	NULL
60	1	NULL


