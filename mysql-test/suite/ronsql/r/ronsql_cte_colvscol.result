=== Create tables for CTE col-vs-col tests ===



=== Test 1: col-vs-col `>` between two Bigint aggregates (SUM > MIN) ===
== Query ==
WITH stats AS (
SELECT o_custkey AS k,
SUM(o_amt) AS gross,
MIN(o_amt) AS lo,
MAX(o_amt) AS hi
FROM cte_orders GROUP BY o_custkey)
SELECT stats.k, SUM(stats.gross)
FROM cte_customer AS c
JOIN stats ON stats.k = c.c_id
WHERE stats.gross > stats.lo
GROUP BY stats.k;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH stats AS (
SELECT o_custkey AS k,
SUM(o_amt) AS gross,
MIN(o_amt) AS lo,
MAX(o_amt) AS hi
FROM cte_orders GROUP BY o_custkey)
SELECT stats.k, SUM(stats.gross)
FROM cte_customer AS c
JOIN stats ON stats.k = c.c_id
WHERE stats.gross > stats.lo
GROUP BY stats.k|
k	SUM(stats.gross)
100	120
200	80


=== Test 2: col-vs-col `!=` (MIN != MAX) ===
== Query ==
WITH stats AS (
SELECT o_custkey AS k,
SUM(o_amt) AS gross,
MIN(o_amt) AS lo,
MAX(o_amt) AS hi
FROM cte_orders GROUP BY o_custkey)
SELECT stats.k, SUM(stats.gross)
FROM cte_customer AS c
JOIN stats ON stats.k = c.c_id
WHERE stats.lo != stats.hi
GROUP BY stats.k;

