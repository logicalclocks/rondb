=== Test 9: mixed-signedness col-vs-col (Bigint SUM vs Bigunsigned COUNT) ===
== Query ==
WITH stats AS (
SELECT o_custkey AS k,
SUM(o_amt) AS gross,
COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey)
SELECT stats.k, SUM(stats.gross)
FROM cte_customer AS c
JOIN stats ON stats.k = c.c_id
WHERE stats.gross > stats.cnt
GROUP BY stats.k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH stats AS (
SELECT o_custkey AS k,
SUM(o_amt) AS gross,
COUNT(*) AS cnt
FROM cte_orders GROUP BY o_custkey)
SELECT stats.k, SUM(stats.gross)
FROM cte_customer AS c
JOIN stats ON stats.k = c.c_id
WHERE stats.gross > stats.cnt
GROUP BY stats.k|
k	SUM(stats.gross)
