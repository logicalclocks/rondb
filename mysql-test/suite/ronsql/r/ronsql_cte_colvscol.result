=== Test 4: DNF — col-vs-col OR col-vs-const ===
== Query ==
WITH stats AS (
SELECT o_custkey AS k,
SUM(o_amt) AS gross,
MIN(o_amt) AS lo
FROM cte_orders GROUP BY o_custkey)
SELECT stats.k, SUM(stats.gross)
FROM cte_customer AS c
JOIN stats ON stats.k = c.c_id
WHERE stats.gross = stats.lo OR stats.k = 100
GROUP BY stats.k;

