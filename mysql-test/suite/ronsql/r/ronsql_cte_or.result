=== Create tables for CTE OR/DNF tests ===



=== Test 1: 2-disjunct OR on GB column (mem-opcode path) ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.k = 100 OR sums.k = 300
GROUP BY sums.k;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.k = 100 OR sums.k = 300
GROUP BY sums.k|
k	SUM(sums.t)
100	125
300	90


