=== Test 1: two-column equality bound (a = 1 AND b = 2) ===
== Query ==
WITH stats AS (SELECT b AS k, SUM(amt) AS total
FROM ix_co WHERE a = 1 AND b = 2 GROUP BY b)
SELECT k, total FROM stats;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH stats AS (SELECT b AS k, SUM(amt) AS total
FROM ix_co WHERE a = 1 AND b = 2 GROUP BY b)
SELECT k, total FROM stats|
k	total
2	30


=== Test 2: equality + double-bounded range (a = 1 AND 2 <= b <= 4) ===
== Query ==
WITH stats AS (SELECT b AS k, SUM(amt) AS total
FROM ix_co
WHERE a = 1 AND b >= 2 AND b <= 4
GROUP BY b)
SELECT k, total FROM stats;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH stats AS (SELECT b AS k, SUM(amt) AS total
FROM ix_co
WHERE a = 1 AND b >= 2 AND b <= 4
GROUP BY b)
SELECT k, total FROM stats|
k	total
2	30
3	30
4	40


