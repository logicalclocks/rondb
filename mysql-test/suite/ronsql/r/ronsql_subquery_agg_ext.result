=== A1: WHERE e.grp = 1 (equality filter on root) ===
== Query ==
SELECT e.id,
(SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
(SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.grp = 1;

Number of output lines, including header: 3

== Diff ==
==========



== Expected result ==
SELECT e.id,
(SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
(SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.grp = 1|
id	sum_val	cnt_evt
