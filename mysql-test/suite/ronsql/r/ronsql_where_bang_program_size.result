=== bg-13: join, ! on the joined table ===
== Query ==
SELECT t.g AS g, COUNT(*) AS n, SUM(t.b) AS s
FROM bt AS t JOIN bj AS j ON j.g = t.g
WHERE !(j.w > 10)
GROUP BY t.g;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
SELECT t.g AS g, COUNT(*) AS n, SUM(t.b) AS s
FROM bt AS t JOIN bj AS j ON j.g = t.g
WHERE !(j.w > 10)
GROUP BY t.g|
g	n	s
1	3	30

