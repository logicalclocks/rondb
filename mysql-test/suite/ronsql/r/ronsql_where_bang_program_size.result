=== bg-15: ! in a CTE body WHERE ===
== Query ==
WITH cb AS (SELECT g AS k, COUNT(*) AS n, SUM(b) AS s
FROM bt WHERE !(a = 1 OR b IS NULL) GROUP BY g)
SELECT k, n, s FROM cb;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH cb AS (SELECT g AS k, COUNT(*) AS n, SUM(b) AS s
FROM bt WHERE !(a = 1 OR b IS NULL) GROUP BY g)
SELECT k, n, s FROM cb|
k	n	s
1	1	20
2	1	30
3	2	60

