=== rr-3: main GROUP BY p, g, one c2 row per main group ===
== Query ==
WITH c1 AS (
SELECT p, g, k, MIN(v) AS mnv, MAX(v) AS mxv, MIN(c) AS mnc, MAX(c) AS mxc
FROM rr_t GROUP BY p, g, k ORDER BY p, g, k LIMIT 1000),
c2 AS (
SELECT p, g, MIN(mnv) AS mnv2, MAX(mxv) AS mxv2,
MIN(mnc) AS mnc2, MAX(mxc) AS mxc2
FROM c1 GROUP BY p, g)
SELECT p, g, MIN(mnv2) AS lov, MAX(mxv2) AS hiv,
MIN(mnc2) AS loc, MAX(mxc2) AS hic
FROM c2 GROUP BY p, g;

