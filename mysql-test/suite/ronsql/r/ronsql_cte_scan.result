=== Create tables for CTE scan tests ===


=== Test 1 (E.1): main GB on CTE_SCAN root col + agg ===
== Query ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT k, SUM(t) FROM sums GROUP BY k;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
WITH sums AS (
SELECT o_custkey AS k, SUM(o_amt) AS t
FROM cte_orders GROUP BY o_custkey)
SELECT k, SUM(t) FROM sums GROUP BY k|
k	SUM(t)
100	125
200	100
300	90


