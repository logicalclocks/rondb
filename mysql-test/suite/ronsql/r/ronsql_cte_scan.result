300	90


=== Test 9 (E.2): chained CTE with WHERE filter on the intermediate ===
== Query ==
WITH a AS (
SELECT o_custkey AS k, SUM(o_amt) AS s
FROM cte_orders GROUP BY o_custkey),
b AS (
SELECT k, MAX(s) AS m
FROM a WHERE s > 100 GROUP BY k)
SELECT k, SUM(m) FROM b GROUP BY k;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH a AS (
SELECT o_custkey AS k, SUM(o_amt) AS s
FROM cte_orders GROUP BY o_custkey),
b AS (
SELECT k, MAX(s) AS m
FROM a WHERE s > 100 GROUP BY k)
SELECT k, SUM(m) FROM b GROUP BY k|
k	SUM(m)
100	125

