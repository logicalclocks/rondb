=== Test 16: CTE projection + join mixed aggregate ===
== Query ==
WITH n AS (
SELECT c_id AS k, MAX(c_floor) AS a
FROM v4_customer GROUP BY c_id)
SELECT SUM(GREATEST(n.a, 30)) AS g,
COUNT(*) AS rows_seen
FROM v4_customer AS c
JOIN n ON n.k = c.c_id;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH n AS (
SELECT c_id AS k, MAX(c_floor) AS a
FROM v4_customer GROUP BY c_id)
SELECT SUM(GREATEST(n.a, 30)) AS g,
COUNT(*) AS rows_seen
FROM v4_customer AS c
JOIN n ON n.k = c.c_id|
g	rows_seen
170	3
