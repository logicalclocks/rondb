=== Test 8: regression — NOT NULL fixture, output identical to v2b path ===
== Query ==
SELECT o_custkey, SUM(GREATEST(o_amt, 50)) AS g
FROM v4_orders GROUP BY o_custkey;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT o_custkey, SUM(GREATEST(o_amt, 50)) AS g
FROM v4_orders GROUP BY o_custkey|
o_custkey	g
100	130
200	140
300	70


=== Test 9: join + linked nullable parent column ===
== Query ==
SELECT c.c_id, SUM(GREATEST(c.c_floor, o.o_amt)) AS g
FROM v4_customer AS c
JOIN v4_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT c.c_id, SUM(GREATEST(c.c_floor, o.o_amt)) AS g
FROM v4_customer AS c
JOIN v4_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id|
c_id	g
100	130
200	NULL
300	120


=== Test 10: CTE-scope — nullable operand inside CTE-body aggregator ===
== Query ==
WITH s AS (
SELECT o_custkey AS k, MAX(o_amt) AS t
FROM v4_orders GROUP BY o_custkey)
SELECT SUM(GREATEST(s.t, 60, 100)) AS g
FROM v4_customer AS c
JOIN s ON s.k = c.c_id;

Number of output lines, including header: 2

== Diff ==
==========



== Expected result ==
WITH s AS (
SELECT o_custkey AS k, MAX(o_amt) AS t
FROM v4_orders GROUP BY o_custkey)
SELECT SUM(GREATEST(s.t, 60, 100)) AS g
FROM v4_customer AS c
JOIN s ON s.k = c.c_id|
g
300


