==============
Generate data:
==============
CREATE TABLE tbl (
pk INT          PRIMARY KEY AUTO_INCREMENT,
d  DATE         NOT NULL,
dt DATETIME(6)  NOT NULL,
ts TIMESTAMP(3) NOT NULL
) ENGINE=NDB;
INSERT INTO tbl (d, dt, ts) VALUES ('2025-11-24', '2025-11-24 11:47:03.000000', '2025-11-24 11:47:03.000000');
INSERT INTO tbl (d, dt, ts) SELECT d, DATE_ADD(dt, INTERVAL 1 MICROSECOND), DATE_ADD(ts, INTERVAL 1 MICROSECOND) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT d, DATE_ADD(dt, INTERVAL 1000 MICROSECOND), DATE_ADD(ts, INTERVAL 1000 MICROSECOND) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT d, DATE_ADD(dt, INTERVAL 1 SECOND), DATE_ADD(ts, INTERVAL 1 SECOND) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT d, DATE_ADD(dt, INTERVAL 1 MINUTE), DATE_ADD(ts, INTERVAL 1 MINUTE) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT d, DATE_ADD(dt, INTERVAL 1 HOUR), DATE_ADD(ts, INTERVAL 1 HOUR) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT DATE_ADD(d, INTERVAL 1 DAY), DATE_ADD(dt, INTERVAL 1 DAY), DATE_ADD(ts, INTERVAL 1 DAY) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT DATE_ADD(d, INTERVAL 1 WEEK), DATE_ADD(dt, INTERVAL 1 WEEK), DATE_ADD(ts, INTERVAL 1 WEEK) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT DATE_ADD(d, INTERVAL 1 MONTH), DATE_ADD(dt, INTERVAL 1 MONTH), DATE_ADD(ts, INTERVAL 1 MONTH) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT DATE_ADD(d, INTERVAL 1 QUARTER), DATE_ADD(dt, INTERVAL 1 QUARTER), DATE_ADD(ts, INTERVAL 1 QUARTER) FROM tbl ORDER BY pk;
INSERT INTO tbl (d, dt, ts) SELECT DATE_ADD(d, INTERVAL 1 YEAR), DATE_ADD(dt, INTERVAL 1 YEAR), DATE_ADD(ts, INTERVAL 1 YEAR) FROM tbl ORDER BY pk;
