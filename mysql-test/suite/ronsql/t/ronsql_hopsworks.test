--echo # vim: set fileencoding=utf-8 : -*- coding: utf-8 -*-
--source include/have_ndb.inc
--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# For speed, RonSQL runs through RDRS only here: ronsql_hopsworks.pl makes
# 402 comparisons with mysqld (every type in every role), as many again in
# the ronsql_jit mirror, and the CLI arm of ronsql_compare.inc would start
# a ronsql_cli process with its own cluster connection for each.
# ronsql_cli and RDRS run the same executor and printer; the CLI arm
# compares them in the other tests of the suite.
--let $suppress_ronsql_cli=yes

--disable_query_log
SET time_zone = "+00:00";
--let RAND_SEED=123
--let NUM_ROWS=200
--let TEST_INC_FILE=$MYSQLTEST_VARDIR/tmp/ronsql_hopsworks_gen.inc
--exec perl $MYSQL_TEST_DIR/suite/ronsql/t/ronsql_hopsworks.pl
--enable_query_log
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/ronsql-explain.out

# The DECIMAL aggregates the data nodes compute as doubles (Q-6) are
# asserted against their known diffs (suite/ronsql/known_diffs, see
# ronsql_hopsworks.pl); remove them when the data nodes send DECIMALs.
--source $TEST_INC_FILE

--disable_query_log
--remove_file $TEST_INC_FILE
--enable_query_log
