--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# Phase I.9: scanIndex inside a CTE materialisation subtree.
#
# testCteNdbApi.cpp Test 18 demonstrates the kernel + NDB API
# accept scanIndex as the materialisation root inside
# beginCteSubtree...endCteSubtree.  This MTR exercises the SQL
# trigger: a CTE body with WHERE bounds on an ordered indexed
# column, which RonSQL now plans as INDEX_SCAN + bounds instead
# of TABLE_SCAN + InterpretedCode filter.
#
# The plan/emit pipeline:
#   - select_cte_body_scan_config picks an ordered index whose
#     leading column matches a bound conjunct.
#   - The single-op CTE-body emit branch (INDEX_SCAN) routes
#     bound conjuncts to NdbQueryIndexBound and residual conjuncts
#     to the InterpretedCode filter.
#   - The readTuple(linked_pk) agg-leaf is unchanged from the
#     TABLE_SCAN branch; the aggregator runs on the leaf as
#     before.
#
# Tests cover:
#   1. Single equality bound on indexed column.
#   2. Range bound (BETWEEN-equivalent: col >= x AND col <= y).
#   3. Half-open bound (col > x), residual filter on a non-indexed
#      column composed in the same CTE body.
#   4. CTE body with no WHERE — must still produce a valid CTE
#      via the existing TABLE_SCAN branch (regression).

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--disable_query_log
--disable_warnings

CREATE TABLE ix_orders (
  o_id      INT NOT NULL,
  o_grp     BIGINT NOT NULL,
  o_amt     BIGINT NOT NULL,
  PRIMARY KEY USING HASH (o_id),
  INDEX idx_grp (o_grp),
  INDEX idx_amt (o_amt)
) ENGINE=NDB;

INSERT INTO ix_orders VALUES
  (1, 100,  50),
  (2, 100,  60),
  (3, 200,  30),
  (4, 200,  70),
  (5, 300,  40),
  (6, 300,  90),
  (7, 400,  10),
  (8, 400,  80);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo
--echo === Test 1: CTE body with equality bound on indexed column ===

# CTE body filters o_grp = 200 via idx_grp.  Aggregator runs
# only on the matched rows.  Equivalent of testCteNdbApi.cpp
# Test 18's scanIndex-in-subtree shape, with a bound.
let $QUERY=
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
                FROM ix_orders WHERE o_grp = 200 GROUP BY o_grp)
SELECT k, total FROM stats;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
                FROM ix_orders WHERE o_grp = 200 GROUP BY o_grp)
SELECT k, total FROM stats|

--echo
--echo
--echo === Test 2: CTE body with double-bounded range on indexed column ===

# Range on idx_grp (200 <= o_grp <= 300).  Both bounds are
# captured by the index.  Aggregator runs on the matching subset.
let $QUERY=
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
                FROM ix_orders
                WHERE o_grp >= 200 AND o_grp <= 300
                GROUP BY o_grp)
SELECT k, total FROM stats;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
                FROM ix_orders
                WHERE o_grp >= 200 AND o_grp <= 300
                GROUP BY o_grp)
SELECT k, total FROM stats|

--echo
--echo
--echo === Test 3: half-open index bound + residual filter on another column ===

# o_grp > 200 captured by idx_grp; o_amt > 30 stays in the
# residual InterpretedCode filter (no compatible index match
# on the LEADING column once the o_grp scoring beats idx_amt's).
let $QUERY=
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
                FROM ix_orders
                WHERE o_grp > 200 AND o_amt > 30
                GROUP BY o_grp)
SELECT k, total FROM stats;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
                FROM ix_orders
                WHERE o_grp > 200 AND o_amt > 30
                GROUP BY o_grp)
SELECT k, total FROM stats|

--echo
--echo
--echo === Test 4: CTE body with no WHERE — TABLE_SCAN regression ===

# No WHERE → select_cte_body_scan_config short-circuits and the
# existing TABLE_SCAN single-op branch handles the body.  Verify
# the new code path doesn't regress this baseline shape.
let $QUERY=
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
                FROM ix_orders GROUP BY o_grp)
SELECT k, total FROM stats;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH stats AS (SELECT o_grp AS k, SUM(o_amt) AS total
                FROM ix_orders GROUP BY o_grp)
SELECT k, total FROM stats|

DELIMITER ;|

# C5 follow-up: only two raw AND conjuncts, but De Morgan expansion
# produces 63/64/65. The old pending-node stack could hold 64 entries:
# the left-associated shape reaches that boundary; right/balanced controls
# have the same term count with much less pending work.
#
# Cases 1-3: 63/64/65 terms, left-associated, FORCE idx_grp.
# Cases 4-5: 65 terms, right-associated / balanced, FORCE idx_grp.
# Case 6:   65 terms, left-associated, no hint.
# Case 7:   65 terms, left-associated, USE idx_amt (table-scan fallback).
# Cases 8-10: 63/64/65 terms, left-associated, FORCE idx_amt (unusable).
# Case 11:  65 terms, left-associated, FORCE a missing index.
#
# Prefix OR atoms cannot match any fixture row. The final OR atom excludes
# order 8, while the separate index bound excludes group 100.
# Every successful case must return (200,100), (300,130), (400,10).
--let RONSQL_CTE_BOOLEAN_DIR=$MYSQL_TMP_DIR
--perl
use strict;
use warnings;
use File::Spec;

sub build_balanced_or {
  my (@terms) = @_;
  return $terms[0] if @terms == 1;
  my $mid = int(@terms / 2);
  return '(' . build_balanced_or(@terms[0 .. $mid - 1]) . ' OR ' .
         build_balanced_or(@terms[$mid .. $#terms]) . ')';
}

sub build_or_predicate {
  my ($shape, @terms) = @_;
  return join(' OR ', @terms) if $shape eq 'left';
  return build_balanced_or(@terms) if $shape eq 'balanced';
  die "Unknown OR shape: $shape\n" unless $shape eq 'right';
  my $predicate = pop @terms;
  while (@terms) {
    my $term = pop @terms;
    $predicate = "$term OR ($predicate)";
  }
  return $predicate;
}

my @cases = (
  [63, 'left',     'FORCE INDEX (idx_grp)'],
  [64, 'left',     'FORCE INDEX (idx_grp)'],
  [65, 'left',     'FORCE INDEX (idx_grp)'],
  [65, 'right',    'FORCE INDEX (idx_grp)'],
  [65, 'balanced', 'FORCE INDEX (idx_grp)'],
  [65, 'left',     ''],
  [65, 'left',     'USE INDEX (idx_amt)'],
  [63, 'left',     'FORCE INDEX (idx_amt)'],
  [64, 'left',     'FORCE INDEX (idx_amt)'],
  [65, 'left',     'FORCE INDEX (idx_amt)'],
  [65, 'left',     'FORCE INDEX (no_such_idx)']
);
for my $case_index (0 .. $#cases) {
  my ($conjunct_count, $shape, $hint) = @{$cases[$case_index]};
  my @terms = map { "o_id = $_" } (101 .. (98 + $conjunct_count));
  push @terms, 'o_id = 8';
  my $predicate = build_or_predicate($shape, @terms);
  my $or_count = 0;
  $predicate =~ s/ OR /++$or_count % 4 == 0 ? " OR\n      " : " OR "/ge;
  my $from = 'ix_orders';
  $from .= " $hint" if length $hint;
  my $case_number = $case_index + 1;
  my $path = File::Spec->catfile($ENV{RONSQL_CTE_BOOLEAN_DIR},
                                "ronsql-cte-boolean-$case_number.sql");
  open my $out, '>', $path or die "Cannot write $path: $!\n";
  print {$out} "WITH stats AS (\n",
              "  SELECT o_grp AS k, SUM(o_amt) AS total\n",
              "  FROM $from\n",
              "  WHERE NOT ($predicate)\n",
              "    AND o_grp >= 200\n",
              "  GROUP BY o_grp)\n",
              "SELECT k, total FROM stats;\n"
    or die "Cannot write $path: $!\n";
  close $out or die "Cannot close $path: $!\n";
}
EOF
--let RONSQL_CTE_BOOLEAN_DIR=
--let $QUERY=
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/ronsql-cte-boolean-explain.out

# Check the access path as well as the rows: an unintended table scan can
# still return the correct result. Each include removes its input SQL file.
--let $cte_boolean_case=1
while ($cte_boolean_case <= 7)
{
  --echo
  --echo === CTE Boolean collection case $cte_boolean_case ===
  --let $QUERY_FILE=$MYSQL_TMP_DIR/ronsql-cte-boolean-$cte_boolean_case.sql
  --copy_file $QUERY_FILE $MYSQL_TMP_DIR/ronsql-cte-boolean-compare.sql
  --source suite/ronsql/include/ronsql_explain.inc
  if ($cte_boolean_case < 7)
  {
    --exec grep -qF 'Body root: INDEX_SCAN using idx_grp' $EXPLAIN_FILE
  }
  if ($cte_boolean_case == 7)
  {
    --exec grep -qF 'Body root: TABLE_SCAN' $EXPLAIN_FILE
  }
  --remove_file $EXPLAIN_FILE
  --let $QUERY_FILE=$MYSQL_TMP_DIR/ronsql-cte-boolean-compare.sql
  --source suite/ronsql/include/ronsql_compare.inc
  inc $cte_boolean_case;
}

# An unusable FORCE hint must fail on both sides of the old boundary.
while ($cte_boolean_case <= 10)
{
  --echo
  --echo === CTE Boolean collection case $cte_boolean_case: unusable FORCE INDEX ===
  --error 1
  --exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test --execute-file '$MYSQL_TMP_DIR/ronsql-cte-boolean-$cte_boolean_case.sql' 2>&1
  --remove_file $MYSQL_TMP_DIR/ronsql-cte-boolean-$cte_boolean_case.sql
  inc $cte_boolean_case;
}

--echo
--echo === CTE Boolean collection case 11: missing FORCE INDEX ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test --execute-file '$MYSQL_TMP_DIR/ronsql-cte-boolean-11.sql' 2>&1
--remove_file $MYSQL_TMP_DIR/ronsql-cte-boolean-11.sql
--let $QUERY_FILE=
--let $EXPLAIN_FILE=

--disable_query_log
DROP TABLE ix_orders;
--enable_query_log
