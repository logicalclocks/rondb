--source include/have_ndb.inc
--source include/have_rdrs2.inc

--disable_query_log
--disable_warnings
CREATE TABLE ronsql_oom_values (
  id INT NOT NULL,
  amount DECIMAL(10,2) NOT NULL,
  unsigned_amount DECIMAL(10,2) UNSIGNED NOT NULL,
  PRIMARY KEY USING HASH (id),
  KEY amount_idx (amount)
) ENGINE=NDB;
--enable_warnings
INSERT INTO ronsql_oom_values VALUES
  (1, -12.00, 12.00), (2, 12.50, 12.50), (3, 1.10, 1.10);

perl END_OF_PERL;
use strict;
use warnings;
use File::Spec;
use POSIX qw(_exit);

my $bindir = $ENV{MYSQL_BINDIR} // $ENV{MYSQL_BASEDIR};
die "Missing MYSQL_BINDIR/MYSQL_BASEDIR\n" unless defined $bindir;
my @candidates;
for my $dir ('runtime_output_directory', 'bin') {
  for my $config ('', 'Release', 'RelWithDebInfo', 'Debug') {
    push @candidates, File::Spec->catfile(
        $bindir, $dir, $config, 'ronsql_oom_test');
  }
}
my ($exe) = grep { -x $_ } @candidates;
die "ronsql_oom_test not found; rebuild the test driver\n" unless defined $exe;

# Retain diagnostics in the log directory. MTR checks that temporary
# directory contents are restored after each test.
my $vardir = $ENV{MYSQLTEST_VARDIR} // die "Missing MYSQLTEST_VARDIR\n";
my $log_dir = File::Spec->catdir($vardir, 'log');
my $log = File::Spec->catfile($log_dir, 'ronsql_oom.output.log');
my $xml = File::Spec->catfile($log_dir, 'ronsql_oom.xml');
unlink $xml or die "Cannot remove old $xml: $!\n" if -e $xml;

sub read_file {
  my ($path) = @_;
  open my $fh, '<', $path or die "Cannot read $path: $!\n";
  local $/;
  return <$fh> // '';
}
sub fail_run {
  my ($reason) = @_;
  print read_file($log) if -f $log;
  die "$reason\nFull output: $log\n";
}

# List-form exec avoids shell quoting; inspect the entire wait status so a
# signal death cannot be mistaken for an exit code of zero.
my $pid = fork();
die "fork failed: $!\n" unless defined $pid;
if ($pid == 0) {
  delete @ENV{qw(GTEST_TOTAL_SHARDS GTEST_SHARD_INDEX GTEST_SHARD_STATUS_FILE)};
  open STDIN, '<', '/dev/null' or _exit(126);
  open STDOUT, '>', $log or _exit(126);
  open STDERR, '>&', STDOUT or _exit(126);
  exec {$exe} $exe, '--gtest_filter=*', '--gtest_repeat=1',
      '--gtest_color=no', "--gtest_output=xml:$xml" or _exit(127);
}
waitpid($pid, 0) == $pid or die "waitpid failed: $!\n";
my $status = $?;
fail_run("ronsql_oom_test failed (wait status $status)") if $status != 0;
fail_run("Missing gtest XML report") unless -f $xml;
my $report = read_file($xml);
my @cases = $report =~ /<testcase\b[^>]*>/g;
my $completed = grep { /\bstatus="run"/ && /\bresult="completed"/ } @cases;
fail_run("Expected all 40 or more regression tests to complete")
    unless @cases >= 40 && $completed == @cases;
for my $suite ('EntryPoints/RonSQLParserAllocationFailure',
               'RonSQLParserListStack',
               'RonSQLParseOnlyInventory', 'RonSQLParseOnlyRejection',
               'RonSQLDecimalParseOnly', 'RonSQLDecimalAllocationFailure') {
  fail_run("Missing test suite $suite")
      unless $report =~ /<testsuite\b[^>]*\bname="\Q$suite\E"/;
}
# Remove the driver output only on success; on failure it is kept for
# diagnosis. Leaving it behind would fail MTR's check-testcase.
for my $path ($xml, $log) {
  unlink $path or die "Cannot remove $path: $!\n";
}
print "RonSQL allocation fault-injection: PASS\n";
END_OF_PERL

DROP TABLE ronsql_oom_values;
--enable_query_log
