--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# Phase I.4: CASE with a CTE column in the condition.
# Lifts generate_embedded_condition's parent-only restriction: it now
# resolves the column descriptor via cteVirtualTables when the
# condition references a CTE_LOOKUP / CTE_SCAN parent COLUMN
# projection.  CTE AGGREGATE outputs in the condition stay rejected
# (would need BRANCH_MEM_OP_ARG_INLINE_TYPE; deferred).

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--echo
--echo === Create tables for CTE CASE tests ===
--echo

--disable_query_log
--disable_warnings

CREATE TABLE cte_orders (
  o_id INT NOT NULL,
  o_custkey INT NOT NULL,
  o_amt INT NOT NULL,
  PRIMARY KEY USING HASH (o_id)
) ENGINE=NDB;

CREATE INDEX idx_o_custkey ON cte_orders (o_custkey);

CREATE TABLE cte_customer (
  c_id INT NOT NULL,
  c_name VARCHAR(20) NOT NULL,
  c_region INT NOT NULL,
  PRIMARY KEY USING HASH (c_id)
) ENGINE=NDB;

INSERT INTO cte_customer VALUES
  (100, 'Alice',   1),
  (200, 'Bob',     1),
  (300, 'Charlie', 2),
  (400, 'Dave',    2);

INSERT INTO cte_orders VALUES
  (1, 100, 50),
  (2, 100, 75),
  (3, 200, 40),
  (4, 200, 60),
  (5, 300, 90);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo
--echo === Test 1: CASE with parent-table condition + CTE THEN arm (baseline) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN c.c_region = 1 THEN sums.t ELSE 0 END)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN c.c_region = 1 THEN sums.t ELSE 0 END)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id|

--echo
--echo
--echo === Test 2: CASE with CTE-column condition (the I.4 fix) ===

# sums.k is a CTE COLUMN projection (group-by key).  Pre-I.4 this
# crashed in generate_embedded_condition because column_map[sums.k]
# is NULL for CTE outputs.  Post-fix the condition path resolves
# the descriptor via the CTE body's source op.
let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k = 100 THEN sums.t ELSE 0 END)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k = 100 THEN sums.t ELSE 0 END)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id|

--echo
--echo
--echo === Test 3: CASE with multi-atom OR over CTE column ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k = 100 OR sums.k = 200
                        THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k = 100 OR sums.k = 200
                        THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id|

--echo
--echo
--echo === Test 4: CASE with multi-atom AND over CTE column ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k != 100 AND sums.k != 200
                        THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN sums.k != 100 AND sums.k != 200
                        THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id|

--echo
--echo
--echo === Test 5: regression — non-CTE CASE shape unchanged ===

let $QUERY=
SELECT c.c_id, SUM(CASE WHEN c.c_region = 1 THEN o.o_amt ELSE 0 END)
FROM cte_customer AS c
JOIN cte_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.c_id, SUM(CASE WHEN c.c_region = 1 THEN o.o_amt ELSE 0 END)
FROM cte_customer AS c
JOIN cte_orders AS o ON o.o_custkey = c.c_id
GROUP BY c.c_id|

DELIMITER ;|

--echo
--echo
--echo === Test 6: rejection — CASE condition on CTE aggregate output ===
--echo Expected error: CTE aggregate output in CASE condition not yet supported

# sums.t is a CTE AGGREGATE (SUM) output.  Pre-I.4 this would also
# have crashed; post-I.4 we reject cleanly at preparer time pointing
# the user to the column-projection workaround.
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'WITH sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t FROM cte_orders GROUP BY o_custkey) SELECT c.c_id, SUM(CASE WHEN sums.t = 100 THEN sums.t ELSE 0 END) FROM cte_customer AS c JOIN sums ON sums.k = c.c_id GROUP BY c.c_id;' 2>&1

# A CASE compiles only as the whole argument of an aggregate function.
# Used as an operand of arithmetic or inside another CASE it used to
# abort the process in the aggregation compiler; it is now rejected.
# Arithmetic inside the arms, and parentheses around the CASE, still work.
#
# Test 7: the ELSE arm reads o_amt, which the THEN arm also loads.  The
# ELSE arm used to reuse the THEN arm's register, which is not loaded
# when the ELSE arm runs, so ELSE rows added nothing.
# Test 8: a copy of o_amt saved before the CASE is never used after it.
# Removing that dead copy used to leave the CASE jump positions one
# instruction off.

DELIMITER |;

--echo
--echo
--echo === Test 7: arithmetic inside CASE arms, parentheses around the CASE ===

let $QUERY=
SELECT o_custkey, SUM((CASE WHEN o_amt > 50 THEN o_amt * 2 ELSE -o_amt END)) AS s
FROM cte_orders
GROUP BY o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o_custkey, SUM((CASE WHEN o_amt > 50 THEN o_amt * 2 ELSE -o_amt END)) AS s
FROM cte_orders
GROUP BY o_custkey|

--echo
--echo
--echo === Test 8: CASE after an aggregate that saves a copy for a later one ===

let $QUERY=
SELECT o_custkey, SUM(o_amt * 2) AS a, SUM(CASE WHEN o_amt > 45 THEN 1 ELSE 0 END) AS b, SUM(o_amt) AS c
FROM cte_orders
GROUP BY o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o_custkey, SUM(o_amt * 2) AS a, SUM(CASE WHEN o_amt > 45 THEN 1 ELSE 0 END) AS b, SUM(o_amt) AS c
FROM cte_orders
GROUP BY o_custkey|

DELIMITER ;|

--echo
--echo
--echo === Test 9: rejection — CASE as an operand of arithmetic ===
--echo Expected error: CASE only as the whole aggregate argument
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT o_custkey, SUM(o_amt * CASE WHEN o_amt > 50 THEN 1 ELSE 0 END) FROM cte_orders GROUP BY o_custkey;' 2>&1

--echo
--echo
--echo === Test 10: rejection — negated CASE in AVG ===
--echo Expected error: CASE only as the whole aggregate argument
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT o_custkey, AVG(-(CASE WHEN o_amt > 50 THEN o_amt ELSE 0 END)) FROM cte_orders GROUP BY o_custkey;' 2>&1

--echo
--echo
--echo === Test 11: rejection — CASE in the ELSE of another CASE ===
--echo Expected error: CASE only as the whole aggregate argument
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT o_custkey, MAX(CASE WHEN o_amt > 80 THEN 3 ELSE CASE WHEN o_amt > 50 THEN 2 ELSE 1 END END) FROM cte_orders GROUP BY o_custkey;' 2>&1

DELIMITER |;

--echo
--echo
--echo === Test 12: CASE AND/OR association preserves every atom ===

# Each OR atom selects a different order; each AND atom excludes one.
# Expected: customers 100/200 have OR totals 125/100 and AND totals 0;
# customer 300 has OR totals 0 and AND totals 90, for all three shapes.

let $QUERY=
SELECT o_custkey,
  SUM(CASE WHEN o_id = 1 OR o_id = 2 OR o_id = 3 OR o_id = 4
           THEN o_amt ELSE 0 END) AS or_left,
  SUM(CASE WHEN o_id = 1 OR (o_id = 2 OR (o_id = 3 OR o_id = 4))
           THEN o_amt ELSE 0 END) AS or_right,
  SUM(CASE WHEN (o_id = 1 OR o_id = 2) OR (o_id = 3 OR o_id = 4)
           THEN o_amt ELSE 0 END) AS or_balanced,
  SUM(CASE WHEN o_id != 1 AND o_id != 2 AND o_id != 3 AND o_id != 4
           THEN o_amt ELSE 0 END) AS and_left,
  SUM(CASE WHEN o_id != 1 AND (o_id != 2 AND (o_id != 3 AND o_id != 4))
           THEN o_amt ELSE 0 END) AS and_right,
  SUM(CASE WHEN (o_id != 1 AND o_id != 2) AND (o_id != 3 AND o_id != 4)
           THEN o_amt ELSE 0 END) AS and_balanced
FROM cte_orders
GROUP BY o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo
--echo === Test 13: CASE AND/OR conditions are not limited to 32 terms ===

# The first 32 OR atoms are false and the first 32 AND atoms are true.
# Only the final atom distinguishes order 5: OR totals 0/0/90 and
# AND totals 125/100/0 for customers 100/200/300.

let $QUERY=
SELECT o_custkey,
  SUM(CASE WHEN o_id = 101 OR o_id = 102 OR o_id = 103 OR o_id = 104
             OR o_id = 105 OR o_id = 106 OR o_id = 107 OR o_id = 108
             OR o_id = 109 OR o_id = 110 OR o_id = 111 OR o_id = 112
             OR o_id = 113 OR o_id = 114 OR o_id = 115 OR o_id = 116
             OR o_id = 117 OR o_id = 118 OR o_id = 119 OR o_id = 120
             OR o_id = 121 OR o_id = 122 OR o_id = 123 OR o_id = 124
             OR o_id = 125 OR o_id = 126 OR o_id = 127 OR o_id = 128
             OR o_id = 129 OR o_id = 130 OR o_id = 131 OR o_id = 132
             OR o_id = 5
           THEN o_amt ELSE 0 END) AS or_33,
  SUM(CASE WHEN o_id != 101 AND o_id != 102 AND o_id != 103 AND o_id != 104
             AND o_id != 105 AND o_id != 106 AND o_id != 107 AND o_id != 108
             AND o_id != 109 AND o_id != 110 AND o_id != 111 AND o_id != 112
             AND o_id != 113 AND o_id != 114 AND o_id != 115 AND o_id != 116
             AND o_id != 117 AND o_id != 118 AND o_id != 119 AND o_id != 120
             AND o_id != 121 AND o_id != 122 AND o_id != 123 AND o_id != 124
             AND o_id != 125 AND o_id != 126 AND o_id != 127 AND o_id != 128
             AND o_id != 129 AND o_id != 130 AND o_id != 131 AND o_id != 132
             AND o_id != 5
           THEN o_amt ELSE 0 END) AS and_33
FROM cte_orders
GROUP BY o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

DELIMITER ;|

# Mixed connectives and standalone truth values remain unsupported.
# The literal in a join also exercises safe projection traversal of a leaf node.

--echo
--echo
--echo === Test 14: rejection - AND branch inside CASE OR ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT o_custkey, SUM(CASE WHEN o_id = 1 OR (o_id = 2 AND o_amt = 75) THEN o_amt ELSE 0 END) AS s FROM cte_orders GROUP BY o_custkey;' 2>&1

--echo
--echo
--echo === Test 15: rejection - OR branch inside CASE AND ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT o_custkey, SUM(CASE WHEN o_id != 1 AND (o_id = 2 OR o_amt = 75) THEN o_amt ELSE 0 END) AS s FROM cte_orders GROUP BY o_custkey;' 2>&1

--echo
--echo
--echo === Test 16: rejection - literal CASE condition ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT c.c_id, SUM(CASE WHEN 1 THEN o.o_amt ELSE 0 END) AS s FROM cte_customer AS c JOIN cte_orders AS o ON o.o_custkey = c.c_id GROUP BY c.c_id;' 2>&1

DELIMITER |;

--echo
--echo
--echo === Test 17: Main CASE literal-left comparison preserves CTE output offsets ===

# c_region occurs only on the right of the CASE comparison. Its linked
# projection must be registered before the sums.t load offset is captured.
# Expected case_sum for customers 100/200/300: 125/100/0.

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN 1 = c.c_region THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo
--echo === Test 18: Main CASE column RHS preserves CTE output offsets ===

# c_id already has a GROUP BY projection; c_region needs its own slot.
# Keep this separate from Test 17 so another CASE cannot register it first.
# Expected case_sum for customers 100/200/300: 125/100/90.

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(CASE WHEN c.c_id > c.c_region THEN sums.t ELSE 0 END) AS case_sum
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
GROUP BY c.c_id;|
--source suite/ronsql/include/ronsql_compare.inc

DELIMITER ;|

# SUM(CASE ...) in a CTE output is rejected by output-type derivation.
# These shapes cannot yet test chained CASE projection offsets. Keep their
# rejection explicit; Tests 17 and 18 cover the supported main-query shapes.

--echo
--echo
--echo === Test 19: rejection - CTE-body SUM(CASE) with literal-left comparison ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'WITH sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t FROM cte_orders GROUP BY o_custkey), case_totals AS (SELECT c.c_id AS k, SUM(CASE WHEN 1 = c.c_region THEN sums.t ELSE 0 END) AS t FROM cte_customer AS c JOIN sums ON sums.k = c.c_id GROUP BY c.c_id) SELECT k, SUM(t) AS case_sum FROM case_totals GROUP BY k;' 2>&1

--echo
--echo
--echo === Test 20: rejection - CTE-body SUM(CASE) with column RHS ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'WITH sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t FROM cte_orders GROUP BY o_custkey), case_totals AS (SELECT c.c_id AS k, SUM(CASE WHEN c.c_id > c.c_region THEN sums.t ELSE 0 END) AS t FROM cte_customer AS c JOIN sums ON sums.k = c.c_id GROUP BY c.c_id) SELECT k, SUM(t) AS case_sum FROM case_totals GROUP BY k;' 2>&1

--echo === Cleanup ===
--disable_query_log
DROP TABLE cte_orders;
DROP TABLE cte_customer;
--enable_query_log
