# HAVING operands RonSQL cannot apply are rejected at prepare time.
#
# 1. HAVING inside a CTE body was parsed but never applied: the kernel
#    materializes every group, so the body returned the groups HAVING
#    should have removed.  analyze_ctes now rejects it.
# 2. ResultPrinter evaluates HAVING over the aggregate registers only.  A
#    plain column (or the alias of an ordinary aggregate output) in HAVING
#    kept its column index, which shares storage with the aggregate
#    register index, so it was compared as an unrelated aggregate value, or
#    failed with "Got record with fewer aggregates than expected" when no
#    such register existed (fs_ronsql finding F17).  It is now rejected
#    before column resolution with one message.  The output alias of a
#    SELECT-list subquery aggregate stays supported (ronsql_subquery_agg).
#
# No NDB connection is needed: these checks run before the dictionary load.

--source include/have_ndb.inc
--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let PARSE_TEST=$RONSQL_CLI_EXE --output-format TEXT --explain-mode=FORCE 2>&1 -e

--echo ===== Aggregate functions in HAVING are supported =====
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having count(*) > 1 and sum(b) < 100;'

--echo ===== GROUP BY column in HAVING =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having a > 1;'

--echo ===== GROUP BY column beside an aggregate in HAVING =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having count(*) > 1 and a > 3;'

--echo ===== GROUP BY column under IS NULL in HAVING =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having a is null;'

--echo ===== Qualified column in HAVING of a join =====
--error 1
--exec $PARSE_TEST 'select t.a, sum(u.b) from tbl as t join tbl2 as u on u.k = t.a group by t.a having t.a > 1;'

--echo ===== Alias of an aggregate output in HAVING =====
--error 1
--exec $PARSE_TEST 'select a, count(*) as n from tbl group by a having n > 2;'

--echo ===== Alias in HAVING with ORDER BY on it and LIMIT (F17) =====
--error 1
--exec $PARSE_TEST 'select a, count(*) as n from tbl group by a having n > 2 order by n desc, a asc limit 9;'

# Apply the same reference checks inside IN's outer operand. These fail
# before dictionary access, including references under arithmetic and NOT.

--echo ===== GROUP BY column under HAVING IN =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having a in (select max(b) from tbl2);'

--echo ===== Qualified column under HAVING IN =====
--error 1
--exec $PARSE_TEST 'select t.a, count(*) from tbl as t group by t.a having t.a in (select max(u.b) from tbl2 as u);'

--echo ===== Ordinary aggregate alias under HAVING IN =====
--error 1
--exec $PARSE_TEST 'select a, count(*) as n from tbl group by a having n in (select count(*) from tbl2);'

--echo ===== Column under arithmetic and negated HAVING IN =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having not ((a + 1) in (select max(b) from tbl2));'

# Supported operators depend on position. Reject unsupported shapes before
# dictionary access, including branches that data or short-circuiting can hide.

--echo ===== Unsupported DIV in a short-circuited HAVING OR =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having count(*) >= 0 or 1 div 2 > 0;'

--echo ===== Unsupported modulo in a short-circuited HAVING AND =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having count(*) < 0 and 1 % 2 > 0;'

--echo ===== Unsupported HAVING XOR =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having count(*) > 1 xor count(*) < 3;'

--echo ===== Aggregate used as a HAVING predicate =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having count(*);'

--echo ===== Comparison used as a HAVING numeric value =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having (count(*) > 1) + 1 > 0;'

--echo ===== Arithmetic under HAVING IS NULL =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having (sum(b) + 1) is null;'

--echo ===== Scalar subquery under HAVING IS NULL =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having (select max(b) from tbl2) is null;'

--echo ===== Scalar subquery used as a HAVING predicate =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having (select count(*) from tbl2);'

--echo ===== IN subquery used as a HAVING numeric value =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having (count(*) in (select max(b) from tbl2)) = 1;'

--echo ===== Arithmetic operand of negated HAVING IN =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having not ((count(*) + 1) in (select max(b) from tbl2));'

--echo ===== EXISTS used as a HAVING predicate =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl group by a having exists (select b from tbl2);'

--echo ===== Unsupported HAVING with an empty-input WHERE condition =====
--error 1
--exec $PARSE_TEST 'select a, count(*) from tbl where 1 = 0 group by a having 1 div 2 > 0;'

--echo ===== HAVING inside a CTE body =====
--error 1
--exec $PARSE_TEST 'with c as (select a as k, count(*) as n from tbl group by a having count(*) > 1) select sum(c.n) from c;'
