--source include/have_ndb.inc
--source include/have_util_curl.inc
--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# RONDB-1121 finding F7, fixed in RONDB-1124 (M1.4): BINARY / VARBINARY
# columns in pass-through results.  Hopsworks projects binary features
# (embeddings, serialized arrays) through the snowflake templates and the
# pass-through printer rejected them ("Unsupported column type (17)").
#
# TEXT output prints the raw bytes with the mysql client's batch-mode
# escaping (NUL, tab, newline and backslash as \0 \t \n \; every other
# byte as is), so ronsql_compare.inc diffs RonSQL against the client byte
# for byte.  The recorded "Expected result" blocks show HEX() instead of
# the raw bytes to keep this file printable.  JSON output carries a base64
# string (RFC 4648 with padding, no line breaks), the RDRS pk-read
# convention; ronsql_json_check.inc parses every body and prints it
# canonically; the JSON queries ORDER BY id so the recorded bodies are
# deterministic.  BINARY(n) is returned at its padded length, as by MySQL;
# VARBINARY(300) exercises the two-byte length prefix (Longvarbinary).

--let $suppress_ronsql_cli=
--let $strict_diff=yes

CREATE TABLE bp (
  id  INT NOT NULL,
  grp INT NOT NULL,
  b4  BINARY(4),
  vb  VARBINARY(16),
  lvb VARBINARY(300),
  PRIMARY KEY (id)
) ENGINE=NDB;
INSERT INTO bp VALUES
  (1, 1, 'AB',         0x4142,             REPEAT('x', 300)),
  (2, 1, 0x00090A5C,   0x00090A5C0D0B7F,   0x00),
  (3, 1, 0xC328FF01,   0xC328FFFE80,       REPEAT(0xFF, 260)),
  (4, 2, X'',          X'',                X''),
  (5, 2, NULL,         NULL,               NULL);

--echo
--echo === bp-1: single-table projection, TEXT parity with the mysql client (escapes, invalid UTF-8, padding) ===
--let $QUERY=SELECT id, b4, vb FROM bp WHERE grp = 1;
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result (hex) ==
--sorted_result
SELECT id, HEX(b4) AS b4_hex, HEX(vb) AS vb_hex FROM bp WHERE grp = 1;

--echo
--echo === bp-2: the long form (two-byte length prefix), TEXT parity ===
--let $QUERY=SELECT id, lvb FROM bp WHERE grp = 1;
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result (lengths) ==
--sorted_result
SELECT id, LENGTH(lvb) AS lvb_len, HEX(LEFT(lvb, 4)) AS lvb_head FROM bp WHERE grp = 1;

--echo
--echo === bp-3: empty values and NULLs, TEXT parity ===
--let $QUERY=SELECT id, b4, vb, lvb FROM bp WHERE grp = 2;
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result (hex) ==
--sorted_result
SELECT id, HEX(b4) AS b4_hex, HEX(vb) AS vb_hex, HEX(lvb) AS lvb_hex FROM bp WHERE grp = 2;

--echo
--echo === bp-4: the Hopsworks snowflake projection (aggregate CTE body, binary column on the joined table) ===
--let $QUERY=WITH c AS (SELECT grp AS g, COUNT(*) AS n FROM bp GROUP BY grp) SELECT b.id, b.vb, c.n FROM bp AS b JOIN c ON c.g = b.grp;
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result (hex) ==
--sorted_result
WITH c AS (SELECT grp AS g, COUNT(*) AS n FROM bp GROUP BY grp) SELECT b.id, HEX(b.vb) AS vb_hex, c.n FROM bp AS b JOIN c ON c.g = b.grp;

--let $JSON_CANON=perl -MJSON::PP -e 'print JSON::PP->new->canonical->encode(JSON::PP->new->decode(join q(), <STDIN>)), qq(\n)'
let $RDRS_RONSQL = curl --no-progress-meter --fail-with-body -X POST
  -H "Content-Type: application/json"
  http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql -d;

--echo ===== JSON: base64 strings (AB\0\0 = QUIAAA==, AB = QUI=, 00 09 0A 5C = AAkKXA==) =====
--let $QUERY=SELECT id, b4, vb FROM bp WHERE grp = 1 AND id < 3 ORDER BY id;
--source suite/ronsql/include/ronsql_json_check.inc

--echo ===== JSON: invalid UTF-8 and high bytes are just bytes (C3 28 FF 01 = wyj/AQ==) =====
--let $QUERY=SELECT id, b4, vb FROM bp WHERE id = 3;
--source suite/ronsql/include/ronsql_json_check.inc

--echo ===== JSON: empty (padded BINARY(4) = AAAAAA==, empty VARBINARY = "") and NULL =====
--let $QUERY=SELECT id, b4, vb, lvb FROM bp WHERE grp = 2 ORDER BY id;
--source suite/ronsql/include/ronsql_json_check.inc

--echo ===== JSON: the snowflake projection =====
--let $QUERY=WITH c AS (SELECT grp AS g, COUNT(*) AS n FROM bp GROUP BY grp) SELECT b.id, b.vb, c.n FROM bp AS b JOIN c ON c.g = b.grp ORDER BY b.id;
--source suite/ronsql/include/ronsql_json_check.inc

DROP TABLE bp;
