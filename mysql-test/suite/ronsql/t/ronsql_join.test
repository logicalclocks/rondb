--source include/have_ndb.inc

--echo
--echo === Create tables for join tests ===
--echo

--disable_query_log

CREATE TABLE orders (
  o_id INT NOT NULL,
  o_custkey INT NOT NULL,
  o_status VARCHAR(10) NOT NULL,
  PRIMARY KEY USING HASH (o_id)
) ENGINE=NDB;

CREATE TABLE lineitem (
  l_id INT NOT NULL,
  l_orderkey INT NOT NULL,
  l_quantity INT NOT NULL,
  l_price INT NOT NULL,
  PRIMARY KEY USING HASH (l_id),
  INDEX idx_orderkey (l_orderkey)
) ENGINE=NDB;

INSERT INTO orders VALUES
  (1, 100, 'open'),
  (2, 100, 'closed'),
  (3, 200, 'open'),
  (4, 200, 'open'),
  (5, 300, 'closed');

INSERT INTO lineitem VALUES
  (1, 1, 10, 100),
  (2, 1, 20, 200),
  (3, 2, 5, 50),
  (4, 2, 15, 150),
  (5, 3, 30, 300),
  (6, 3, 25, 250),
  (7, 4, 8, 80),
  (8, 4, 12, 120),
  (9, 5, 40, 400),
  (10, 5, 35, 350);

--enable_query_log

DELIMITER |;

--echo
--echo
--echo === Test 1: Basic 2-table join with GROUP BY on parent, SUM on child ===

let $QUERY=
SELECT o.o_custkey, SUM(l.l_quantity), SUM(l.l_price)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o.o_custkey, SUM(l.l_quantity), SUM(l.l_price)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_custkey|

--echo
--echo
--echo === Test 2: COUNT aggregate on join ===

let $QUERY=
SELECT o.o_custkey, COUNT(l.l_quantity)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o.o_custkey, COUNT(l.l_quantity)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_custkey|

--echo
--echo
--echo === Test 3: MIN/MAX aggregate on join ===

let $QUERY=
SELECT o.o_custkey, MIN(l.l_price), MAX(l.l_price)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o.o_custkey, MIN(l.l_price), MAX(l.l_price)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_custkey|

--echo
--echo
--echo === Test 4: GROUP BY on leaf column ===

let $QUERY=
SELECT l.l_orderkey, SUM(l.l_quantity)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY l.l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT l.l_orderkey, SUM(l.l_quantity)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY l.l_orderkey|

DELIMITER ;|

--echo
--echo === Cleanup ===

DROP TABLE lineitem;
DROP TABLE orders;
