--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--echo
--echo === Create tables for subquery tests ===
--echo

--disable_query_log
--disable_warnings

CREATE TABLE orders (
  o_id INT NOT NULL,
  o_custkey INT NOT NULL,
  o_total INT NOT NULL,
  PRIMARY KEY USING HASH (o_id)
) ENGINE=NDB;

CREATE TABLE lineitem (
  l_id INT NOT NULL,
  l_orderkey INT NOT NULL,
  l_quantity INT NOT NULL,
  l_price INT NOT NULL,
  PRIMARY KEY USING HASH (l_id),
  INDEX idx_orderkey (l_orderkey)
) ENGINE=NDB;

CREATE TABLE empty_table (
  e_id INT NOT NULL,
  e_val INT NOT NULL,
  PRIMARY KEY USING HASH (e_id)
) ENGINE=NDB;

CREATE INDEX idx_custkey ON orders (o_custkey);
CREATE INDEX idx_oid ON orders (o_id);

INSERT INTO orders VALUES
  (1, 100, 500),
  (2, 100, 300),
  (3, 200, 700),
  (4, 200, 200),
  (5, 300, 400);

INSERT INTO lineitem VALUES
  (1, 1, 10, 100),
  (2, 1, 20, 200),
  (3, 2, 5, 50),
  (4, 2, 15, 150),
  (5, 3, 30, 300),
  (6, 3, 25, 250),
  (7, 4, 8, 80),
  (8, 4, 12, 120),
  (9, 5, 40, 400),
  (10, 5, 35, 350);

--enable_warnings
--enable_query_log

--echo
--echo === Test 1: EXISTS subquery — basic semi-join ===
--echo All orders have lineitems, so all orders match

DELIMITER |;
let $QUERY=
SELECT o_custkey, SUM(o_total)
FROM orders
WHERE EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id)
GROUP BY o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 2: IN subquery — scalar inner result ===
--echo o_custkey IN (SELECT MAX(l_orderkey) FROM lineitem)
--echo MAX(l_orderkey) = 5, so rows with o_custkey = 5 are included (but no such row)

let $QUERY=
SELECT o_custkey, SUM(o_total)
FROM orders
WHERE o_custkey IN (SELECT MAX(l_orderkey) FROM lineitem)
GROUP BY o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo
--echo === Test 3: Scalar subquery in WHERE — single table ===
--echo l_quantity > (SELECT MIN(l_quantity) FROM lineitem)
--echo MIN(l_quantity) = 5, so rows with l_quantity > 5 are included

let $QUERY=
SELECT l_orderkey, SUM(l_quantity), COUNT(*)
FROM lineitem
WHERE l_quantity > (SELECT MIN(l_quantity) FROM lineitem)
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 4: Scalar subquery with inner WHERE ===
--echo l_quantity > (SELECT MIN(l_quantity) FROM lineitem WHERE l_price > 100)
--echo MIN where price > 100 = 12, so rows with l_quantity > 12 are included

let $QUERY=
SELECT l_orderkey, SUM(l_quantity), COUNT(*)
FROM lineitem
WHERE l_quantity > (SELECT MIN(l_quantity) FROM lineitem WHERE l_price > 100)
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 5: Scalar subquery — MAX in WHERE ===
--echo l_price < (SELECT MAX(l_price) FROM lineitem)
--echo MAX(l_price) = 400, so rows with l_price < 400 are included

let $QUERY=
SELECT l_orderkey, SUM(l_quantity), SUM(l_price)
FROM lineitem
WHERE l_price < (SELECT MAX(l_price) FROM lineitem)
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 6: Scalar subquery — SUM in WHERE with equality ===
--echo o_total = (SELECT MIN(o_total) FROM orders)
--echo MIN(o_total) = 200

let $QUERY=
SELECT o_custkey, COUNT(*), SUM(o_total)
FROM orders
WHERE o_total = (SELECT MIN(o_total) FROM orders)
GROUP BY o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 7: Scalar subquery — COUNT as scalar ===
--echo l_quantity > (SELECT COUNT(*) FROM lineitem) means l_quantity > 10

let $QUERY=
SELECT l_orderkey, SUM(l_price)
FROM lineitem
WHERE l_quantity > (SELECT COUNT(*) FROM lineitem)
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 8: Multiple scalar subqueries in WHERE ===
--echo l_quantity > (SELECT MIN(l_quantity) FROM lineitem)
--echo AND l_price < (SELECT MAX(l_price) FROM lineitem)

let $QUERY=
SELECT l_orderkey, SUM(l_quantity), SUM(l_price)
FROM lineitem
WHERE l_quantity > (SELECT MIN(l_quantity) FROM lineitem)
  AND l_price < (SELECT MAX(l_price) FROM lineitem)
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 9: IN subquery — multiple values from GROUP BY ===
--echo l_orderkey IN (SELECT MIN(l_orderkey) FROM lineitem GROUP BY l_orderkey)
--echo All l_orderkey values (1-5), so all rows match

let $QUERY=
SELECT l_orderkey, SUM(l_quantity), COUNT(*)
FROM lineitem
WHERE l_orderkey IN (SELECT MIN(l_orderkey) FROM lineitem GROUP BY l_orderkey)
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 10: IN subquery — selective inner WHERE ===
--echo l_orderkey IN (SELECT MIN(l_orderkey) FROM lineitem WHERE l_quantity > 20 GROUP BY l_orderkey)
--echo Inner returns l_orderkey 3 and 5 (rows with quantity > 20)

let $QUERY=
SELECT l_orderkey, SUM(l_price)
FROM lineitem
WHERE l_orderkey IN (SELECT MIN(l_orderkey) FROM lineitem WHERE l_quantity > 20 GROUP BY l_orderkey)
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 11: IN subquery — inner WHERE filters to empty ===
--echo l_orderkey IN (SELECT MIN(l_orderkey) FROM lineitem WHERE l_quantity > 999 GROUP BY l_orderkey)
--echo Inner returns no rows, so no outer rows match

let $QUERY=
SELECT l_orderkey, SUM(l_quantity)
FROM lineitem
WHERE l_orderkey IN (SELECT MIN(l_orderkey) FROM lineitem WHERE l_quantity > 999 GROUP BY l_orderkey)
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 12: IN subquery with AND condition ===
--echo l_orderkey IN (...) AND l_quantity > 10

let $QUERY=
SELECT l_orderkey, SUM(l_price)
FROM lineitem
WHERE l_orderkey IN (SELECT MIN(l_orderkey) FROM lineitem GROUP BY l_orderkey)
  AND l_quantity > 10
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 13: Cross-column comparison — less than ===
--echo WHERE l_quantity < l_price (column vs column)

let $QUERY=
SELECT l_orderkey, SUM(l_quantity), SUM(l_price)
FROM lineitem
WHERE l_quantity < l_price
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 14: Cross-column comparison combined with constant ===
--echo WHERE l_quantity < l_price AND l_price > 100

let $QUERY=
SELECT l_orderkey, SUM(l_quantity), SUM(l_price)
FROM lineitem
WHERE l_quantity < l_price AND l_price > 100
GROUP BY l_orderkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 15: EXISTS with filter on inner ===
--echo Only orders with lineitem quantity > 20

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 20)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 16: EXISTS with no match ===
--echo l_quantity > 999 matches nothing

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 999)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 17: EXISTS with COUNT(*) aggregation ===
--echo Count orders per custkey that have lineitems

let $QUERY=
SELECT o_custkey, COUNT(*)
FROM orders
WHERE EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id)
GROUP BY o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 18: EXISTS with outer WHERE filter ===
--echo Orders with custkey = 200 that have lineitems

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE o_custkey = 200
  AND EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 19: NOT EXISTS — no matching lineitems ===
--echo No lineitem has l_quantity > 999, so NOT EXISTS is true for all orders

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE NOT EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 999)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 20: EXISTS with qualified column names ===
--echo Using table aliases in correlation predicate

let $QUERY=
SELECT o.o_custkey, SUM(o.o_total)
FROM orders AS o
WHERE EXISTS (SELECT l.l_id FROM lineitem AS l WHERE l.l_orderkey = o.o_id)
GROUP BY o.o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 21: NOT EXISTS — all orders have lineitems ===
--echo NOT EXISTS returns empty (every order has at least one lineitem)

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE NOT EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 22: NOT EXISTS — partial match ===
--echo Orders 1,2,4 have no lineitems with l_quantity > 20

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE NOT EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 20)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 23: NOT EXISTS with outer filter ===
--echo custkey = 200 AND no high-qty lineitems: only order 4

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE o_custkey = 200
  AND NOT EXISTS (SELECT l_id FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 20)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 24: Correlated scalar subquery — less than ===
--echo o_total < (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id)
--echo SUM per orderkey: (1,300),(2,200),(3,550),(4,200),(5,750)
--echo Only order 5 qualifies (400 < 750)

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE o_total < (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 25: Correlated scalar subquery — equality ===
--echo o_total = (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id)
--echo Only order 4 qualifies (200 = 200)

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE o_total = (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 26: Correlated scalar subquery — greater than ===
--echo o_total > (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id)
--echo Orders 1,2,3 qualify: (500>300, 300>200, 700>550)

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE o_total > (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 27: Correlated scalar subquery with outer filter ===
--echo o_custkey = 200 AND o_total > SUM(l_price): only order 3 (700>550)

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE o_custkey = 200
  AND o_total > (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 28: Correlated scalar subquery with inner filter ===
--echo o_total > (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 20)
--echo Inner SUM where qty>20: (3,550),(5,750). Only order 3 qualifies (700>550)

let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE o_total > (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 20)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

# NULL semantics of NOT EXISTS and NOT (x IN (subquery)).  nq_outer row 3
# has a NULL o_k, and nq_inner row 2 a NULL i_k.  MySQL's NOT EXISTS is
# TRUE for a NULL outer column, x NOT IN a result holding a NULL is never
# TRUE, and x NOT IN an empty result is TRUE even for a NULL x.

--disable_query_log
--disable_warnings
CREATE TABLE nq_outer (
  o_id INT NOT NULL,
  o_k INT NULL,
  o_amt INT NOT NULL,
  PRIMARY KEY USING HASH (o_id)
) ENGINE=NDB|
CREATE TABLE nq_inner (
  i_id INT NOT NULL,
  i_k INT NULL,
  PRIMARY KEY USING HASH (i_id)
) ENGINE=NDB|
INSERT INTO nq_outer VALUES (1, 10, 100), (2, 20, 200), (3, NULL, 300), (4, 40, 400)|
INSERT INTO nq_inner VALUES (1, 10), (2, NULL), (3, 30)|
--enable_warnings
--enable_query_log

--echo
--echo === Test 29: NOT EXISTS with a NULL outer correlation column ===
--echo Orders 2, 3 (NULL o_k) and 4 have no match
let $QUERY=
SELECT o_id, SUM(o_amt)
FROM nq_outer
WHERE NOT EXISTS (SELECT i_id FROM nq_inner WHERE i_k = o_k)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 30: NOT IN a subquery result that holds a NULL ===
--echo The result is (10, NULL, 30), so no row qualifies
let $QUERY=
SELECT o_id, SUM(o_amt)
FROM nq_outer
WHERE NOT (o_k IN (SELECT MIN(i_k) FROM nq_inner GROUP BY i_id))
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 31: NOT IN a subquery result without NULL ===
--echo The result is (10, 30): orders 2 and 4 (order 3 has a NULL o_k)
let $QUERY=
SELECT o_id, SUM(o_amt)
FROM nq_outer
WHERE NOT (o_k IN (SELECT MIN(i_k) FROM nq_inner WHERE i_id != 2 GROUP BY i_id))
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 32: NOT IN an empty subquery result ===
--echo Every order qualifies, also order 3 with a NULL o_k
let $QUERY=
SELECT o_id, SUM(o_amt)
FROM nq_outer
WHERE NOT (o_k IN (SELECT MIN(i_k) FROM nq_inner WHERE i_id > 100 GROUP BY i_id))
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 33: IN a subquery result that holds a NULL ===
--echo Only order 1 matches
let $QUERY=
SELECT o_id, SUM(o_amt)
FROM nq_outer
WHERE o_k IN (SELECT MIN(i_k) FROM nq_inner GROUP BY i_id)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

# A correlated scalar subquery is NULL for an outer row without inner rows,
# so the comparison is NULL under NOT as well and the row is dropped.

--echo
--echo === Test 34: NOT around a correlated scalar subquery ===
--echo Inner SUM where qty>20: (3,550),(5,750). Orders 1, 2 and 4 have no
--echo inner rows. Only order 3 qualifies (NOT 700<550)
let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE NOT (o_total < (SELECT SUM(l_price) FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 20))
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 35: NOT around a correlated scalar subquery on the left ===
--echo SUM(i_id) per i_k: (10,1),(30,3). Orders 2 and 4 have no inner rows,
--echo order 3 a NULL o_k. Only order 1 qualifies (NOT 1>1)
let $QUERY=
SELECT o_id, SUM(o_amt)
FROM nq_outer
WHERE NOT ((SELECT SUM(i_id) FROM nq_inner WHERE i_k = o_k) > o_id)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

# A correlated COUNT subquery is 0, not NULL, for an outer row without
# inner rows, also when the outer key is NULL.

--echo
--echo === Test 36: Correlated COUNT subquery, outer keys without inner rows ===
--echo COUNT(*) per i_k: (10,1),(NULL,1),(30,1). Orders 2 and 4 have no inner
--echo rows and order 3 a NULL o_k, so their COUNT is 0: orders 2, 3 and 4
let $QUERY=
SELECT o_id, SUM(o_amt)
FROM nq_outer
WHERE o_id > (SELECT COUNT(*) FROM nq_inner WHERE i_k = o_k)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Test 37: NOT around a correlated COUNT subquery on the left ===
--echo COUNT(l_id) where qty>20: (3,2),(5,2), and 0 for orders 1, 2 and 4.
--echo No count reaches o_custkey, so every order qualifies
let $QUERY=
SELECT o_id, SUM(o_total)
FROM orders
WHERE NOT ((SELECT COUNT(l_id) FROM lineitem WHERE l_orderkey = o_id AND l_quantity > 20) >= o_custkey)
GROUP BY o_id;|
--source suite/ronsql/include/ronsql_compare.inc

DELIMITER ;|

# RONSQL-41: a scalar subquery that returned more than one row, or a
# scalar or IN subquery that selected more than one column, failed with
# "Subquery returned a non-numeric result." (or "IN-subquery returned a
# non-numeric result."), since the whole output was parsed as one
# number. MySQL reports "Subquery returns more than 1 row" and
# "Operand should contain 1 column(s)". The column count is now checked
# at prepare time and the row count when the subquery has run.

--echo
--echo === Test 38: Scalar subquery selecting two columns (rejected) ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT l_orderkey, SUM(l_quantity) AS q FROM lineitem WHERE l_quantity > (SELECT MIN(l_quantity), MAX(l_quantity) FROM lineitem) GROUP BY l_orderkey;' 2>&1

--echo
--echo === Test 39: IN subquery selecting two columns (rejected) ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT l_orderkey, SUM(l_price) AS p FROM lineitem WHERE l_orderkey IN (SELECT MIN(l_orderkey), MAX(l_price) FROM lineitem GROUP BY l_orderkey) GROUP BY l_orderkey;' 2>&1

--echo
--echo === Test 40: Scalar subquery returning five rows (rejected) ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT l_orderkey, SUM(l_quantity) AS q FROM lineitem WHERE l_quantity > (SELECT MIN(l_quantity) FROM lineitem GROUP BY l_orderkey) GROUP BY l_orderkey;' 2>&1

--echo
--echo === Cleanup ===

DROP TABLE empty_table;
DROP TABLE lineitem;
DROP TABLE orders;
DROP TABLE nq_inner;
DROP TABLE nq_outer;
