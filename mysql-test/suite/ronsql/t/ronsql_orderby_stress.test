# =============================================================================
# Table 4: tie_breaker — Multi-column tie-breaking
# 12 groups x 4 rows = 48 rows
# First ORDER BY column has many ties, second/third break them
# =============================================================================

--disable_query_log
--disable_warnings
CREATE TABLE tie_breaker (
  pk    INT NOT NULL AUTO_INCREMENT,
  c_a   INT NULL,
  c_b   INT NULL,
  c_c   INT NULL,
  val   INT NOT NULL,
  PRIMARY KEY USING HASH (pk)
) ENGINE=NDB;

# 12 groups: 4 with c_a=1, 4 with c_a=2, 2 with c_a=3, 2 with c_a=NULL
# Each group has 4 rows, val = 10,20,30,40 (sum=100)
#
# Groups:
# (1, 10, 100), (1, 10, 200), (1, 20, 100), (1, 20, 200)
# (2, 10, 100), (2, 10, 200), (2, 20, 100), (2, 20, 200)
# (3, 10, 100), (3, 20, 200)
# (NULL, 10, 100), (NULL, NULL, NULL)

# Row set 1 (val=10)
INSERT INTO tie_breaker (c_a, c_b, c_c, val) VALUES
  (1, 10, 100, 10), (1, 10, 200, 10), (1, 20, 100, 10), (1, 20, 200, 10),
  (2, 10, 100, 10), (2, 10, 200, 10), (2, 20, 100, 10), (2, 20, 200, 10),
  (3, 10, 100, 10), (3, 20, 200, 10),
  (NULL, 10, 100, 10), (NULL, NULL, NULL, 10);

# Row set 2 (val=20)
INSERT INTO tie_breaker (c_a, c_b, c_c, val) VALUES
  (1, 10, 100, 20), (1, 10, 200, 20), (1, 20, 100, 20), (1, 20, 200, 20),
  (2, 10, 100, 20), (2, 10, 200, 20), (2, 20, 100, 20), (2, 20, 200, 20),
  (3, 10, 100, 20), (3, 20, 200, 20),
  (NULL, 10, 100, 20), (NULL, NULL, NULL, 20);

# Row set 3 (val=30)
INSERT INTO tie_breaker (c_a, c_b, c_c, val) VALUES
  (1, 10, 100, 30), (1, 10, 200, 30), (1, 20, 100, 30), (1, 20, 200, 30),
  (2, 10, 100, 30), (2, 10, 200, 30), (2, 20, 100, 30), (2, 20, 200, 30),
  (3, 10, 100, 30), (3, 20, 200, 30),
  (NULL, 10, 100, 30), (NULL, NULL, NULL, 30);

# Row set 4 (val=40)
INSERT INTO tie_breaker (c_a, c_b, c_c, val) VALUES
  (1, 10, 100, 40), (1, 10, 200, 40), (1, 20, 100, 40), (1, 20, 200, 40),
  (2, 10, 100, 40), (2, 10, 200, 40), (2, 20, 100, 40), (2, 20, 200, 40),
  (3, 10, 100, 40), (3, 20, 200, 40),
  (NULL, 10, 100, 40), (NULL, NULL, NULL, 40);

--enable_warnings
--enable_query_log

--echo Row count tie_breaker:
SELECT count(*) FROM tie_breaker;

DELIMITER |;

--echo
--echo
--echo
--echo Tie-breaking 3-column ASC (fully deterministic order):
--let $skip_sort=yes
let $QUERY=
SELECT c_a, c_b, c_c, count(*), sum(val)
FROM tie_breaker
GROUP BY c_a, c_b, c_c
ORDER BY c_a ASC, c_b ASC, c_c ASC;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Tie-breaking 3-column mixed (DESC, ASC, DESC):
--let $skip_sort=yes
let $QUERY=
SELECT c_a, c_b, c_c, count(*), sum(val)
FROM tie_breaker
GROUP BY c_a, c_b, c_c
ORDER BY c_a DESC, c_b ASC, c_c DESC;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Tie-breaking 2-column (groups merged, still deterministic):
--let $skip_sort=yes
let $QUERY=
SELECT c_a, c_b, count(*), sum(val)
FROM tie_breaker
GROUP BY c_a, c_b
ORDER BY c_a ASC, c_b DESC;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Tie-breaking 3-column ASC LIMIT 5:
--let $skip_sort=yes
let $QUERY=
SELECT c_a, c_b, c_c, count(*), sum(val)
FROM tie_breaker
GROUP BY c_a, c_b, c_c
ORDER BY c_a ASC, c_b ASC, c_c ASC
LIMIT 5;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Tie-breaking 3-column all DESC LIMIT 3:
--let $skip_sort=yes
let $QUERY=
SELECT c_a, c_b, c_c, count(*), sum(val)
FROM tie_breaker
GROUP BY c_a, c_b, c_c
ORDER BY c_a DESC, c_b DESC, c_c DESC
LIMIT 3;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Tie-breaking ORDER BY only c_a ASC (4 groups, deterministic):
--let $skip_sort=yes
let $QUERY=
SELECT c_a, count(*), sum(val)
FROM tie_breaker
GROUP BY c_a
ORDER BY c_a;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Tie-breaking NULL groups first via LIMIT 2 (multi-level NULL comparison):
--let $skip_sort=yes
let $QUERY=
SELECT c_a, c_b, c_c, count(*), sum(val)
FROM tie_breaker
GROUP BY c_a, c_b, c_c
ORDER BY c_a ASC, c_b ASC, c_c ASC
LIMIT 2;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Tie-breaking with multiple aggregates:
--let $skip_sort=yes
let $QUERY=
SELECT c_a, c_b, c_c, count(*), sum(val), min(val), max(val), avg(val)
FROM tie_breaker
GROUP BY c_a, c_b, c_c
ORDER BY c_a ASC, c_b ASC, c_c ASC;|
--source suite/ronsql/include/ronsql_compare.inc

DELIMITER ;|

--echo Cleanup tie_breaker
--disable_warnings
DROP TABLE tie_breaker;
--enable_warnings
