  (NULL,        NULL,                 NULL,                 NULL,         30);

--enable_warnings
--enable_query_log

--echo Row count boundary_orderby:
SELECT count(*) FROM boundary_orderby;

DELIMITER |;

--echo
--echo
--echo
--echo Boundary INT ASC (NULL first, then -2147483648 to 2147483647):
--let $skip_sort=yes
let $QUERY=
SELECT c_int, count(*), sum(val)
FROM boundary_orderby
GROUP BY c_int
ORDER BY c_int;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Boundary INT DESC (NULL first, then 2147483647 to -2147483648):
--let $skip_sort=yes
let $QUERY=
SELECT c_int, count(*), sum(val)
FROM boundary_orderby
GROUP BY c_int
ORDER BY c_int DESC;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Boundary BIGINT ASC:
--let $skip_sort=yes
let $QUERY=
SELECT c_bigint, count(*), sum(val)
FROM boundary_orderby
GROUP BY c_bigint
ORDER BY c_bigint;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Boundary BIGINT UNSIGNED ASC:
--let $skip_sort=yes
let $QUERY=
SELECT c_bigunsigned, count(*), sum(val)
FROM boundary_orderby
GROUP BY c_bigunsigned
ORDER BY c_bigunsigned;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Boundary DECIMAL ASC:
--let $skip_sort=yes
let $QUERY=
SELECT c_decimal, count(*), sum(val)
FROM boundary_orderby
GROUP BY c_decimal
ORDER BY c_decimal;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Boundary INT ASC LIMIT 3:
--let $skip_sort=yes
let $QUERY=
SELECT c_int, count(*), sum(val)
FROM boundary_orderby
GROUP BY c_int
ORDER BY c_int
LIMIT 3;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Boundary multi-column INT ASC, DECIMAL DESC:
--let $skip_sort=yes
let $QUERY=
SELECT c_int, c_decimal, count(*), sum(val)
FROM boundary_orderby
GROUP BY c_int, c_decimal
ORDER BY c_int ASC, c_decimal DESC;|
--source suite/ronsql/include/ronsql_compare.inc

DELIMITER ;|

--echo Cleanup boundary_orderby
--disable_warnings
DROP TABLE boundary_orderby;
--enable_warnings


# =============================================================================
# Table 2: many_groups — 50 groups x 4 rows = 200 rows
# Tests ORDER BY with larger number of groups
# =============================================================================

--disable_query_log
--disable_warnings
CREATE TABLE many_groups (
  pk        INT          NOT NULL AUTO_INCREMENT,
  grp       INT          NOT NULL,
  c_varchar VARCHAR(100) CHARACTER SET utf8mb4 NOT NULL,
  c_date    DATE         NOT NULL,
  val       INT          NOT NULL,
  PRIMARY KEY USING HASH (pk)
) ENGINE=NDB;

# Generate 200 rows using Perl: 50 groups x 4 rows
# grp = 1..50, c_varchar = deterministic string, c_date = deterministic date
# val cycles through 10,20,30,40 (sum per group = 100)
--let TEST_DATA_TSV=$MYSQLTEST_VARDIR/tmp/many_groups_data.tsv

perl;
  use strict;
  use warnings;
  my $file_path = $ENV{TEST_DATA_TSV} // die "TEST_DATA_TSV not set";
  open(my $fh, '>', $file_path) or die "Could not open file '$file_path' $!";

  # 26 prefixes to generate diverse sort-order strings
  my @prefixes = qw(alpha bravo charlie delta echo foxtrot golf hotel india
                     juliet kilo lima mike november oscar papa quebec romeo
                     sierra tango uniform victor whiskey xray yankee zulu);
  my @vals = (10, 20, 30, 40);

  for my $grp (1..50) {
    my $prefix = $prefixes[($grp - 1) % 26];
    my $suffix = sprintf("%03d", $grp);
    my $varchar = "${prefix}_${suffix}";
    my $year = 2000 + ($grp - 1);
    my $month = (($grp - 1) % 12) + 1;
    my $day = (($grp - 1) % 28) + 1;
    my $date = sprintf("%04d-%02d-%02d", $year, $month, $day);
    for my $vi (0..3) {
      my $val = $vals[$vi];
      print $fh "$grp\t$varchar\t$date\t$val\n";
    }
  }
  close($fh);
EOF
--enable_warnings
--enable_query_log
--echo Loading 200 rows into many_groups:
--disable_query_log
--disable_warnings
eval LOAD DATA INFILE '$TEST_DATA_TSV' INTO TABLE many_groups (grp, c_varchar, c_date, val);
--enable_warnings
--enable_query_log
--remove_file $TEST_DATA_TSV

--echo Row count many_groups:
SELECT count(*) FROM many_groups;

DELIMITER |;

--echo
--echo
--echo
--echo 50 groups ORDER BY grp ASC:
--let $skip_sort=yes
let $QUERY=
SELECT grp, count(*), sum(val)
FROM many_groups
GROUP BY grp
ORDER BY grp;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY grp DESC:
--let $skip_sort=yes
let $QUERY=
SELECT grp, count(*), sum(val)
FROM many_groups
GROUP BY grp
ORDER BY grp DESC;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY c_varchar ASC:
--let $skip_sort=yes
let $QUERY=
SELECT c_varchar, count(*), sum(val)
FROM many_groups
GROUP BY c_varchar
ORDER BY c_varchar;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY c_date DESC:
--let $skip_sort=yes
let $QUERY=
SELECT c_date, count(*), sum(val)
FROM many_groups
GROUP BY c_date
ORDER BY c_date DESC;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY grp ASC LIMIT 10:
--let $skip_sort=yes
let $QUERY=
SELECT grp, count(*), sum(val)
FROM many_groups
GROUP BY grp
ORDER BY grp
LIMIT 10;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY grp DESC LIMIT 10:
--let $skip_sort=yes
let $QUERY=
SELECT grp, count(*), sum(val)
FROM many_groups
GROUP BY grp
ORDER BY grp DESC
LIMIT 10;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY c_varchar ASC LIMIT 25 (half):
--let $skip_sort=yes
let $QUERY=
SELECT c_varchar, count(*), sum(val)
FROM many_groups
GROUP BY c_varchar
ORDER BY c_varchar
LIMIT 25;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY grp LIMIT 50 (exact count):
--let $skip_sort=yes
let $QUERY=
SELECT grp, count(*), sum(val)
FROM many_groups
GROUP BY grp
ORDER BY grp
LIMIT 50;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY grp LIMIT 999 (exceeds count):
--let $skip_sort=yes
let $QUERY=
SELECT grp, count(*), sum(val)
FROM many_groups
GROUP BY grp
ORDER BY grp
LIMIT 999;|
--source suite/ronsql/include/ronsql_compare.inc

--echo 50 groups ORDER BY grp LIMIT 0 (zero):
--let $skip_sort=yes
let $QUERY=
SELECT grp, count(*), sum(val)
FROM many_groups
GROUP BY grp
ORDER BY grp
LIMIT 0;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Single group via WHERE (degenerate ORDER BY):
--let $skip_sort=yes
let $QUERY=
SELECT grp, count(*), sum(val)
FROM many_groups
WHERE grp = 25
GROUP BY grp
ORDER BY grp;|
--source suite/ronsql/include/ronsql_compare.inc

--echo Two-column ORDER BY grp ASC, c_varchar ASC on many_groups:
--let $skip_sort=yes
let $QUERY=
SELECT grp, c_varchar, count(*), sum(val)
FROM many_groups
GROUP BY grp, c_varchar
ORDER BY grp ASC, c_varchar ASC;|
--source suite/ronsql/include/ronsql_compare.inc

DELIMITER ;|

--echo Cleanup many_groups
--disable_warnings
DROP TABLE many_groups;
--enable_warnings


# =============================================================================
# Table 3: string_edge — String ordering edge cases
# 9 groups x 6 rows = 54 rows
# Empty string, short strings, long strings, NULL
# =============================================================================

--disable_query_log
--disable_warnings
CREATE TABLE string_edge (
  pk        INT          NOT NULL AUTO_INCREMENT,
  c_varchar VARCHAR(300) CHARACTER SET utf8mb4 NULL,
  c_int     INT          NOT NULL,
  val       INT          NOT NULL,
  PRIMARY KEY USING HASH (pk)
) ENGINE=NDB;

# 9 groups: '', 'A', 'B', 'aa', 'ab', 'ba', <290-char string>, 'zzz', NULL
# c_int varies: 1..9 mapping to groups, for multi-column test
# val cycles 5,10,15,20,25,30 (sum=105 per group)

# Group 1: empty string, c_int=1
INSERT INTO string_edge (c_varchar, c_int, val) VALUES
  ('', 1, 5), ('', 1, 10), ('', 1, 15), ('', 1, 20), ('', 1, 25), ('', 1, 30);

