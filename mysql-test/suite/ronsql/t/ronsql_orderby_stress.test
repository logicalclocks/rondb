--source include/have_ndb.inc
--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# RonSQL doesn't support time zones yet, and works as if in UTC.
SET time_zone = "+00:00";

# =============================================================================
# Table 1: boundary_orderby — Integer/decimal boundary values
# 8 groups x 6 rows = 48 rows
# Tests MIN/MAX values for integer types as ORDER BY keys
# =============================================================================

--disable_query_log
--disable_warnings
CREATE TABLE boundary_orderby (
  pk           INT              NOT NULL AUTO_INCREMENT,
  c_int        INT              NULL,
  c_bigint     BIGINT           NULL,
  c_bigunsigned BIGINT UNSIGNED NULL,
  c_decimal    DECIMAL(10,2)    NULL,
  val          INT              NOT NULL,
  PRIMARY KEY USING HASH (pk)
) ENGINE=NDB;

# 8 groups with boundary values, 6 rows each (val = 5,10,15,20,25,30, sum=105)
# c_int groups: -2147483648, -1000000, -1, 0, 1, 1000000, 2147483647, NULL
# c_bigint mirrors: -9223372036854775808, -1000000, -1, 0, 1, 1000000, 9223372036854775807, NULL
# c_bigunsigned: 0, 1, 1000000, 9999999999, 9999999999999999999, 18446744073709551615, reserved, NULL
# c_decimal: -99999999.99, -0.01, 0.00, 0.01, 0.10, 99999999.99, reserved, NULL

# Row set 1 (one row from each group, val=5)
INSERT INTO boundary_orderby (c_int, c_bigint, c_bigunsigned, c_decimal, val) VALUES
  (-2147483648, -9223372036854775808, 0,                    -99999999.99, 5),
  (-1000000,    -1000000,             1,                    -0.01,        5),
  (-1,          -1,                   1000000,              0.00,         5),
  (0,           0,                    9999999999,           0.01,         5),
  (1,           1,                    9999999999999999999,  0.10,         5),
  (1000000,     1000000,              18446744073709551615, 99999999.99,  5),
  (2147483647,  9223372036854775807,  9999999999999999999,  0.10,         5),
  (NULL,        NULL,                 NULL,                 NULL,         5);

# Row set 2 (val=10)
INSERT INTO boundary_orderby (c_int, c_bigint, c_bigunsigned, c_decimal, val) VALUES
  (-2147483648, -9223372036854775808, 0,                    -99999999.99, 10),
  (-1000000,    -1000000,             1,                    -0.01,        10),
  (-1,          -1,                   1000000,              0.00,         10),
  (0,           0,                    9999999999,           0.01,         10),
  (1,           1,                    9999999999999999999,  0.10,         10),
  (1000000,     1000000,              18446744073709551615, 99999999.99,  10),
  (2147483647,  9223372036854775807,  9999999999999999999,  0.10,         10),
  (NULL,        NULL,                 NULL,                 NULL,         10);

# Row set 3 (val=15)
INSERT INTO boundary_orderby (c_int, c_bigint, c_bigunsigned, c_decimal, val) VALUES
  (-2147483648, -9223372036854775808, 0,                    -99999999.99, 15),
  (-1000000,    -1000000,             1,                    -0.01,        15),
  (-1,          -1,                   1000000,              0.00,         15),
  (0,           0,                    9999999999,           0.01,         15),
  (1,           1,                    9999999999999999999,  0.10,         15),
  (1000000,     1000000,              18446744073709551615, 99999999.99,  15),
  (2147483647,  9223372036854775807,  9999999999999999999,  0.10,         15),
  (NULL,        NULL,                 NULL,                 NULL,         15);

# Row set 4 (val=20)
INSERT INTO boundary_orderby (c_int, c_bigint, c_bigunsigned, c_decimal, val) VALUES
  (-2147483648, -9223372036854775808, 0,                    -99999999.99, 20),
  (-1000000,    -1000000,             1,                    -0.01,        20),
  (-1,          -1,                   1000000,              0.00,         20),
  (0,           0,                    9999999999,           0.01,         20),
  (1,           1,                    9999999999999999999,  0.10,         20),
  (1000000,     1000000,              18446744073709551615, 99999999.99,  20),
  (2147483647,  9223372036854775807,  9999999999999999999,  0.10,         20),
  (NULL,        NULL,                 NULL,                 NULL,         20);

# Row set 5 (val=25)
INSERT INTO boundary_orderby (c_int, c_bigint, c_bigunsigned, c_decimal, val) VALUES
  (-2147483648, -9223372036854775808, 0,                    -99999999.99, 25),
  (-1000000,    -1000000,             1,                    -0.01,        25),
  (-1,          -1,                   1000000,              0.00,         25),
  (0,           0,                    9999999999,           0.01,         25),
  (1,           1,                    9999999999999999999,  0.10,         25),
  (1000000,     1000000,              18446744073709551615, 99999999.99,  25),
  (2147483647,  9223372036854775807,  9999999999999999999,  0.10,         25),
  (NULL,        NULL,                 NULL,                 NULL,         25);

# Row set 6 (val=30)
INSERT INTO boundary_orderby (c_int, c_bigint, c_bigunsigned, c_decimal, val) VALUES
  (-2147483648, -9223372036854775808, 0,                    -99999999.99, 30),
  (-1000000,    -1000000,             1,                    -0.01,        30),
