# MIN / MAX over a CASE whose arms are both string columns.
#
# ronsql_exec_fixes_handoff.md section 4.1: RonSQL refuses CASE arms
# that mix strings with other values or strings of different types or
# collations (ronsql_case_arm_types ca-6), and the data nodes aggregate
# the all-string form. The printer took the charset of a string MIN /
# MAX only from a column argument, so for a CASE the query failed with
# "Could not find charset for string aggregation result", when printing
# and when sorting by the aggregate. It now takes the charset of the
# arms' columns.
#
# The arms differ in length (VARCHAR(10) / VARCHAR(20), CHAR(4) /
# CHAR(6)) and share latin1_swedish_ci. NdbSqlUtil::cmpChar compares
# CHAR values of one length only (a debug RDRS stopped on its assert in
# the merge of cm-2); string MIN / MAX results now compare with
# NdbSqlUtil::getStringResultCmp, which takes two CHAR lengths, in the
# data node, the NDB API merge and the printer. The values order differently
# under the collation and in binary ('apple' < 'Banana' < 'Zoo' vs
# 'Banana' < 'Zoo' < 'apple'), so a binary compare shows. Group 1
# takes both arms, group 2 only THEN and group 3 only ELSE.
#
#   cm-1  VARCHAR arms, GROUP BY
#   cm-2  CHAR arms, GROUP BY
#   cm-3  VARCHAR arms, no GROUP BY
#   cm-4  ORDER BY the MIN, which sorts with the charset
#   cm-5  cm-1 over a join (join aggregation in DBLQH)
#   cm-6  ORDER BY the MAX of CHAR arms of different lengths
#
# Expected results come from mysqld (strict_diff).

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--disable_query_log
--disable_warnings
CREATE TABLE cms (
  g  INT NOT NULL,
  id INT NOT NULL,
  k  INT NOT NULL,
  a  VARCHAR(10) CHARACTER SET latin1 COLLATE latin1_swedish_ci NOT NULL,
  b  VARCHAR(20) CHARACTER SET latin1 COLLATE latin1_swedish_ci NOT NULL,
  c1 CHAR(4) CHARACTER SET latin1 COLLATE latin1_swedish_ci NOT NULL,
  c2 CHAR(6) CHARACTER SET latin1 COLLATE latin1_swedish_ci NOT NULL,
  PRIMARY KEY (g, id)
) ENGINE=NDB;
# THEN arm: k > 5.
INSERT INTO cms VALUES
  (1, 1, 9, 'pear',  'zebra',  'dd', 'zz'),
  (1, 2, 2, 'kiwi',  'Banana', 'bb', 'Kk'),
  (1, 3, 7, 'apple', 'cherry', 'aa', 'xx'),
  (1, 4, 1, 'fig',   'Zoo',    'cc', 'Hh'),
  (2, 1, 8, 'Mango', 'aaa',    'Mm', 'aa'),
  (2, 2, 6, 'Lime',  'zzz',    'll', 'zz'),
  (3, 1, 0, 'zzz',   'Olive',  'zz', 'Oo'),
  (3, 2, 3, 'aaa',   'grape',  'aa', 'gg');
CREATE TABLE cms_drv (
  pk INT NOT NULL,
  g  INT NOT NULL,
  id INT NOT NULL,
  PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO cms_drv SELECT g * 100 + id, g, id FROM cms;
--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === cm-1: VARCHAR arms, GROUP BY ===
let $QUERY=
SELECT g,
MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn,
MAX(CASE WHEN k > 5 THEN a ELSE b END) AS mx
FROM cms GROUP BY g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT g,
MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn,
MAX(CASE WHEN k > 5 THEN a ELSE b END) AS mx
FROM cms GROUP BY g|

--echo
--echo === cm-2: CHAR arms, GROUP BY ===
let $QUERY=
SELECT g,
MIN(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mn,
MAX(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mx
FROM cms GROUP BY g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT g,
MIN(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mn,
MAX(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mx
FROM cms GROUP BY g|

--echo
--echo === cm-3: VARCHAR arms, no GROUP BY ===
let $QUERY=
SELECT MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn,
MAX(CASE WHEN k > 5 THEN a ELSE b END) AS mx
FROM cms;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn,
MAX(CASE WHEN k > 5 THEN a ELSE b END) AS mx
FROM cms|

--echo
--echo === cm-4: ORDER BY the MIN of VARCHAR arms ===
let $QUERY=
SELECT g, MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn
FROM cms GROUP BY g ORDER BY mn;|
--let $skip_sort=yes
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
SELECT g, MIN(CASE WHEN k > 5 THEN a ELSE b END) AS mn
FROM cms GROUP BY g ORDER BY mn|

--echo
--echo === cm-5: VARCHAR arms over a join ===
let $QUERY=
SELECT x.g,
MIN(CASE WHEN t.k > 5 THEN t.a ELSE t.b END) AS mn,
MAX(CASE WHEN t.k > 5 THEN t.a ELSE t.b END) AS mx
FROM cms_drv AS x
JOIN cms AS t ON t.g = x.g AND t.id = x.id
GROUP BY x.g;|
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
--sorted_result
SELECT x.g,
MIN(CASE WHEN t.k > 5 THEN t.a ELSE t.b END) AS mn,
MAX(CASE WHEN t.k > 5 THEN t.a ELSE t.b END) AS mx
FROM cms_drv AS x
JOIN cms AS t ON t.g = x.g AND t.id = x.id
GROUP BY x.g|

--echo
--echo === cm-6: ORDER BY the MAX of CHAR arms of different lengths ===
let $QUERY=
SELECT g, MAX(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mx
FROM cms GROUP BY g ORDER BY mx;|
--let $skip_sort=yes
--source suite/ronsql/include/ronsql_compare.inc
--echo == Expected result ==
SELECT g, MAX(CASE WHEN k > 5 THEN c1 ELSE c2 END) AS mx
FROM cms GROUP BY g ORDER BY mx|

DELIMITER ;|

--let $QUERY=

--disable_query_log
--disable_warnings
DROP TABLE cms_drv;
DROP TABLE cms;
--enable_warnings
--enable_query_log
