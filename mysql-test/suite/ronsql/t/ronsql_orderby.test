--source include/have_ndb.inc
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");

# RonSQL doesn't support time zones yet, and works as if in UTC.
SET time_zone = "+00:00";

--disable_query_log
CREATE TABLE orderby_test (
  pk               INT              NOT NULL AUTO_INCREMENT,
  c_tinyint        TINYINT          NULL,
  c_tinyunsigned   TINYINT UNSIGNED NULL,
  c_smallint       SMALLINT         NULL,
  c_smallunsigned  SMALLINT UNSIGNED NULL,
  c_mediumint      MEDIUMINT        NULL,
  c_mediumunsigned MEDIUMINT UNSIGNED NULL,
  c_int            INT              NULL,
  c_unsigned       INT UNSIGNED     NULL,
  c_bigint         BIGINT           NULL,
  c_bigunsigned    BIGINT UNSIGNED  NULL,
  c_float          FLOAT            NULL,
  c_double         DOUBLE           NULL,
  c_decimal        DECIMAL(10,2)    NULL,
  c_decunsigned    DECIMAL(10,2) UNSIGNED NULL,
  c_char           CHAR(20)    CHARACTER SET utf8mb4 NULL,
  c_varchar        VARCHAR(50)  CHARACTER SET utf8mb4 NULL,
  c_longvarchar    VARCHAR(300) CHARACTER SET utf8mb4 NULL,
  c_date           DATE             NULL,
  c_datetime       DATETIME(3)      NULL,
  c_timestamp      TIMESTAMP(3)     NULL,
  c_varbinary      VARBINARY(50)    NULL,
  c_time           TIME(3)          NULL,
  c_year           YEAR             NULL,
  c_bit            BIT(8)           NULL,
  val              INT              NOT NULL,
  PRIMARY KEY USING HASH (pk)
) ENGINE=NDB;

# Insert 32 rows: 7 non-NULL groups (G1-G7) x 4 rows + 4 NULL rows
# Values are intentionally NOT in sorted order for any column.
# Each group's 4 rows have val = 10, 20, 30, 40 (sum = 100).

# Rows 1-8: one row from each group
INSERT INTO orderby_test
  (c_tinyint, c_tinyunsigned, c_smallint, c_smallunsigned,
   c_mediumint, c_mediumunsigned, c_int, c_unsigned,
   c_bigint, c_bigunsigned,
   c_float, c_double, c_decimal, c_decunsigned,
   c_char, c_varchar, c_longvarchar,
   c_date, c_datetime, c_timestamp,
   c_varbinary, c_time, c_year, c_bit, val) VALUES
  # G1
  (50, 200, 12000, 50000,
   300000, 1500000, 50000, 3000000,
   500000000, 8000000000,
   2.0, 100.0, 42.99, 100.00,
   'grape', 'grape juice', 'grape is a fruit that grows on vines and is used for wine and juice',
   '2023-06-15', '2023-06-15 14:30:00.000', '2023-06-15 14:30:00.000',
   0x4731, '14:30:00.000', 2023, b'01010000', 10),
  # G2
  (-120, 0, -30000, 0,
   -5000000, 0, -2000000, 0,
   -9000000000, 0,
   -8.5, -1000.5, -500.50, 0.00,
   'apple', 'apple pie', 'apple is a popular fruit eaten raw or baked into delicious pies and crisps',
   '2019-03-15', '2019-03-15 08:00:00.000', '2019-03-15 08:00:00.000',
   0x4732, '08:00:00.000', 2019, b'00000010', 10),
  # G3
  (7, 42, 500, 1000,
   100, 42000, 7, 42,
   7, 42,
   0.5, 3.75, 3.33, 3.33,
   'fig', 'fig pudding', 'fig is a sweet fruit that can be eaten fresh or dried for later consumption',
   '2024-02-28', '2024-02-28 23:59:59.500', '2024-02-28 23:59:59.500',
   0x4733, '23:59:59.500', 2024, b'01000010', 10),
  # G4
  (127, 255, 32000, 65000,
   8000000, 16000000, 2100000000, 4200000000,
   9000000000000, 18000000000000,
   100.0, 99999.5, 999.99, 999.99,
   'Honeydew', 'Honeydew melon', 'Honeydew melon is a large sweet melon with pale green flesh and smooth rind',
   '2025-09-10', '2025-09-10 00:00:00.001', '2025-09-10 00:00:00.001',
   0x4734, '00:00:00.001', 2025, b'11111111', 10),
  # G5
  (-15, 5, -100, 15,
   -500, 5000, -100, 500,
   -500, 5000,
   -1.25, -50.125, -25.10, 0.50,
   'cherry', 'cherry tart', 'cherry is a small stone fruit that comes in sweet and sour varieties for eating',
   '2020-07-20', '2020-07-20 12:00:00.000', '2020-07-20 12:00:00.000',
   0x4735, '12:00:00.000', 2020, b'00001000', 10),
  # G6
  (0, 100, 0, 30000,
   0, 8000000, 0, 1000000,
   0, 1000000000,
   0.0, 0.0, 0.00, 42.99,
   'Banana', 'Banana split', 'Banana is a curved yellow fruit rich in potassium and commonly eaten as a snack',
   '2021-01-01', '2021-01-01 00:00:00.000', '2021-01-01 00:00:00.000',
   0x4736, '00:00:00.000', 2021, b'00000100', 10),
  # G7
  (80, 15, 20000, 5000,
   2000000, 100000, 800000, 80000,
   80000000000, 500000,
   10.75, 5000.25, 100.00, 500.50,
   'Date', 'Date cake', 'Date is a sweet tropical fruit from the date palm tree popular in Middle Eastern food',
   '2022-11-30', '2022-11-30 18:45:30.250', '2022-11-30 18:45:30.250',
   0x4737, '18:45:30.250', 2022, b'00010000', 10),
  # G_NULL
  (NULL, NULL, NULL, NULL,
   NULL, NULL, NULL, NULL,
   NULL, NULL,
   NULL, NULL, NULL, NULL,
   NULL, NULL, NULL,
   NULL, NULL, NULL,
   NULL, NULL, NULL, NULL, 10);

