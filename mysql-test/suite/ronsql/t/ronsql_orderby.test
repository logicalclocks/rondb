--echo Row count:
SELECT count(*) FROM orderby_test;

DELIMITER |;

#
# ===== Section A: ORDER BY ASC for every supported type =====
#

--echo
--echo
--echo
--echo ORDER BY c_tinyint ASC:
--let $skip_sort=yes
let $QUERY=
SELECT c_tinyint, count(*), sum(val)
FROM orderby_test
GROUP BY c_tinyint
ORDER BY c_tinyint;|
--source suite/ronsql/include/ronsql_compare.inc

