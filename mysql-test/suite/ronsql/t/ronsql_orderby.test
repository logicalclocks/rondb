--echo ORDER BY c_date DESC, c_decimal ASC:
--let $skip_sort=yes
let $QUERY=
SELECT c_date, c_decimal, count(*), sum(val)
FROM orderby_test
GROUP BY c_date, c_decimal
ORDER BY c_date DESC, c_decimal ASC;|
--source suite/ronsql/include/ronsql_compare.inc

--echo ORDER BY c_varchar ASC, c_tinyunsigned DESC:
--let $skip_sort=yes
let $QUERY=
SELECT c_varchar, c_tinyunsigned, count(*), sum(val)
FROM orderby_test
GROUP BY c_varchar, c_tinyunsigned
ORDER BY c_varchar ASC, c_tinyunsigned DESC;|
--source suite/ronsql/include/ronsql_compare.inc

--echo ORDER BY c_char ASC, c_double DESC, c_date ASC:
--let $skip_sort=yes
let $QUERY=
SELECT c_char, c_double, c_date, count(*), sum(val)
FROM orderby_test
GROUP BY c_char, c_double, c_date
ORDER BY c_char ASC, c_double DESC, c_date ASC;|
--source suite/ronsql/include/ronsql_compare.inc

#
# ===== Section D: ORDER BY with LIMIT =====
#

--echo
--echo
--echo
--echo ORDER BY c_int ASC LIMIT 3:
--let $skip_sort=yes
let $QUERY=
SELECT c_int, count(*), sum(val)
FROM orderby_test
GROUP BY c_int
ORDER BY c_int
LIMIT 3;|
--source suite/ronsql/include/ronsql_compare.inc

--echo ORDER BY c_varchar DESC LIMIT 5:
