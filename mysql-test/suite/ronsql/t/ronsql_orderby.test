let $QUERY=
SELECT c_varchar, count(*), sum(val)
FROM orderby_test
GROUP BY c_varchar
ORDER BY c_varchar DESC
LIMIT 5;|
--source suite/ronsql/include/ronsql_compare.inc

--echo ORDER BY c_date ASC, c_int DESC LIMIT 4:
--let $skip_sort=yes
let $QUERY=
SELECT c_date, c_int, count(*), sum(val)
FROM orderby_test
GROUP BY c_date, c_int
ORDER BY c_date ASC, c_int DESC
LIMIT 4;|
--source suite/ronsql/include/ronsql_compare.inc

