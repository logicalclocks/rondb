--source include/have_ndb.inc

call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--echo
--echo === Create tables for extended subquery aggregation tests ===
--echo

--disable_query_log
--disable_warnings

CREATE TABLE sq_entity (
  id INT NOT NULL,
  grp INT NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

CREATE TABLE sq_measures (
  entity_id INT NOT NULL,
  ts INT NOT NULL,
  val INT NOT NULL,
  PRIMARY KEY USING HASH (entity_id, ts),
  INDEX idx_measures_eid (entity_id)
) ENGINE=NDB;

CREATE TABLE sq_events (
  entity_id INT NOT NULL,
  ts INT NOT NULL,
  event_type INT NOT NULL,
  PRIMARY KEY USING HASH (entity_id, ts),
  INDEX idx_events_eid (entity_id)
) ENGINE=NDB;

# 6 entities: ids 1-4 have both measures and events,
# id 5 has measures only, id 6 has events only
INSERT INTO sq_entity VALUES
  (1, 1), (2, 1), (3, 2), (4, 2), (5, 3), (6, 3);

INSERT INTO sq_measures VALUES
  (1,1,10),(1,2,20),(1,3,30),
  (2,1,40),(2,2,50),(2,3,60),
  (3,1,70),(3,2,80),(3,3,90),
  (4,1,100),(4,2,110),(4,3,120),
  (5,1,500),(5,2,600),(5,3,700);

INSERT INTO sq_events VALUES
  (1,1,1),(1,2,2),
  (2,1,3),(2,2,4),
  (3,1,5),(3,2,6),
  (4,1,7),(4,2,8),
  (6,1,9),(6,2,10);

--enable_warnings
--enable_query_log

--let $MYSQL= $MYSQL --init-command-add='SET sql_mode=""'

DELIMITER |;

# =========================================================================
# Category A: WHERE filters on outer table
# =========================================================================

--echo
--echo === A1: WHERE e.grp = 1 (equality filter on root) ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.grp = 1;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.grp = 1|

# =========================================================================

--echo
--echo
--echo === A2: WHERE e.id > 3 (range filter) ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.id > 3;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.id > 3|

# =========================================================================

--echo
--echo
--echo === A3: WHERE e.id = 1 (single root row) ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.id = 1;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.id = 1|

# =========================================================================
# Category C: Mixed output column types
# =========================================================================

--echo
--echo
--echo === C1: Regular columns interleaved with subquery outputs ===

let $QUERY=
SELECT e.id, e.grp,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id, e.grp,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e|

# =========================================================================

--echo
--echo
--echo === C2: Subquery output between regular columns ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  e.grp
FROM sq_entity AS e;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  e.grp
FROM sq_entity AS e|

# =========================================================================
# Category D: Extended HAVING
# =========================================================================

--echo
--echo
--echo === D1: HAVING compound AND ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
HAVING sum_val > 100 AND cnt_evt > 0;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
HAVING sum_val > 100 AND cnt_evt > 0|

# =========================================================================

--echo
--echo
--echo === D2: HAVING IS NULL (select only entities with no measures) ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
HAVING sum_val IS NULL;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
HAVING sum_val IS NULL|

# =========================================================================

--echo
--echo
--echo === D3: HAVING multiple conditions ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
HAVING cnt_evt >= 2 AND sum_val < 200;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
HAVING cnt_evt >= 2 AND sum_val < 200|

# =========================================================================

--echo
--echo
--echo === D4: WHERE + HAVING combined ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.grp = 2
HAVING sum_val > 200;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM sq_entity AS e
WHERE e.grp = 2
HAVING sum_val > 200|

# =========================================================================

# =========================================================================
# Category B: WHERE filters on inner subquery tables
# =========================================================================

--echo
--echo
--echo === B1: Inner WHERE filter (m.ts > 1) reduces child rows ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id AND m.ts > 1) AS sum_val
FROM sq_entity AS e;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id AND m.ts > 1) AS sum_val
FROM sq_entity AS e|

# =========================================================================

--echo
--echo
--echo === B2: Two subqueries with different inner filters ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id AND m.ts <= 2) AS sum_early,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id AND ev.event_type > 3) AS cnt_high
FROM sq_entity AS e;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id AND m.ts <= 2) AS sum_early,
  (SELECT COUNT(ev.event_type) FROM sq_events AS ev WHERE ev.entity_id = e.id AND ev.event_type > 3) AS cnt_high
FROM sq_entity AS e|

# =========================================================================

--echo
--echo
--echo === B3: Inner filter eliminates all rows for some entities ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id AND m.val > 500) AS sum_big
FROM sq_entity AS e;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id AND m.val > 500) AS sum_big
FROM sq_entity AS e|

# =========================================================================
# Category E: Large dataset stress with filters
# =========================================================================

DELIMITER ;|
--echo
--echo === Create large tables for stress tests ===

--disable_query_log
DROP TABLE IF EXISTS lg_events;
DROP TABLE IF EXISTS lg_measures;
DROP TABLE IF EXISTS lg_entity;

CREATE TABLE lg_entity (
  id INT NOT NULL,
  grp INT NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB
COMMENT='NDB_TABLE=PARTITION_BALANCE=FOR_RP_BY_LDM_X_2';

CREATE TABLE lg_measures (
  entity_id INT NOT NULL,
  ts INT NOT NULL,
  val INT NOT NULL,
  PRIMARY KEY USING HASH (entity_id, ts),
  INDEX idx_lg_meas_eid (entity_id)
) ENGINE=NDB
COMMENT='NDB_TABLE=PARTITION_BALANCE=FOR_RP_BY_LDM_X_2';

CREATE TABLE lg_events (
  entity_id INT NOT NULL,
  ts INT NOT NULL,
  event_type INT NOT NULL,
  PRIMARY KEY USING HASH (entity_id, ts),
  INDEX idx_lg_evt_eid (entity_id)
) ENGINE=NDB
COMMENT='NDB_TABLE=PARTITION_BALANCE=FOR_RP_BY_LDM_X_2';

--delimiter $
CREATE PROCEDURE populate_lg()
BEGIN
  DECLARE i INT DEFAULT 1;
  DECLARE g INT;
  DECLARE j INT;
  WHILE i <= 200 DO
    SET g = ((i - 1) % 50) + 1;
    INSERT INTO lg_entity VALUES (i, g);
    SET j = 1;
    WHILE j <= 5 DO
      INSERT INTO lg_measures VALUES (i, j, i * 10 + j);
      SET j = j + 1;
    END WHILE;
    SET j = 1;
    WHILE j <= 3 DO
      INSERT INTO lg_events VALUES (i, j, g);
      SET j = j + 1;
    END WHILE;
    SET i = i + 1;
  END WHILE;
END$
--delimiter ;
CALL populate_lg();
DROP PROCEDURE populate_lg;
--enable_query_log

DELIMITER |;

--echo
--echo
--echo === E1: Large dataset with WHERE filter on root ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM lg_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM lg_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM lg_entity AS e
WHERE e.grp <= 3;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result (first 5) ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM lg_measures AS m WHERE m.entity_id = e.id) AS sum_val,
  (SELECT COUNT(ev.event_type) FROM lg_events AS ev WHERE ev.entity_id = e.id) AS cnt_evt
FROM lg_entity AS e
WHERE e.grp <= 3
LIMIT 5|

# =========================================================================

--echo
--echo
--echo === E2: Large dataset with inner filter + WHERE ===

let $QUERY=
SELECT e.id,
  (SELECT SUM(m.val) FROM lg_measures AS m WHERE m.entity_id = e.id AND m.ts <= 2) AS sum_early,
  (SELECT MAX(ev.event_type) FROM lg_events AS ev WHERE ev.entity_id = e.id) AS max_evt
FROM lg_entity AS e
WHERE e.id <= 50;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result (first 5) ==
--sorted_result
SELECT e.id,
  (SELECT SUM(m.val) FROM lg_measures AS m WHERE m.entity_id = e.id AND m.ts <= 2) AS sum_early,
  (SELECT MAX(ev.event_type) FROM lg_events AS ev WHERE ev.entity_id = e.id) AS max_evt
FROM lg_entity AS e
WHERE e.id <= 50
LIMIT 5|

# =========================================================================

# =========================================================================
# Category H: Rejection tests — verify error messages for unsupported patterns
# Send query via RDRS and check for expected error text in response.
# =========================================================================

DELIMITER ;|

--echo
--echo
--echo === H1: Inner subquery with JOIN (unsupported) ===

--exec printf '{"query":"SELECT e.id, (SELECT SUM(m.val) FROM sq_measures AS m JOIN sq_events AS ev ON ev.entity_id = m.entity_id WHERE m.entity_id = e.id) AS sv FROM sq_entity AS e;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--echo H1 response:
--exec grep -o 'subquery with JOIN is not supported' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected rejection for inner JOIN"

--echo
--echo === H2: Inner subquery without correlation (unsupported) ===

--exec printf '{"query":"SELECT e.id, (SELECT SUM(m.val) FROM sq_measures AS m) AS sv FROM sq_entity AS e;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--echo H2 response:
--exec grep -o 'must have a WHERE clause with correlation' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected rejection for missing correlation"

--echo
--echo === H3: Inner subquery with GROUP BY (unsupported) ===

--exec printf '{"query":"SELECT e.id, (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id GROUP BY m.ts) AS sv FROM sq_entity AS e;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--echo H3 response:
--exec grep -o 'must not have GROUP BY' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected rejection for inner GROUP BY"

--echo
--echo === H4: Inner subquery with non-aggregate output (unsupported) ===

--exec printf '{"query":"SELECT e.id, (SELECT m.val FROM sq_measures AS m WHERE m.entity_id = e.id) AS sv FROM sq_entity AS e;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--echo H4 response:
--exec grep -o 'output must be an aggregate function' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected rejection for non-aggregate output"

--echo
--echo === H5: Outer query with GROUP BY + subqueries (unsupported) ===

--exec printf '{"query":"SELECT e.grp, (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id) AS sv FROM sq_entity AS e GROUP BY e.grp;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--echo H5 response:
--exec grep -o 'GROUP BY are not yet supported' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected rejection for outer GROUP BY"

# =========================================================================

--echo
--echo === Cleanup ===

--disable_query_log
DROP TABLE IF EXISTS lg_events;
DROP TABLE IF EXISTS lg_measures;
DROP TABLE IF EXISTS lg_entity;
DROP TABLE IF EXISTS sq_events;
DROP TABLE IF EXISTS sq_measures;
DROP TABLE IF EXISTS sq_entity;
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs.out
--enable_query_log
