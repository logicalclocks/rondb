--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# Phase I.12 - RonSQL coverage of testCteNdbApiOuterJoin.cpp.
#
# Tests 5 and 6 are aggregate queries that bypass the non-aggregate
# gate at RonSQLPreparer.cpp:540-636.  They lock in the kernel-side
# outer-join + linked-attr machinery as working through RonSQL.
#
# Tests 1, 2, 3 are projection-only queries that today hit the
# non-aggregate gate.  The gate accepts only:
#   - `FROM <cte>` projection-only with no joins (Phase E.3), or
#   - `FROM <real_table>` projection-only INNER chain with
#     complete-key CTE_LOOKUP joins (I.8 + I.11).
# I.12 extends the gate with two relaxations:
#   A. Accept `FROM <cte>` projection-only WITH joins (Tests 1, 2).
#   B. Accept LEFT_OUTER joins in the chain (Tests 2, 3).
#
# Test 1: scanCte INNER JOIN readTuple (Phase 2 baseline).
# Test 2: scanCte LEFT JOIN readTuple (Phase 2).
# Test 3: scanTable LEFT JOIN lookupCte (Phase 1).
# Test 5: scalar main aggregation over `oj_rhs LEFT JOIN cte0`
#         (Phase 5 NULL-injection on agg-feed).
# Test 6: `cte0 JOIN oj_rhs` with main aggregator on the real-table
#         leaf, GROUP BY linked CTE virt-column (Phase E.1K).

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--disable_query_log
--disable_warnings

CREATE TABLE oj_cte_src (
  pk  INT NOT NULL,
  grp INT NOT NULL,
  val INT NOT NULL,
  PRIMARY KEY USING HASH (pk)
) ENGINE=NDB;

CREATE INDEX idx_oj_cte_src_grp ON oj_cte_src (grp);

CREATE TABLE oj_rhs (
  id    INT NOT NULL,
  label VARCHAR(16) NOT NULL,
  PRIMARY KEY USING HASH (id)
) ENGINE=NDB;

INSERT INTO oj_cte_src VALUES
  (1,1,10),
  (2,1,20),
  (3,2,30),
  (4,2,40),
  (5,3,50);

INSERT INTO oj_rhs VALUES
  (1,'one'),
  (3,'three'),
  (5,'five');

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo
--echo === Test 1: scanCte INNER JOIN readTuple (projection-only) ===

# CTE 0 yields {(1,30),(2,70),(3,50)}; oj_rhs ids = {1,3,5}.  INNER
# JOIN drops grp=2 (no oj_rhs match) and id=5 (no cte0 match).
# Expected rows: (1,30,'one'), (3,50,'three').
# Note: oj_rhs id=3 has label 'three'; cte0 grp=3 SUM(val)=50.

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT cte0.k AS g, cte0.total AS t, oj_rhs.label AS lbl
FROM cte0
JOIN oj_rhs ON oj_rhs.id = cte0.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT cte0.k AS g, cte0.total AS t, oj_rhs.label AS lbl
FROM cte0
JOIN oj_rhs ON oj_rhs.id = cte0.k|

--echo
--echo
--echo === Test 2: scanCte LEFT JOIN readTuple (projection-only) ===

# Same shape as Test 1 but LEFT JOIN: all 3 cte0 groups survive;
# grp=2 has no oj_rhs match -> NULL label.
# Expected: (1,30,'one'), (2,70,NULL), (3,50,'three').

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT cte0.k AS g, cte0.total AS t, oj_rhs.label AS lbl
FROM cte0
LEFT JOIN oj_rhs ON oj_rhs.id = cte0.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT cte0.k AS g, cte0.total AS t, oj_rhs.label AS lbl
FROM cte0
LEFT JOIN oj_rhs ON oj_rhs.id = cte0.k|

--echo
--echo
--echo === Test 3: scanTable LEFT JOIN lookupCte (projection-only) ===

# oj_rhs ids = {1,3,5}; cte0 groups = {1,2,3}.  All 3 oj_rhs rows
# survive; id=5 has no cte0 match -> NULL cte columns.
# Expected: (1,'one',1,30), (3,'three',3,50), (5,'five',NULL,NULL).

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT oj_rhs.id AS rid, oj_rhs.label AS lbl,
       cte0.k AS g, cte0.total AS t
FROM oj_rhs
LEFT JOIN cte0 ON cte0.k = oj_rhs.id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT oj_rhs.id AS rid, oj_rhs.label AS lbl,
       cte0.k AS g, cte0.total AS t
FROM oj_rhs
LEFT JOIN cte0 ON cte0.k = oj_rhs.id|

--echo
--echo
--echo === Test 5: scalar main aggregation over LEFT JOIN cte (NULL-injection) ===

# CTE 0 yields {(1,30),(2,70),(3,50)}; oj_rhs has id={1,3,5}.
#   id=1 -> cte0(1) -> total=30
#   id=3 -> cte0(3) -> total=50
#   id=5 -> no cte0 match -> NULL row injected; SUM ignores NULL but
#           COUNT(*) still counts the parent row.
# Expected: cnt=3, s=80.

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT COUNT(*) AS cnt, SUM(cte0.total) AS s
FROM oj_rhs
LEFT JOIN cte0 ON cte0.k = oj_rhs.id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT COUNT(*) AS cnt, SUM(cte0.total) AS s
FROM oj_rhs
LEFT JOIN cte0 ON cte0.k = oj_rhs.id|

--echo
--echo
--echo === Test 6: scanCte parent + main aggregator on real leaf with linked CTE GROUP BY ===

# scanCte(0) INNER JOIN readTuple(oj_rhs, id = cte.k); the main
# aggregator sits on the real-table leaf.  GROUP BY cte0.k uses
# DBSPJ appendFromParent (Path 2) into the main aggregator's
# linked-attr buffer (Phase E.1K).
# CTE 0 = {(1,30),(2,70),(3,50)}, oj_rhs ids = {1,3,5}.
# INNER JOIN drops grp=2.  Expected: (1,30), (3,50).

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT cte0.k AS g, SUM(cte0.total) AS s
FROM cte0
JOIN oj_rhs ON oj_rhs.id = cte0.k
GROUP BY cte0.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM oj_cte_src GROUP BY grp)
SELECT cte0.k AS g, SUM(cte0.total) AS s
FROM cte0
JOIN oj_rhs ON oj_rhs.id = cte0.k
GROUP BY cte0.k|

DELIMITER ;|

--echo
--echo
--echo === Cleanup ===

--disable_query_log
DROP TABLE oj_cte_src;
DROP TABLE oj_rhs;
--enable_query_log
