--echo
--echo
--echo === R25: Events in timestamp range per customer ===

let $QUERY=
SELECT c.customer_id, COUNT(*)
FROM fv_customers AS c
JOIN fv_events AS e ON e.customer_id = c.customer_id
WHERE e.ts >= 2000 AND e.ts < 5000
GROUP BY c.customer_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.customer_id, COUNT(*)
FROM fv_customers AS c
JOIN fv_events AS e ON e.customer_id = c.customer_id
WHERE e.ts >= 2000 AND e.ts < 5000
GROUP BY c.customer_id|

--echo
--echo
--echo === R26: Recent events only (ts >= 5000) per segment ===

let $QUERY=
SELECT c.segment, COUNT(*)
FROM fv_customers AS c
JOIN fv_events AS e ON e.customer_id = c.customer_id
WHERE e.ts >= 5000
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, COUNT(*)
FROM fv_customers AS c
JOIN fv_events AS e ON e.customer_id = c.customer_id
WHERE e.ts >= 5000
GROUP BY c.segment|

--echo
--echo
--echo === R27: Time range + event type filter ===

let $QUERY=
SELECT c.customer_id, COUNT(*)
FROM fv_customers AS c
JOIN fv_events AS e ON e.customer_id = c.customer_id
WHERE e.ts >= 1000 AND e.ts < 4000 AND e.event_type = 1
GROUP BY c.customer_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.customer_id, COUNT(*)
FROM fv_customers AS c
JOIN fv_events AS e ON e.customer_id = c.customer_id
WHERE e.ts >= 1000 AND e.ts < 4000 AND e.event_type = 1
GROUP BY c.customer_id|

--echo
--echo
--echo === R28: Date-range filtered transactions ===

let $QUERY=
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE t.tx_date >= 20260201 AND t.tx_date < 20260315
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, COUNT(*), SUM(t.amount)
