--perl
use strict;
my $dir = $ENV{'MYSQLTEST_VARDIR'};
open(FILE, ">", "$dir/tmp/gen_scale_data.sql") or die "Cannot open: $!";
my @cust_vals;
for my $i (1..120) {
  my $seg = ($i % 4) + 1;
  my $reg = ($i % 3) + 1;
  push @cust_vals, "($i,$seg,$reg)";
}
print FILE "INSERT INTO fv_customers_large VALUES " . join(",", @cust_vals) . ";\n";
my @tx_vals;
my $tx_id = 1;
for my $cid (1..120) {
  my $ntx = ($cid % 3 == 0) ? 3 : 2;
  for my $j (1..$ntx) {
    my $amount = 100 + ($cid * 7 + $j * 13) % 900;
    my $tx_date = 20260101 + int(($cid - 1) / 4);
    my $cat = ($tx_id % 3) + 1;
    push @tx_vals, "($tx_id,$cid,$amount,$tx_date,$cat)";
    $tx_id++;
  }
}
print FILE "INSERT INTO fv_txn_large VALUES " . join(",", @tx_vals) . ";\n";
close(FILE);
EOF
--source $MYSQLTEST_VARDIR/tmp/gen_scale_data.sql
--remove_file $MYSQLTEST_VARDIR/tmp/gen_scale_data.sql

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo
--echo === R1: Star join SUM GROUP BY segment ===

let $QUERY=
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment|

--echo
--echo
--echo === R2: Star join COUNT and SUM GROUP BY segment ===

let $QUERY=
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment|

--echo
--echo
--echo === R3: Star join all aggregate types ===

let $QUERY=
SELECT c.segment, COUNT(*), SUM(t.amount), MIN(t.amount), MAX(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, COUNT(*), SUM(t.amount), MIN(t.amount), MAX(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment|

--echo
--echo
--echo === R4: Snowflake 4-way SUM(price) GROUP BY segment ===

let $QUERY=
SELECT c.segment, SUM(p.price)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
JOIN fv_tx_products AS tp ON tp.tx_id = t.tx_id
JOIN fv_products AS p ON p.product_id = tp.product_id
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, SUM(p.price)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
JOIN fv_tx_products AS tp ON tp.tx_id = t.tx_id
JOIN fv_products AS p ON p.product_id = tp.product_id
GROUP BY c.segment|

--echo
--echo
--echo === R5: Snowflake GROUP BY leaf column (product_type) ===

let $QUERY=
SELECT p.product_type, COUNT(*)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
JOIN fv_tx_products AS tp ON tp.tx_id = t.tx_id
JOIN fv_products AS p ON p.product_id = tp.product_id
GROUP BY p.product_type;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT p.product_type, COUNT(*)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
JOIN fv_tx_products AS tp ON tp.tx_id = t.tx_id
JOIN fv_products AS p ON p.product_id = tp.product_id
GROUP BY p.product_type|

--echo
--echo
--echo === R6: Filter on root (region=1) ===

let $QUERY=
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE c.region = 1
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE c.region = 1
GROUP BY c.segment|

--echo
--echo
--echo === R7: Filter on child (category=2) ===

let $QUERY=
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE t.category = 2
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE t.category = 2
GROUP BY c.segment|

--echo
--echo
--echo === R8: Combined filters (region=1 AND category=2) ===

let $QUERY=
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE c.region = 1 AND t.category = 2
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE c.region = 1 AND t.category = 2
GROUP BY c.segment|

--echo
--echo
--echo === R9: LEFT JOIN sparse features ===

let $QUERY=
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment|

--echo
--echo
--echo === R10: COUNT star vs COUNT column ===

let $QUERY=
SELECT COUNT(*), COUNT(t.tx_id)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
SELECT COUNT(*), COUNT(t.tx_id)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id|

--echo
--echo
--echo === R11: Multi-level outer join snowflake ===

let $QUERY=
SELECT c.segment, COUNT(*), SUM(p.price)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id
LEFT JOIN fv_tx_products AS tp ON tp.tx_id = t.tx_id
LEFT JOIN fv_products AS p ON p.product_id = tp.product_id
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, COUNT(*), SUM(p.price)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id
LEFT JOIN fv_tx_products AS tp ON tp.tx_id = t.tx_id
LEFT JOIN fv_products AS p ON p.product_id = tp.product_id
GROUP BY c.segment|

--echo
--echo
--echo === R12: Arithmetic expression SUM(amount * category) ===

let $QUERY=
SELECT c.segment, SUM(t.amount * t.category)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, SUM(t.amount * t.category)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment|

--echo
--echo
--echo === R13: Multi-level GROUP BY (segment, category) ===

let $QUERY=
SELECT c.segment, t.category, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment, t.category;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, t.category, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment, t.category|

--echo
--echo
--echo === R14: Global aggregation (no GROUP BY) ===

let $QUERY=
SELECT COUNT(*), SUM(t.amount), MIN(t.amount), MAX(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
SELECT COUNT(*), SUM(t.amount), MIN(t.amount), MAX(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id|

--echo
--echo
--echo === R15: AVG aggregation ===

let $QUERY=
SELECT c.segment, AVG(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, AVG(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment|

--echo
--echo
--echo === R16: HAVING filter on aggregate ===

let $QUERY=
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment
HAVING SUM(t.amount) > 500;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment
HAVING SUM(t.amount) > 500|

--echo
--echo
--echo === R17: ORDER BY aggregate DESC with LIMIT (DISABLED - needs RonSQL alias support) ===

