--echo
--echo
--echo === R23: Full feature vector per segment (5 agg types) ===

let $QUERY=
SELECT c.segment, COUNT(*), SUM(t.amount), MIN(t.amount), MAX(t.amount), AVG(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment;|
