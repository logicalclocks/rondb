--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings
# ronsql_cli does not properly refresh NDB dictionary cache for join queries,
# causing "Invalid schema version (code 1227)" errors. Suppress ronsql_cli
# and rely on RDRS comparison (which handles schema refresh correctly).
--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--echo
--echo === Create tables for feature view aggregation tests ===
--echo

--disable_query_log
--disable_warnings

CREATE TABLE fv_customers (
  customer_id INT NOT NULL,
  segment INT NOT NULL,
  region INT NOT NULL,
  PRIMARY KEY USING HASH (customer_id)
) ENGINE=NDB;

CREATE TABLE fv_transactions (
  tx_id INT NOT NULL,
  customer_id INT NOT NULL,
  amount BIGINT NOT NULL,
  tx_date INT NOT NULL,
  category INT NOT NULL,
  PRIMARY KEY USING HASH (tx_id),
  INDEX ix_cust (customer_id)
) ENGINE=NDB;

CREATE TABLE fv_products (
  product_id INT NOT NULL,
  product_type INT NOT NULL,
  price BIGINT NOT NULL,
  PRIMARY KEY USING HASH (product_id)
) ENGINE=NDB;

CREATE TABLE fv_tx_products (
  tx_id INT NOT NULL,
  product_id INT NOT NULL,
  PRIMARY KEY USING HASH (tx_id)
) ENGINE=NDB;

CREATE TABLE fv_events (
  event_id INT NOT NULL,
  customer_id INT NOT NULL,
  event_type INT NOT NULL,
  ts INT NOT NULL,
  PRIMARY KEY USING HASH (event_id),
  INDEX ix_cust_ts (customer_id, ts)
) ENGINE=NDB;

CREATE TABLE fv_orders (
  order_id INT NOT NULL,
  customer_id INT NOT NULL,
  order_date INT NOT NULL,
  status INT NOT NULL,
  PRIMARY KEY USING HASH (order_id),
  INDEX ix_cust_date (customer_id, order_date)
) ENGINE=NDB;

CREATE TABLE fv_order_items (
  item_id INT NOT NULL,
  order_id INT NOT NULL,
  product_id INT NOT NULL,
  quantity INT NOT NULL,
  unit_price BIGINT NOT NULL,
  PRIMARY KEY USING HASH (item_id),
  INDEX ix_order (order_id)
) ENGINE=NDB;

CREATE TABLE fv_customers_large (
  customer_id INT NOT NULL,
  segment INT NOT NULL,
  region INT NOT NULL,
  PRIMARY KEY USING HASH (customer_id)
) ENGINE=NDB;

CREATE TABLE fv_txn_large (
  tx_id INT NOT NULL,
  customer_id INT NOT NULL,
  amount BIGINT NOT NULL,
  tx_date INT NOT NULL,
  category INT NOT NULL,
  PRIMARY KEY USING HASH (tx_id),
  INDEX ix_cust (customer_id)
) ENGINE=NDB;

