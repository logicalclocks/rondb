SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE c.region = 999
GROUP BY c.segment|

--echo
--echo
--echo === R19: LEFT JOIN with filter on root ===

let $QUERY=
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE c.region = 1
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.segment, COUNT(*), SUM(t.amount)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE c.region = 1
GROUP BY c.segment|

--echo
--echo
--echo === R20: Outer join with HAVING ===

let $QUERY=
SELECT c.segment, COUNT(*)
FROM fv_customers AS c
LEFT JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment
HAVING COUNT(*) > 2;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
