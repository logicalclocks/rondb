--echo == Expected result ==
SELECT c.segment, SUM(t.amount) AS total
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
GROUP BY c.segment
ORDER BY total DESC
LIMIT 2|

--echo
--echo
--echo === R18: Empty result (no matching filter) ===

let $QUERY=
SELECT c.segment, SUM(t.amount)
FROM fv_customers AS c
JOIN fv_transactions AS t ON t.customer_id = c.customer_id
WHERE c.region = 999
GROUP BY c.segment;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
