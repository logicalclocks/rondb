--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# Phase I.11 — RonSQL coverage of testCteNdbApi.cpp Tests 12-16.
#
# These tests exercise CTE operation placements that are already covered
# by NDB API/kernel tests, but need RonSQL SQL-level coverage:
#   Test 12: lookupCte as CTE materialisation root + child
#   Test 13: lookupCte as main-query internal node
#   Test 14: lookupCte as CTE materialisation internal node
#   Test 15: scanCte as main-query aggregate leaf
#   Test 16: scanCte as CTE materialisation root non-leaf

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--disable_query_log
--disable_warnings

CREATE TABLE cte_src (
  pk  INT NOT NULL,
  grp INT NOT NULL,
  val INT NOT NULL,
  PRIMARY KEY USING HASH (pk)
) ENGINE=NDB;

CREATE INDEX idx_cte_src_grp ON cte_src (grp);

INSERT INTO cte_src VALUES
  (1,1,10),
  (2,1,20),
  (3,2,30),
  (4,2,40),
  (5,3,50);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo
--echo === Test 12: lookupCte as CTE materialisation root + child ===

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp),
     cte1 AS (SELECT s.grp AS grp, SUM(s.val) AS total
              FROM cte0
              JOIN cte_src AS s ON s.pk = cte0.k
              WHERE cte0.k = 1
              GROUP BY s.grp)
SELECT grp, total FROM cte1;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp),
     cte1 AS (SELECT s.grp AS grp, SUM(s.val) AS total
              FROM cte0
              JOIN cte_src AS s ON s.pk = cte0.k
              WHERE cte0.k = 1
              GROUP BY s.grp)
SELECT grp, total FROM cte1|

--echo
--echo
--echo === Test 13: lookupCte as main-query internal node ===

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp)
SELECT m.pk AS pk, m.grp AS grp, cte0.k AS c_grp,
       cte0.total AS total, s2.pk AS s2_pk, s2.val AS val
FROM cte_src AS m
JOIN cte0 ON cte0.k = m.grp
JOIN cte_src AS s2 ON s2.pk = cte0.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp)
SELECT m.pk AS pk, m.grp AS grp, cte0.k AS c_grp,
       cte0.total AS total, s2.pk AS s2_pk, s2.val AS val
FROM cte_src AS m
JOIN cte0 ON cte0.k = m.grp
JOIN cte_src AS s2 ON s2.pk = cte0.k|

--echo
--echo
--echo === Test 14: lookupCte as CTE materialisation internal node ===

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp),
     cte1 AS (SELECT s2.grp AS grp, SUM(s2.val) AS total
              FROM cte_src AS s1
              JOIN cte0 ON cte0.k = s1.grp
              JOIN cte_src AS s2 ON s2.pk = cte0.k
              GROUP BY s2.grp)
SELECT grp, total FROM cte1;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp),
     cte1 AS (SELECT s2.grp AS grp, SUM(s2.val) AS total
              FROM cte_src AS s1
              JOIN cte0 ON cte0.k = s1.grp
              JOIN cte_src AS s2 ON s2.pk = cte0.k
              GROUP BY s2.grp)
SELECT grp, total FROM cte1|

--echo
--echo
--echo === Test 15: scanCte as main-query aggregate leaf ===

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp)
SELECT COUNT(*) AS cnt, SUM(cte0.total) AS s
FROM cte0;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp)
SELECT COUNT(*) AS cnt, SUM(cte0.total) AS s
FROM cte0|

--echo
--echo
--echo === Test 16: scanCte as CTE materialisation root non-leaf ===

let $QUERY=
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp),
     cte1 AS (SELECT s.grp AS grp, SUM(s.val) AS total
              FROM cte0
              JOIN cte_src AS s ON s.pk = cte0.k
              GROUP BY s.grp)
SELECT grp, total FROM cte1;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH cte0 AS (SELECT grp AS k, SUM(val) AS total
              FROM cte_src GROUP BY grp),
     cte1 AS (SELECT s.grp AS grp, SUM(s.val) AS total
              FROM cte0
              JOIN cte_src AS s ON s.pk = cte0.k
              GROUP BY s.grp)
SELECT grp, total FROM cte1|

DELIMITER ;|

--echo
--echo
--echo === Cleanup ===

--disable_query_log
DROP TABLE cte_src;
--enable_query_log
