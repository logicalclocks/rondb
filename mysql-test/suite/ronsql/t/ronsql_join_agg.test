FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_custkey|

--echo
--echo
--echo === Test 17: Expression inside aggregate ===

let $QUERY=
SELECT o.o_custkey, SUM(l.l_quantity * l.l_price)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_custkey;|
