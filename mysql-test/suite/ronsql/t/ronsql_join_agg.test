--echo == Expected result ==
--sorted_result
SELECT o1.o_status, COUNT(*)
FROM orders AS o1 JOIN orders AS o2 ON o2.o_custkey = o1.o_custkey
GROUP BY o1.o_status|

--echo
--echo
--echo === Test 39: Self-join with SUM ===

let $QUERY=
SELECT o1.o_custkey, SUM(o2.o_id)
FROM orders AS o1 JOIN orders AS o2 ON o2.o_custkey = o1.o_custkey
GROUP BY o1.o_custkey;|
