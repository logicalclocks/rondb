--source include/have_ndb.inc

call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");

--echo
--echo === Create tables for join aggregation tests ===
--echo

--disable_query_log
--disable_warnings

CREATE TABLE orders (
  o_id INT NOT NULL,
  o_custkey INT NOT NULL,
  o_status VARCHAR(10) NOT NULL,
  PRIMARY KEY USING HASH (o_id)
) ENGINE=NDB;

CREATE TABLE lineitem (
  l_id INT NOT NULL,
  l_orderkey INT NOT NULL,
  l_quantity INT NOT NULL,
  l_price INT NOT NULL,
  PRIMARY KEY USING HASH (l_id),
  INDEX idx_orderkey (l_orderkey)
) ENGINE=NDB;

INSERT INTO orders VALUES
  (1, 100, 'open'),
  (2, 100, 'closed'),
  (3, 200, 'open'),
  (4, 200, 'open'),
  (5, 300, 'closed');

INSERT INTO lineitem VALUES
  (1, 1, 10, 100),
  (2, 1, 20, 200),
  (3, 2, 5, 50),
  (4, 2, 15, 150),
  (5, 3, 30, 300),
  (6, 3, 25, 250),
  (7, 4, 8, 80),
  (8, 4, 12, 120),
  (9, 5, 40, 400),
  (10, 5, 35, 350);

CREATE TABLE customer (
  c_id INT NOT NULL,
  c_name VARCHAR(20) NOT NULL,
  c_region INT NOT NULL,
  PRIMARY KEY USING HASH (c_id)
) ENGINE=NDB;

CREATE INDEX idx_custkey ON orders (o_custkey);
CREATE INDEX idx_oid ON orders (o_id);

INSERT INTO customer VALUES
  (100, 'Alice', 1),
  (200, 'Bob', 1),
  (300, 'Charlie', 2);

CREATE TABLE order_extra (
  oe_orderid INT NOT NULL,
  oe_custkey INT NOT NULL,
  oe_note_val INT NOT NULL,
  PRIMARY KEY USING HASH (oe_orderid, oe_custkey)
) ENGINE=NDB;

INSERT INTO order_extra VALUES
  (1, 100, 10),
  (2, 100, 20),
  (3, 200, 30),
  (4, 200, 40),
  (5, 300, 50);

CREATE TABLE suppliers (
  s_id INT NOT NULL,
  s_name VARCHAR(20) NOT NULL,
  s_code VARCHAR(10) NOT NULL,
  PRIMARY KEY USING HASH (s_id)
) ENGINE=NDB;

CREATE INDEX idx_scode ON suppliers (s_code);

CREATE TABLE parts (
  p_id BIGINT NOT NULL,
  p_suppcode VARCHAR(10) NOT NULL,
  p_price INT NOT NULL,
  PRIMARY KEY USING HASH (p_id)
) ENGINE=NDB;

CREATE INDEX idx_suppcode ON parts (p_suppcode);

CREATE TABLE shipments (
  sh_id INT NOT NULL,
  sh_partid BIGINT NOT NULL,
  sh_date DATE NOT NULL,
  sh_qty INT NOT NULL,
  PRIMARY KEY USING HASH (sh_id)
) ENGINE=NDB;

CREATE INDEX idx_partid ON shipments (sh_partid);

CREATE TABLE activities (
  a_id INT NOT NULL,
  a_date DATE NOT NULL,
  a_type VARCHAR(10) NOT NULL,
  a_amount INT NOT NULL,
  PRIMARY KEY USING HASH (a_id)
) ENGINE=NDB;

CREATE INDEX idx_adate ON activities (a_date);

INSERT INTO suppliers VALUES
  (1, 'Acme', 'SUP-001'),
  (2, 'Bolt Co', 'SUP-002'),
  (3, 'Gear Inc', 'SUP-003');

INSERT INTO parts VALUES
  (1001, 'SUP-001', 50),
  (1002, 'SUP-001', 75),
  (1003, 'SUP-002', 30),
  (1004, 'SUP-002', 60),
  (1005, 'SUP-003', 90);

INSERT INTO shipments VALUES
  (1, 1001, '2024-01-15', 10),
  (2, 1001, '2024-02-20', 20),
  (3, 1002, '2024-01-15', 15),
  (4, 1003, '2024-02-20', 25),
  (5, 1004, '2024-03-10', 30),
  (6, 1005, '2024-01-15', 5);

INSERT INTO activities VALUES
  (1, '2024-01-15', 'sale', 100),
  (2, '2024-01-15', 'return', 20),
  (3, '2024-02-20', 'sale', 200),
  (4, '2024-02-20', 'sale', 150),
  (5, '2024-03-10', 'sale', 300);

--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo
--echo === Test 5: 3-table join, GROUP BY on root, SUM on leaf ===

let $QUERY=
SELECT c.c_region, SUM(l.l_quantity)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY c.c_region;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.c_region, SUM(l.l_quantity)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY c.c_region|

--echo
--echo
--echo === Test 6: 3-table join, GROUP BY on middle table ===

let $QUERY=
SELECT o.o_status, SUM(l.l_quantity), COUNT(l.l_id)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_status;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o.o_status, SUM(l.l_quantity), COUNT(l.l_id)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_status|

--echo
--echo
--echo === Test 7: 3-table join, GROUP BY on root, MIN/MAX on leaf ===

let $QUERY=
SELECT c.c_name, MIN(l.l_price), MAX(l.l_price)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY c.c_name;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT c.c_name, MIN(l.l_price), MAX(l.l_price)
FROM customer AS c
JOIN orders AS o ON o.o_custkey = c.c_id
JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY c.c_name|

--echo
--echo
--echo === Test 8: WHERE filter on root table ===

let $QUERY=
SELECT o.o_custkey, SUM(l.l_quantity)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
WHERE o.o_custkey = 100
GROUP BY o.o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o.o_custkey, SUM(l.l_quantity)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
WHERE o.o_custkey = 100
GROUP BY o.o_custkey|

--echo
--echo
--echo === Test 9: WHERE with range on root table ===

