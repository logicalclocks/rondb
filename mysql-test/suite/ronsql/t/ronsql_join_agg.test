SELECT o1.o_custkey, SUM(o2.o_id)
FROM orders AS o1 JOIN orders AS o2 ON o2.o_custkey = o1.o_custkey
GROUP BY o1.o_custkey;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o1.o_custkey, SUM(o2.o_id)
FROM orders AS o1 JOIN orders AS o2 ON o2.o_custkey = o1.o_custkey
GROUP BY o1.o_custkey|

--echo
--echo
--echo === Test 40: VARCHAR join key ===

let $QUERY=
SELECT s.s_name, SUM(p.p_price)
FROM suppliers AS s JOIN parts AS p ON p.p_suppcode = s.s_code
GROUP BY s.s_name;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT s.s_name, SUM(p.p_price)
FROM suppliers AS s JOIN parts AS p ON p.p_suppcode = s.s_code
GROUP BY s.s_name|

--echo
--echo
--echo === Test 41: BIGINT join key ===

let $QUERY=
SELECT p.p_id, SUM(sh.sh_qty)
FROM parts AS p JOIN shipments AS sh ON sh.sh_partid = p.p_id
GROUP BY p.p_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT p.p_id, SUM(sh.sh_qty)
FROM parts AS p JOIN shipments AS sh ON sh.sh_partid = p.p_id
GROUP BY p.p_id|

--echo
--echo
--echo === Test 42: DATE join key ===

let $QUERY=
SELECT sh.sh_date, SUM(a.a_amount)
FROM shipments AS sh JOIN activities AS a ON a.a_date = sh.sh_date
GROUP BY sh.sh_date;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT sh.sh_date, SUM(a.a_amount)
FROM shipments AS sh JOIN activities AS a ON a.a_date = sh.sh_date
GROUP BY sh.sh_date|

--echo
--echo
--echo === Test 43: 3-table join with VARCHAR + BIGINT keys ===

let $QUERY=
SELECT s.s_name, SUM(sh.sh_qty)
FROM suppliers AS s
JOIN parts AS p ON p.p_suppcode = s.s_code
JOIN shipments AS sh ON sh.sh_partid = p.p_id
GROUP BY s.s_name;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT s.s_name, SUM(sh.sh_qty)
FROM suppliers AS s
JOIN parts AS p ON p.p_suppcode = s.s_code
JOIN shipments AS sh ON sh.sh_partid = p.p_id
GROUP BY s.s_name|

DELIMITER ;|

--echo
--echo
--echo === Test 44: Group eviction with ERROR_INSERT 5090 ===

--source include/check_ndb_debug.inc

if ($have_ndb_debug)
{
--exec $NDB_MGM -e "ALL ERROR 5090" > /dev/null 2>&1

DELIMITER |;

let $QUERY=
SELECT o.o_id, SUM(l.l_quantity)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT o.o_id, SUM(l.l_quantity)
FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id
GROUP BY o.o_id|

DELIMITER ;|

--exec $NDB_MGM -e "ALL ERROR 0" > /dev/null 2>&1
}

--echo
--echo
--echo === Test 45: Error — cross-table comparison ===
--echo Expected error: WHERE condition references columns from multiple tables
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT o.o_custkey, SUM(l.l_quantity) FROM orders AS o JOIN lineitem AS l ON l.l_orderkey = o.o_id WHERE l.l_quantity > o.o_custkey GROUP BY o.o_custkey;' 2>&1

