# Phase J — LEFT-to-INNER promotion when WHERE rejects NULL on the
# RHS column.  Standard MySQL optimizer rule; before this fix, the
# WHERE pushed down to CTE_LOOKUP didn't see NULL-injected rows and
# RonSQL diverged from MySQL.  See cte_filter_phase_j.md.

--echo
--echo
--echo === Test 23 (J): LEFT JOIN + WHERE on aggregate output (promotes to INNER) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
WHERE sums.t > 50
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
WHERE sums.t > 50
GROUP BY sums.k|

--echo
--echo
--echo === Test 24 (J): LEFT JOIN + WHERE on CTE GB key (promotes to INNER) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
WHERE sums.k != 100
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
WHERE sums.k != 100
GROUP BY sums.k|

--echo
--echo
--echo === Test 25 (J): two LEFT JOINs, WHERE on only one (per-op promotion) ===

let $QUERY=
WITH
  sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t
           FROM cte_orders GROUP BY o_custkey),
  cnt  AS (SELECT o_custkey AS k, COUNT(*) AS n
           FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t), SUM(cnt.n)
FROM cte_customer AS c
LEFT JOIN sums ON sums.k = c.c_id
LEFT JOIN cnt  ON cnt.k  = c.c_id
WHERE sums.t > 50
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH
  sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t
           FROM cte_orders GROUP BY o_custkey),
  cnt  AS (SELECT o_custkey AS k, COUNT(*) AS n
           FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t), SUM(cnt.n)
FROM cte_customer AS c
LEFT JOIN sums ON sums.k = c.c_id
LEFT JOIN cnt  ON cnt.k  = c.c_id
WHERE sums.t > 50
GROUP BY sums.k|

# Phase I.1 — IS NULL / IS NOT NULL on CTE column or aggregate output.
# Exercises the new BRANCH_LINKED_EQ_NULL / BRANCH_LINKED_NE_NULL
# kernel opcodes via emit_cte_lookup_filter.  Test 28 also verifies
# Phase J's promotion gate correctly defers when WHERE is
# null-preserving (so the LEFT JOIN survives and unmatched rows
# pass through).  See cte_filter_phase_i1.md.

--echo
--echo
--echo === Test 26 (I.1): INNER JOIN + WHERE cte.k IS NOT NULL (always-true) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.k IS NOT NULL
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.k IS NOT NULL
GROUP BY sums.k|

--echo
--echo
--echo === Test 27 (I.1): INNER JOIN + WHERE cte.t IS NULL (always-false on matched) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t IS NULL
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t IS NULL
GROUP BY sums.k|

# Phase K — ANTI_JOIN for `WHERE col IS NULL` on LEFT JOIN's RHS
# where the CTE column is provably non-NULL on the matched path
# (GB key, SUM, COUNT).  Promotes the LEFT_OUTER op to ANTI_JOIN;
# emit_child_ops emits setMatchType(MatchNullOnly), DBSPJ marks the
# CTE_LOOKUP_REQ with CTE_LOOKUP_ANTI_JOIN_FLAG, DBLQH suppresses
# the agg feed on matched rows.  Only NULL-injected unmatched
# parents reach the aggregator.  See cte_filter_phase_k.md.

--echo
--echo
--echo === Test 28 (K): LEFT JOIN + WHERE cte.t IS NULL on SUM (anti-join) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
WHERE sums.t IS NULL
GROUP BY c.c_id;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
WHERE sums.t IS NULL
GROUP BY c.c_id|

--echo
--echo
