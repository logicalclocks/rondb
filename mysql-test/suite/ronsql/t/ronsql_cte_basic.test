WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
GROUP BY sums.k|

--echo
--echo
--echo === Test 11 (D-followup): WHERE on aggregate CTE output (inline-type opcode) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t > 100
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t > 100
GROUP BY sums.k|

--echo
--echo
--echo === Test 12 (D2): WHERE on MAX aggregate output (widened virt-type) ===

let $QUERY=
WITH maxes AS (
  SELECT o_custkey AS k, MAX(o_amt) AS mx
  FROM cte_orders GROUP BY o_custkey)
SELECT maxes.k, SUM(maxes.mx)
FROM cte_customer AS c
JOIN maxes ON maxes.k = c.c_id
WHERE maxes.mx > 70
GROUP BY maxes.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH maxes AS (
  SELECT o_custkey AS k, MAX(o_amt) AS mx
  FROM cte_orders GROUP BY o_custkey)
SELECT maxes.k, SUM(maxes.mx)
FROM cte_customer AS c
JOIN maxes ON maxes.k = c.c_id
WHERE maxes.mx > 70
GROUP BY maxes.k|

# Phase P-GB — verification.  Earlier branch state flagged a buffer-format
# mismatch that would SEGV on parent-table GROUP BY over a CTE agg leaf.
# That mismatch was incidentally fixed by Phase E.1K's writer-side rework
# (DBSPJ now writes a uniform 2-word [tableId][schemaVersion] / CTE-marker
# prefix for every linked entry, and the reader already discriminates via
# the marker bit).  These tests exercise the previously-untested shape.

--echo
--echo
--echo === Test 13 (P-GB): main GROUP BY parent-table column over CTE agg leaf ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_region, SUM(sums.t)
FROM cte_customer AS c JOIN sums ON sums.k = c.c_id
GROUP BY c.c_region;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_region, SUM(sums.t)
FROM cte_customer AS c JOIN sums ON sums.k = c.c_id
GROUP BY c.c_region|

--echo
--echo
--echo === Test 14 (P-GB): same as 13 but LEFT JOIN (NULL-injected unmatched parent) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_region, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
GROUP BY c.c_region;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_region, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
GROUP BY c.c_region|

# Phase H.1 — filter operator + conjunct matrix.  emit_cte_lookup_filter
# accepts six operators (= != < <= > >=) and any number of top-level
# AND conjuncts; H.1 covers the SQL surface for the operators not yet
# exercised by Tests 9 / 11 / 12.

--echo
--echo
--echo === Test 15 (H.1): != on CTE_LOOKUP key ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.k != 100
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.k != 100
GROUP BY sums.k|

--echo
--echo
--echo === Test 16a (H.1): <= on CTE_LOOKUP agg output ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t <= 100
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t <= 100
GROUP BY sums.k|

--echo
--echo
--echo === Test 16b (H.1): >= on CTE_LOOKUP agg output ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t >= 100
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t >= 100
GROUP BY sums.k|

--echo
--echo
--echo === Test 17 (H.1): multi-conjunct AND on CTE_LOOKUP output ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.k >= 100 AND sums.t > 100
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
