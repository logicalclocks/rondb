WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.k >= 100 AND sums.t > 100
GROUP BY sums.k|

--echo
--echo
--echo === Test 18 (H.1): all-reject filter on CTE_LOOKUP ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t > 1000000
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
WHERE sums.t > 1000000
GROUP BY sums.k|

# Phase H.3 — reachable edge cases.  Multi-CTE filter isolation,
# VARCHAR GB key with WHERE, LEFT JOIN with surviving filter, empty
# CTE, single-row CTE.  These shapes were exercised at the NDB-API
# level by testCteNdbApiFilter and testCteNdbApiOuterJoin but not
# from SQL.

--echo
--echo
--echo === Test 19 (H.3): multi-CTE filter isolation ===

let $QUERY=
WITH
  sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t
           FROM cte_orders GROUP BY o_custkey),
  cnt  AS (SELECT o_custkey AS k, COUNT(*) AS n
           FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t), SUM(cnt.n)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
JOIN cnt  ON cnt.k  = c.c_id
WHERE sums.t > 90 AND cnt.n > 1
GROUP BY sums.k;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH
  sums AS (SELECT o_custkey AS k, SUM(o_amt) AS t
           FROM cte_orders GROUP BY o_custkey),
  cnt  AS (SELECT o_custkey AS k, COUNT(*) AS n
           FROM cte_orders GROUP BY o_custkey)
SELECT sums.k, SUM(sums.t), SUM(cnt.n)
FROM cte_customer AS c
JOIN sums ON sums.k = c.c_id
JOIN cnt  ON cnt.k  = c.c_id
WHERE sums.t > 90 AND cnt.n > 1
GROUP BY sums.k|

--echo
--echo
--echo === Test 20 (H.3): VARCHAR GB key + WHERE filter on it ===

# Query contains a SQL single-quoted string literal.  Keep this case on
# the QUERY_FILE path so both compare-helper entry points continue to
# have string-literal coverage.

--let QUERY_FILE=$MYSQL_TMP_DIR/query.sql
--write_file $QUERY_FILE
WITH by_code AS (
  SELECT r_code AS rcode, COUNT(*) AS n
  FROM cte_regions GROUP BY r_code)
SELECT by_code.rcode, SUM(by_code.n)
FROM cte_regions AS r
JOIN by_code ON by_code.rcode = r.r_code
WHERE by_code.rcode = 'US'
GROUP BY by_code.rcode;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH by_code AS (
  SELECT r_code AS rcode, COUNT(*) AS n
  FROM cte_regions GROUP BY r_code)
SELECT by_code.rcode, SUM(by_code.n)
FROM cte_regions AS r
JOIN by_code ON by_code.rcode = r.r_code
WHERE by_code.rcode = 'US'
GROUP BY by_code.rcode|

