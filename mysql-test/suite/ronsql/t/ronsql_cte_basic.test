--echo
--echo
--echo === Test 30 (K): LEFT JOIN + AND of two IS NULL conjuncts (anti-join) ===

let $QUERY=
WITH sums AS (
  SELECT o_custkey AS k, SUM(o_amt) AS t
  FROM cte_orders GROUP BY o_custkey)
SELECT c.c_id, SUM(sums.t)
FROM cte_customer AS c LEFT JOIN sums ON sums.k = c.c_id
WHERE sums.t IS NULL AND sums.k IS NULL
GROUP BY c.c_id;|
