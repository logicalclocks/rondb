--source include/have_ndb.inc

# RONDB-831 tests

#todo Remove the canonicalization scripts when AVG formatting is fixed

--echo Create test table with no rows
CREATE TABLE tbl1 (
  pk INT NOT NULL AUTO_INCREMENT,
  idx INT NULL,
  flt INT NULL,
  gr INT NULL,
  dat INT NULL,
  PRIMARY KEY USING HASH (pk),
  INDEX index_idx (idx)
) ENGINE=NDB CHARSET=latin1;

let $i=2;
while($i){
if($i==2) {
--echo ====== Queries on an empty table ======
}
if($i==1) {

# for idx in NULL 6 7 8; do for flt in NULL 66 11; do for gr in NULL 1 2; do for dat in NULL 5; do echo "($idx, $flt, $gr, $dat),";done;done;done;done
INSERT INTO tbl1 (idx, flt, gr, dat) VALUES
(NULL, NULL, NULL, NULL),
(NULL, NULL, NULL, 5),
(NULL, NULL, 1, NULL),
(NULL, NULL, 1, 5),
(NULL, NULL, 2, NULL),
(NULL, NULL, 2, 5),
(NULL, 66, NULL, NULL),
(NULL, 66, NULL, 5),
(NULL, 66, 1, NULL),
(NULL, 66, 1, 5),
(NULL, 66, 2, NULL),
(NULL, 66, 2, 5),
(NULL, 11, NULL, NULL),
