(6, 66, 2, NULL),
(6, 66, 2, 5),
(6, 11, NULL, NULL),
(6, 11, NULL, 5),
(6, 11, 1, NULL),
(6, 11, 1, 5),
(6, 11, 2, NULL),
(6, 11, 2, 5),
(7, NULL, NULL, NULL),
(7, NULL, NULL, 5),
(7, NULL, 1, NULL),
(7, NULL, 1, 5),
(7, NULL, 2, NULL),
(7, NULL, 2, 5),
(7, 66, NULL, NULL),
(7, 66, NULL, 5),
(7, 66, 1, NULL),
(7, 66, 1, 5),
(7, 66, 2, NULL),
(7, 66, 2, 5),
(7, 11, NULL, NULL),
