(8, 11, 2, 5);

--echo
--echo
--echo
--echo ====== Queries on an table with both NULL and non-NULL dat ======
}

DELIMITER |;

--echo Table scan
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Table scan, group on 1 column
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
GROUP BY gr
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Table scan, group on 2 columns
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
GROUP BY gr
       , idx
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Table scan, eq filter
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE flt = 66
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Table scan, eq filter, group on 1 column
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE flt = 66
GROUP BY gr
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Table scan, eq filter, group on 2 columns
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE flt = 66
GROUP BY gr
       , idx
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Range scan
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE idx >= 6 AND idx < 8
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Range scan, group on 1 column
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE idx >= 6 AND idx < 8
GROUP BY gr
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Range scan, group on 2 columns
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE idx >= 6 AND idx < 8
GROUP BY gr
       , idx
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Range scan, eq filter
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE idx >= 6 AND idx < 8 AND flt = 66
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Range scan, eq filter, group on 1 column
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE idx >= 6 AND idx < 8 AND flt = 66
GROUP BY gr
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

--echo Range scan, eq filter, group on 2 columns
let $QUERY=
SELECT AVG(dat), COUNT(dat), MAX(dat), MIN(dat), SUM(dat), COUNT(*)
FROM tbl1
WHERE idx >= 6 AND idx < 8 AND flt = 66
GROUP BY gr
       , idx
;|
--let $canonicalization_script=s/\.0000//;
--source suite/ronsql/include/ronsql_compare.inc

DELIMITER ;|
dec $i;
}
DROP TABLE tbl1;
