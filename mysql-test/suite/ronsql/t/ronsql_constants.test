--source include/have_ndb.inc
--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let PARSE_TEST=$RONSQL_CLI_EXE --output-format TEXT --explain-mode=FORCE 2>&1 -e

--echo ===== Max Int64 integer constant =====
--exec $PARSE_TEST 'select sum(9223372036854775807) from tbl;'
--exec $PARSE_TEST 'select sum(-9223372036854775807) from tbl;'
--exec $PARSE_TEST 'select sum(-9223372036854775807-1) from tbl;'

--echo ===== Integer folding =====
--exec $PARSE_TEST 'select sum(((45 % 3) + (67 DIV 8) * 7 - -8) / 5) from tbl;'

--echo ===== Too big integer constant =====
--error 1
--exec $PARSE_TEST 'select sum(9223372036854775808) from tbl;'
--error 1
--exec $PARSE_TEST 'select sum(-9223372036854775808) from tbl;'

--echo ===== Overflow in integer constant folding =====
--error 1
--exec $PARSE_TEST 'select sum(-9223372036854775807-2) from tbl;'
--error 1
--exec $PARSE_TEST 'select sum(922337203685477580*11) from tbl;'
--error 1
--exec $PARSE_TEST 'select sum(-922337203685477580*11) from tbl;'
--error 1
--exec $PARSE_TEST 'select sum((-9223372036854775807-1) DIV -1) from tbl;'

--echo ===== Divide by zero in integer constant folding =====
--error 1
--exec $PARSE_TEST 'select sum(9223372036854775807 DIV 0) from tbl;'
--error 1
--exec $PARSE_TEST 'select sum((-9223372036854775807-1) DIV 0) from tbl;'
--error 1
--exec $PARSE_TEST 'select sum((4+5) DIV 0) from tbl;'
--error 1
--exec $PARSE_TEST 'select sum(1 DIV 0) from tbl;'
--error 1
--exec $PARSE_TEST 'select sum(1 % 0) from tbl;'

CREATE TABLE tbl (sint8 TINYINT NULL) ENGINE=NDB;
INSERT INTO tbl (sint8) VALUES (7);

--echo Integer constant folding:
DELIMITER |;
let $QUERY=
SELECT sum( 9223372036854775807)
     , sum(-9223372036854775807-1)
     , sum(-9223372036854775807  +  123456)
     , sum( 9223372036854775807  -  123456)
     , sum(  922337203685477580  *  10)
     , sum( -922337203685477580  *  10)
     , sum( 9223372036854775807 DIV 10)
     , sum(-9223372036854775807 DIV 10)
     , sum( 9223372036854775807  %  10)
     , sum(-9223372036854775807  %  10)
     , sum((-9223372036854775807-1) % -1)
     , sum( 123456)
     , sum(-123456-1)
     , sum(-123456  +  123456)
     , sum( 123456  -  123456)
     , sum( 123456  *  10)
     , sum(-123456  *  10)
     , sum( 123456 DIV 10)
     , sum(-123456 DIV 10)
     , sum( 123456  %  10)
     , sum(-123456  %  10)
FROM tbl;|
--source suite/ronsql/include/ronsql_compare.inc

# Compare both expression grammars against MySQL. The one-row fixture
# contains sint8=7. Explicit parentheses distinguish unary negation from
# negating a complete product; column operands also exercise runtime arithmetic.
--let $strict_diff=yes
--let $QUERY=
--let $QUERY_FILE=$MYSQL_TMP_DIR/ronsql-unary-minus.sql

--echo
--echo === Unary minus before DIV and multiplication ===
--echo Expected: DIV: -12,-12,-1; repeated minus: 12,12,1
--write_file $QUERY_FILE
SELECT SUM(8 DIV -2 * 3) AS div_parsed,
       SUM((8 DIV (-2)) * 3) AS div_grouped,
       SUM(8 DIV -(2 * 3)) AS div_product,
       SUM(8 DIV - -2 * 3) AS double_parsed,
       SUM((8 DIV (-(-2))) * 3) AS double_grouped,
       SUM(8 DIV -(-(2 * 3))) AS double_product
FROM tbl;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Unary minus with column DIV and modulo ===
--echo Expected: DIV: -9,-9,-1; modulo: 3,3,1
--write_file $QUERY_FILE
SELECT SUM(sint8 DIV -2 * 3) AS div_parsed,
       SUM((sint8 DIV (-2)) * 3) AS div_grouped,
       SUM(sint8 DIV -(2 * 3)) AS div_product,
       SUM(sint8 % -2 * 3) AS mod_parsed,
       SUM((sint8 % (-2)) * 3) AS mod_grouped,
       SUM(sint8 % -(2 * 3)) AS mod_product
FROM tbl;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Unary minus precedence in HAVING ===
--echo Expected: n=1
--write_file $QUERY_FILE
SELECT COUNT(*) AS n
FROM tbl
HAVING (SUM(sint8) + 1) / -2 * 3 = -12
   AND (SUM(sint8) + 1) / - -2 * 3 = 12;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Explicit unary-minus grouping in HAVING ===
--echo Expected: n=1
--write_file $QUERY_FILE
SELECT COUNT(*) AS n
FROM tbl
HAVING ((SUM(sint8) + 1) / (-2)) * 3 = -12
   AND ((SUM(sint8) + 1) / (-(-2))) * 3 = 12;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === Negated-product grouping in HAVING ===
--echo Expected: no rows
--write_file $QUERY_FILE
SELECT COUNT(*) AS n
FROM tbl
HAVING (SUM(sint8) + 1) / -(2 * 3) = -12
    OR (SUM(sint8) + 1) / -(-(2 * 3)) = 12;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--let $QUERY_FILE=
--let $strict_diff=

--echo Cleanup
DELIMITER ;|
DROP TABLE tbl;
