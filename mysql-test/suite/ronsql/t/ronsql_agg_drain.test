--source include/have_ndb.inc
--source suite/ndb_push_agg/t/have_ndb_error_insert.inc
--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

# RONDB-1124: RonSQL aggregation with bounded result batches and
# QueryMemory drains. A fragment keeps its groups resident until the scan
# ends or QueryMemory runs short, then sends them in result records of at
# most 16 KB, one per scan batch, and resumes scanning after a memory
# drain. An IN list on the leading primary-key column runs as a
# multi-range scan whose aggregation state is carried across ranges, so
# forced drains land inside and between ranges:
#   ERROR_INSERT 4042 - drain on every 7th row
#   ERROR_INSERT 4043 - drain once the resident groups need two records
# Every result is compared strictly with the MySQL server, which does
# not push the aggregation (ndb_pushdown_aggregate is OFF by default).

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes
--let $EXPLAIN_FILE=$MYSQL_TMP_DIR/agg_drain_explain.out

--disable_query_log
--disable_warnings
# 600 ids x 3 subs. pad is 3000 bytes and depends on id only, so 11
# resident pad groups already need two result records.
CREATE TABLE t_mr (
  id INT NOT NULL,
  sub INT NOT NULL,
  g INT NOT NULL,
  w INT NOT NULL,
  pad VARCHAR(3000) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL,
  PRIMARY KEY (id, sub)
) ENGINE=NDB;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t_mr
  WITH RECURSIVE seq(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM seq WHERE n < 1799)
  SELECT n DIV 3 + 1, n % 3 + 1, ((n DIV 3 + 1) * 7 + n % 3 + 1) % 150,
         (n DIV 3 + 1) * 10 + n % 3 + 1,
         CONCAT(LPAD(n DIV 3 + 1, 4, '0'), REPEAT('p', 2996))
  FROM seq;
# 10000-byte strings for string MAX payloads.
CREATE TABLE t_s10 (
  pk INT NOT NULL PRIMARY KEY,
  g INT NOT NULL,
  s VARCHAR(10000) CHARACTER SET latin1 COLLATE latin1_bin NOT NULL
) ENGINE=NDB;
INSERT INTO t_s10
  WITH RECURSIVE seq(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM seq WHERE n < 39)
  SELECT n, n % 4, CONCAT(LPAD(n, 4, '0'), REPEAT(CHAR(97 + n % 26), 9996)) FROM seq;
--enable_warnings
--let $list = 5000
--let $i = 400
while ($i)
{
  --let $list = $list, $i
  --dec $i
}
--enable_query_log

--echo
--echo === multi-range scan, ERROR_INSERT 4042: a drain on every 7th row ===
--exec $NDB_MGM -e "all error 4042" >> $NDB_TOOLS_OUTPUT
--let QUERY = SELECT id, COUNT(*), SUM(w), MIN(w), MAX(w) FROM t_mr WHERE id IN ($list) GROUP BY id;
--source suite/ronsql/include/ronsql_compare.inc
--let QUERY = SELECT g, COUNT(*), SUM(w) FROM t_mr WHERE id IN ($list) GROUP BY g;
--source suite/ronsql/include/ronsql_compare.inc
--let QUERY = SELECT g, COUNT(*), MIN(pad), MAX(pad) FROM t_mr WHERE id IN ($list) GROUP BY g;
--source suite/ronsql/include/ronsql_compare.inc
--let QUERY = SELECT COUNT(*), SUM(w), MAX(w) FROM t_mr WHERE id IN ($list);
--source suite/ronsql/include/ronsql_compare.inc
--let QUERY = SELECT id, sub, COUNT(*), SUM(w) FROM t_mr GROUP BY id, sub;
--source suite/ronsql/include/ronsql_compare.inc
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT

--echo
--echo === multi-range scan, ERROR_INSERT 4043: drains spanning several batches ===
--exec $NDB_MGM -e "all error 4043" >> $NDB_TOOLS_OUTPUT
--let QUERY = SELECT pad, COUNT(*), SUM(w) FROM t_mr WHERE id IN ($list) GROUP BY pad;
--source suite/ronsql/include/ronsql_compare.inc
--let QUERY = SELECT pad, COUNT(*), SUM(w) FROM t_mr GROUP BY pad;
--source suite/ronsql/include/ronsql_compare.inc
--exec $NDB_MGM -e "all error 0" >> $NDB_TOOLS_OUTPUT
--let QUERY = SELECT COUNT(*), SUM(w) FROM t_mr WHERE id IN ($list);
--source suite/ronsql/include/ronsql_explain.inc
--exec grep -qF 'Ranges: 401 (IN list on `id`: 401 values, 401 distinct; SF_MultiRange).' $EXPLAIN_FILE

--echo
--echo === one 10 KB string MAX payload per group, each record above 8 KB ===
--let QUERY = SELECT g, MAX(s) FROM t_s10 GROUP BY g;
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === MIN and MAX payloads could need 20 KB: a limit error ===
--exec printf '{"query":"SELECT g, MIN(s), MAX(s) FROM t_s10 GROUP BY g;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--exec grep -oF '[limit] Caught exception: The GROUP BY columns and aggregate results of one group can need more than 16 KB, counted at the declared column sizes.' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected a limit error for a group over 16 KB"
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs.out

# RONSQL-14: at most 127 GROUP BY columns and 255 aggregate results per
# SELECT, and an aggregation program shorter than 1024 words. Exceeding
# them is a limit error, not an internal one. NdbAggregator used to
# refuse only in Finalize(), after writing a 129th GROUP BY column past
# its array, or a program past its 8192-word buffer.
--disable_query_log
--disable_warnings
--let $cols = c1 INT NOT NULL DEFAULT 0
--let $i = 2
while ($i <= 128)
{
  --let $cols = $cols, c$i INT NOT NULL DEFAULT 0
  --inc $i
}
eval CREATE TABLE t_wide (pk INT NOT NULL PRIMARY KEY, $cols) ENGINE=NDB;
INSERT INTO t_wide (pk) VALUES (1), (2);
--enable_warnings
--enable_query_log

--echo
--echo === 127 GROUP BY columns are accepted ===
--let $gb = c1
--let $i = 2
while ($i <= 127)
{
  --let $gb = $gb, c$i
  --inc $i
}
--let QUERY = SELECT c1, COUNT(*) FROM t_wide GROUP BY $gb;
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === 128 GROUP BY columns are a limit error ===
--exec printf '{"query":"SELECT c1, COUNT(*) FROM t_wide GROUP BY $gb, c128;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--exec grep -oF '[limit] Caught exception: GROUP BY has more than 127 columns.' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected a limit error for 128 GROUP BY columns"
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs.out

--echo
--echo === 255 aggregate results are accepted ===
--let $aggs = SUM(c1)
--let $i = 2
while ($i <= 128)
{
  --let $aggs = $aggs, SUM(c$i)
  --inc $i
}
--let $i = 1
while ($i <= 127)
{
  --let $aggs = $aggs, MIN(c$i)
  --inc $i
}
--let QUERY = SELECT $aggs FROM t_wide;
--source suite/ronsql/include/ronsql_compare.inc

--echo
--echo === 256 aggregate results are a limit error ===
--exec printf '{"query":"SELECT $aggs, MIN(c128) FROM t_wide;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--exec grep -oF '[limit] Caught exception: More than 255 aggregate results in one SELECT. AVG counts as two, except in a CTE body.' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected a limit error for 256 aggregate results"
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs.out

# SUMs of 9 products of c1 and a constant. Each product needs a 3-word
# constant load and a multiplication, and all but the first an addition,
# so each SUM needs at least 45 program words: 40 SUMs need at least 1800
# and 200 SUMs at least 9000. The constants are all different, so no
# product or SUM is shared. Each SUM is longer than 64 bytes, so it needs
# an alias.
--let $k = 1
--let $s = 1
while ($s <= 200)
{
  --inc $k
  --let $sum = SUM(c1 * $k
  --let $t = 2
  while ($t <= 9)
  {
    --inc $k
    --let $sum = $sum + c1 * $k
    --inc $t
  }
  if ($s == 1)
  {
    --let $sums = $sum) AS s$s
  }
  if ($s > 1)
  {
    --let $sums = $sums, $sum) AS s$s
  }
  if ($s == 40)
  {
    --let $sums40 = $sums
  }
  --inc $s
}

--echo
--echo === an aggregation program of 1024 words or more is a limit error ===
--exec printf '{"query":"SELECT $sums40 FROM t_wide;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--exec grep -oF '[limit] Caught exception: The aggregate expressions are too large: the aggregation program must be shorter than 1024 words.' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected a limit error for a program of 1024 words or more"
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs.out

--echo
--echo === a program beyond the 8192-word buffer fails cleanly ===
--exec printf '{"query":"SELECT $sums FROM t_wide;","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl -s -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out
--exec grep -oF 'Caught exception: Failed writing aggregation program' $MYSQL_TMP_DIR/ronsql-rdrs.out || echo "UNEXPECTED: expected the program writing to stop at the end of the buffer"
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs.out

--echo
--echo === RDRS still answers ===
--let QUERY = SELECT COUNT(*), SUM(c128) FROM t_wide;
--source suite/ronsql/include/ronsql_compare.inc
--remove_file $EXPLAIN_FILE
--remove_file $NDB_TOOLS_OUTPUT

--disable_query_log
DROP TABLE t_mr, t_s10, t_wide;
--enable_query_log
