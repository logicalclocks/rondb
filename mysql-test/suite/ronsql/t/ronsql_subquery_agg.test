  (SELECT SUM(m.val) FROM sq_measures AS m WHERE m.entity_id = e.id AND m.ts > 1) AS sum_late,
  (SELECT COUNT(m2.val) FROM sq_measures AS m2 WHERE m2.entity_id = e.id AND m2.val > 50) AS cnt_big
FROM sq_entity AS e|

