# Aggregates over a CASE whose arms have different types
# (dblqh_ronsql_analysis.md section 1, items 1, 1b and 1c).
#
# SUM / MIN / MAX (CASE WHEN c THEN x ELSE y END) updates one aggregate
# slot from each arm, and one arm runs per row.  The data node's
# OptimizeProgramBuffer typed each update from its own register, so with
# a DOUBLE or DECIMAL THEN arm and an integer ELSE arm the slot got a
# DOUBLE kernel in one arm and a BIGINT kernel in the other.  The typed
# kernels never convert the slot: a group whose rows took both arms got
# DOUBLE bits in a BIGINT slot, or integers added to the bits of a
# DOUBLE.  GREATEST / LEAST has the same shape: its Mov runs only for
# some rows, and the optimizer typed the register from the Mov alone.
#
# cat is partitioned on g, so all rows of a group are aggregated in one
# fragment, where both arms update the same slot.  Groups 1 and 2 take
# both arms (group 2 with negative THEN values, inserted THEN arm
# first), group 3 only the THEN arm and group 4 only the ELSE arm.
#
#   ca-1  DOUBLE THEN arm, integer ELSE arms, per group
#   ca-2  DECIMAL(10,2) THEN arm, integer ELSE arms, per group, and a
#         DECIMAL ELSE arm.  A DECIMAL column load is two words, which
#         RonSQL's CASE skips counted as one: the ELSE rows of a DECIMAL
#         THEN arm landed on its Skip and were dropped (sum1 17.5 / -10.5,
#         group 4 NULL), and the THEN rows of a DECIMAL ELSE arm landed on
#         its RepeatAgg and were counted twice (sum_ep 9 / 6.75 / 8).
#         Expected (MySQL): (g, sum1, min999, maxm, sum_ep) =
#         (1, 21.5, 1.25, 10, 5) (2, -7.5, -7.75, -0.5, 3.75)
#         (3, 2.5, 0.25, 1, 4) (4, 3, 999, -100, 0.75).
#   ca-3  ca-1 without GROUP BY (the partials of all fragments merge)
#   ca-4  ca-1 over a join (join aggregation in DBLQH)
#   ca-5  SUM of GREATEST / LEAST over a DOUBLE CTE output and 5
#   ca-6  MIN / MAX over CASE arms that mix strings with other values,
#         or strings of different types, and SUM over a string ELSE arm:
#         refused before the query runs.  A string MIN / MAX slot holds
#         a pointer, which a numeric arm overwrote: a data node crash.

--source include/have_ndb.inc

--disable_warnings
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");
--enable_warnings

--let $suppress_ronsql_cli=yes
--let $strict_diff=yes

--disable_query_log
--disable_warnings
CREATE TABLE cat (
  g  INT NOT NULL,
  id INT NOT NULL,
  k  INT NOT NULL,
  d  DOUBLE NOT NULL,
  p  DECIMAL(10,2) NOT NULL,
  s  VARCHAR(8) NOT NULL,
  c  CHAR(4) NOT NULL,
  PRIMARY KEY (g, id)
) ENGINE=NDB PARTITION BY KEY (g);
# THEN arm: k > 5.
INSERT INTO cat VALUES
  (1, 1,  1,  0.5,   0.25, 'a', 'a'),
  (1, 2,  8,  2.5,   1.25, 'b', 'b'),
  (1, 3,  2,  0.5,   0.25, 'c', 'c'),
  (1, 4,  9,  9.25,  3.50, 'd', 'd'),
  (1, 5,  3,  0.5,   0.25, 'e', 'e'),
  (1, 6, 10,  4.75,  2.75, 'f', 'f'),
  (1, 7,  4,  0.5,   0.25, 'g', 'g'),
  (1, 8, 11, 12.5,  10.00, 'h', 'h');
INSERT INTO cat VALUES
  (2, 1,  7, -1.5,  -2.25, 'a', 'a'),
  (2, 2,  0,  0.5,   0.25, 'b', 'b'),
  (2, 3,  8, -8.25, -0.50, 'c', 'c'),
  (2, 4,  1,  0.5,   0.25, 'd', 'd'),
  (2, 5,  9, -3.75, -7.75, 'e', 'e'),
  (2, 6,  2,  0.5,   0.25, 'f', 'f');
INSERT INTO cat VALUES
  (3, 1,  6,  1.25,  0.25, 'a', 'a'),
  (3, 2,  7,  2.5,   0.50, 'b', 'b'),
  (3, 3,  8,  3.75,  0.75, 'c', 'c'),
  (3, 4,  9,  5,     1.00, 'd', 'd');
INSERT INTO cat VALUES
  (4, 1,  0,  0.5,   0.25, 'a', 'a'),
  (4, 2,  1,  0.5,   0.25, 'b', 'b'),
  (4, 3,  2,  0.5,   0.25, 'c', 'c');
CREATE TABLE cat_drv (
  pk INT NOT NULL,
  g  INT NOT NULL,
  id INT NOT NULL,
  PRIMARY KEY (pk)
) ENGINE=NDB;
INSERT INTO cat_drv SELECT g * 100 + id, g, id FROM cat;
--enable_warnings
--enable_query_log

DELIMITER |;

--echo
--echo === ca-1: DOUBLE THEN arm, integer ELSE arms ===
let $QUERY=
SELECT g,
       SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE -100 END) AS maxm
FROM cat GROUP BY g;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT g,
       SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE -100 END) AS maxm
FROM cat GROUP BY g|

--echo
--echo === ca-2: DECIMAL THEN arm, integer ELSE arms, DECIMAL ELSE arm ===
# MySQL shows the DECIMAL results with two decimals and RonSQL its
# DOUBLE results without trailing zeros: drop trailing fraction zeros
# on both sides.  A wrong DOUBLE (e.g. 21.500000000000004) still differs.
--let $canonicalization_perl=s/(\.[0-9]*[1-9])0+(?![0-9])/\$1/g;s/\.0+(?![0-9])//g;
let $QUERY=
SELECT g,
       SUM(CASE WHEN k > 5 THEN p ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN p ELSE 999 END) AS min999,
       MAX(CASE WHEN k > 5 THEN p ELSE -100 END) AS maxm,
       SUM(CASE WHEN k > 5 THEN 1 ELSE p END) AS sum_ep
FROM cat GROUP BY g;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT g,
       SUM(CASE WHEN k > 5 THEN p ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN p ELSE 999 END) AS min999,
       MAX(CASE WHEN k > 5 THEN p ELSE -100 END) AS maxm,
       SUM(CASE WHEN k > 5 THEN 1 ELSE p END) AS sum_ep
FROM cat GROUP BY g|

--echo
--echo === ca-3: ca-1 without GROUP BY ===
let $QUERY=
SELECT SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE -100 END) AS maxm
FROM cat;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
SELECT SUM(CASE WHEN k > 5 THEN d ELSE 0 END) AS sum0,
       SUM(CASE WHEN k > 5 THEN d ELSE 1 END) AS sum1,
       MIN(CASE WHEN k > 5 THEN d ELSE 7 END) AS min7,
       MAX(CASE WHEN k > 5 THEN d ELSE -100 END) AS maxm
FROM cat|

--echo
--echo === ca-4: ca-1 over a join ===
let $QUERY=
SELECT x.g,
       SUM(CASE WHEN a.k > 5 THEN a.d ELSE 0 END) AS sum0,
       SUM(CASE WHEN a.k > 5 THEN a.d ELSE 1 END) AS sum1,
       MIN(CASE WHEN a.k > 5 THEN a.d ELSE 7 END) AS min7,
       MAX(CASE WHEN a.k > 5 THEN a.d ELSE -100 END) AS maxm
FROM cat_drv AS x
JOIN cat AS a ON a.g = x.g AND a.id = x.id
GROUP BY x.g;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
SELECT x.g,
       SUM(CASE WHEN a.k > 5 THEN a.d ELSE 0 END) AS sum0,
       SUM(CASE WHEN a.k > 5 THEN a.d ELSE 1 END) AS sum1,
       MIN(CASE WHEN a.k > 5 THEN a.d ELSE 7 END) AS min7,
       MAX(CASE WHEN a.k > 5 THEN a.d ELSE -100 END) AS maxm
FROM cat_drv AS x
JOIN cat AS a ON a.g = x.g AND a.id = x.id
GROUP BY x.g|

--echo
--echo === ca-5: SUM of GREATEST / LEAST over a DOUBLE CTE output ===
# m is one row's d.  GREATEST(m, 5) moves 5 into m's register only when
# m < 5, GREATEST(5, m) moves m into 5's register only when m > 5, so
# the summed register is DOUBLE for some rows and BIGINT for others.
let $QUERY=
WITH s AS (SELECT g, id, MAX(d) AS m FROM cat GROUP BY g, id)
SELECT g,
       SUM(GREATEST(m, 5)) AS g_m5,
       SUM(GREATEST(5, m)) AS g_5m,
       SUM(LEAST(m, 5)) AS l_m5,
       SUM(LEAST(5, m)) AS l_5m
FROM s GROUP BY g;|
--source suite/ronsql/include/ronsql_compare.inc

--echo == Expected result ==
--sorted_result
WITH s AS (SELECT g, id, MAX(d) AS m FROM cat GROUP BY g, id)
SELECT g,
       SUM(GREATEST(m, 5)) AS g_m5,
       SUM(GREATEST(5, m)) AS g_5m,
       SUM(LEAST(m, 5)) AS l_m5,
       SUM(LEAST(5, m)) AS l_5m
FROM s GROUP BY g|

DELIMITER ;|

--echo
--echo === ca-6a: MIN over a VARCHAR THEN arm and an integer ELSE arm ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT g, MIN(CASE WHEN k > 5 THEN s ELSE 5 END) AS m FROM cat GROUP BY g;' 2>&1

--echo
--echo === ca-6b: MAX over an integer THEN arm and a VARCHAR ELSE arm ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT g, MAX(CASE WHEN k > 5 THEN 5 ELSE s END) AS m FROM cat GROUP BY g;' 2>&1

--echo
--echo === ca-6c: MIN over a VARCHAR THEN arm and a CHAR ELSE arm ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT g, MIN(CASE WHEN k > 5 THEN s ELSE c END) AS m FROM cat GROUP BY g;' 2>&1

--echo
--echo === ca-6d: SUM over an integer THEN arm and a VARCHAR ELSE arm ===
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test -e 'SELECT g, SUM(CASE WHEN k > 5 THEN 1 ELSE s END) AS m FROM cat GROUP BY g;' 2>&1

--echo
--echo === Cleanup ===

--disable_query_log
DROP TABLE cat_drv;
DROP TABLE cat;
--enable_query_log
