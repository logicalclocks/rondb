--source include/have_ndb.inc
call mtr.add_suppression("Schema dist coordinator detected timeout");
call mtr.add_suppression("Participant timeout");

--let QUERY_FILE=$MYSQL_TMP_DIR/query.sql

CREATE TABLE tbl (sint8 TINYINT NULL) ENGINE=NDB;
INSERT INTO tbl (sint8) VALUES (7);

--echo Overflow using multiplication:
--write_file $QUERY_FILE
SELECT sint8
     , sum((sint8 / sint8)
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024
           * 1024 * 1024 * 8
           * 2
     ) as mul_overflow
FROM tbl
GROUP BY sint8;
EOF
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test < '$QUERY_FILE' 2>&1
--remove_file $QUERY_FILE
--echo
--echo
--echo

--echo Zero through many divisions:
--write_file $QUERY_FILE
SELECT sint8
     , sum((sint8 / sint8)
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024 / 1024
           / 1024 / 1024 / 8
           / 1024 / 1024 / 1024 / 1024 / 1024 / 4
     ) as div_overflow
FROM tbl
GROUP BY sint8;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo Zero through many integer divisions:
--write_file $QUERY_FILE
SELECT sint8
     , sum(sint8
           DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024 DIV 1024
     ) as intdiv_overflow
FROM tbl
GROUP BY sint8;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo Division by zero:
--write_file $QUERY_FILE
SELECT sint8
     , sum(1 / (sint8 - sint8)) as div_zero
FROM tbl
GROUP BY sint8;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo Integer division by zero:
--write_file $QUERY_FILE
SELECT sint8
     , sum(1 DIV (sint8 - sint8)) as intdiv_zero
FROM tbl
GROUP BY sint8;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo Modulo zero:
--write_file $QUERY_FILE
SELECT sint8
     , sum(1 % (sint8 - sint8)) as mod_zero
FROM tbl
GROUP BY sint8;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo Compare MySQL and RonSQL using a query that creates a fairly deep stack
--echo using 100 unary minuses and 100 NOTs.
--write_file $QUERY_FILE
SELECT sum(sint8)
FROM tbl
WHERE
  sint8 > ----------------------------------------------------------------------------------------------------1 AND
  NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT
  NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT
  NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT
  NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT
  NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT
  sint8>0;
EOF
--source suite/ronsql/include/ronsql_compare.inc

--echo Test the maximum stack depth for unary minus and NOT that RonSQL can
--echo handle.
--write_file $QUERY_FILE
SELECT sum(sint8)
FROM tbl
WHERE
  sint8 >
EOF
# Add 98*100=9800 minus signs to the query file.
let $1= 98;
while ($1)
{
--append_file $QUERY_FILE
  ----------------------------------------------------------------------------------------------------
EOF
dec $1;
}
--append_file $QUERY_FILE
  1
  AND
EOF
# Add 490*20=9800 NOT keywords to the query file.
let $1= 490;
while ($1)
{
--append_file $QUERY_FILE
  NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT
EOF
dec $1;
}
--append_file $QUERY_FILE
  sint8>0;
EOF
# Test ronsql_cli
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test < '$QUERY_FILE' 2>&1
# Test rdrs2
--exec printf '{"query":"' > $MYSQL_TMP_DIR/ronsql-rdrs-body-1
--exec perl -pe 's/\n/\\n/g;' $QUERY_FILE > $MYSQL_TMP_DIR/ronsql-rdrs-body-2
--exec printf '","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body-3
--exec cat $MYSQL_TMP_DIR/ronsql-rdrs-body-1 $MYSQL_TMP_DIR/ronsql-rdrs-body-2 $MYSQL_TMP_DIR/ronsql-rdrs-body-3 > $MYSQL_TMP_DIR/ronsql-rdrs-body
--exec curl --fail-with-body -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body 2>/dev/null
--remove_file $QUERY_FILE
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body-1
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body-2
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body-3

--echo Exceeding maximum stack depth for RonSQL should fail gracefully
--write_file $QUERY_FILE
SELECT sum(sint8)
FROM tbl
WHERE
  sint8 >
EOF
# Add 99*100+88=9988 minus signs to the query file.
let $1= 99;
while ($1)
{
--append_file $QUERY_FILE
  ----------------------------------------------------------------------------------------------------
EOF
dec $1;
}
--append_file $QUERY_FILE
  ----------------------------------------------------------------------------------------1
  AND
EOF
# Add 499*20+8=9988 NOT keywords to the query file.
let $1= 499;
while ($1)
{
--append_file $QUERY_FILE
  NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT NOT
EOF
dec $1;
}
--append_file $QUERY_FILE
  NOT NOT NOT NOT NOT NOT NOT NOT sint8>0;
EOF
# Test ronsql_cli - expect error with "Parser stack exceeded" message
--error 1
--exec $RONSQL_CLI_EXE --connect-string $NDB_CONNECTSTRING -D test < '$QUERY_FILE' > $MYSQL_TMP_DIR/ronsql-cli.out 2>&1
--exec grep -q "Parser stack exceeded" $MYSQL_TMP_DIR/ronsql-cli.out
--remove_file $MYSQL_TMP_DIR/ronsql-cli.out
# Test rdrs2 - expect error response with "Parser stack exceeded" message
--exec printf '{"query":"' > $MYSQL_TMP_DIR/ronsql-rdrs-body-1
--exec perl -pe 's/\n/\\n/g;' $QUERY_FILE > $MYSQL_TMP_DIR/ronsql-rdrs-body-2
--exec printf '","database":"test","outputFormat":"TEXT"}' > $MYSQL_TMP_DIR/ronsql-rdrs-body-3
--exec cat $MYSQL_TMP_DIR/ronsql-rdrs-body-1 $MYSQL_TMP_DIR/ronsql-rdrs-body-2 $MYSQL_TMP_DIR/ronsql-rdrs-body-3 > $MYSQL_TMP_DIR/ronsql-rdrs-body
--error 22
--exec curl --fail-with-body -X POST -H "Content-Type: application/json" http://$RDRS_NOKEY_HOST:$RDRS_NOKEY_PORT/0.1.0/ronsql --data-binary @$MYSQL_TMP_DIR/ronsql-rdrs-body > $MYSQL_TMP_DIR/ronsql-rdrs.out 2>/dev/null
--exec grep -q "Parser stack exceeded" $MYSQL_TMP_DIR/ronsql-rdrs.out
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs.out
--remove_file $QUERY_FILE
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body-1
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body-2
--remove_file $MYSQL_TMP_DIR/ronsql-rdrs-body-3

--echo Cleanup
DROP TABLE tbl;
