{
  "PIDFile": "@pid-file",
  "REST": {
    "ServerIP": "@bind-address",
    "ServerPort": @port
  },
  "Internal": {
    "#comment": "Deliberately tiny request/response caps for ronsql_size_limits.test",
    "maxReqSize": 300,
    "MaxRespSize": 65536
  },
  "RonDB": {
      "Mgmds": [ { "IP": "@cluster_config.ndb_mgmd.1.1.HostName",
                   "Port": @cluster_config.ndb_mgmd.1.1.PortNumber } ]
  },
  "Security": {
    "InsecureAllowAll": @InsecureAllowAll,
    "TLS": {
      "EnableTLS": false,
      "RequireAndVerifyClientCert": false
    },
    "APIKey": {
      "UseHopsworksAPIKeys": @UseHopsworksAPIKeys
    }
  },
  "Log": {
    "Level": "INFO",
    "LogQueries": true
  }
}
