=== cf-7: control, GROUP BY drops the group whose rows all fail ===
== Query ==
SELECT o.id AS id, COUNT(*) AS n, SUM(l.price) AS s
FROM xo AS o JOIN xl AS l ON l.oid = o.id
WHERE l.qty > o.lim
GROUP BY o.id;

Number of output lines, including header: 4

== Diff ==
==========



== Expected result ==
SELECT o.id AS id, COUNT(*) AS n, SUM(l.price) AS s
FROM xo AS o JOIN xl AS l ON l.oid = o.id
WHERE l.qty > o.lim
GROUP BY o.id|
id	n	s
1	1	200
2	1	300
3	1	500

