# Topology mirror of suite ronsql (RONDB-1124 T-3): 2 node groups x 2
# replicas (4 data nodes).  Everything else — CompiledInterpreter=OFF (the
# interpreter arm), the two RDRS instances and their template, node ids —
# comes from the included file; only the data-node count differs
# (NoOfReplicas stays 2).  The tests are the subset of suite ronsql whose
# paths depend on the fragment count or the topology, generated by
# suite/ronsql/mirrors/ronsql_mirrors.pl (the list is in
# ronsql_mirrors.cfg).  Each mirror test asserts the topology (COUNT(*)
# FROM ndbinfo.nodes) before sourcing the original, so a mirror can never
# silently run on the base cluster.
!include suite/ronsql/my.cnf

[cluster_config.1]
ndbd=,,,
NoOfReplicas=2
