=== Hopsworks DDL round-trip: TIMESTAMP(3), TTL comment, hash-only PK ===
SHOW CREATE TABLE sessions_1;
Table	Create Table
sessions_1	CREATE TABLE `sessions_1` (
  `customer_id` bigint NOT NULL,
  `event_time` timestamp(3) NOT NULL /*!50606 STORAGE MEMORY */,
  `duration` int DEFAULT NULL,
  `pages` int DEFAULT NULL,
  `device` varchar(100) DEFAULT NULL,
  `bytes` bigint DEFAULT NULL,
  PRIMARY KEY (`customer_id`,`event_time`),
  KEY `ttl_index` (`event_time`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='NDB_TABLE=TTL=3153600000@event_time,READ_BACKUP=1'
SHOW CREATE TABLE transactions_hash_1;
Table	Create Table
transactions_hash_1	CREATE TABLE `transactions_hash_1` (
  `customer_id` bigint NOT NULL,
  `event_time` timestamp NOT NULL /*!50606 STORAGE MEMORY */,
  `amount` bigint DEFAULT NULL,
  `fee` int DEFAULT NULL,
  `merchant_id` int DEFAULT NULL,
  `category` varchar(100) DEFAULT NULL,
  `score` double DEFAULT NULL,
  `amount_dec` decimal(12,2) DEFAULT NULL,
  `flag` tinyint DEFAULT NULL,
  PRIMARY KEY (`customer_id`,`event_time`) USING HASH,
  KEY `idx_merchant_id` (`merchant_id`)
) ENGINE=ndbcluster DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='NDB_TABLE=READ_BACKUP=1'

