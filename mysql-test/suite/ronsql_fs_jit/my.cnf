# RONDB-1056 / RONDB-1121 E8 — the JIT arm of the feature-store RonSQL
# differential.  Runs the SAME tests as suite ronsql_fs (one-line mirrors
# that --source the originals) with the compiled interpreter ACTIVE, while
# ronsql_fs pins CompiledInterpreter=OFF.  Each mirror brackets its test
# with a recorded JIT fallback-delta pin (census: how many programs of the
# Hopsworks corpus fall back to the interpreter).  Strict compile arming
# (suite/ronsql_cte_jit/include/jit_strict_arm.inc) is deliberately NOT
# applied yet: arm it per test once its recorded delta is 0.
!include suite/ronsql_fs/my.cnf

[cluster_config.1]
CompiledInterpreter=ON
