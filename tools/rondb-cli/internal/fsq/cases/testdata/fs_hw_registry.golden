=== fs_hw_collect5 [S6b] ronsql+mysql rows=<= 5
-- collect the newest 5 rows, direct form
SELECT `customer_id`, `event_time`, `amount`, `category` FROM `transactions_1` WHERE `customer_id` = {KEY} ORDER BY `event_time` DESC LIMIT 5;
-- plan pins: Execute as index scan. | ORDER BY: index order (SF_OrderBy | SF_Descending | Result limited to 5 rows.

=== fs_hw_collect5_cte [S6] ronsql+mysql rows=<= 5 (or REJECT)
-- collect the newest 5 rows, Hopsworks CTE form (F0: clean rejection expected)
WITH t AS (SELECT `customer_id`, `event_time`, `amount`, `category` FROM `transactions_1` WHERE `customer_id` = {KEY} ORDER BY `event_time` DESC LIMIT 5) SELECT `customer_id`, `event_time`, `amount`, `category` FROM t;

=== fs_hw_collect5_twin [S6 twin] mysql-only rows=<= 5
-- production MySQL collect statement (ROW_NUMBER window, rank <= 5)
SELECT *
FROM (SELECT `fg0`.`customer_id` AS `tx_customer_id`, `fg0`.`event_time` AS `tx_event_time`, `fg0`.`amount` AS `tx_amount`, `fg0`.`category` AS `tx_category`, ROW_NUMBER() OVER (PARTITION BY `fg0`.`customer_id` ORDER BY `fg0`.`event_time` DESC) AS hopsworks_collect_rank
FROM `fs_bench`.`transactions_1` AS `fg0`
WHERE `fg0`.`customer_id` = {KEY}) AS hopsworks_collect_src
WHERE hopsworks_collect_rank <= 5
ORDER BY hopsworks_collect_rank

