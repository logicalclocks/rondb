# fs_hw benchmark registry — generated by cases.BenchEntries (RONDB-1121 E5); do not edit by hand.
# Placeholders per request: {KEY} random customer in 1..max (KeySQL); {KEYS:n} n distinct customers; {SKEY}/{SKEYS:n} string keys of customers 1..max/10; {ACCT} random account in 1..max/2 with {CUR} one of its currencies; {NOW-7d} etc. the TIMESTAMP literal FS_NOW minus the window

=== fs_hw_floor [-] ronsql+mysql rows=1
-- Fixed-overhead floor: COUNT(*) over countries_1 (40 rows)
SELECT COUNT(*) FROM `countries_1`;

=== fs_hw_agg_point [S1] ronsql+mysql rows=1
-- point aggregate over one customer's history
SELECT COUNT(`amount`) AS `amount_count`, SUM(`amount`) AS `amount_sum`, MAX(`amount`) AS `amount_max`, MIN(`fee`) AS `fee_min` FROM `transactions_1` WHERE `customer_id` = {KEY};
-- plan pins: Execute as index scan. | Index: `PRIMARY`

=== fs_hw_agg_window7d [S2] ronsql+mysql rows=1
-- point aggregate with a 7-day window
SELECT COUNT(`amount`) AS `amount_count`, SUM(`amount`) AS `amount_sum`, MAX(`amount`) AS `amount_max`, MIN(`fee`) AS `fee_min` FROM `transactions_1` WHERE `customer_id` = {KEY} AND `event_time` >= {NOW-7d};
-- plan pins: Execute as index scan. | Index: `PRIMARY`

=== fs_hw_agg_greatest [S5] ronsql+mysql rows=1
-- MAX(GREATEST) / MAX(LEAST) fold
SELECT COUNT(*) AS `count`, MAX(GREATEST(`amount`, `fee`)) AS `amount_fee_greatest`, MAX(LEAST(`amount`, `fee`)) AS `amount_fee_least` FROM `transactions_1` WHERE `customer_id` = {KEY};
-- plan pins: Execute as index scan. | Index: `PRIMARY`

=== fs_hw_agg_filter [S4] ronsql+mysql rows=1
-- point aggregate with two feature-view filters
SELECT COUNT(`amount`) AS `amount_count`, SUM(`amount`) AS `amount_sum`, MAX(`amount`) AS `amount_max`, MIN(`fee`) AS `fee_min` FROM `transactions_1` WHERE `customer_id` = {KEY} AND `category` = 'grocery' AND `amount` >= 300;
-- plan pins: Execute as index scan. | Index: `PRIMARY`

