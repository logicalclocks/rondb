=== fs_hw_snow1_point [S7] ronsql+mysql rows=<= 1
-- snowflake 1-hop INNER (customer -> region)
WITH `b` AS (SELECT `region_id`, COUNT(*) AS `hw_cnt` FROM `customers_1` WHERE `customer_id` = {KEY} GROUP BY `region_id`) SELECT `j2`.`region_name` AS `r_region_name`, `j2`.`population` AS `r_population` FROM `b` JOIN `regions_1` AS `j2` ON `j2`.`region_id` = `b`.`region_id`;
-- plan pins: Body root: INDEX_SCAN using PRIMARY | [ROOT] CTE_SCAN | [INNER] PK_LOOKUP

=== fs_hw_snow1_twin [S7 twin] mysql-only rows=<= 1
-- production MySQL nested join, 1 hop
SELECT `fg1`.`region_name` AS `r_region_name`, `fg1`.`population` AS `r_population`, `fg0`.`tier` AS `p_tier`, `fg0`.`age` AS `p_age`
FROM `fs_bench`.`customers_1` AS `fg0`
INNER JOIN `fs_bench`.`regions_1` AS `fg1` ON `fg0`.`region_id` = `fg1`.`region_id`
WHERE `fg0`.`customer_id` = {KEY}

=== fs_hw_snow2_point [S7] ronsql+mysql rows=<= 1
-- snowflake 2-hop INNER (customer -> region -> country)
WITH `b` AS (SELECT `region_id`, COUNT(*) AS `hw_cnt` FROM `customers_1` WHERE `customer_id` = {KEY} GROUP BY `region_id`) SELECT `j2`.`region_name` AS `r_region_name`, `j2`.`population` AS `r_population`, `j3`.`country_name` AS `c_country_name`, `j3`.`continent` AS `c_continent` FROM `b` JOIN `regions_1` AS `j2` ON `j2`.`region_id` = `b`.`region_id` JOIN `countries_1` AS `j3` ON `j3`.`country_id` = `j2`.`country_id`;
-- plan pins: Body root: INDEX_SCAN using PRIMARY | [ROOT] CTE_SCAN | [INNER] PK_LOOKUP

=== fs_hw_snow2_twin [S7 twin] mysql-only rows=<= 1
-- production MySQL nested join, 2 hops
SELECT `fg1`.`region_name` AS `r_region_name`, `fg1`.`population` AS `r_population`, `fg2`.`country_name` AS `c_country_name`, `fg2`.`continent` AS `c_continent`, `fg0`.`tier` AS `p_tier`, `fg0`.`age` AS `p_age`
FROM `fs_bench`.`customers_1` AS `fg0`
INNER JOIN `fs_bench`.`regions_1` AS `fg1` ON `fg0`.`region_id` = `fg1`.`region_id`
INNER JOIN `fs_bench`.`countries_1` AS `fg2` ON `fg1`.`country_id` = `fg2`.`country_id`
WHERE `fg0`.`customer_id` = {KEY}

=== fs_hw_snow1_batch100 [S7 batch] ronsql+mysql rows=<= 100
-- snowflake 1-hop batch of 100 (root key projected; F12: CTE body table scan)
WITH `b` AS (SELECT `customer_id`, `region_id`, COUNT(*) AS `hw_cnt` FROM `customers_1` WHERE `customer_id` IN ({KEYS:100}) GROUP BY `customer_id`, `region_id`) SELECT `j2`.`region_name` AS `r_region_name`, `j2`.`population` AS `r_population`, `b`.`customer_id` AS `customer_id` FROM `b` JOIN `regions_1` AS `j2` ON `j2`.`region_id` = `b`.`region_id`;
-- plan pins: Body root: TABLE_SCAN | [ROOT] CTE_SCAN | [INNER] PK_LOOKUP

=== fs_hw_snow2_left_chain [S8] ronsql+mysql rows=<= 1
-- LEFT per-chain template for the country node (two inner hops, one projection)
WITH `b` AS (SELECT `region_id`, COUNT(*) AS `hw_cnt` FROM `customers_1` WHERE `customer_id` = {KEY} GROUP BY `region_id`) SELECT `j3`.`country_name` AS `c_country_name`, `j3`.`continent` AS `c_continent` FROM `b` JOIN `regions_1` AS `j2` ON `j2`.`region_id` = `b`.`region_id` JOIN `countries_1` AS `j3` ON `j3`.`country_id` = `j2`.`country_id`;
-- plan pins: Body root: INDEX_SCAN using PRIMARY | [ROOT] CTE_SCAN | [INNER] PK_LOOKUP

=== fs_hw_snow2_left_single [S8b] ronsql+mysql rows=1
-- single-statement LEFT JOIN hops (future Hopsworks shape)
WITH `b` AS (SELECT `region_id`, COUNT(*) AS `hw_cnt` FROM `customers_1` WHERE `customer_id` = {KEY} GROUP BY `region_id`) SELECT `j2`.`region_name` AS `r_region_name`, `j2`.`population` AS `r_population`, `j3`.`country_name` AS `c_country_name`, `j3`.`continent` AS `c_continent` FROM `b` LEFT JOIN `regions_1` AS `j2` ON `j2`.`region_id` = `b`.`region_id` LEFT JOIN `countries_1` AS `j3` ON `j3`.`country_id` = `j2`.`country_id`;
-- plan pins: Body root: INDEX_SCAN using PRIMARY | [ROOT] CTE_SCAN | [LEFT JOIN] PK_LOOKUP

