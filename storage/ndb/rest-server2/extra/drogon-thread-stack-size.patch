     }
-    if (thread_.joinable())
+    if (threadStarted_ && !threadJoined_)
     {
-        thread_.join();
+        pthread_join(threadId_, nullptr);
+        threadJoined_ = true;
     }
 }
 
 void EventLoopThread::wait()
 {
-    thread_.join();
+    if (threadStarted_ && !threadJoined_)
+    {
+        pthread_join(threadId_, nullptr);
+        threadJoined_ = true;
+    }
