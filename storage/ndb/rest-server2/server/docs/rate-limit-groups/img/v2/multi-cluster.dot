digraph multi {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=11, pad=0.3, nodesep=0.5, ranksep=1.0, bgcolor="white", compound=true];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=9, color="#096b67", arrowsize=0.7, penwidth=1.1];

  groups [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD COLSPAN="4" BGCOLOR="#096b67"><FONT COLOR="white"><B>the two new tables, joined</B></FONT></TD></TR>
 <TR><TD BGCOLOR="#edf4f4"><B>name</B></TD><TD BGCOLOR="#edf4f4"><B>budget_percent</B></TD><TD BGCOLOR="#edf4f4"><B>who</B> (project_id)</TD><TD BGCOLOR="#edf4f4"><B>cluster</B></TD></TR>
 <TR><TD><FONT FACE="Menlo" POINT-SIZE="9">recommender_m_rl</FONT></TD><TD>20.00</TD><TD>13 Recommender</TD><TD PORT="r1"><FONT FACE="Menlo" POINT-SIZE="9">rondb-m</FONT></TD></TR>
 <TR><TD><FONT FACE="Menlo" POINT-SIZE="9">recommender2_m_rl</FONT></TD><TD>30.00</TD><TD>14 Recommender2</TD><TD PORT="r2"><FONT FACE="Menlo" POINT-SIZE="9">rondb-m</FONT></TD></TR>
 <TR><TD><FONT FACE="Menlo" POINT-SIZE="9">recommender_s_rl</FONT></TD><TD>20.00</TD><TD>13 Recommender</TD><TD PORT="r3"><FONT FACE="Menlo" POINT-SIZE="9">rondb-s</FONT></TD></TR>
 <TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#566574">each row names its cluster: the namespace. The same project in two groups on different clusters is no tie (section 9).</FONT></TD></TR>
</TABLE>>];

  subgraph cluster_M {
    label="cluster M (namespace rondb-m)"; style="rounded,filled"; fillcolor="#f4f7f7"; color="#8aa5a3"; fontname="Helvetica"; fontsize=11;
    userM [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD PORT="in" BGCOLOR="#edf4f4" ALIGN="LEFT"><B>USER entries installed by Hopsworks</B></TD></TR>
 <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="9">recommender_m_rl  = 20% of M<BR ALIGN="LEFT"/>recommender2_m_rl = 30% of M</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9" COLOR="#566574">plus the members' aliases; 50 of M's 50 points used</FONT></TD></TR>
</TABLE>>];
  }
  subgraph cluster_S {
    label="cluster S (namespace rondb-s)"; style="rounded,filled"; fillcolor="#f4f7f7"; color="#8aa5a3"; fontname="Helvetica"; fontsize=11;
    userS [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD PORT="in" BGCOLOR="#edf4f4" ALIGN="LEFT"><B>USER entries installed by Hopsworks</B></TD></TR>
 <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="9">recommender_s_rl = 20% of S</FONT></TD></TR>
</TABLE>>];
  }
  subgraph cluster_R {
    label="cluster R (namespace rondb-r)"; style="rounded,filled"; fillcolor="#f4f7f7"; color="#8aa5a3"; fontname="Helvetica"; fontsize=11;
    userR [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD BGCOLOR="#edf4f4" ALIGN="LEFT"><B>USER entries installed by Hopsworks</B></TD></TR>
 <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#566574">none: no group names rondb-r</FONT></TD></TR>
</TABLE>>];
  }

  groups:r1:e -> userM:in:w [label="cluster = rondb-m"];
  groups:r2:e -> userM:in:w;
  groups:r3:e -> userS:in:w [label="cluster = rondb-s"];
}
