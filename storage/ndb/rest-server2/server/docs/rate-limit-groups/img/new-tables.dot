digraph newtables {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=11, pad=0.3, nodesep=0.6, ranksep=0.9, bgcolor="white"];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=9, color="#096b67", arrowsize=0.7, penwidth=1.1];

  users [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD COLSPAN="2" BGCOLOR="#566574"><FONT COLOR="white"><B>users</B> (existing)</FONT></TD></TR>
 <TR><TD BGCOLOR="#f1f3f5"><B>email</B></TD><TD BGCOLOR="#f1f3f5"><B>uid</B></TD></TR>
 <TR><TD>mary@acme.io</TD><TD PORT="u1001">1001</TD></TR>
 <TR><TD>mike@acme.io</TD><TD PORT="u1002">1002</TD></TR>
 <TR><TD>sam@acme.io</TD><TD>1003</TD></TR>
 <TR><TD>alice@acme.io</TD><TD>1004</TD></TR>
 <TR><TD>ava@acme.io</TD><TD>1005</TD></TR>
 <TR><TD>rosa@acme.io</TD><TD>1006</TD></TR>
</TABLE>>];

  project [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD COLSPAN="2" BGCOLOR="#566574"><FONT COLOR="white"><B>project</B> (existing)</FONT></TD></TR>
 <TR><TD BGCOLOR="#f1f3f5"><B>projectname</B></TD><TD BGCOLOR="#f1f3f5"><B>id</B></TD></TR>
 <TR><TD>Marketing</TD><TD>11</TD></TR>
 <TR><TD>Sales</TD><TD>12</TD></TR>
 <TR><TD>Recommender</TD><TD PORT="p13">13</TD></TR>
 <TR><TD>Recommender2</TD><TD PORT="p14">14</TD></TR>
</TABLE>>];

  bucket_user [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD COLSPAN="4" BGCOLOR="#096b67"><FONT COLOR="white"><B>rate_limit_bucket_user</B> (new) — who</FONT></TD></TR>
 <TR><TD BGCOLOR="#edf4f4"><B>uid</B></TD><TD BGCOLOR="#edf4f4"><B>project_id</B></TD><TD BORDER="0" BGCOLOR="white" ALIGN="LEFT"><FONT COLOR="#566574"><I>resolves to</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#8a97a0"><I>not a column, explanation only</I></FONT></TD><TD BGCOLOR="#edf4f4"><B>bucket_id</B></TD></TR>
 <TR><TD>NULL</TD><TD PORT="bp13">13</TD><TD BORDER="0" ALIGN="LEFT"><FONT COLOR="#566574"><I>every project_team row with project_id 13, any role<BR ALIGN="LEFT"/>today: alice@ → 1004, ava@ → 1005, plus service accounts</I></FONT></TD><TD PORT="b1">1</TD></TR>
 <TR><TD PORT="bu1001">1001</TD><TD>NULL</TD><TD BORDER="0" ALIGN="LEFT"><FONT COLOR="#566574"><I>uid 1001 (Mary) directly</I></FONT></TD><TD PORT="b2a">2</TD></TR>
 <TR><TD PORT="bu1002">1002</TD><TD>NULL</TD><TD BORDER="0" ALIGN="LEFT"><FONT COLOR="#566574"><I>uid 1002 (Mike) directly</I></FONT></TD><TD PORT="b2b">2</TD></TR>
 <TR><TD>NULL</TD><TD PORT="bp14">14</TD><TD BORDER="0" ALIGN="LEFT"><FONT COLOR="#566574"><I>every project_team row with project_id 14, any role<BR ALIGN="LEFT"/>today: rosa@ → 1006, plus service accounts</I></FONT></TD><TD PORT="b3">3</TD></TR>
 <TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#566574">uid or project_id, never both. A project row is expanded at request time from RDRS's cached project_team; nothing is copied here.</FONT></TD></TR>
</TABLE>>];

  bucket [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD COLSPAN="4" BGCOLOR="#096b67"><FONT COLOR="white"><B>rate_limit_bucket</B> (new)</FONT></TD></TR>
 <TR><TD BGCOLOR="#edf4f4"><B>id</B></TD><TD BGCOLOR="#edf4f4"><B>name</B> (= RonDB USER)</TD><TD BGCOLOR="#edf4f4"><B>budget_percent</B></TD><TD BGCOLOR="#edf4f4"><B>data_scope</B></TD></TR>
 <TR><TD PORT="id1">1</TD><TD><FONT FACE="Menlo" POINT-SIZE="9">recommender</FONT></TD><TD>20.00</TD><TD>ALL</TD></TR>
 <TR><TD PORT="id2">2</TD><TD><FONT FACE="Menlo" POINT-SIZE="9">clicks_own</FONT></TD><TD>2.00</TD><TD>SELECTED</TD></TR>
 <TR><TD PORT="id3">3</TD><TD><FONT FACE="Menlo" POINT-SIZE="9">rec2_on_marketing</FONT></TD><TD>5.00</TD><TD>SELECTED</TD></TR>
 <TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#566574">ALL = no data rows; SELECTED = only the data rows listed</FONT></TD></TR>
</TABLE>>];

  bucket_data [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD COLSPAN="4" BGCOLOR="#096b67"><FONT COLOR="white"><B>rate_limit_bucket_data</B> (new) — what</FONT></TD></TR>
 <TR><TD BGCOLOR="#edf4f4"><B>feature_group_id</B></TD><TD BGCOLOR="#edf4f4"><B>feature_store_id</B></TD><TD BORDER="0" BGCOLOR="white" ALIGN="LEFT"><FONT COLOR="#566574"><I>resolves to</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="8" COLOR="#8a97a0"><I>not a column, explanation only</I></FONT></TD><TD BGCOLOR="#edf4f4"><B>bucket_id</B></TD></TR>
 <TR><TD PORT="dfg31">31</TD><TD>NULL</TD><TD BORDER="0" ALIGN="LEFT"><FONT COLOR="#566574"><I>one online table: marketing.marketing_clicks_1<BR ALIGN="LEFT"/>(store name + feature group name_version; version 2 is a different row, not covered)</I></FONT></TD><TD PORT="d2">2</TD></TR>
 <TR><TD>NULL</TD><TD PORT="dfs21">21</TD><TD BORDER="0" ALIGN="LEFT"><FONT COLOR="#566574"><I>one database: marketing<BR ALIGN="LEFT"/>(every table in it, every feature group and version, including ones created later)</I></FONT></TD><TD PORT="d3">3</TD></TR>
 <TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#566574">feature_group_id or feature_store_id, never both. RDRS expands each row to a (database, table) or (database) key when it loads the cache.</FONT></TD></TR>
</TABLE>>];

  feature_group [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD COLSPAN="3" BGCOLOR="#566574"><FONT COLOR="white"><B>feature_group</B> (existing)</FONT></TD></TR>
 <TR><TD BGCOLOR="#f1f3f5"><B>name</B></TD><TD BGCOLOR="#f1f3f5"><B>feature_store_id</B></TD><TD BGCOLOR="#f1f3f5"><B>id</B></TD></TR>
 <TR><TD>marketing_clicks</TD><TD>21</TD><TD PORT="fg31">31</TD></TR>
 <TR><TD>marketing_campaigns</TD><TD>21</TD><TD>32</TD></TR>
 <TR><TD>sales_orders</TD><TD>22</TD><TD>33</TD></TR>
 <TR><TD>recommender_features</TD><TD>23</TD><TD>34</TD></TR>
 <TR><TD>recommender2_features</TD><TD>24</TD><TD>35</TD></TR>
</TABLE>>];

  feature_store [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8aa5a3">
 <TR><TD COLSPAN="3" BGCOLOR="#566574"><FONT COLOR="white"><B>feature_store</B> (existing)</FONT></TD></TR>
 <TR><TD BGCOLOR="#f1f3f5"><B>name</B> (= online database)</TD><TD BGCOLOR="#f1f3f5"><B>project_id</B></TD><TD BGCOLOR="#f1f3f5"><B>id</B></TD></TR>
 <TR><TD>marketing</TD><TD>11</TD><TD PORT="fs21">21</TD></TR>
 <TR><TD>sales</TD><TD>12</TD><TD>22</TD></TR>
 <TR><TD>recommender</TD><TD>13</TD><TD>23</TD></TR>
 <TR><TD>recommender2</TD><TD>14</TD><TD>24</TD></TR>
</TABLE>>];

  // existing tables (left) <- link tables (middle) -> rate_limit_bucket (right)
  users:u1001:e   -> bucket_user:bu1001 [dir=back];
  users:u1002:e   -> bucket_user:bu1002 [dir=back];
  project:p13:e   -> bucket_user:bp13   [dir=back, label="project_id → id"];
  project:p14:e   -> bucket_user:bp14   [dir=back];
  feature_group:fg31:e -> bucket_data:dfg31 [dir=back, label="feature_group_id → id"];
  feature_store:fs21:e -> bucket_data:dfs21 [dir=back, label="feature_store_id → id"];
  bucket_user:b1:e  -> bucket:id1:w [label="bucket_id → id"];
  bucket_user:b2a:e -> bucket:id2:w;
  bucket_user:b2b:e -> bucket:id2:w;
  bucket_user:b3:e  -> bucket:id3:w;
  bucket_data:d2:e  -> bucket:id2:w [label="bucket_id → id"];
  bucket_data:d3:e  -> bucket:id3:w;

  { rank=same; users; project; feature_group; feature_store; }
  { rank=same; bucket_user; bucket_data; }
}
